#!/usr/bin/env bash
# =========================================================================
#  Linux 全局日志全量秒清 & 尺寸硬性熔断哨兵 (全需求满血终极版)
#  适配系统: Alpine (OpenRC/BusyBox), Debian, Ubuntu, CentOS, Rocky, Alma
# =========================================================================

red='\033[31m'; green='\033[32m'; yellow='\033[33m'
cyan='\033[36m'; bold='\033[1m'; plain='\033[0m'

[[ $EUID -ne 0 ]] && echo -e "${red}错误：${plain}必须使用 root 权限运行！\n" && exit 1

# 1. 基础环境静默自愈
auto_install_deps() {
    if [ -f /etc/alpine-release ] || command -v apk &>/dev/null; then
        apk update >/dev/null 2>&1
        apk add --no-cache bash logrotate cronie findutils >/dev/null 2>&1
    elif command -v apt-get &>/dev/null; then
        apt-get update -y -q >/dev/null 2>&1
        apt-get install -y --no-install-recommends logrotate cron findutils >/dev/null 2>&1
    elif command -v dnf &>/dev/null; then
        dnf install -y logrotate crontabs findutils >/dev/null 2>&1
    elif command -v yum &>/dev/null; then
        yum install -y logrotate crontabs findutils >/dev/null 2>&1
    fi
}
auto_install_deps

echo -e "\n${cyan}================================================================${plain}"
echo -e "${cyan}   🚀 Linux 全局日志全量清剿 & 尺寸硬性熔断哨兵 (全系统满血版)   ${plain}"
echo -e "${cyan}================================================================${plain}"

# =========================================================================
# 阶段 1：Systemd 深度源头压制（非 Systemd 环境如 Alpine 自动跳过）
# =========================================================================
echo -e "\n${yellow}[1/6] 正在检查并阻断系统底层冗余双写与崩溃转储...${plain}"
if [ -d /run/systemd/system ] && command -v journalctl &>/dev/null; then
    if [ -f "/etc/systemd/journald.conf" ]; then
        sed -i '/^ForwardToSyslog=/d; /^#ForwardToSyslog=/d' /etc/systemd/journald.conf
        sed -i '/^SystemMaxUse=/d; /^#SystemMaxUse=/d' /etc/systemd/journald.conf
        sed -i '/^RuntimeMaxUse=/d; /^#RuntimeMaxUse=/d' /etc/systemd/journald.conf
        echo "ForwardToSyslog=no" >> /etc/systemd/journald.conf
        echo "SystemMaxUse=15M" >> /etc/systemd/journald.conf
        echo "RuntimeMaxUse=10M" >> /etc/systemd/journald.conf
        systemctl restart systemd-journald >/dev/null 2>&1
        journalctl --vacuum-size=10M >/dev/null 2>&1
    fi
    mkdir -p /etc/systemd/coredump.conf.d 2>/dev/null
    cat << 'EOF' > /etc/systemd/coredump.conf.d/disable-coredump.conf
[Coredump]
Storage=none
ProcessSizeMax=0
EOF
    rm -rf /var/lib/systemd/coredump/* /var/crash/* 2>/dev/null
    echo -e "${green}✔ Systemd Journald 双写已截断，CoreDump 崩溃刷盘已封死${plain}"
else
    echo -e "${cyan}✔ 非 Systemd 环境 (Alpine/OpenRC)，无需双写治理，自动略过${plain}"
fi

# =========================================================================
# 阶段 2：Docker 容器全局源头限额 (若有 Docker 则治理，无则略过)
# =========================================================================
echo -e "\n${yellow}[2/6] 正在检查 Docker 容器引擎日志限额...${plain}"
if command -v docker &>/dev/null; then
    mkdir -p /etc/docker 2>/dev/null
    d_conf="/etc/docker/daemon.json"
    if [ ! -f "$d_conf" ]; then
        cat << 'EOF' > "$d_conf"
{
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "5m",
    "max-file": "1"
  }
}
EOF
        command -v systemctl &>/dev/null && systemctl restart docker >/dev/null 2>&1
        command -v rc-service &>/dev/null && rc-service docker restart >/dev/null 2>&1
        echo -e "${green}✔ 已注入 Docker 全局单容器 5MB 日志上限${plain}"
    else
        echo -e "${green}✔ Docker 配置文件已存在，维持安全监听${plain}"
    fi
else
    echo -e "${cyan}✔ 未运行 Docker，自动略过${plain}"
fi

# =========================================================================
# 阶段 3：配置通用 Logrotate 规则 (5M 触发截断，零保留)
# =========================================================================
echo -e "\n${yellow}[3/6] 正在写入 Logrotate 5MB 轮转截断规则...${plain}"
mkdir -p /etc/logrotate.d 2>/dev/null
cat << 'EOF' > /etc/logrotate.d/global_log_limit
/var/log/*.log
/var/log/*/*.log
/var/log/cf-*
/var/log/cloudflared*
/var/log/v2bx*
/var/log/V2bX*
/var/log/messages
/var/log/syslog
/var/log/daemon.log
{
    size 5M
    rotate 0
    missingok
    notifempty
    copytruncate
    nocompress
}
EOF
echo -e "${green}✔ Logrotate 配置完毕${plain}"

# =========================================================================
# 阶段 4：生成极速羽量级巡检执行体 (纯 POSIX 标准，耗时 < 0.05s)
# =========================================================================
echo -e "\n${yellow}[4/6] 正在生成常驻防爆巡检守护核心...${plain}"
cat << 'EOF' > /usr/local/bin/mega_log_sentinel.sh
#!/bin/sh
LOCK_DIR="/tmp/log_sentinel.lock"
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    lock_age=$(find "$LOCK_DIR" -prune -mmin +5 2>/dev/null)
    if [ -n "$lock_age" ]; then
        rm -rf "$LOCK_DIR"
    else
        exit 0
    fi
fi
trap 'rm -rf "$LOCK_DIR"' EXIT INT TERM

# 1. 穿透释放被锁死的已删除幽灵句柄
for fd in /proc/[0-9]*/fd/*; do
    [ -e "$fd" ] || continue
    t=$(readlink "$fd" 2>/dev/null)
    case "$t" in
        *"(deleted)"*)
            case "$t" in
                *.log*|*.err*|*messages*|*cf-*|*cloudflared*|*v2bx*|*syslog*)
                    : > "$fd" 2>/dev/null
                    ;;
            esac
            ;;
    esac
done

# 2. 轮转检查
[ -x /usr/sbin/logrotate ] && /usr/sbin/logrotate -f /etc/logrotate.d/global_log_limit >/dev/null 2>&1

# 3. 磁盘水位与限额截断
disk_used=$(df -P / 2>/dev/null | awk 'NR==2 {gsub("%","",$5); print $5}')
[ -z "$disk_used" ] && disk_used=0

if [ "$disk_used" -ge 85 ]; then
    # 85% 紧急熔断：全量秒清
    find /var/log -type f \( -name "*.log" -o -name "*_err" -o -name "*_out" -o -name "messages" -o -name "syslog" -o -name "btmp" \) \
        -exec sh -c 'for f; do : > "$f"; done' sh {} + 2>/dev/null
    rm -rf /tmp/* /var/tmp/* 2>/dev/null
else
    # 常规限制：单日志超过 5MB 瞬间抽干
    find /var/log -type f -size +5M \
        -exec sh -c 'for f; do : > "$f"; done' sh {} + 2>/dev/null

    if [ -d "/var/lib/docker/containers" ]; then
        find /var/lib/docker/containers/ -type f -name "*-json.log" -size +5M \
            -exec sh -c 'for f; do : > "$f"; done' sh {} + 2>/dev/null
    fi

    for auth_f in /var/log/btmp /var/log/wtmp; do
        if [ -f "$auth_f" ]; then
            sz=$(wc -c < "$auth_f" 2>/dev/null || echo 0)
            [ "$sz" -gt 3145728 ] && : > "$auth_f" 2>/dev/null
        fi
    done
fi

# 清理归档旧压缩垃圾
find /var/log -type f \( -name "*.gz" -o -name "*.xz" -o -name "*.[0-9]" -o -name "*.old" \) -delete 2>/dev/null
EOF
chmod +x /usr/local/bin/mega_log_sentinel.sh
echo -e "${green}✔ 守护核心就绪${plain}"

# =========================================================================
# 阶段 5：跨系统调度挂载 (Systemd Cron.d & Alpine Crontab)
# =========================================================================
echo -e "\n${yellow}[5/6] 正在向系统挂载每 15 分钟高频调度...${plain}"
if [ -d "/etc/cron.d" ]; then
    cat << 'EOF' > /etc/cron.d/mega_log_sentinel
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
*/15 * * * * root /usr/local/bin/mega_log_sentinel.sh >/dev/null 2>&1
EOF
    chmod 644 /etc/cron.d/mega_log_sentinel
    echo -e "${green}✔ 已挂载至 /etc/cron.d/mega_log_sentinel${plain}"
fi

if [ -f /etc/alpine-release ] || command -v apk &>/dev/null; then
    mkdir -p /etc/crontabs
    touch /etc/crontabs/root
    sed -i '/mega_log_sentinel/d' /etc/crontabs/root 2>/dev/null
    echo "*/15 * * * * /usr/local/bin/mega_log_sentinel.sh >/dev/null 2>&1" >> /etc/crontabs/root
    chmod 600 /etc/crontabs/root
    if command -v rc-service &>/dev/null; then
        rc-update add crond default >/dev/null 2>&1
        rc-service crond restart >/dev/null 2>&1
    fi
    echo -e "${green}✔ 已挂载至 Alpine /etc/crontabs/root 并激活 crond${plain}"
fi

# =========================================================================
# 阶段 6：首次执行——全量无死角识别并秒清所有现存日志 (彻底兑现清空需求)
# =========================================================================
echo -e "\n${yellow}[6/6] 正在执行全量识别与首次彻底清零...${plain}"

# 1. 首次全盘日志原地彻底归零 (保留句柄，秒放空间)
find /var/log -type f \( -name "*.log" -o -name "*_err" -o -name "*_out" -o -name "*.err" -o -name "messages" -o -name "syslog" -o -name "daemon.log" -o -name "cf-*" -o -name "cloudflared*" -o -name "v2bx*" \) \
    -exec sh -c 'for f; do : > "$f"; done' sh {} + 2>/dev/null

# 2. 清理 SSH 爆破大文件
for auth_f in /var/log/btmp /var/log/wtmp /var/log/lastlog; do
    [ -f "$auth_f" ] && : > "$auth_f" 2>/dev/null
done

# 3. 运行哨兵释放残留幽灵句柄
/usr/local/bin/mega_log_sentinel.sh

echo -e "\n${cyan}================================================================${plain}"
echo -e "${green}🎉 全量清理与尺寸熔断机制已 100% 部署完毕！${plain}"
echo -e "🧹 ${bold}首次清理${plain}: 已将所有历史 log 日志彻底原地抽干清零"
echo -e "📏 ${bold}尺寸硬锁${plain}: 单日志文件硬性锁死 ${yellow}5MB${plain}，超限立即截断"
echo -e "🚨 ${bold}应急熔断${plain}: 磁盘水位达 ${red}85%${plain} 时启动全面抽干，永不撑爆"
echo -e "👻 ${bold}幽灵释放${plain}: 穿透监听 /proc，秒解已删文件后台锁死磁盘问题"
echo -e "⚡ ${bold}极限降耗${plain}: 纯 POSIX 批处理，单次耗时 < 0.05s，128M 小鸡运行零感知"
echo -e "${cyan}================================================================${plain}\n"

echo -e "${cyan}当前主磁盘空间状态：${plain}"
df -h /
