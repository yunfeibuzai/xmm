#!/usr/bin/env bash
# =========================================================================
#  麦卖云 V2bX & Linux 全局日志秒清与尺寸硬性熔断哨兵 (v3.1.0-Pro)
#  路径：V2bXclean
#  适配系统: Alpine (OpenRC/BusyBox), Debian, Ubuntu, CentOS, Rocky, Alma
# =========================================================================
sh_ver="3.1.0-Pro"

red='\033[31m'; green='\033[32m'; yellow='\033[33m'
cyan='\033[36m'; bold='\033[1m'; plain='\033[0m'

[[ $EUID -ne 0 ]] && echo -e "${red}错误：${plain}必须使用 root 权限运行！\n" && exit 1

# 1. 基础环境静默自愈
auto_install_deps() {
    if [ -f /etc/alpine-release ] || command -v apk &>/dev/null; then
        apk update >/dev/null 2>&1
        apk add --no-cache bash logrotate cronie findutils >/dev/null 2>&1
    elif command -v apt-get &>/dev/null; then
        apt-get update -y -q >/dev/null 2>&1
        apt-get install -y --no-install-recommends logrotate cron findutils >/dev/null 2>&1
    elif command -v dnf &>/dev/null; then
        dnf install -y logrotate crontabs findutils >/dev/null 2>&1
    elif command -v yum &>/dev/null; then
        yum install -y logrotate crontabs findutils >/dev/null 2>&1
    fi
}
auto_install_deps

echo -e "\n${cyan}================================================================${plain}"
echo -e "${cyan}   🚀 麦卖云全系统日志秒清 & 尺寸硬性熔断哨兵 v${sh_ver}         ${plain}"
echo -e "${cyan}================================================================${plain}"

# =========================================================================
# 阶段 1：Systemd 深度源头压制
# =========================================================================
echo -e "\n${yellow}[1/6] 正在检查并阻断系统底层冗余双写与崩溃转储...${plain}"
if [ -d /run/systemd/system ] && command -v journalctl &>/dev/null; then
    if [ -f "/etc/systemd/journald.conf" ]; then
        sed -i '/^ForwardToSyslog=/d; /^#ForwardToSyslog=/d' /etc/systemd/journald.conf
        sed -i '/^SystemMaxUse=/d; /^#SystemMaxUse=/d' /etc/systemd/journald.conf
        sed -i '/^RuntimeMaxUse=/d; /^#RuntimeMaxUse=/d' /etc/systemd/journald.conf
        echo "ForwardToSyslog=no" >> /etc/systemd/journald.conf
        echo "SystemMaxUse=15M" >> /etc/systemd/journald.conf
        echo "RuntimeMaxUse=10M" >> /etc/systemd/journald.conf
        systemctl restart systemd-journald >/dev/null 2>&1
        journalctl --vacuum-size=10M >/dev/null 2>&1
    fi
    mkdir -p /etc/systemd/coredump.conf.d 2>/dev/null
    cat << 'EOF' > /etc/systemd/coredump.conf.d/disable-coredump.conf
[Coredump]
Storage=none
ProcessSizeMax=0
EOF
    rm -rf /var/lib/systemd/coredump/* /var/crash/* 2>/dev/null
    echo -e "${green}✔ Systemd Journald 双写已截断，CoreDump 崩溃刷盘已封死${plain}"
else
    echo -e "${cyan}✔ 非 Systemd 环境 (Alpine/OpenRC)，无需双写治理，自动略过${plain}"
fi

# =========================================================================
# 阶段 2：Docker 容器全局源头限额 (平滑热重载，不重启现有容器)
# =========================================================================
echo -e "\n${yellow}[2/6] 正在检查 Docker 容器引擎日志限额...${plain}"
if command -v docker &>/dev/null; then
    mkdir -p /etc/docker 2>/dev/null
    d_conf="/etc/docker/daemon.json"
    if [ ! -f "$d_conf" ]; then
        cat << 'EOF' > "$d_conf"
{
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "5m",
    "max-file": "1"
  }
}
EOF
        if pgrep -x dockerd >/dev/null 2>&1; then
            kill -HUP "$(pgrep -x dockerd | head -n1)" >/dev/null 2>&1
        fi
        echo -e "${green}✔ 已注入 Docker 全局单容器 5MB 日志上限 (平滑生效)${plain}"
    else
        echo -e "${green}✔ Docker 配置文件已存在，维持安全监听${plain}"
    fi
else
    echo -e "${cyan}✔ 未运行 Docker，自动略过${plain}"
fi

# =========================================================================
# 阶段 3：配置专属 Logrotate 规则 (避开系统自带规则防重名冲突)
# =========================================================================
echo -e "\n${yellow}[3/6] 正在写入 V2bX 与隧道专属 Logrotate 5MB 轮转规则...${plain}"
mkdir -p /etc/logrotate.d 2>/dev/null
rm -f /etc/logrotate.d/global_log_limit /etc/logrotate.d/v2bx_anti_explode /etc/logrotate.d/v2bx_all 2>/dev/null

cat << 'EOF' > /etc/logrotate.d/v2bx_sentinel_limit
/var/log/V2bX/*.log
/var/log/v2bx*.log
/var/log/v2bx*.err
/var/log/cf-*.log
/var/log/cloudflared*.log
/etc/V2bX/error.log
{
    su root root
    size 5M
    rotate 0
    missingok
    notifempty
    copytruncate
    nocompress
    nodateext
}
EOF
echo -e "${green}✔ Logrotate 专属截断规则配置完毕 (零冲突)${plain}"

# =========================================================================
# 阶段 4：生成极速羽量级巡检执行体 (纯 POSIX /bin/sh，兼容 BusyBox)
# =========================================================================
echo -e "\n${yellow}[4/6] 正在生成常驻防爆巡检守护核心...${plain}"
cat << 'EOF' > /usr/local/bin/mega_log_sentinel.sh
#!/bin/sh
LOCK_DIR="/var/run/mega_log_sentinel.lock"
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    lock_age=$(find "$LOCK_DIR" -prune -mmin +5 2>/dev/null)
    if [ -n "$lock_age" ]; then
        rm -rf "$LOCK_DIR"
        mkdir "$LOCK_DIR" 2>/dev/null || exit 0
    else
        exit 0
    fi
fi
trap 'rm -rf "$LOCK_DIR"' EXIT INT TERM

# 1. 穿透释放被锁死的已删除幽灵句柄
for fd in /proc/[0-9]*/fd/*; do
    [ -e "$fd" ] || continue
    t=$(readlink "$fd" 2>/dev/null)
    case "$t" in
        *"(deleted)"*)
            case "$t" in
                /var/log/*|/etc/V2bX/*|/tmp/*|/var/tmp/*)
                    : > "$fd" 2>/dev/null
                    ;;
            esac
            ;;
    esac
done

# 2. 执行专属 Logrotate 轮转与 Journald 空间回收
[ -x /usr/sbin/logrotate ] && /usr/sbin/logrotate -f /etc/logrotate.d/v2bx_sentinel_limit >/dev/null 2>&1
command -v journalctl >/dev/null 2>&1 && journalctl --vacuum-size=10M >/dev/null 2>&1

# 3. 磁盘水位与无差别限额截断 (跳过稀疏文件与二进制 journal)
disk_used=$(df -P / 2>/dev/null | awk 'NR==2 {gsub("%","",$5); print $5}')
[ -z "$disk_used" ] && disk_used=0

if [ "$disk_used" -ge 85 ]; then
    find /var/log -type f ! -name "lastlog" ! -name "faillog" ! -name "*.journal" ! -name "*.journal~" \
        -exec sh -c 'for f do : > "$f"; done' _ {} + 2>/dev/null
    find /etc/V2bX -maxdepth 2 -type f -name "*.log" \
        -exec sh -c 'for f do : > "$f"; done' _ {} + 2>/dev/null
    find /tmp /var/tmp ! -path /tmp ! -path /var/tmp -mmin +60 ! -name "systemd-private-*" ! -name "mega_log_sentinel.lock" \
        -exec rm -rf {} + 2>/dev/null
else
    find /var/log -type f -size +5M ! -name "lastlog" ! -name "faillog" ! -name "*.journal" ! -name "*.journal~" \
        -exec sh -c 'for f do : > "$f"; done' _ {} + 2>/dev/null
    find /etc/V2bX -maxdepth 2 -type f -name "*.log" -size +5M \
        -exec sh -c 'for f do : > "$f"; done' _ {} + 2>/dev/null

    if [ -d "/var/lib/docker/containers" ]; then
        find /var/lib/docker/containers/ -type f -name "*-json.log" -size +5M \
            -exec sh -c 'for f do : > "$f"; done' _ {} + 2>/dev/null
    fi
fi

# 4. 清理归档旧压缩日志垃圾
find /var/log /etc/V2bX -maxdepth 3 -type f \( -name "*.gz" -o -name "*.xz" -o -name "*.[0-9]" -o -name "*.old" \) -delete 2>/dev/null
EOF
chmod +x /usr/local/bin/mega_log_sentinel.sh
echo -e "${green}✔ 守护核心就绪${plain}"

# =========================================================================
# 阶段 5：跨系统双保险调度挂载 (同时兼容 cron.d 与 Alpine crontabs)
# =========================================================================
echo -e "\n${yellow}[5/6] 正在向系统挂载每 15 分钟高频调度...${plain}"
mkdir -p /etc/cron.d 2>/dev/null
cat << 'EOF' > /etc/cron.d/mega_log_sentinel
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
*/15 * * * * root /usr/local/bin/mega_log_sentinel.sh >/dev/null 2>&1
EOF
chmod 644 /etc/cron.d/mega_log_sentinel

if [ -f /etc/alpine-release ] || command -v apk &>/dev/null; then
    mkdir -p /etc/crontabs
    touch /etc/crontabs/root
    sed -i '/mega_log_sentinel/d' /etc/crontabs/root 2>/dev/null
    echo "*/15 * * * * /usr/local/bin/mega_log_sentinel.sh >/dev/null 2>&1" >> /etc/crontabs/root
    chmod 600 /etc/crontabs/root
    if command -v rc-service &>/dev/null; then
        rc-update add crond default >/dev/null 2>&1
        rc-service crond restart >/dev/null 2>&1
    fi
    echo -e "${green}✔ 已双路挂载至 Alpine (/etc/cron.d 与 /etc/crontabs/root) 并激活 crond${plain}"
else
    if command -v systemctl &>/dev/null; then
        systemctl enable --now cron >/dev/null 2>&1 || systemctl enable --now crond >/dev/null 2>&1
    fi
    echo -e "${green}✔ 已挂载至 /etc/cron.d/mega_log_sentinel 并激活定时服务${plain}"
fi

# =========================================================================
# 阶段 6：首次执行——全量秒清所有现存日志
# =========================================================================
echo -e "\n${yellow}[6/6] 正在执行全量识别与首次彻底清零...${plain}"

find /var/log -type f ! -name "lastlog" ! -name "faillog" ! -name "*.journal" ! -name "*.journal~" \
    -exec sh -c 'for f do : > "$f"; done' _ {} + 2>/dev/null
find /etc/V2bX -maxdepth 2 -type f -name "*.log" \
    -exec sh -c 'for f do : > "$f"; done' _ {} + 2>/dev/null

/usr/local/bin/mega_log_sentinel.sh

echo -e "\n${cyan}================================================================${plain}"
echo -e "${green}🎉 全系统清理与尺寸熔断机制已 100% 部署完毕！${plain}"
echo -e "🧹 ${bold}全盘清洗${plain}: 原地抽干 /var/log 与 /etc/V2bX/*.log，不破坏程序文件句柄"
echo -e "🛡️  ${bold}安全避障${plain}: 跳过稀疏文件 lastlog 与二进制 journal，零冲突轮转"
echo -e "🚨 ${bold}应急熔断${plain}: 磁盘水位达 ${red}85%${plain} 时启动全面抽干，仅清理陈旧临时文件"
echo -e "👻 ${bold}幽灵释放${plain}: 穿透监听 /proc，即时释放已删除日志文件占用的磁盘块"
echo -e "${cyan}================================================================${plain}\n"

echo -e "${cyan}当前主磁盘空间状态：${plain}"
df -h /
