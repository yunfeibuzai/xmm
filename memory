#!/bin/bash

# =========================================================================
#  麦卖云 V2bX 资源护卫与内存调度引擎 (memory - 全模式自适应防爆版)
# =========================================================================
sh_ver="3.0.0-Pro"

RED='\033[31m'
GREEN='\033[32m'
YELLOW='\033[0;33m'
BLUE='\033[0;36m'
MAGENTA='\033[0;35m'
PLAIN='\033[0m'

if [ "$EUID" -ne 0 ]; then
    echo -e "${RED}错误：请以 root 用户运行此脚本！${PLAIN}"
    exit 1
fi

# 1. 自动检测系统守护程序与单/多进程运行模式
INIT_TYPE=""
IS_MULTI=false
TARGET_FILES=()
SINGLE_SERVICE_NAME="V2bX"

if [[ -f /etc/V2bX/nodes/.multi_enabled ]] || \
   [[ -f /etc/systemd/system/v2bx@.service ]] || \
   compgen -G "/etc/init.d/v2bx.node_*" >/dev/null 2>&1; then
    IS_MULTI=true
fi

if command -v systemctl &>/dev/null && { [ -f "/etc/systemd/system/V2bX.service" ] || [ -f "/etc/systemd/system/v2bx@.service" ] || [ -f "/etc/systemd/system/v2bx.service" ]; }; then
    INIT_TYPE="systemd"
    [ -f "/etc/systemd/system/V2bX.service" ] && TARGET_FILES+=("/etc/systemd/system/V2bX.service")
    if [ -f "/etc/systemd/system/v2bx.service" ] && [ ! -f "/etc/systemd/system/V2bX.service" ]; then
        TARGET_FILES+=("/etc/systemd/system/v2bx.service")
        SINGLE_SERVICE_NAME="v2bx"
    fi
    [ -f "/etc/systemd/system/v2bx@.service" ] && TARGET_FILES+=("/etc/systemd/system/v2bx@.service")
elif command -v rc-service &>/dev/null && { [ -f "/etc/init.d/V2bX" ] || compgen -G "/etc/init.d/v2bx.node_*" >/dev/null 2>&1; }; then
    INIT_TYPE="openrc"
    [ -f "/etc/init.d/V2bX" ] && TARGET_FILES+=("/etc/init.d/V2bX")
    for rc_f in /etc/init.d/v2bx.node_*; do
        [ -f "$rc_f" ] && TARGET_FILES+=("$rc_f")
    done
else
    echo -e "${RED}错误：未找到 V2bX 服务文件，请确认该节点已正确安装。${PLAIN}"
    exit 1
fi

MODE_DESC="${BLUE}单进程模式${PLAIN}"
[ "$IS_MULTI" = true ] && MODE_DESC="${MAGENTA}多进程隔离模式${PLAIN}"

clear
echo -e "${GREEN}=========================================================${PLAIN}"
echo -e "${GREEN}       麦卖云 V2bX 资源护卫与内存调度引擎 v${sh_ver}       ${PLAIN}"
echo -e "${GREEN}=========================================================${PLAIN}"
echo -e " 系统环境: ${BLUE}${INIT_TYPE^^}${PLAIN} | 当前架构: ${MODE_DESC}"
echo -e "${GREEN}---------------------------------------------------------${PLAIN}"
echo -e " 1. 🟢 软性优化内存 (设定 Go 回收水位线，防高并发 CPU 颠簸)"
echo -e " 2. 🟡 硬性限制内存 (防 OOM 拖垮整机，设定物理 cgroup 上限)"
echo -e " 3. 🟠 限制 CPU 占用 (防大流量跑满 CPU 导致主机商停机)"
echo -e " 4. ⚪ 还原默认配置 (清除进程级限制，交由 Shannon-x 内置管理)"
echo -e " 0. 退出脚本"
echo -e "${GREEN}=========================================================${PLAIN}"
read -rp "请选择操作 [0-4]: " Choice < /dev/tty

# 安全插入到 systemd [Service] 段首行
inject_systemd_line() {
    local file="$1"
    local line="$2"
    awk -v ins="$line" '
        /^\[Service\]/ { print; print ins; next }
        { print }
    ' "$file" > "${file}.tmp" && mv -f "${file}.tmp" "$file"
}

# 精细化清理内存限制 (兼容单/多进程及 OpenRC command_env)
clean_mem_limits() {
    for f in "${TARGET_FILES[@]}"; do
        [ ! -f "$f" ] && continue
        if [ "$INIT_TYPE" = "systemd" ]; then
            sed -i '/^Environment="*GOGC=/d; /^Environment="*GOMEMLIMIT=/d' "$f"
            sed -i '/^MemoryMax=/d; /^MemoryHigh=/d; /^MemorySwapMax=/d; /^OOMScoreAdjust=/d' "$f"
        else
            sed -i '/^export GOGC=/d; /^export GOMEMLIMIT=/d' "$f"
            sed -i -E 's/[[:space:]]*GOMEMLIMIT=[^" ]+//g; s/[[:space:]]*GOGC=[^" ]+//g' "$f"
            chmod +x "$f"
        fi
    done
}

# 精细化清理 CPU 限制
clean_cpu_limits() {
    for f in "${TARGET_FILES[@]}"; do
        [ ! -f "$f" ] && continue
        if [ "$INIT_TYPE" = "systemd" ]; then
            sed -i '/^CPUQuota=/d; /^Nice=/d' "$f"
        else
            sed -i '/^start_stop_daemon_args=/d' "$f"
            chmod +x "$f"
        fi
    done
}

# 自适应单/多进程重启与状态验证
restart_service() {
    echo -e "${YELLOW}\n正在重载配置并重启 V2bX 服务...${PLAIN}"
    if [ "$INIT_TYPE" = "systemd" ]; then
        systemctl daemon-reload
        if [ "$IS_MULTI" = true ]; then
            local all_ok=true
            for nf in /etc/V2bX/nodes/node_*.json; do
                [ ! -f "$nf" ] && continue
                local inst; inst=$(basename "$nf" .json)
                systemctl restart "v2bx@${inst}.service" 2>/dev/null
                sleep 0.8
                if systemctl is-active --quiet "v2bx@${inst}.service"; then
                    echo -e "${GREEN} ✔ 实例 v2bx@${inst} 重启成功！${PLAIN}"
                else
                    echo -e "${RED} ✖ 实例 v2bx@${inst} 启动失败，请执行 journalctl -u v2bx@${inst} -n 20 排查。${PLAIN}"
                    all_ok=false
                fi
            done
            [ "$all_ok" = true ] && echo -e "${GREEN}所有隔离节点实例均已应用新策略！${PLAIN}"
        else
            systemctl restart "$SINGLE_SERVICE_NAME"
            sleep 1.5
            if systemctl is-active --quiet "$SINGLE_SERVICE_NAME"; then
                echo -e "${GREEN}✔ 配置已成功生效！${PLAIN}"
            else
                echo -e "${RED}警告：服务重启失败，请运行 journalctl -u ${SINGLE_SERVICE_NAME} -n 20 查看原因。${PLAIN}"
            fi
        fi
    else
        if [ "$IS_MULTI" = true ]; then
            for rc_f in /etc/init.d/v2bx.node_*; do
                [ ! -f "$rc_f" ] && continue
                local svc; svc=$(basename "$rc_f")
                rc-service "$svc" restart
            done
            echo -e "${GREEN}✔ OpenRC 所有隔离节点实例均已应用新策略！${PLAIN}"
        else
            rc-service "$SINGLE_SERVICE_NAME" restart
            echo -e "${GREEN}✔ 配置已成功生效！${PLAIN}"
        fi
    fi
}

case "$Choice" in
    1)
        TOTAL_MEM=$(free -m 2>/dev/null | awk '/^Mem:/{print $2}')
        if [ -z "$TOTAL_MEM" ] || [ "$TOTAL_MEM" -eq 0 ]; then
            TOTAL_MEM=$(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo 2>/dev/null)
        fi

        # 根据总内存分级计算安全水位线 (小内存留足内核 socket 缓冲余量)
        if [ "$TOTAL_MEM" -le 600 ]; then
            REC_PCT=65
        elif [ "$TOTAL_MEM" -le 2200 ]; then
            REC_PCT=70
        else
            REC_PCT=80
        fi
        LIMIT_MEM=$((TOTAL_MEM * REC_PCT / 100))
        [ "$LIMIT_MEM" -lt 80 ] && LIMIT_MEM=80

        echo -e "\n当前服务器物理内存: ${BLUE}${TOTAL_MEM} MiB${PLAIN} (推荐水位线: ${REC_PCT}%)"
        echo -e "${YELLOW}提示：此设置将覆盖 config.json 中的 Runtime 软上限；多进程模式下为单个节点实例的上限。${PLAIN}"
        read -rp "请输入软性回收触发线 (单位 MiB, 最低 80, 回车默认 ${LIMIT_MEM}): " USER_LIMIT < /dev/tty
        [ -z "$USER_LIMIT" ] && USER_LIMIT=$LIMIT_MEM
        if ! [[ "$USER_LIMIT" =~ ^[0-9]+$ ]] || [ "$USER_LIMIT" -lt 80 ]; then
            echo -e "${RED}输入错误：数值必须是大于等于 80 的整数！${PLAIN}"
            exit 1
        fi

        clean_mem_limits
        for f in "${TARGET_FILES[@]}"; do
            [ ! -f "$f" ] && continue
            if [ "$INIT_TYPE" = "systemd" ]; then
                inject_systemd_line "$f" "Environment=\"GOMEMLIMIT=${USER_LIMIT}MiB\""
            else
                if grep -q '^command_env=' "$f"; then
                    sed -i -E "s|^command_env=\"([^\"]*)\"|command_env=\"\1 GOMEMLIMIT=${USER_LIMIT}MiB\"|" "$f"
                else
                    sed -i "/command=/a command_env=\"GOMEMLIMIT=${USER_LIMIT}MiB\"" "$f"
                fi
                chmod +x "$f"
            fi
        done
        echo -e "${GREEN}✔ 软性内存回收水位线 (${USER_LIMIT} MiB) 已注入！${PLAIN}"
        restart_service
        ;;

    2)
        if [ "$INIT_TYPE" = "openrc" ]; then
            echo -e "${YELLOW}提示：OpenRC (Alpine) 不支持 systemd 级 MemoryMax 硬隔离，已自动为您转为选项 1 软上限模式。${PLAIN}"
            exit 1
        fi

        echo -e "\n${YELLOW}提示：Shannon-x 为全内核打包，硬性内存上限不得低于 96 MiB（否则启动即触发 OOM 崩溃）。${PLAIN}"
        read -rp "请输入允许单个 V2bX 进程使用的最大物理内存上限 (单位 MiB, 最低 96, 例如 160): " HARD_LIMIT < /dev/tty
        if ! [[ "$HARD_LIMIT" =~ ^[0-9]+$ ]] || [ "$HARD_LIMIT" -lt 96 ]; then
            echo -e "${RED}输入错误：硬限制上限必须为大于等于 96 的整数！${PLAIN}"
            exit 1
        fi

        # Go 堆软上限设为硬上限的 80%，留出 20% 给协程栈与运行时开销，确保先触发 GC 再触发 cgroup 限制
        GO_SOFT_LIMIT=$((HARD_LIMIT * 80 / 100))
        HIGH_LIMIT=$((HARD_LIMIT * 85 / 100))

        clean_mem_limits
        for f in "${TARGET_FILES[@]}"; do
            [ ! -f "$f" ] && continue
            inject_systemd_line "$f" "OOMScoreAdjust=-100"
            inject_systemd_line "$f" "MemoryMax=${HARD_LIMIT}M"
            inject_systemd_line "$f" "MemoryHigh=${HIGH_LIMIT}M"
            inject_systemd_line "$f" "Environment=\"GOGC=50\""
            inject_systemd_line "$f" "Environment=\"GOMEMLIMIT=${GO_SOFT_LIMIT}MiB\""
        done

        echo -e "${GREEN}✔ 硬性内存防爆锁已注入 (物理上限: ${HARD_LIMIT}M | Go GC 预警线: ${GO_SOFT_LIMIT}MiB)。${PLAIN}"
        restart_service
        ;;

    3)
        if [ "$INIT_TYPE" = "openrc" ]; then
            echo -e "\n${YELLOW}提示：Alpine (OpenRC) 无原生 cgroup CPUQuota，将通过降低进程调度优先级 (Nice=19) 防止卡死系统。${PLAIN}"
            clean_cpu_limits
            for f in "${TARGET_FILES[@]}"; do
                [ ! -f "$f" ] && continue
                sed -i '/command=/a start_stop_daemon_args="--nicelevel 19"' "$f"
                chmod +x "$f"
            done
            echo -e "${GREEN}✔ OpenRC 低优先级调度保护已注入。${PLAIN}"
            restart_service
            exit 0
        fi

        echo -e "\n${YELLOW}提示：限制 CPU 可防止大流量加解密跑满母鸡导致被主机商停机（多核机 100% 代表占满 1 个核心）。${PLAIN}"
        read -rp "请输入允许 V2bX 使用的最大 CPU 占用比 (例如填 40 代表 40%): " CPU_LIMIT < /dev/tty
        if ! [[ "$CPU_LIMIT" =~ ^[0-9]+$ ]] || [ "$CPU_LIMIT" -lt 10 ]; then
            echo -e "${RED}输入错误：请输入大于等于 10 的整数！${PLAIN}"
            exit 1
        fi

        clean_cpu_limits
        for f in "${TARGET_FILES[@]}"; do
            [ ! -f "$f" ] && continue
            inject_systemd_line "$f" "Nice=19"
            inject_systemd_line "$f" "CPUQuota=${CPU_LIMIT}%"
        done

        echo -e "${GREEN}✔ CPU 压制锁 (${CPU_LIMIT}% + Nice=19) 已注入。${PLAIN}"
        restart_service
        ;;

    4)
        clean_mem_limits
        clean_cpu_limits
        echo -e "${GREEN}✔ 已清除所有进程级内存与 CPU 限制（已交还 Shannon-x config.json Runtime 自动接管）。${PLAIN}"
        restart_service
        ;;

    0)
        exit 0
        ;;

    *)
        echo -e "${RED}未知选项！${PLAIN}"
        exit 1
        ;;
esac
