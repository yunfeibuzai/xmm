#!/bin/bash
# ====================================================
# Project: Cloudflare DDNS Subsystem
# Description: 自动更新 Cloudflare DNS 解析，支持 IPv4/IPv6，支持冗余清理
# Author: Maimai Cloud / xmm
# ====================================================

SCRIPT_DIR="/root/relay_scripts"
DDNS_LOG="/var/log/xmm_ddns.log"

GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
PLAIN='\033[0m'

# ====================================================
# 1. 核心依赖自动检测与安装
# ====================================================
install_dependencies() {
    # 检测并安装 jq
    if ! command -v jq &> /dev/null; then
        echo -e "${YELLOW}[*] 未检测到 jq，正在自动安装...${PLAIN}"
        if command -v apt-get >/dev/null 2>&1; then 
            apt-get update >/dev/null 2>&1 && apt-get install -y jq >/dev/null 2>&1
        elif command -v apk >/dev/null 2>&1; then 
            apk update >/dev/null 2>&1 && apk add --no-cache jq >/dev/null 2>&1
        elif command -v yum >/dev/null 2>&1; then 
            yum install -y epel-release >/dev/null 2>&1 && yum install -y jq >/dev/null 2>&1
        fi
    fi

    # 检测并安装 crontab (兼容多系统服务管理)
    if ! command -v crontab &> /dev/null; then
        echo -e "${YELLOW}[*] 未检测到 crontab (定时任务)，正在自动安装...${PLAIN}"
        if command -v apt-get >/dev/null 2>&1; then 
            apt-get update >/dev/null 2>&1 && apt-get install -y cron >/dev/null 2>&1
            systemctl enable --now cron >/dev/null 2>&1
        elif command -v apk >/dev/null 2>&1; then 
            apk update >/dev/null 2>&1 && apk add --no-cache cronie >/dev/null 2>&1
            rc-update add crond default >/dev/null 2>&1
            rc-service crond start >/dev/null 2>&1
        elif command -v yum >/dev/null 2>&1; then 
            yum install -y crontabs >/dev/null 2>&1
            systemctl enable --now crond >/dev/null 2>&1
        fi
    fi
}

# ====================================================
# 2. 配置并生成 DDNS 核心脚本
# ====================================================
setup_ddns() {
    echo -e "\n${CYAN}--- ☁️ 配置 Cloudflare DDNS ---${PLAIN}"
    
    install_dependencies

    read -p "[1/4] CF 解析域名 (例: relay.xmm.com): " ddns_domain
    read -p "[2/4] 解析类型 (4=IPv4, 6=IPv6): " ddns_type
    read -p "[3/4] CF API Token: " cf_token
    read -p "[4/4] CF Zone ID: " cf_zone_id

    RECORD_TYPE=$([ "$ddns_type" == "4" ] && echo "A" || echo "AAAA")
    
    mkdir -p "$SCRIPT_DIR"
    DDNS_SCRIPT="${SCRIPT_DIR}/cf_ddns.sh"
    
    # 【优化1】分段写入：首先写入带有变量值的头部 (避免使用危险的 sed 替换)
    cat > "$DDNS_SCRIPT" << EOF
#!/bin/bash
DOMAIN="${ddns_domain}"
IP_TYPE="${ddns_type}"
CF_TOKEN="${cf_token}"
ZONE_ID="${cf_zone_id}"
RECORD_TYPE="${RECORD_TYPE}"
LOG_FILE="${DDNS_LOG}"
EOF

    # 【优化1】分段写入：追加写入纯代码逻辑块 (单引号 EOF 锁定内部符号)
    cat >> "$DDNS_SCRIPT" << 'EOF'

write_log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
    # 防爆处理：文件存在时，仅保留最近40条，防止日志无限膨胀
    if [ -f "$LOG_FILE" ]; then
        tail -n 40 "$LOG_FILE" > "${LOG_FILE}.tmp" && mv "${LOG_FILE}.tmp" "$LOG_FILE"
    fi
}

# 【优化2】IP 探针增强：双节点备用，防止单节点假死或被墙 (加入超时机制 -m 8)
if [ "$IP_TYPE" == "4" ]; then
    CURRENT_IP=$(curl -s4m8 https://api.ipify.org || curl -s4m8 https://ipv4.icanhazip.com)
else
    CURRENT_IP=$(curl -s6m8 https://api64.ipify.org || curl -s6m8 https://ipv6.icanhazip.com)
fi

# 【优化3】防投毒/防HTML返回报错：严格正则校验提取结果是否为纯 IP 字符
if [[ ! "$CURRENT_IP" =~ ^[0-9a-fA-F:\.]+$ ]]; then
    write_log "❌ 致命：未能获取到有效的本地 IP (可能网络异常或被阻断)。"
    exit 1
fi

# 2. 从 Cloudflare 获取当前解析记录 (增加超时 -m 10 防拥塞死锁)
RECORD_INFO=$(curl -s -m 10 -X GET "https://api.cloudflare.com/client/v4/zones/${ZONE_ID}/dns_records?type=${RECORD_TYPE}&name=${DOMAIN}" \
    -H "Authorization: Bearer ${CF_TOKEN}" \
    -H "Content-Type: application/json")

API_SUCCESS=$(echo "$RECORD_INFO" | jq -r '.success // false')
if [ "$API_SUCCESS" != "true" ]; then
    write_log "❌ 请求 CF API 失败，请检查 Token 或 Zone ID 是否正确！"
    exit 1
fi

# 3. 统计记录数量，清理冗余同名记录
RECORD_COUNT=$(echo "$RECORD_INFO" | jq -r '.result | length')

if [ "$RECORD_COUNT" -gt 1 ]; then
    write_log "⚠️ 发现 [${RECORD_COUNT}] 条同名记录，触发自动清理冗余..."
    for id in $(echo "$RECORD_INFO" | jq -r '.result[].id'); do
        curl -s -m 10 -X DELETE "https://api.cloudflare.com/client/v4/zones/${ZONE_ID}/dns_records/${id}" \
            -H "Authorization: Bearer ${CF_TOKEN}" \
            -H "Content-Type: application/json" >/dev/null
    done
    RECORD_COUNT=0
fi

# 4. 执行更新或新建动作
if [ "$RECORD_COUNT" -eq 1 ]; then
    RECORD_ID=$(echo "$RECORD_INFO" | jq -r '.result[0].id')
    OLD_IP=$(echo "$RECORD_INFO" | jq -r '.result[0].content')

    if [ "$CURRENT_IP" != "$OLD_IP" ]; then
        RESULT=$(curl -s -m 10 -X PUT "https://api.cloudflare.com/client/v4/zones/${ZONE_ID}/dns_records/${RECORD_ID}" \
            -H "Authorization: Bearer ${CF_TOKEN}" \
            -H "Content-Type: application/json" \
            --data "{\"type\":\"${RECORD_TYPE}\",\"name\":\"${DOMAIN}\",\"content\":\"${CURRENT_IP}\",\"ttl\":60,\"proxied\":false}")
        echo "$RESULT" | jq -e '.success' >/dev/null && write_log "✅ 更新 IP ➔ $CURRENT_IP" || write_log "❌ 更新记录失败"
    else
        write_log "ℹ️ IP 未发生改变 ($CURRENT_IP)"
    fi
elif [ "$RECORD_COUNT" -eq 0 ]; then
    RESULT=$(curl -s -m 10 -X POST "https://api.cloudflare.com/client/v4/zones/${ZONE_ID}/dns_records" \
        -H "Authorization: Bearer ${CF_TOKEN}" \
        -H "Content-Type: application/json" \
        --data "{\"type\":\"${RECORD_TYPE}\",\"name\":\"${DOMAIN}\",\"content\":\"${CURRENT_IP}\",\"ttl\":60,\"proxied\":false}")
    echo "$RESULT" | jq -e '.success' >/dev/null && write_log "✅ 新建解析 ➔ $CURRENT_IP" || write_log "❌ 新建解析失败"
fi
EOF

    chmod +x "$DDNS_SCRIPT"
    mkdir -p /root/.cache 2>/dev/null

    echo -e "${YELLOW}[*] 正在执行初次握手同步，请稍候...${PLAIN}"
    bash "$DDNS_SCRIPT"
    
    if tail -n 1 "$DDNS_LOG" | grep -qE "✅|ℹ️"; then
        echo -e "${GREEN}[+] 首通测试完毕，配置成功！准备加入守护阵列...${PLAIN}"
        if command -v crontab &> /dev/null; then
            # 精确剔除旧任务，植入新任务
            (crontab -l 2>/dev/null | grep -v "$DDNS_SCRIPT"; echo "*/5 * * * * bash $DDNS_SCRIPT >/dev/null 2>&1") | crontab -
            echo -e "${GREEN}[+] 定时任务守护激活！(每5分钟巡检一次)${PLAIN}"
        else
            echo -e "${RED}[-] 添加定时任务失败：crontab 环境异常，请手动配置。${PLAIN}"
        fi
    else
        echo -e "${RED}[-] 失败：请核对 CF Token、Zone ID 等参数。相关输出请查阅日志。${PLAIN}"
    fi
    
    echo -e "\n按回车键返回..." && read -r
}

# ====================================================
# 3. 日志查看功能
# ====================================================
view_logs() {
    echo -e "\n${CYAN}=== 📜 麦卖云 DDNS 同步日志 ===${PLAIN}"
    if [ -f "$DDNS_LOG" ]; then
        cat "$DDNS_LOG"
    else
        echo -e "${RED}当前暂无同步记录。${PLAIN}"
    fi
    echo -e "${CYAN}===================================${PLAIN}"
    echo -e "\n按回车键返回..." && read -r
}

# ====================================================
# 4. 路由分发器
# ====================================================
if [ -n "$1" ]; then
    "$1"
else
    echo "Usage: $0 {setup_ddns|view_logs}"
fi
