#!/bin/bash
# ====================================================
# Project: Cloudflare DDNS Subsystem
# Description: 自动更新 Cloudflare DNS 解析，支持 IPv4/IPv6，支持冗余清理
# Author: YourName / YourProject
# ====================================================

SCRIPT_DIR="/root/relay_scripts"
DDNS_LOG="/var/log/xmm_ddns.log"

GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
PLAIN='\033[0m'

# ====================================================
# 1. 核心依赖自动检测与安装
# ====================================================
install_dependencies() {
    # 检测并安装 jq
    if ! command -v jq &> /dev/null; then
        echo -e "${YELLOW}[*] 未检测到 jq，正在自动安装...${PLAIN}"
        if command -v apt-get >/dev/null 2>&1; then 
            apt-get update >/dev/null 2>&1 && apt-get install -y jq >/dev/null 2>&1
        elif command -v apk >/dev/null 2>&1; then 
            apk update >/dev/null 2>&1 && apk add jq >/dev/null 2>&1
        elif command -v yum >/dev/null 2>&1; then 
            yum install -y epel-release >/dev/null 2>&1 && yum install -y jq >/dev/null 2>&1
        fi
    fi

    # 检测并安装 crontab
    if ! command -v crontab &> /dev/null; then
        echo -e "${YELLOW}[*] 未检测到 crontab (定时任务)，正在自动安装...${PLAIN}"
        if command -v apt-get >/dev/null 2>&1; then 
            apt-get update >/dev/null 2>&1 && apt-get install -y cron >/dev/null 2>&1
            systemctl enable --now cron >/dev/null 2>&1
        elif command -v apk >/dev/null 2>&1; then 
            apk update >/dev/null 2>&1 && apk add dcron >/dev/null 2>&1
            rc-update add dcron >/dev/null 2>&1; crond
        elif command -v yum >/dev/null 2>&1; then 
            yum install -y crontabs >/dev/null 2>&1
            systemctl enable --now crond >/dev/null 2>&1
        fi
    fi
}

# ====================================================
# 2. 配置并生成 DDNS 核心脚本
# ====================================================
setup_ddns() {
    echo -e "\n${CYAN}--- 配置 Cloudflare DDNS ---${PLAIN}"
    
    install_dependencies

    read -p "[1/4] CF 解析域名 (例: relay.xmm.com): " ddns_domain
    read -p "[2/4] 解析类型 (4=IPv4, 6=IPv6): " ddns_type
    read -p "[3/4] CF API Token: " cf_token
    read -p "[4/4] CF Zone ID: " cf_zone_id

    RECORD_TYPE=$([ "$ddns_type" == "4" ] && echo "A" || echo "AAAA")
    
    # 确保脚本存放目录存在
    mkdir -p "$SCRIPT_DIR"
    DDNS_SCRIPT="${SCRIPT_DIR}/cf_ddns.sh"
    # 写入内部执行脚本 (Heredoc)
    cat << 'EOF' > "$DDNS_SCRIPT"
#!/bin/bash
DOMAIN="MY_DOMAIN"
IP_TYPE="MY_IP_TYPE"
CF_TOKEN="MY_CF_TOKEN"
ZONE_ID="MY_ZONE_ID"
RECORD_TYPE="MY_RECORD_TYPE"
LOG_FILE="MY_LOG_FILE"

write_log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
    # 仅保留最近30条日志，防止磁盘占满
    tail -n 30 "$LOG_FILE" > "${LOG_FILE}.tmp" && mv "${LOG_FILE}.tmp" "$LOG_FILE"
}

# 1. 获取本地公网 IP
CURRENT_IP=$([ "$IP_TYPE" == "4" ] && curl -s4 https://api.ipify.org || curl -s6 https://api64.ipify.org)
[ -z "$CURRENT_IP" ] && { write_log "❌ 获取本地 IP 失败"; exit 1; }

# 2. 从 Cloudflare 获取当前解析记录
RECORD_INFO=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones/${ZONE_ID}/dns_records?type=${RECORD_TYPE}&name=${DOMAIN}" \
    -H "Authorization: Bearer ${CF_TOKEN}" \
    -H "Content-Type: application/json")

# 检查 API 是否请求成功
API_SUCCESS=$(echo "$RECORD_INFO" | jq -r '.success // false')
if [ "$API_SUCCESS" != "true" ]; then
    write_log "❌ 请求 CF API 失败，请检查 Token 或 Zone ID"
    exit 1
fi

# 3. 统计记录数量，清理冗余记录
RECORD_COUNT=$(echo "$RECORD_INFO" | jq -r '.result | length')

if [ "$RECORD_COUNT" -gt 1 ]; then
    write_log "⚠️ 发现多条同名解析记录，正在自动清理冗余..."
    for id in $(echo "$RECORD_INFO" | jq -r '.result[].id'); do
        curl -s -X DELETE "https://api.cloudflare.com/client/v4/zones/${ZONE_ID}/dns_records/${id}" \
            -H "Authorization: Bearer ${CF_TOKEN}" \
            -H "Content-Type: application/json" >/dev/null
    done
    RECORD_COUNT=0
fi

# 4. 执行更新或新建动作
if [ "$RECORD_COUNT" -eq 1 ]; then
    RECORD_ID=$(echo "$RECORD_INFO" | jq -r '.result[0].id')
    OLD_IP=$(echo "$RECORD_INFO" | jq -r '.result[0].content')

    if [ "$CURRENT_IP" != "$OLD_IP" ]; then
        RESULT=$(curl -s -X PUT "https://api.cloudflare.com/client/v4/zones/${ZONE_ID}/dns_records/${RECORD_ID}" \
            -H "Authorization: Bearer ${CF_TOKEN}" \
            -H "Content-Type: application/json" \
            --data "{\"type\":\"${RECORD_TYPE}\",\"name\":\"${DOMAIN}\",\"content\":\"${CURRENT_IP}\",\"ttl\":60,\"proxied\":false}")
        echo "$RESULT" | jq -e '.success' >/dev/null && write_log "✅ 更新 IP -> $CURRENT_IP" || write_log "❌ 更新失败"
    else
        write_log "ℹ️ IP 未改变 ($CURRENT_IP)"
    fi
elif [ "$RECORD_COUNT" -eq 0 ]; then
    RESULT=$(curl -s -X POST "https://api.cloudflare.com/client/v4/zones/${ZONE_ID}/dns_records" \
        -H "Authorization: Bearer ${CF_TOKEN}" \
        -H "Content-Type: application/json" \
        --data "{\"type\":\"${RECORD_TYPE}\",\"name\":\"${DOMAIN}\",\"content\":\"${CURRENT_IP}\",\"ttl\":60,\"proxied\":false}")
    echo "$RESULT" | jq -e '.success' >/dev/null && write_log "✅ 新建解析 -> $CURRENT_IP" || write_log "❌ 新建失败"
fi
EOF

    # 替换变量占位符
    sed -i "s|MY_DOMAIN|${ddns_domain}|g; s|MY_IP_TYPE|${ddns_type}|g; s|MY_CF_TOKEN|${cf_token}|g; s|MY_ZONE_ID|${cf_zone_id}|g; s|MY_RECORD_TYPE|${RECORD_TYPE}|g; s|MY_LOG_FILE|${DDNS_LOG}|g" "$DDNS_SCRIPT"
    chmod +x "$DDNS_SCRIPT"
    
    # 预先创建 Crontab 缓存目录（针对 Alpine 等精简系统的兼容处理）
    mkdir -p /root/.cache 2>/dev/null

    echo -e "${YELLOW}[*] 尝试首次同步...${PLAIN}"
    bash "$DDNS_SCRIPT"
    
    # 检测运行结果并写入定时任务
    if tail -n 1 "$DDNS_LOG" | grep -qE "✅|ℹ️"; then
        echo -e "${GREEN}[+] DDNS 配置成功！准备加入定时任务...${PLAIN}"
        if command -v crontab &> /dev/null; then
            # 移除旧的同名任务，添加新的任务 (每 5 分钟执行一次)
            (crontab -l 2>/dev/null | grep -v "$DDNS_SCRIPT"; echo "*/5 * * * * bash $DDNS_SCRIPT >/dev/null 2>&1") | crontab -
            echo -e "${GREEN}[+] 定时任务已成功添加！(每5分钟同步一次)${PLAIN}"
        else
            echo -e "${RED}[-] 添加定时任务失败：crontab 环境异常。${PLAIN}"
        fi
    else
        echo -e "${RED}[-] 测试失败，请检查参数配置或日志。${PLAIN}"
    fi
    
    echo -e "\n按回车键返回..." && read -r
}

# ====================================================
# 3. 日志查看功能
# ====================================================
view_logs() {
    echo -e "\n${CYAN}=== DDNS 日志 ===${PLAIN}"
    if [ -f "$DDNS_LOG" ]; then
        cat "$DDNS_LOG"
    else
        echo -e "${RED}暂无记录。${PLAIN}"
    fi
    echo -e "${CYAN}=================${PLAIN}"
    echo -e "\n按回车键返回..." && read -r
}

# ====================================================
# 4. 主程序入口
# ====================================================
if [ -n "$1" ]; then
    # 允许通过参数直接调用函数，如 ./xmmddns.sh setup_ddns
    "$1"
else
    # 如果没有传参，可以直接展示一个简易菜单或提示
    echo "Usage: $0 {setup_ddns|view_logs}"
fi
