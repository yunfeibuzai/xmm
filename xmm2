# ════════════════════ 4. 在线自更新 ════════════════════
update_self_script() {
    ui_banner
    ui_section "正在同步云端最新 xmm2 向导引擎"
    local tmp_new="/tmp/xmm2_update_${RANDOM}"
    local urls=(
        "https://ghp.ci/https://raw.githubusercontent.com/yunfeibuzai/xmm/main/xmm2"
        "https://mirror.ghproxy.net/https://raw.githubusercontent.com/yunfeibuzai/xmm/main/xmm2"
        "https://raw.githubusercontent.com/yunfeibuzai/xmm/main/xmm2"
    )

    local success=false
    for url in "${urls[@]}"; do
        if wget -q --timeout=10 -O "$tmp_new" "$url" || curl -sL --connect-timeout 8 "$url" -o "$tmp_new"; then
            if [[ -f "$tmp_new" && -s "$tmp_new" ]] && grep -q "sh_ver=" "$tmp_new"; then
                success=true; break
            fi
        fi
    done

    if [ "$success" = true ]; then
        local new_ver; new_ver=$(grep -m1 '^sh_ver=' "$tmp_new" | cut -d'"' -f2)
        [[ -f "$0" ]] && cp -f "$tmp_new" "$0"
        cp -f "$tmp_new" /usr/local/bin/xmm2 2>/dev/null
        chmod +x /usr/local/bin/xmm2 "$0" 2>/dev/null
        rm -f "$tmp_new"
        echo -e " ${green}✔ xmm2 已成功更新至 v${new_ver}！正在重新载入...${plain}"
        sleep 1
        exec bash "$0"
    else
        rm -f "$tmp_new"
        echo -e " ${red}✖ 拉取更新失败，请检查网络或 GitHub 仓库连通性！${plain}"
    fi
}

