#!/bin/bash

# 麦卖云 V2bX 节点独立配置向导引擎 (xmm2 - 健壮卡片矩阵版)
sh_ver="3.3.0-Stable"

# 终端色彩与样式
red='\033[31m'; green='\033[32m'; yellow='\033[33m'
magenta='\033[35m'; cyan='\033[36m'; bold='\033[1m'; plain='\033[0m'
dim='\033[2m'

[[ $EUID -ne 0 ]] && echo -e "${red}错误：${plain}必须使用 root 用户运行此脚本！\n" && exit 1

mkdir -p /etc/V2bX /var/log/V2bX
saved_file="/etc/V2bX/.saved_creds"

# ════════════════════ UI 组件库 ════════════════════
ui_line() {
    echo -e "${dim}────────────────────────────────────────────────────────${plain}"
}

ui_banner() {
    printf '\033[H\033[2J'
    echo -e "${cyan}${bold}╔══════════════════════════════════════════════════════╗${plain}"
    echo -e "${cyan}${bold}║         麦卖云 V2bX 节点独立配置引擎 (xmm2)          ║${plain}"
    echo -e "${cyan}${bold}║    多内核全协议矩阵 • 防爆日志隔离 • OpenRC/Systemd  ║${plain}"
    echo -e "${cyan}${bold}╚══════════════════════════════════════════════════════╝${plain}"
    echo -e " ${dim}版本: v${sh_ver}  |  状态: $([ -f /etc/V2bX/config.json ] && echo -e "${green}配置已就绪${plain}" || echo -e "${yellow}未配置${plain}")${plain}"
    ui_line
}

ui_section() {
    echo -e "\n${cyan}${bold}▌ $1${plain}"
    ui_line
}

ui_step() {
    echo -e "\n${magenta}${bold}┌── [步骤 $1] $2${plain}"
}

# ════════════════════ 服务与环境适配 ════════════════════
restart_v2bx_service() {
    echo ""
    ui_section "正在应用配置并重载服务"
    if command -v systemctl &>/dev/null; then
        if systemctl restart V2bX 2>/dev/null; then
            echo -e " ${green}✔ Systemd: V2bX 服务已成功重启生效！${plain}"
        else
            echo -e " ${yellow}⚠ Systemd: V2bX 尚未注册为系统服务，配置已落盘，待服务启动后生效。${plain}"
        fi
    elif command -v rc-service &>/dev/null; then
        if rc-service V2bX restart 2>/dev/null; then
            echo -e " ${green}✔ OpenRC: V2bX 服务已成功重启生效！${plain}"
        else
            echo -e " ${yellow}⚠ OpenRC: 服务尚未注册，配置已就绪。${plain}"
        fi
    else
        echo -e " ${yellow}ℹ 未检测到系统守护程序。若已挂载 -w 参数，核心将自动热重载。${plain}"
    fi
}

# 🌟 修复 Bug 1 & 2：注入标准的 block 黑洞出站，并用纯 CIDR 替代 geoip.dat，彻底消灭崩溃源
init_aux_files() {
    if [[ ! -f /etc/V2bX/sing_origin.json ]]; then
        cat << 'EOF' > /etc/V2bX/sing_origin.json
{
  "outbounds": [
    { "type": "direct", "tag": "direct" }
  ]
}
EOF
    fi

    if [[ ! -f /etc/V2bX/dns.json ]]; then
        cat << 'EOF' > /etc/V2bX/dns.json
{
  "servers": [ "1.1.1.1", "8.8.8.8", "localhost" ],
  "tag": "dns_inbound"
}
EOF
    fi

    # 修复：补齐 blackhole block 出站，修正 domainStrategy
    if [[ ! -f /etc/V2bX/custom_outbound.json ]]; then
        cat << 'EOF' > /etc/V2bX/custom_outbound.json
[
  { "tag": "IPv4_out", "protocol": "freedom", "settings": { "domainStrategy": "UseIP" } },
  { "tag": "block", "protocol": "blackhole" }
]
EOF
    fi

    # 修复：纯 CIDR 封禁局域网回流与 BT，无需任何外部 geoip.dat
    if [[ ! -f /etc/V2bX/route.json ]]; then
        cat << 'EOF' > /etc/V2bX/route.json
{
  "domainStrategy": "AsIs",
  "rules": [
    {
      "type": "field",
      "outboundTag": "block",
      "ip": [
        "0.0.0.0/8", "10.0.0.0/8", "100.64.0.0/10", "127.0.0.0/8",
        "169.254.0.0/16", "172.16.0.0/12", "192.0.0.0/24", "192.0.2.0/24",
        "192.168.0.0/16", "198.18.0.0/15", "198.51.100.0/24", "203.0.113.0/24",
        "::1/128", "fc00::/7", "fe80::/10"
      ]
    },
    { "type": "field", "outboundTag": "block", "protocol": [ "bittorrent" ] }
  ]
}
EOF
    fi

    [[ ! -f /etc/V2bX/hy2config.yaml ]] && generate_hy2_yaml
}

generate_hy2_yaml() {
    cat << 'EOF' > /etc/V2bX/hy2config.yaml
quic:
  initStreamReceiveWindow: 16777216
  maxStreamReceiveWindow: 16777216
  initConnReceiveWindow: 33554432
  maxConnReceiveWindow: 33554432
  maxIdleTimeout: 90s
  maxIncomingStreams: 4096
  disablePathMTUDiscovery: false
ignoreClientBandwidth: false
disableUDP: false
udpIdleTimeout: 120s
resolver:
  type: system
masquerade:
  type: 404
EOF
}

load_or_ask_creds() {
    local default_host="https://example.com"
    local default_key=""

    if [[ -f "$saved_file" ]]; then
        # shellcheck disable=SC1090
        source "$saved_file" 2>/dev/null
        default_host=${saved_host:-"https://example.com"}
        default_key=${saved_key:-""}
    fi

    echo -e "${yellow}💡 基础对接配置 (支持自动记忆，下次无需重复输入)${plain}"
    echo -e " 当前记忆面板: ${cyan}${saved_host:-未保存}${plain}"
    
    echo -ne " ${bold}▸ 请输入机场面板网址${plain} ${dim}[回车默认: ${default_host}]${plain}: "
    read -r input_host < /dev/tty
    api_host=${input_host:-"$default_host"}
    
    # 修复：自动补充 https:// 协议头与去除尾部斜杠
    if [[ ! "$api_host" =~ ^https?:// ]]; then
        api_host="https://${api_host}"
    fi
    api_host="${api_host%/}"

    if [[ -n "$default_key" ]]; then
        echo -ne " ${bold}▸ 请输入对接 API Key${plain} ${dim}[回车使用记忆 Key: ${default_key:0:4}****]${plain}: "
        read -r input_key < /dev/tty
        api_key=${input_key:-"$default_key"}
    else
        api_key=""
        while [[ -z "$api_key" ]]; do
            echo -ne " ${bold}▸ 请输入面板对接 API Key${plain}: "
            read -r api_key < /dev/tty
        done
    fi

    echo -ne " ${bold}▸ 是否固定保存此面板信息以便日后调用？${plain} [Y/n]: "
    read -r save_yn < /dev/tty
    [[ -z "$save_yn" ]] && save_yn="y"
    if [[ "$save_yn" =~ ^[Yy]$ ]]; then
        echo "saved_host=\"$api_host\"" > "$saved_file"
        echo "saved_key=\"$api_key\"" >> "$saved_file"
        chmod 600 "$saved_file"
        echo -e " ${green}✔ 凭证已安全锁定于 ${saved_file}${plain}"
    fi
}

build_xray_core_json() {
    local hs=${1:-10} idle=${2:-300} up=${3:-2} down=${4:-4} buf=${5:-256}
    cat << EOF
{
  "Type": "xray",
  "Log": {
    "Level": "error",
    "AccessPath": "",
    "ErrorPath": "/etc/V2bX/error.log",
    "MaxSize": 100,
    "MaxBackups": 0,
    "MaxDays": 90,
    "Compress": true
  },
  "AssetPath": "/etc/V2bX/",
  "DnsConfigPath": "/etc/V2bX/dns.json",
  "OutboundConfigPath": "/etc/V2bX/custom_outbound.json",
  "RouteConfigPath": "/etc/V2bX/route.json",
  "XrayConnectionConfig": {
    "handshake": ${hs},
    "connIdle": ${idle},
    "uplinkOnly": ${up},
    "downlinkOnly": ${down},
    "bufferSize": ${buf}
  }
}
EOF
}

build_sing_core_json() {
    cat << 'EOF'
{
  "Type": "sing",
  "Log": { "Level": "error", "Timestamp": true },
  "NTP": { "Enable": false, "Server": "time.apple.com", "ServerPort": 0 },
  "OriginalPath": "/etc/V2bX/sing_origin.json"
}
EOF
}

build_hy2_core_json() {
    cat << 'EOF'
{ "Type": "hysteria2", "Log": { "Level": "error" } }
EOF
}

# ════════════════════ 节点采集引擎 ════════════════════
collect_single_node() {
    local idx="$1"
    ui_section "配置第 ${idx} 个后端节点"

    # [1/4] 核心与协议 (修复：动态按核心隔离支持的协议)
    ui_step "1/4" "选择代理核心与传输协议"
    echo -e "  ${cyan}[1]${plain} Xray      ${dim}(首选: Vless / Vmess / Reality / XHTTP / CDN)${plain}"
    echo -e "  ${cyan}[2]${plain} Sing-box  ${dim}(首选: Shadowsocks / Trojan / Tuic / AnyTLS)${plain}"
    echo -e "  ${cyan}[3]${plain} Hysteria2 ${dim}(官方专属高性能内核)${plain}"
    
    local core_num=""
    while [[ ! "$core_num" =~ ^[1-3]$ ]]; do
        echo -ne " ${bold}▸ 请选择内核引擎${plain} [1-3, 默认 1]: "
        read -r core_num < /dev/tty
        [[ -z "$core_num" ]] && core_num=1
    done

    case "$core_num" in 
        1) core_type="xray"; has_xray=true ;; 
        2) core_type="sing"; has_sing=true ;; 
        3) core_type="hysteria2"; has_hysteria2=true ;; 
    esac

    local protocol_num=""
    if [[ "$core_type" == "hysteria2" ]]; then
        node_type="hysteria2"
        protocol_num="5"
        echo -e "  ${green}✔ Hysteria2 引擎自动锁定协议: hysteria2${plain}"
    elif [[ "$core_type" == "xray" ]]; then
        echo -e "\n  ${cyan}[1]${plain} Vless ${dim}(推荐 Reality / XHTTP)${plain}  ${cyan}[2]${plain} Vmess  ${cyan}[3]${plain} Trojan  ${cyan}[4]${plain} Shadowsocks"
        while [[ ! "$protocol_num" =~ ^[1-4]$ ]]; do
            echo -ne " ${bold}▸ 请选择 Xray 支持的协议${plain} [1-4, 默认 1-Vless]: "
            read -r protocol_num < /dev/tty
            [[ -z "$protocol_num" ]] && protocol_num=1
        done
        case "$protocol_num" in
            1) node_type="vless" ;; 2) node_type="vmess" ;; 3) node_type="trojan" ;; 4) node_type="shadowsocks" ;;
        esac
    elif [[ "$core_type" == "sing" ]]; then
        echo -e "\n  ${cyan}[1]${plain} Shadowsocks  ${cyan}[2]${plain} Trojan  ${cyan}[3]${plain} Tuic  ${cyan}[4]${plain} AnyTLS  ${cyan}[5]${plain} Hysteria"
        while [[ ! "$protocol_num" =~ ^[1-5]$ ]]; do
            echo -ne " ${bold}▸ 请选择 Sing-box 支持的协议${plain} [1-5, 默认 1-Shadowsocks]: "
            read -r protocol_num < /dev/tty
            [[ -z "$protocol_num" ]] && protocol_num=1
        done
        case "$protocol_num" in
            1) node_type="shadowsocks" ;; 2) node_type="trojan" ;; 3) node_type="tuic" ;; 4) node_type="anytls" ;; 5) node_type="hysteria" ;;
        esac
    fi

    # [2/4] 节点基础信息
    ui_step "2/4" "基础参数与监听网络"
    node_id=""
    while [[ ! "$node_id" =~ ^[0-9]+$ ]]; do
        echo -ne " ${bold}▸ 请输入面板中的 Node ID${plain} (纯数字): "
        read -r node_id < /dev/tty
    done

    local listen_ip="0.0.0.0"
    echo -ne " ${bold}▸ 监听 IP (ListenIP)${plain} ${dim}[回车默认 0.0.0.0，双栈填 ::]${plain}: "
    read -r input_listen < /dev/tty
    [[ -n "$input_listen" ]] && listen_ip="$input_listen"

    # [3/4] TLS 证书模式 (修复 Bug 3 & 体验优化：Trojan 强制引导 TLS，废除无效的 self 模式)
    ui_step "3/4" "TLS 安全与证书模式"
    local run_tls_flow=false
    local reality_yn="n" tls_yn="n" cert_mode_num="" cert_mode="none" cert_domain="" cf_token=""
    local cert_file="" key_file=""

    if [[ "$node_type" == "vless" ]]; then
        echo -ne " ${bold}▸ 该 Vless 节点是否为 Reality 节点？${plain} [Y/n, 默认 Y]: "
        read -r reality_yn < /dev/tty
        [[ -z "$reality_yn" ]] && reality_yn="y"
        if [[ "$reality_yn" =~ ^[Yy]$ ]]; then
            cert_mode="none"
            echo -e "  ${green}✔ Reality 节点无需申请证书 (自动设为 none)${plain}"
        else
            run_tls_flow=true
        fi
    elif [[ "$node_type" == "hysteria2" || "$node_type" == "tuic" || "$node_type" == "hysteria" || "$node_type" == "trojan" ]]; then
        # Trojan, Hysteria, Tuic 原生必须具备 TLS
        run_tls_flow=true
        echo -e "  ${yellow}ℹ 协议 [${node_type}] 必须配置 TLS 证书。${plain}"
    else
        echo -ne " ${bold}▸ 是否为此节点开启 TLS 证书保护？${plain} [y/N, 默认 N]: "
        read -r tls_yn < /dev/tty
        [[ "$tls_yn" =~ ^[Yy]$ ]] && run_tls_flow=true
    fi

    if [ "$run_tls_flow" = true ]; then
        echo -e "  ${cyan}[1]${plain} HTTP 模式  ${dim}(域名需解析到本机，自动向 Let's Encrypt 申请)${plain}"
        echo -e "  ${cyan}[2]${plain} DNS 模式   ${dim}(使用 Cloudflare API Token 验证，免 80 端口)${plain}"
        echo -e "  ${cyan}[3]${plain} File 模式  ${dim}(手动填入已有证书文件路径)${plain}"
        echo -e "  ${cyan}[4]${plain} 本地自签   ${dim}(自动用 openssl 生成自签证书并以 File 模式装载)${plain}"
        
        while [[ ! "$cert_mode_num" =~ ^[1-4]$ ]]; do
            echo -ne " ${bold}▸ 选择证书申请方式${plain} [1-4, 默认 1]: "
            read -r cert_mode_num < /dev/tty
            [[ -z "$cert_mode_num" ]] && cert_mode_num=1
        done

        case "$cert_mode_num" in
            1)
                cert_mode="http"
                while [[ -z "$cert_domain" ]]; do
                    echo -ne " ${bold}▸ 请输入绑定域名 (如 node.example.com)${plain}: "
                    read -r cert_domain < /dev/tty
                done
                cert_file="/etc/V2bX/${cert_domain}.cert.pem"; key_file="/etc/V2bX/${cert_domain}.key.pem"
                ;;
            2)
                cert_mode="dns"
                while [[ -z "$cert_domain" ]]; do
                    echo -ne " ${bold}▸ 请输入绑定域名 (如 node.example.com)${plain}: "
                    read -r cert_domain < /dev/tty
                done
                while [[ -z "$cf_token" ]]; do
                    echo -ne " ${bold}▸ 请输入 Cloudflare API Token${plain}: "
                    read -r cf_token < /dev/tty
                done
                cert_file="/etc/V2bX/${cert_domain}.cert.pem"; key_file="/etc/V2bX/${cert_domain}.key.pem"
                ;;
            3)
                cert_mode="file"
                echo -ne " ${bold}▸ 请输入节点域名${plain} ${dim}[可留空]${plain}: "
                read -r cert_domain < /dev/tty
                echo -ne " ${bold}▸ 公钥绝对路径${plain} ${dim}[默认: /etc/V2bX/server.crt.cer]${plain}: "
                read -r input_cert < /dev/tty
                cert_file=${input_cert:-"/etc/V2bX/server.crt.cer"}
                echo -ne " ${bold}▸ 私钥绝对路径${plain} ${dim}[默认: /etc/V2bX/cert.key]${plain}: "
                read -r input_key < /dev/tty
                key_file=${input_key:-"/etc/V2bX/cert.key"}
                ;;
            4)
                # 修复 Bug 3：自动生成真实的自签证书文件，走 file 模式挂载
                cert_mode="file"
                echo -ne " ${bold}▸ 请输入自签域名${plain} ${dim}[默认: cf.babymonster.cc.cd]${plain}: "
                read -r input_sni < /dev/tty
                cert_domain=${input_sni:-"cf.babymonster.cc.cd"}
                cert_file="/etc/V2bX/${cert_domain}.cert.pem"
                key_file="/etc/V2bX/${cert_domain}.key.pem"
                echo -e "  ${cyan}正在调用 openssl 生成自签证书...${plain}"
                openssl req -x509 -nodes -newkey rsa:2048 -days 3650 \
                    -keyout "$key_file" -out "$cert_file" \
                    -subj "/CN=${cert_domain}" >/dev/null 2>&1
                echo -e "  ${green}✔ 自签名证书已生成至 /etc/V2bX/，已自动适配为 File 模式。${plain}"
                ;;
        esac
    fi

    # 组装 CertConfig
    local cert_block=""
    if [[ "$cert_mode" == "dns" ]]; then
        cert_block='{ "CertMode": "dns", "RejectUnknownSni": false, "CertDomain": "'"${cert_domain}"'", "CertFile": "'"${cert_file}"'", "KeyFile": "'"${key_file}"'", "Email": "admin@v2bx.com", "Provider": "cloudflare", "DNSEnv": { "CF_DNS_API_TOKEN": "'"${cf_token}"'", "CLOUDFLARE_DNS_API_TOKEN": "'"${cf_token}"'" } }'
    elif [[ "$cert_mode" =~ ^(http|file)$ ]]; then
        cert_block='{ "CertMode": "'"${cert_mode}"'", "RejectUnknownSni": false, "CertDomain": "'"${cert_domain}"'", "CertFile": "'"${cert_file}"'", "KeyFile": "'"${key_file}"'", "Email": "admin@v2bx.com" }'
    else
        cert_block='{ "CertMode": "none" }'
    fi

    # [4/4] 限速与网络扩展
    ui_step "4/4" "流量控制与网络优化"
    local limit_block=""
    echo -ne " ${bold}▸ 是否配置本节点专属限速/设备锁 (LimitConfig)？${plain} [y/N, 默认 N]: "
    read -r limit_yn < /dev/tty
    if [[ "$limit_yn" =~ ^[Yy]$ ]]; then
        echo -ne "   └─ 单用户限速 (Mbps, 0 为不限) [0]: "; read -r speed_limit < /dev/tty; [[ -z "$speed_limit" ]] && speed_limit=0
        echo -ne "   └─ 单用户设备限制 (0 为跟随面板) [0]: "; read -r dev_limit < /dev/tty; [[ -z "$dev_limit" ]] && dev_limit=0
        echo -ne "   └─ 单用户 TCP 连接上限 (0 为不限) [0]: "; read -r conn_limit < /dev/tty; [[ -z "$conn_limit" ]] && conn_limit=0
        echo -ne "   └─ 是否启用暴流动态压制 (60秒达1GB限速10Mbps)？[y/N]: "; read -r dyn_yn < /dev/tty
        local enable_dyn="false"; [[ "$dyn_yn" =~ ^[Yy]$ ]] && enable_dyn="true"

        limit_block=', "LimitConfig": { "EnableRealtime": false, "SpeedLimit": '"${speed_limit}"', "DeviceLimit": '"${dev_limit}"', "ConnLimit": '"${conn_limit}"', "EnableDynamicSpeedLimit": '"${enable_dyn}"', "DynamicSpeedLimitConfig": { "Periodic": 60, "Traffic": 1073741824, "SpeedLimit": 10, "ExpireTime": 600 } }'
    fi

    local dns_type="UseIPv4"
    if [[ "$core_type" == "xray" ]]; then
        echo -ne " ${bold}▸ Xray 出站解析策略${plain} [1:IPv4(默认) 2:IPv6 3:双栈 4:AsIs]: "
        read -r dns_opt < /dev/tty
        case "$dns_opt" in 2) dns_type="UseIPv6" ;; 3) dns_type="UseIP" ;; 4) dns_type="AsIs" ;; esac

        current_node='{ "Core": "xray", "ApiHost": "'"${api_host}"'", "ApiKey": "'"${api_key}"'", "NodeID": '"${node_id}"', "NodeType": "'"${node_type}"'", "Timeout": 30, "ListenIP": "'"${listen_ip}"'", "SendIP": "0.0.0.0", "DeviceOnlineMinTraffic": 200, "ReportMinTraffic": 0, "EnableProxyProtocol": false, "EnableUot": true, "EnableTFO": true, "DNSType": "'"${dns_type}"'", "DisableSniffing": false, "CertConfig": '"${cert_block}""${limit_block}"' }'
    elif [[ "$core_type" == "sing" ]]; then
        current_node='{ "Core": "sing", "ApiHost": "'"${api_host}"'", "ApiKey": "'"${api_key}"'", "NodeID": '"${node_id}"', "NodeType": "'"${node_type}"'", "Timeout": 30, "ListenIP": "'"${listen_ip}"'", "SendIP": "0.0.0.0", "DeviceOnlineMinTraffic": 200, "ReportMinTraffic": 0, "EnableTFO": true, "EnableSniff": true, "SniffOverrideDestination": true, "CertConfig": '"${cert_block}""${limit_block}"' }'
    elif [[ "$core_type" == "hysteria2" ]]; then
        generate_hy2_yaml
        current_node='{ "Core": "hysteria2", "ApiHost": "'"${api_host}"'", "ApiKey": "'"${api_key}"'", "NodeID": '"${node_id}"', "NodeType": "hysteria2", "Hysteria2ConfigPath": "/etc/V2bX/hy2config.yaml", "Timeout": 30, "ListenIP": "", "SendIP": "0.0.0.0", "DeviceOnlineMinTraffic": 200, "ReportMinTraffic": 0, "CertConfig": '"${cert_block}""${limit_block}"' }'
    fi

    # 打印节点确认卡片
    echo -e "\n${green}${bold}┌── 节点 #${idx} 配置完成 ──────────────────────────────${plain}"
    echo -e "│ ${cyan}内核${plain}: ${core_type}     │ ${cyan}协议${plain}: ${node_type}     │ ${cyan}NodeID${plain}: ${node_id}"
    echo -e "│ ${cyan}监听${plain}: ${listen_ip}    │ ${cyan}证书${plain}: ${cert_mode}     │ ${cyan}域名${plain}: ${cert_domain:-无}"
    echo -e "${green}${bold}└─────────────────────────────────────────────────────${plain}"
}

# ════════════════════ 1. 全新配置创建 ════════════════════
wizard_create_all() {
    ui_banner
    init_aux_files
    load_or_ask_creds

    nodes_block=""
    has_xray=false; has_sing=false; has_hysteria2=false
    node_count=0

    while true; do
        ((node_count++))
        collect_single_node "$node_count"
        [[ -z "$nodes_block" ]] && nodes_block="$current_node" || nodes_block="${nodes_block},${current_node}"

        echo ""
        echo -ne " ${bold}▸ 是否继续配置下一个节点？${plain} [y/N, 默认 N]: "
        read -r continue_yn < /dev/tty
        [[ ! "$continue_yn" =~ ^[Yy]$ ]] && break
    done

    # Xray 性能档位
    local hs=10 idle=300 up=2 down=4 buf=256
    if [ "$has_xray" = true ]; then
        ui_section "Xray 引擎网络连接池性能档位"
        echo -e "  ${cyan}[1] 均衡通用档${plain} (10/300/2/4/256)   ${dim}• 推荐 1GB 内存 VPS${plain}"
        echo -e "  ${cyan}[2] 极速高并发${plain} (15/600/5/10/512)  ${dim}• 适合高配大带宽小鸡${plain}"
        echo -e "  ${cyan}[3] 极限低内存${plain} (4/60/1/2/32)      ${dim}• 512MB 及以下 NAT 鸡专用${plain}"
        echo -ne " ${bold}▸ 请选择连接池档位${plain} [1-3, 默认 1]: "
        read -r perf_opt < /dev/tty
        case "$perf_opt" in 2) hs=15; idle=600; up=5; down=10; buf=512 ;; 3) hs=4; idle=60; up=1; down=2; buf=32 ;; esac
    fi

    local cores_array=()
    [ "$has_xray" = true ] && cores_array+=("$(build_xray_core_json $hs $idle $up $down $buf)")
    [ "$has_sing" = true ] && cores_array+=("$(build_sing_core_json)")
    [ "$has_hysteria2" = true ] && cores_array+=("$(build_hy2_core_json)")

    local cores_block; cores_block=$(IFS=,; echo "${cores_array[*]}")
    local raw_json='{ "Log": { "Level": "error", "Output": "" }, "Cores": [ '"${cores_block}"' ], "Nodes": [ '"${nodes_block}"' ] }'

    if command -v jq &>/dev/null; then
        if echo "$raw_json" | jq . > /etc/V2bX/config.json 2>/dev/null; then
            echo -e "\n ${green}✔ 成功生成包含 ${node_count} 个节点的标准化配置 (/etc/V2bX/config.json)${plain}"
        else
            echo "$raw_json" > /etc/V2bX/config.json
            echo -e "\n ${yellow}⚠ 已写入原始配置 (jq 校验未通过)${plain}"
        fi
    else
        echo "$raw_json" > /etc/V2bX/config.json
        echo -e "\n ${green}✔ 配置已写入 /etc/V2bX/config.json${plain}"
    fi

    restart_v2bx_service
}

# ════════════════════ 2. 调优 Xray 性能 ════════════════════
switch_xray_profile() {
    ui_banner
    ui_section "动态调整 Xray 连接池与内存参数"
    if [[ ! -f /etc/V2bX/config.json ]] || ! command -v jq &>/dev/null; then
        echo -e " ${red}✖ 错误：未找到 /etc/V2bX/config.json 或系统未安装 jq！${plain}"; return
    fi

    echo -e "  ${cyan}[1] 均衡通用档${plain} (10/300/2/4/256)   ${dim}• 推荐 1GB 内存 VPS${plain}"
    echo -e "  ${cyan}[2] 极速高并发${plain} (15/600/5/10/512)  ${dim}• 适合高配大带宽小鸡${plain}"
    echo -e "  ${cyan}[3] 极限低内存${plain} (4/60/1/2/32)      ${dim}• 512MB 及以下 NAT 鸡专用${plain}"
    echo -ne " ${bold}▸ 请选择档位${plain} [1-3]: "
    read -r p_num < /dev/tty
    
    local hs=10 idle=300 up=2 down=4 buf=256
    case "$p_num" in 2) hs=15; idle=600; up=5; down=10; buf=512 ;; 3) hs=4; idle=60; up=1; down=2; buf=32 ;; *) return ;; esac

    local tmp_f="/tmp/v2bx_perf_${RANDOM}.json"
    if jq --argjson hs $hs --argjson idle $idle --argjson up $up --argjson down $down --argjson buf $buf \
       '(.Cores[] | select(.Type=="xray") | .XrayConnectionConfig) = {"handshake":$hs,"connIdle":$idle,"uplinkOnly":$up,"downlinkOnly":$down,"bufferSize":$buf}' \
       /etc/V2bX/config.json > "$tmp_f" 2>/dev/null; then
        mv -f "$tmp_f" /etc/V2bX/config.json
        echo -e " ${green}✔ Xray 参数已更新为: ${hs}/${idle}/${up}/${down}/${buf}${plain}"
        restart_v2bx_service
    else
        rm -f "$tmp_f"
        echo -e " ${red}✖ 更新未生效 (请确认当前配置是否启用了 Xray 内核)${plain}"
    fi
}

