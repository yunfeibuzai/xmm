# ════════════════════ 5. 在线自更新 ════════════════════
update_self_script() {
    ui_banner
    ui_section "正在同步云端最新 xmm2 向导引擎"
    local tmp_new="/tmp/xmm2_update_${RANDOM}.sh"
    local success=false
    for mirror in "${GH_MIRRORS[@]}"; do
        local url="${mirror}${REPO_RAW_BASE}/xmm2"
        rm -f "$tmp_new"
        if curl -fsSL --connect-timeout 5 --max-time 15 "$url" -o "$tmp_new" 2>/dev/null || \
           wget -q --timeout=8 --no-check-certificate -O "$tmp_new" "$url" 2>/dev/null; then
            if [[ -s "$tmp_new" ]] && grep -q "sh_ver=" "$tmp_new"; then
                sed -i 's/\r$//' "$tmp_new" 2>/dev/null
                if bash -n "$tmp_new" 2>/dev/null; then
                    success=true
                    break
                fi
            fi
        fi
    done

    if [ "$success" = true ]; then
        local new_ver real_self
        new_ver=$(grep -m1 '^sh_ver=' "$tmp_new" | cut -d'"' -f2)
        real_self=$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")
        mkdir -p /usr/local/bin
        cp -f "$tmp_new" /usr/local/bin/xmm2 2>/dev/null
        chmod +x /usr/local/bin/xmm2 2>/dev/null
        if [[ -f "$real_self" && "$real_self" != "/usr/local/bin/xmm2" ]]; then
            cp -f "$tmp_new" "$real_self"
            chmod +x "$real_self" 2>/dev/null
        fi
        rm -f "$tmp_new"
        echo -e " ${green}✔ xmm2 已成功更新至 v${new_ver}！正在重新载入...${plain}"
        sleep 1
        exec bash "/usr/local/bin/xmm2"
    else
        rm -f "$tmp_new"
        echo -e " ${red}✖ 拉取更新失败，请检查网络或 GitHub 仓库连通性！${plain}"
    fi
}

