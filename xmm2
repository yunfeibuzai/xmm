#!/bin/bash

# 麦卖云 V2bX 节点独立配置向导引擎 (xmm2 - 多进程隔离 + 现代卡片矩阵版)
sh_ver="3.4.1-Refactored"

# 终端色彩与样式
red='\033[31m'; green='\033[32m'; yellow='\033[33m'
magenta='\033[35m'; cyan='\033[36m'; bold='\033[1m'; plain='\033[0m'
dim='\033[2m'

[[ $EUID -ne 0 ]] && echo -e "${red}错误：${plain}必须使用 root 用户运行此脚本！\n" && exit 1

mkdir -p /etc/V2bX /etc/V2bX/nodes /var/log/V2bX
saved_file="/etc/V2bX/.saved_creds"

# ════════════════════ UI 组件库 ════════════════════
ui_line() {
    echo -e "${dim}────────────────────────────────────────────────────────${plain}"
}

detect_run_mode() {
    if compgen -G "/etc/systemd/system/multi-user.target.wants/v2bx@*.service" >/dev/null 2>&1 || \
       compgen -G "/etc/init.d/V2bX.*" >/dev/null 2>&1; then
        echo -e "${magenta}多进程隔离模式${plain}"
    elif [[ -f /etc/V2bX/config.json ]]; then
        echo -e "${green}单进程标准模式${plain}"
    else
        echo -e "${yellow}未配置${plain}"
    fi
}

ui_banner() {
    printf '\033[H\033[2J'
    echo -e "${cyan}${bold}╔══════════════════════════════════════════════════════╗${plain}"
    echo -e "${cyan}${bold}║         麦卖云 V2bX 节点独立配置引擎 (xmm2)          ║${plain}"
    echo -e "${cyan}${bold}║    多内核全协议矩阵 • 多进程隔离 • OpenRC/Systemd    ║${plain}"
    echo -e "${cyan}${bold}╚══════════════════════════════════════════════════════╝${plain}"
    echo -e " ${dim}版本: v${sh_ver}  |  当前模式: $(detect_run_mode)${plain}"
    ui_line
}

ui_section() {
    echo -e "\n${cyan}${bold}▌ $1${plain}"
    ui_line
}

# ════════════════════ 服务与环境适配 ════════════════════
restart_v2bx_service() {
    echo ""
    ui_section "正在应用配置并重载服务"
    if compgen -G "/etc/systemd/system/multi-user.target.wants/v2bx@*.service" >/dev/null 2>&1 || \
       compgen -G "/etc/init.d/V2bX.*" >/dev/null 2>&1; then
        echo -e " ${cyan}ℹ 检测到当前处于【多进程隔离模式】，正在自动重新拆分并重启所有节点实例...${plain}"
        multi_migrate_instances "quiet"
        return
    fi

    if command -v systemctl &>/dev/null; then
        if systemctl restart V2bX 2>/dev/null; then
            echo -e " ${green}✔ Systemd: V2bX 服务已成功重启生效！${plain}"
        else
            echo -e " ${yellow}⚠ Systemd: V2bX 尚未注册为系统服务，配置已落盘，待服务启动后生效。${plain}"
        fi
    elif command -v rc-service &>/dev/null; then
        if rc-service V2bX restart 2>/dev/null; then
            echo -e " ${green}✔ OpenRC: V2bX 服务已成功重启生效！${plain}"
        else
            echo -e " ${yellow}⚠ OpenRC: 服务尚未注册，配置已就绪。${plain}"
        fi
    else
        echo -e " ${yellow}ℹ 未检测到系统守护程序。若已挂载 -w 参数，核心将自动热重载。${plain}"
    fi
}

init_aux_files() {
    if [[ ! -f /etc/V2bX/sing_origin.json ]]; then echo '{ "outbounds": [ { "type": "direct", "tag": "direct" } ] }' > /etc/V2bX/sing_origin.json; fi
    if [[ ! -f /etc/V2bX/dns.json ]]; then echo '{ "servers": [ "1.1.1.1", "8.8.8.8", "localhost" ], "tag": "dns_inbound" }' > /etc/V2bX/dns.json; fi
    if [[ ! -f /etc/V2bX/custom_outbound.json ]]; then echo '[ { "tag": "IPv4_out", "protocol": "freedom", "settings": { "domainStrategy": "UseIP" } }, { "tag": "block", "protocol": "blackhole" } ]' > /etc/V2bX/custom_outbound.json; fi
    if [[ ! -f /etc/V2bX/route.json ]]; then
        cat << 'EOF' > /etc/V2bX/route.json
{ "domainStrategy": "AsIs", "rules": [ { "type": "field", "outboundTag": "block", "ip": [ "0.0.0.0/8", "10.0.0.0/8", "100.64.0.0/10", "127.0.0.0/8", "169.254.0.0/16", "172.16.0.0/12", "192.0.0.0/24", "192.0.2.0/24", "192.168.0.0/16", "198.18.0.0/15", "198.51.100.0/24", "203.0.113.0/24", "::1/128", "fc00::/7", "fe80::/10" ] }, { "type": "field", "outboundTag": "block", "protocol": [ "bittorrent" ] } ] }
EOF
    fi
    [[ ! -f /etc/V2bX/hy2config.yaml ]] && generate_hy2_yaml
}

generate_hy2_yaml() {
    cat << 'EOF' > /etc/V2bX/hy2config.yaml
quic:
  initStreamReceiveWindow: 16777216
  maxStreamReceiveWindow: 16777216
  initConnReceiveWindow: 33554432
  maxConnReceiveWindow: 33554432
  maxIdleTimeout: 90s
  maxIncomingStreams: 4096
  disablePathMTUDiscovery: false
ignoreClientBandwidth: false
disableUDP: false
udpIdleTimeout: 120s
resolver:
  type: system
masquerade:
  type: 404
EOF
}

load_or_ask_creds() {
    local default_host="https://example.com"
    local default_key=""

    if [[ -f "$saved_file" ]]; then
        source "$saved_file" 2>/dev/null
        default_host=${saved_host:-"https://example.com"}
        default_key=${saved_key:-""}
    fi

    echo -e "${yellow}💡 基础对接配置 (支持自动记忆，下次无需重复输入)${plain}"
    echo -e " 当前记忆面板: ${cyan}${saved_host:-未保存}${plain}"
    
    echo -ne " ${bold}▸ 请输入机场面板网址${plain} ${dim}[回车默认: ${default_host}]${plain}: "
    read -r input_host < /dev/tty
    api_host=${input_host:-"$default_host"}
    
    if [[ ! "$api_host" =~ ^https?:// ]]; then api_host="https://${api_host}"; fi
    api_host="${api_host%/}"

    if [[ -n "$default_key" ]]; then
        echo -ne " ${bold}▸ 请输入对接 API Key${plain} ${dim}[回车使用记忆 Key: ${default_key:0:4}****]${plain}: "
        read -r input_key < /dev/tty
        api_key=${input_key:-"$default_key"}
    else
        api_key=""
        while [[ -z "$api_key" ]]; do
            echo -ne " ${bold}▸ 请输入面板对接 API Key${plain}: "
            read -r api_key < /dev/tty
        done
    fi

    echo -ne " ${bold}▸ 是否固定保存此面板信息以便日后调用？${plain} [Y/n]: "
    read -r save_yn < /dev/tty
    [[ -z "$save_yn" ]] && save_yn="y"
    if [[ "$save_yn" =~ ^[Yy]$ ]]; then
        echo "saved_host=\"$api_host\"" > "$saved_file"
        echo "saved_key=\"$api_key\"" >> "$saved_file"
        chmod 600 "$saved_file"
        echo -e " ${green}✔ 凭证已安全锁定于 ${saved_file}${plain}"
    fi
}

# ════════════════════ 核心重构：1. 拉取分离的全新配置生成引擎 ════════════════════
fetch_and_run_xmm11_2() {
    local tmp_file="/tmp/xmm11_2_${RANDOM}.sh"
    local urls=(
        "https://ghp.ci/https://raw.githubusercontent.com/yunfeibuzai/xmm/main/all/xmm11_2"
        "https://mirror.ghproxy.net/https://raw.githubusercontent.com/yunfeibuzai/xmm/main/all/xmm11_2"
        "https://raw.githubusercontent.com/yunfeibuzai/xmm/main/all/xmm11_2"
    )
    
    echo -e "\n${cyan}正在从云端拉取 [全新配置生成引擎模块 (xmm11_2)]...${plain}"
    local success=false
    for url in "${urls[@]}"; do
        if wget -q --timeout=10 -O "$tmp_file" "$url" || curl -sL --connect-timeout 8 "$url" -o "$tmp_file"; then
            if [[ -f "$tmp_file" && -s "$tmp_file" ]]; then
                success=true; break
            fi
        fi
    done

    if [ "$success" = true ]; then
        chmod +x "$tmp_file"
        bash "$tmp_file"
        rm -f "$tmp_file"
    else
        rm -f "$tmp_file"
        echo -e "${red}错误：拉取 xmm11_2 模块失败，请检查网络或 GitHub 存储库连通性！${plain}"
    fi
}

# ════════════════════ 2. 调优 Xray 性能 ════════════════════
switch_xray_profile() {
    ui_banner
    ui_section "动态调整 Xray 连接池与内存参数"
    if [[ ! -f /etc/V2bX/config.json ]] || ! command -v jq &>/dev/null; then
        echo -e " ${red}✖ 错误：未找到 /etc/V2bX/config.json 或系统未安装 jq！${plain}"; return
    fi

    echo -e "  ${cyan}[1] 均衡通用档${plain} (10/300/2/4/256)   ${dim}• 推荐 1GB 内存 VPS${plain}"
    echo -e "  ${cyan}[2] 极速高并发${plain} (15/600/5/10/512)  ${dim}• 适合高配大带宽小鸡${plain}"
    echo -e "  ${cyan}[3] 极限低内存${plain} (4/60/1/2/32)      ${dim}• 512MB 及以下 NAT 鸡专用${plain}"
    echo -ne " ${bold}▸ 请选择档位${plain} [1-3]: "
    read -r p_num < /dev/tty
    
    local hs=10 idle=300 up=2 down=4 buf=256
    case "$p_num" in 2) hs=15; idle=600; up=5; down=10; buf=512 ;; 3) hs=4; idle=60; up=1; down=2; buf=32 ;; *) return ;; esac

    local tmp_f="/tmp/v2bx_perf_${RANDOM}.json"
    if jq --argjson hs $hs --argjson idle $idle --argjson up $up --argjson down $down --argjson buf $buf \
       '(.Cores[] | select(.Type=="xray") | .XrayConnectionConfig) = {"handshake":$hs,"connIdle":$idle,"uplinkOnly":$up,"downlinkOnly":$down,"bufferSize":$buf}' \
       /etc/V2bX/config.json > "$tmp_f" 2>/dev/null; then
        mv -f "$tmp_f" /etc/V2bX/config.json
        echo -e " ${green}✔ Xray 参数已更新为: ${hs}/${idle}/${up}/${down}/${buf}${plain}"
        restart_v2bx_service
    else
        rm -f "$tmp_f"
        echo -e " ${red}✖ 更新未生效 (请确认当前配置是否启用了 Xray 内核)${plain}"
    fi
}

# ════════════════════ 3. 凭证与附属文件 ════════════════════
manage_creds_and_aux() {
    ui_banner
    ui_section "面板凭证与内核配置文件管理"
    if [[ -f "$saved_file" ]]; then
        source "$saved_file" 2>/dev/null
        echo -e " 当前记忆面板: ${green}${saved_host:-未保存}${plain}"
        echo -e " 当前记忆密钥: ${green}${saved_key:0:4}****${plain}"
    else
        echo -e " 当前记忆凭证: ${yellow}尚未保存${plain}"
    fi
    ui_line
    echo -e "  ${cyan}[1]${plain} 重新设置并记忆机场网址与 API Key"
    echo -e "  ${cyan}[2]${plain} 清除已记忆的凭证文件"
    echo -e "  ${cyan}[3]${plain} 重新生成高性能 Hy2 配置 (/etc/V2bX/hy2config.yaml)"
    echo -e "  ${cyan}[4]${plain} 一键重置 DNS / 路由 / Sing-origin 附属规则"
    echo -e "  ${cyan}[0]${plain} 返回主菜单"
    echo -ne " ${bold}▸ 请选择操作${plain} [0-4]: "
    read -r c_opt < /dev/tty
    case "$c_opt" in
        1) rm -f "$saved_file"; load_or_ask_creds ;;
        2) rm -f "$saved_file"; echo -e " ${green}✔ 凭证已清除。${plain}" ;;
        3) generate_hy2_yaml; echo -e " ${green}✔ /etc/V2bX/hy2config.yaml 重新生成完成！${plain}" ;;
        4) 
            rm -f /etc/V2bX/sing_origin.json /etc/V2bX/dns.json /etc/V2bX/custom_outbound.json /etc/V2bX/route.json
            init_aux_files
            echo -e " ${green}✔ 所有附属规则文件已重置为标准模板！${plain}" 
            ;;
    esac
}

# ════════════════════ 4. 节点拆分与多进程隔离托管 ════════════════════
multi_split_configs() {
    if [[ ! -f /etc/V2bX/config.json ]] || ! command -v jq &>/dev/null; then
        echo -e " ${red}✖ 错误：未找到 /etc/V2bX/config.json 或未安装 jq！${plain}"
        return 1
    fi

    local total_nodes
    total_nodes=$(jq '.Nodes | length' /etc/V2bX/config.json 2>/dev/null || echo 0)
    if [[ "$total_nodes" -eq 0 ]]; then
        echo -e " ${red}✖ 错误：当前 config.json 中没有任何节点配置！${plain}"
        return 1
    fi

    mkdir -p /etc/V2bX/nodes /var/log/V2bX
    rm -f /etc/V2bX/nodes/node_*.json

    echo -e " ${cyan}正在从主配置拆分 ${total_nodes} 个独立节点实例配置...${plain}"
    for ((i=0; i<total_nodes; i++)); do
        local nid ntype ncore inst_name out_file
        nid=$(jq -r ".Nodes[$i].NodeID" /etc/V2bX/config.json)
        ntype=$(jq -r ".Nodes[$i].NodeType" /etc/V2bX/config.json)
        ncore=$(jq -r ".Nodes[$i].Core" /etc/V2bX/config.json)
        inst_name="node_${nid}_${ntype}"
        out_file="/etc/V2bX/nodes/${inst_name}.json"

        jq --argjson idx "$i" --arg core "$ncore" --arg name "$inst_name" '
        {
          "Log": {
            "Level": (.Log.Level // "error"),
            "Output": ""
          },
          "Cores": [
            (
              (.Cores[] | select(.Type == $core)) as $c |
              if $core == "xray" then
                $c | .Log.ErrorPath = ("/var/log/V2bX/error_" + $name + ".log") | .Log.AccessPath = ("/var/log/V2bX/access_" + $name + ".log")
              else
                $c
              end
            )
          ],
          "Nodes": [ .Nodes[$idx] ]
        }' /etc/V2bX/config.json > "$out_file"

        echo -e "   ├─ 已生成独立配置: ${green}${out_file}${plain} ${dim}(Core: ${ncore}, NodeID: ${nid})${plain}"
    done
    echo -e " ${green}✔ 拆分完成！主配置 /etc/V2bX/config.json 保持原样未修改。${plain}"
    return 0
}

multi_migrate_instances() {
    local mode="$1"
    multi_split_configs || return 1

    local mem_env="" cpu_quota="" nice_val="" mem_high="" mem_max=""
    if [[ -f /etc/systemd/system/V2bX.service ]]; then
        mem_env=$(grep '^Environment="GOMEMLIMIT=' /etc/systemd/system/V2bX.service | head -n1)
        cpu_quota=$(grep '^CPUQuota=' /etc/systemd/system/V2bX.service | head -n1)
        nice_val=$(grep '^Nice=' /etc/systemd/system/V2bX.service | head -n1)
        mem_high=$(grep '^MemoryHigh=' /etc/systemd/system/V2bX.service | head -n1)
        mem_max=$(grep '^MemoryMax=' /etc/systemd/system/V2bX.service | head -n1)
    elif [[ -f /etc/init.d/V2bX ]]; then
        mem_env=$(grep 'GOMEMLIMIT=' /etc/init.d/V2bX | head -n1)
    fi

    if command -v systemctl &>/dev/null; then
        systemctl stop V2bX 2>/dev/null
        systemctl disable V2bX >/dev/null 2>&1
        for old_srv in /etc/systemd/system/multi-user.target.wants/v2bx@*.service; do
            [[ -e "$old_srv" ]] || continue
            local srv_base
            srv_base=$(basename "$old_srv")
            systemctl stop "$srv_base" 2>/dev/null
            systemctl disable "$srv_base" >/dev/null 2>&1
        done

        cat << EOF > /etc/systemd/system/v2bx@.service
[Unit]
Description=V2bX Isolated Node Instance (%i)
After=network.target

[Service]
ExecStart=/usr/local/V2bX/V2bX server -c /etc/V2bX/nodes/%i.json -w
Restart=always
RestartSec=5
User=root
LimitNOFILE=1048576
LimitNPROC=51200
Environment="XRAY_DNS_PATH=/etc/V2bX/dns.json"
Environment="SING_DNS_PATH=/etc/V2bX/sing_dns.json"
EOF
        if [[ -n "$mem_env" ]]; then
            {
                echo "$mem_env"
                echo 'Environment="GOGC=80"'
                [[ -n "$cpu_quota" ]] && echo "$cpu_quota"
                [[ -n "$nice_val" ]] && echo "$nice_val"
                [[ -n "$mem_high" ]] && echo "$mem_high"
                [[ -n "$mem_max" ]] && echo "$mem_max"
                echo "MemorySwapMax=0"
                echo "OOMScoreAdjust=-100"
            } >> /etc/systemd/system/v2bx@.service
        fi
        echo -e "[Install]\nWantedBy=multi-user.target" >> /etc/systemd/system/v2bx@.service
        systemctl daemon-reload

        for nf in /etc/V2bX/nodes/node_*.json; do
            [[ -f "$nf" ]] || continue
            local inst
            inst=$(basename "$nf" .json)
            systemctl enable "v2bx@${inst}.service" >/dev/null 2>&1
            systemctl restart "v2bx@${inst}.service"
            echo -e " ${green}✔ 已启动独立守护实例: v2bx@${inst}.service${plain}"
        done

    elif command -v rc-service &>/dev/null; then
        rc-service V2bX stop 2>/dev/null
        rc-update del V2bX default >/dev/null 2>&1
        for old_rc in /etc/init.d/V2bX.node_*; do
            [[ -f "$old_rc" ]] || continue
            local rc_base
            rc_base=$(basename "$old_rc")
            rc-service "$rc_base" stop 2>/dev/null
            rc-update del "$rc_base" default >/dev/null 2>&1
            rm -f "$old_rc"
        done

        for nf in /etc/V2bX/nodes/node_*.json; do
            [[ -f "$nf" ]] || continue
            local inst rc_file
            inst=$(basename "$nf" .json)
            rc_file="/etc/init.d/V2bX.${inst}"
            cat << EOF > "$rc_file"
#!/sbin/openrc-run
description="V2bX Isolated Node (${inst})"
command="/usr/local/V2bX/V2bX"
command_args="server -c /etc/V2bX/nodes/${inst}.json -w"
command_background=true
pidfile="/run/V2bX.${inst}.pid"
output_log="/var/log/V2bX/out_${inst}.log"
error_log="/var/log/V2bX/err_${inst}.log"
command_env="XRAY_DNS_PATH=/etc/V2bX/dns.json SING_DNS_PATH=/etc/V2bX/sing_dns.json"
EOF
            [[ -n "$mem_env" ]] && echo "$mem_env" >> "$rc_file"
            cat << 'EOF' >> "$rc_file"
depend() {
    need net
}
EOF
            chmod +x "$rc_file"
            rc-update add "V2bX.${inst}" default >/dev/null 2>&1
            rc-service "V2bX.${inst}" restart
            echo -e " ${green}✔ 已启动 OpenRC 独立守护实例: V2bX.${inst}${plain}"
        done
    fi

    [[ "$mode" != "quiet" ]] && echo -e "\n ${green}🎉 已成功切换至【每节点独立进程模式】，各节点故障与重载完全隔离！${plain}"
}

multi_status_view() {
    ui_section "多进程实例运行状态看板"
    echo -e " 当前运行架构: $(detect_run_mode)\n"

    if command -v systemctl &>/dev/null; then
        local found=false
        for nf in /etc/V2bX/nodes/node_*.json; do
            [[ -f "$nf" ]] || continue
            found=true
            local inst st_color st_text pid_info
            inst=$(basename "$nf" .json)
            if systemctl is-active --quiet "v2bx@${inst}.service" 2>/dev/null; then
                st_color="${green}● 运行中${plain}"
                pid_info=$(systemctl show -p MainPID --value "v2bx@${inst}.service" 2>/dev/null)
            else
                st_color="${red}○ 已停止${plain}"
                pid_info="-"
            fi
            printf "  %-28s 状态: %-18b PID: %s\n" "v2bx@${inst}" "$st_color" "$pid_info"
        done
        [[ "$found" = false ]] && echo -e " ${yellow}暂无已拆分的节点配置文件 (/etc/V2bX/nodes/ 为空)${plain}"
    elif command -v rc-service &>/dev/null; then
        local found=false
        for rc_f in /etc/init.d/V2bX.node_*; do
            [[ -f "$rc_f" ]] || continue
            found=true
            local srv_name st_out
            srv_name=$(basename "$rc_f")
            st_out=$(rc-service "$srv_name" status 2>/dev/null)
            if echo "$st_out" | grep -q "started"; then
                echo -e "  ${srv_name} -> ${green}● 运行中${plain}"
            else
                echo -e "  ${srv_name} -> ${red}○ 已停止${plain}"
            fi
        done
        [[ "$found" = false ]] && echo -e " ${yellow}当前未激活 OpenRC 多进程实例。${plain}"
    fi
}

multi_rollback_single() {
    ui_section "正在回滚至单进程标准模式"
    
    # 完美反向合并逻辑：将子节点最新配置送回主配置
    if ls /etc/V2bX/nodes/node_*.json 1> /dev/null 2>&1; then
        echo -e " ${cyan}正在将独立节点的最新配置反向同步合并至主配置...${plain}"
        if jq --slurpfile splits /etc/V2bX/nodes/node_*.json '.Nodes = [ $splits[] | .Nodes[] ]' /etc/V2bX/config.json > /etc/V2bX/config.tmp; then
            mv -f /etc/V2bX/config.tmp /etc/V2bX/config.json
            echo -e " ${green}✔ 节点参数已完美合并归一至 /etc/V2bX/config.json！${plain}"
        else
            rm -f /etc/V2bX/config.tmp
            echo -e " ${red}✖ 反向合并失败，将使用原主配置。${plain}"
        fi
    fi

    if command -v systemctl &>/dev/null; then
        for nf in /etc/V2bX/nodes/node_*.json; do
            [[ -f "$nf" ]] || continue
            local inst
            inst=$(basename "$nf" .json)
            systemctl stop "v2bx@${inst}.service" 2>/dev/null
            systemctl disable "v2bx@${inst}.service" >/dev/null 2>&1
        done
        rm -f /etc/systemd/system/v2bx@.service
        systemctl daemon-reload
        systemctl enable V2bX >/dev/null 2>&1
        systemctl restart V2bX
        echo -e " ${green}✔ 已停用所有独立子实例，并恢复主服务 V2bX.service 单进程运行！${plain}"
    elif command -v rc-service &>/dev/null; then
        for rc_f in /etc/init.d/V2bX.node_*; do
            [[ -f "$rc_f" ]] || continue
            local srv_name
            srv_name=$(basename "$rc_f")
            rc-service "$srv_name" stop 2>/dev/null
            rc-update del "$srv_name" default >/dev/null 2>&1
            rm -f "$rc_f"
        done
        rc-update add V2bX default >/dev/null 2>&1
        rc-service V2bX restart
        echo -e " ${green}✔ 已恢复 OpenRC V2bX 单进程运行模式！${plain}"
    fi
}

