# ════════════════════ 4. 按端口隔离编译与本机证书自动复用引擎 ════════════════════
multi_split_configs() {
    if [[ ! -f /etc/V2bX/config.json ]]; then
        echo -e " ${red}✖ 错误：未找到 /etc/V2bX/config.json！${plain}"
        return 1
    fi

    mkdir -p /etc/V2bX/nodes /var/log/V2bX
    rm -f /etc/V2bX/nodes/node_*.json /etc/V2bX/nodes/port_*.json

    echo -e " ${cyan}正在扫描本机可用证书、查询面板真实监听端口并按端口合并拆分配置...${plain}"
    python3 - <<'PYEOF'
import json, os, re, subprocess, urllib.request, urllib.parse, ssl, sys

master_path = "/etc/V2bX/config.json"
nodes_dir = "/etc/V2bX/nodes"

raw = open(master_path, "r", encoding="utf-8").read()
try:
    cfg = json.loads(raw)
except Exception:
    cfg = json.loads(re.sub(r'(?<!:)//.*', '', raw))

nodes = cfg.get("Nodes", [])
if not nodes:
    print("  [错误] config.json 中没有任何节点配置！")
    sys.exit(1)

# 1. 扫描本机未过期的有效证书与私钥配对 (支持精确域名与 *.domain 泛域名)
cert_inventory = []
search_dirs = ["/etc/V2bX", "/etc/V2bX/cert", "/etc/V2bX/certs", "/root/.acme.sh"]
scanned_certs = set()

for base_dir in search_dirs:
    if not os.path.isdir(base_dir):
        continue
    for root, _, files in os.walk(base_dir):
        for fn in files:
            if not fn.lower().endswith((".crt", ".pem", ".cer")):
                continue
            if "ca.cer" in fn.lower() or ("chain" in fn.lower() and "fullchain" not in fn.lower()):
                continue
            c_path = os.path.join(root, fn)
            if c_path in scanned_certs:
                continue
            scanned_certs.add(c_path)

            chk = subprocess.run(
                ["openssl", "x509", "-in", c_path, "-noout", "-checkend", "86400", "-ext", "subjectAltName", "-subject"],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True
            )
            if chk.returncode != 0:
                continue

            stem = os.path.splitext(fn)[0].replace("_ecc", "").replace("fullchain", "")
            k_candidates = [
                os.path.splitext(c_path)[0] + ".key",
                os.path.join(root, stem + ".key") if stem else "",
                os.path.join(root, os.path.basename(root).replace("_ecc", "") + ".key"),
                os.path.join(root, "privkey.pem"),
                os.path.join(root, "private.key"),
            ]
            k_path = next((kp for kp in k_candidates if kp and os.path.isfile(kp) and os.path.getsize(kp) > 0), "")
            if not k_path:
                for f2 in files:
                    if f2.lower().endswith(".key"):
                        k_path = os.path.join(root, f2)
                        break
            if not k_path:
                continue

            domains = set(re.findall(r'DNS:([^\s,]+)', chk.stdout))
            cn_m = re.search(r'CN\s*=\s*([^\s,/]+)', chk.stdout)
            if cn_m:
                domains.add(cn_m.group(1))
            if domains:
                cert_inventory.append((domains, c_path, k_path))

def find_matching_cert(target_domain):
    if not target_domain:
        return None
    td = target_domain.strip().lower()
    for domains, cp, kp in cert_inventory:
        if td in [d.lower() for d in domains]:
            return (cp, kp)
    if "." in td:
        wildcard = "*." + td.split(".", 1)[1]
        for domains, cp, kp in cert_inventory:
            if wildcard in [d.lower() for d in domains]:
                return (cp, kp)
    return None

# 2. 请求 Xboard UniProxy 接口获取真实监听端口与下发域名
ctx = ssl.create_default_context()
ctx.check_hostname = False
ctx.verify_mode = ssl.CERT_NONE

def fetch_node_remote_meta(node):
    api_host = str(node.get("ApiHost", "")).rstrip("/")
    api_key = str(node.get("ApiKey", ""))
    nid = str(node.get("NodeID", ""))
    ntype = str(node.get("NodeType", "")).lower()
    if not (api_host and api_key and nid and ntype):
        return None, ""
    qs = urllib.parse.urlencode({"node_id": nid, "node_type": ntype, "token": api_key})
    url = f"{api_host}/api/v1/server/UniProxy/config?{qs}"
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "V2bX/1.0"})
        with urllib.request.urlopen(req, timeout=6, context=ctx) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            port = data.get("server_port")
            host = data.get("host") or data.get("server_name") or ""
            return (int(port) if port else None), str(host)
    except Exception as e:
        print(f"   ├─ [提示] 节点 {nid} 拉取面板端口失败 ({e})，回退为独立实例")
        return None, ""

port_groups = {}
fallback_groups = {}

for node in nodes:
    nid = node.get("NodeID")
    ntype = node.get("NodeType", "unknown")
    port, remote_host = fetch_node_remote_meta(node)

    cert_cfg = node.get("CertConfig") or {}
    cmode = str(cert_cfg.get("CertMode", "")).lower()
    cdomain = str(cert_cfg.get("CertDomain", "")).strip() or remote_host

    if cmode in ("dns", "http", "") and cdomain:
        matched = find_matching_cert(cdomain)
        if matched:
            cert_cfg["CertMode"] = "file"
            cert_cfg["CertFile"] = matched[0]
            cert_cfg["KeyFile"] = matched[1]
            node["CertConfig"] = cert_cfg
            print(f"   ├─ [证书复用] NodeID {nid} ({cdomain}) 命中本机有效证书，已切换 file 模式 -> {matched[0]}")

    if port:
        port_groups.setdefault(port, []).append(node)
    else:
        fallback_groups[f"node_{nid}_{ntype}"] = [node]

def write_instance_file(inst_name, group_nodes):
    needed_cores = {str(n.get("Core", "xray")).lower() for n in group_nodes}
    matched_cores = []
    for c in cfg.get("Cores", []):
        ctype = str(c.get("Type", "")).lower()
        if ctype in needed_cores:
            c_copy = json.loads(json.dumps(c))
            if ctype == "xray":
                c_copy.setdefault("Log", {})
                c_copy["Log"]["ErrorPath"] = f"/var/log/V2bX/error_{inst_name}.log"
                if c_copy["Log"].get("AccessPath", "") != "none":
                    c_copy["Log"]["AccessPath"] = f"/var/log/V2bX/access_{inst_name}.log"
            matched_cores.append(c_copy)

    sub_cfg = {
        "Log": {"Level": cfg.get("Log", {}).get("Level", "error"), "Output": ""},
        "Runtime": cfg.get("Runtime", {"GCPercent": 50, "MemoryLimitPercent": 70}),
        "Cores": matched_cores,
        "Nodes": group_nodes
    }
    out_file = os.path.join(nodes_dir, f"{inst_name}.json")
    with open(out_file, "w", encoding="utf-8") as f:
        json.dump(sub_cfg, f, indent=2, ensure_ascii=False)
    nids = [str(n.get("NodeID")) for n in group_nodes]
    print(f"   ├─ 已生成隔离配置: {out_file} (包含 NodeID: {', '.join(nids)})")

for p, g_nodes in sorted(port_groups.items()):
    write_instance_file(f"port_{p}", g_nodes)

for fb_name, g_nodes in fallback_groups.items():
    write_instance_file(fb_name, g_nodes)
PYEOF
    [[ $? -ne 0 ]] && return 1
    echo -e " ${green}✔ 按端口合并拆分完成！母版 /etc/V2bX/config.json 保持原样。${plain}"
    return 0
}

multi_migrate_instances() {
    local mode="$1"
    multi_split_configs || return 1

    local mem_env="" cpu_quota="" nice_val="" mem_high="" mem_max=""
    if [[ -f /etc/systemd/system/V2bX.service ]]; then
        mem_env=$(grep '^Environment="GOMEMLIMIT=' /etc/systemd/system/V2bX.service | head -n1)
        cpu_quota=$(grep '^CPUQuota=' /etc/systemd/system/V2bX.service | head -n1)
        nice_val=$(grep '^Nice=' /etc/systemd/system/V2bX.service | head -n1)
        mem_high=$(grep '^MemoryHigh=' /etc/systemd/system/V2bX.service | head -n1)
        mem_max=$(grep '^MemoryMax=' /etc/systemd/system/V2bX.service | head -n1)
    elif [[ -f /etc/init.d/V2bX ]]; then
        mem_env=$(grep 'GOMEMLIMIT=' /etc/init.d/V2bX | head -n1 | sed -n 's/.*\(GOMEMLIMIT=[^" ]*\).*/\1/p')
    fi

    if is_systemd; then
        # 彻底禁用并屏蔽总服务，防止任何脚本或命令误拉起导致端口抢占
        systemctl stop V2bX.service 2>/dev/null
        systemctl disable V2bX.service >/dev/null 2>&1
        systemctl mask V2bX.service >/dev/null 2>&1

        for old_srv in /etc/systemd/system/multi-user.target.wants/v2bx@*.service; do
            [[ -e "$old_srv" ]] || continue
            local srv_base
            srv_base=$(basename "$old_srv")
            systemctl stop "$srv_base" 2>/dev/null
            systemctl disable "$srv_base" >/dev/null 2>&1
        done

        cat << EOF > /etc/systemd/system/v2bx@.service
[Unit]
Description=V2bX Isolated Instance (%i)
After=network-online.target nss-lookup.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
ExecStart=/usr/local/V2bX/V2bX server -c /etc/V2bX/nodes/%i.json -w
Restart=always
RestartSec=5
User=root
LimitNOFILE=1048576
LimitNPROC=51200
Environment="XRAY_DNS_PATH=/etc/V2bX/dns.json"
Environment="SING_DNS_PATH=/etc/V2bX/sing_dns.json"
EOF
        if [[ -n "$mem_env" ]]; then
            {
                echo "$mem_env"
                echo 'Environment="GOGC=80"'
                [[ -n "$cpu_quota" ]] && echo "$cpu_quota"
                [[ -n "$nice_val" ]] && echo "$nice_val"
                [[ -n "$mem_high" ]] && echo "$mem_high"
                [[ -n "$mem_max" ]] && echo "$mem_max"
                echo "OOMScoreAdjust=-100"
            } >> /etc/systemd/system/v2bx@.service
        fi
        echo -e "[Install]\nWantedBy=multi-user.target" >> /etc/systemd/system/v2bx@.service
        systemctl daemon-reload

        shopt -s nullglob
        local split_files=(/etc/V2bX/nodes/port_*.json /etc/V2bX/nodes/node_*.json)
        shopt -u nullglob

        for nf in "${split_files[@]}"; do
            local inst
            inst=$(basename "$nf" .json)
            systemctl reset-failed "v2bx@${inst}.service" 2>/dev/null
            systemctl enable "v2bx@${inst}.service" >/dev/null 2>&1
            systemctl restart "v2bx@${inst}.service"
            if systemctl is-active --quiet "v2bx@${inst}.service"; then
                echo -e " ${green}✔ 已启动独立守护实例: v2bx@${inst}.service${plain}"
            else
                echo -e " ${red}✖ 实例 v2bx@${inst}.service 启动异常，请检查证书或面板配置！${plain}"
            fi
        done

    elif command -v rc-service &>/dev/null; then
        rc-service V2bX stop 2>/dev/null
        rc-update del V2bX default >/dev/null 2>&1
        [[ -f /etc/init.d/V2bX ]] && chmod -x /etc/init.d/V2bX 2>/dev/null

        for old_rc in /etc/init.d/V2bX.node_* /etc/init.d/v2bx.node_* /etc/init.d/v2bx.port_*; do
            [[ -f "$old_rc" ]] || continue
            local rc_base
            rc_base=$(basename "$old_rc")
            rc-service "$rc_base" stop 2>/dev/null
            rc-update del "$rc_base" default >/dev/null 2>&1
            rm -f "$old_rc"
        done

        shopt -s nullglob
        local split_files=(/etc/V2bX/nodes/port_*.json /etc/V2bX/nodes/node_*.json)
        shopt -u nullglob

        for nf in "${split_files[@]}"; do
            local inst rc_file
            inst=$(basename "$nf" .json)
            rc_file="/etc/init.d/v2bx.${inst}"
            local env_line="XRAY_DNS_PATH=/etc/V2bX/dns.json SING_DNS_PATH=/etc/V2bX/sing_dns.json"
            [[ -n "$mem_env" ]] && env_line="${env_line} ${mem_env} GOGC=80"
            cat << EOF > "$rc_file"
#!/sbin/openrc-run
description="V2bX Isolated Instance (${inst})"
command="/usr/local/V2bX/V2bX"
command_args="server -c /etc/V2bX/nodes/${inst}.json -w"
command_background=true
pidfile="/run/v2bx.${inst}.pid"
output_log="/var/log/V2bX/out_${inst}.log"
error_log="/var/log/V2bX/err_${inst}.log"
command_env="${env_line}"
respawn_delay=5
respawn_max=3

depend() {
    need net
}
EOF
            chmod +x "$rc_file"
            rc-update add "v2bx.${inst}" default >/dev/null 2>&1
            rc-service "v2bx.${inst}" restart
            echo -e " ${green}✔ 已启动 OpenRC 独立守护实例: v2bx.${inst}${plain}"
        done
    fi

    touch /etc/V2bX/nodes/.multi_enabled
    [[ "$mode" != "quiet" ]] && echo -e "\n ${green}🎉 已成功切换至【按端口隔离的多进程模式】（总服务已屏蔽，60秒3次熔断已激活）！${plain}"
}

multi_status_view() {
    ui_section "多进程实例运行状态看板"
    echo -e " 当前运行架构: $(detect_run_mode)\n"

    shopt -s nullglob
    local split_files=(/etc/V2bX/nodes/port_*.json /etc/V2bX/nodes/node_*.json)
    shopt -u nullglob

    if [[ ${#split_files[@]} -eq 0 ]]; then
        echo -e " ${yellow}暂无已拆分的实例配置文件 (/etc/V2bX/nodes/ 为空)${plain}"
        return
    fi

    if is_systemd; then
        for nf in "${split_files[@]}"; do
            local inst st_color pid_info nids
            inst=$(basename "$nf" .json)
            nids=$(jq -r '[.Nodes[].NodeID] | join(",")' "$nf" 2>/dev/null)
            if systemctl is-active --quiet "v2bx@${inst}.service" 2>/dev/null; then
                st_color="${green}● 运行中${plain}"
                pid_info=$(systemctl show -p MainPID --value "v2bx@${inst}.service" 2>/dev/null)
            else
                st_color="${red}○ 已停止${plain}"
                pid_info="-"
            fi
            printf "  %-22s 状态: %-18b PID: %-8s NodeID: [%s]\n" "v2bx@${inst}" "$st_color" "$pid_info" "${nids:-?}"
        done
    elif command -v rc-service &>/dev/null; then
        for nf in "${split_files[@]}"; do
            local inst srv_name st_out nids
            inst=$(basename "$nf" .json)
            srv_name="v2bx.${inst}"
            nids=$(jq -r '[.Nodes[].NodeID] | join(",")' "$nf" 2>/dev/null)
            st_out=$(rc-service "$srv_name" status 2>/dev/null)
            if echo "$st_out" | grep -q "started"; then
                echo -e "  ${srv_name} -> ${green}● 运行中${plain} (NodeID: [${nids:-?}])"
            else
                echo -e "  ${srv_name} -> ${red}○ 已停止${plain} (NodeID: [${nids:-?}])"
            fi
        done
    fi
}

multi_rollback_single() {
    ui_section "正在回滚至单进程标准模式"
    rm -f /etc/V2bX/nodes/.multi_enabled

    shopt -s nullglob
    local split_files=(/etc/V2bX/nodes/port_*.json /etc/V2bX/nodes/node_*.json)
    shopt -u nullglob

    if [[ ${#split_files[@]} -gt 0 ]]; then
        echo -e " ${cyan}正在将独立实例的最新配置反向同步合并至母版配置...${plain}"
        if jq --slurpfile splits "${split_files[@]}" '.Nodes = [ $splits[] | .Nodes[] ]' /etc/V2bX/config.json > /etc/V2bX/config.tmp 2>/dev/null; then
            mv -f /etc/V2bX/config.tmp /etc/V2bX/config.json
            echo -e " ${green}✔ 节点参数已完美合并归一至 /etc/V2bX/config.json！${plain}"
        else
            rm -f /etc/V2bX/config.tmp
            echo -e " ${red}✖ 反向合并失败，将使用原主配置。${plain}"
        fi
    fi

    if is_systemd; then
        for nf in "${split_files[@]}"; do
            local inst
            inst=$(basename "$nf" .json)
            systemctl stop "v2bx@${inst}.service" 2>/dev/null
            systemctl disable "v2bx@${inst}.service" >/dev/null 2>&1
        done
        rm -f /etc/systemd/system/v2bx@.service /etc/V2bX/nodes/port_*.json /etc/V2bX/nodes/node_*.json
        systemctl daemon-reload
        systemctl unmask V2bX.service >/dev/null 2>&1
        systemctl enable V2bX >/dev/null 2>&1
        systemctl restart V2bX
        echo -e " ${green}✔ 已停用所有独立子实例，解除屏蔽并恢复主服务 V2bX.service 单进程运行！${plain}"
    elif command -v rc-service &>/dev/null; then
        for rc_f in /etc/init.d/v2bx.port_* /etc/init.d/v2bx.node_* /etc/init.d/V2bX.node_*; do
            [[ -f "$rc_f" ]] || continue
            local srv_name
            srv_name=$(basename "$rc_f")
            rc-service "$srv_name" stop 2>/dev/null
            rc-update del "$srv_name" default >/dev/null 2>&1
            rm -f "$rc_f"
        done
        rm -f /etc/V2bX/nodes/port_*.json /etc/V2bX/nodes/node_*.json
        [[ -f /etc/init.d/V2bX ]] && chmod +x /etc/init.d/V2bX 2>/dev/null
        rc-update add V2bX default >/dev/null 2>&1
        rc-service V2bX restart
        echo -e " ${green}✔ 已恢复 OpenRC V2bX 单进程运行模式！${plain}"
    fi
}

