#!/bin/sh
# Title: Cloudflare Certificate Installer & Updater
# Description: Cross-OS compatible script to install CF certs for V2bX.

# 定义颜色
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

# 脚本 GitHub Raw 地址 (用于自更新)
SCRIPT_URL="https://raw.githubusercontent.com/yunfeibuzai/xmm/main/zhenshu"

# 检查 root 权限
if [ "$(id -u)" != "0" ]; then
  printf "%b\n" "${RED}错误: 请使用 root 权限运行此脚本 (Please run as root)${NC}"
  exit 1
fi

# 安装快捷命令 zs
install_shortcut() {
    if [ "$0" != "/usr/bin/zs" ]; then
        cp "$0" /usr/bin/zs
        chmod +x /usr/bin/zs
        printf "%b\n" "${GREEN}✅ 已自动安装快捷命令，以后在终端任意位置输入 ${YELLOW}zs${GREEN} 即可打开本工具！${NC}\n"
    fi
}

# 更新脚本功能
update_script() {
    printf "%b\n" "\n${YELLOW}正在从 GitHub 获取最新脚本...${NC}"
    if command -v curl >/dev/null 2>&1; then
        curl -sSL "$SCRIPT_URL" -o /usr/bin/zs
    elif command -v wget >/dev/null 2>&1; then
        wget -qO /usr/bin/zs "$SCRIPT_URL"
    else
        printf "%b\n" "${RED}错误: 系统未安装 curl 或 wget，无法自动更新。${NC}"
        return
    fi
    chmod +x /usr/bin/zs
    printf "%b\n" "${GREEN}✅ 脚本已成功更新到最新版本！请重新输入 zs 运行脚本。${NC}"
    exit 0
}

# 证书导入主逻辑
install_cert() {
    CERT_DIR="/etc/V2bX"
    CERT_FILE="$CERT_DIR/server.crt.cer"
    KEY_FILE="$CERT_DIR/cert.key"

    # 检测并询问是否清理残留
    if [ -f "$CERT_FILE" ] || [ -f "$KEY_FILE" ]; then
      printf "%b\n" "\n${YELLOW}⚠️ 检测到系统已存在旧的证书或私钥文件！${NC}"
      printf "文件路径: \n - $CERT_FILE\n - $KEY_FILE\n"
      printf "是否清理旧残留文件并重新导入？(y/n) [默认: y]: "
      read -r choice
      choice=${choice:-y}
      if [ "$choice" != "y" ] && [ "$choice" != "Y" ]; then
        printf "%b\n" "${RED}已取消操作，返回主菜单。${NC}"
        return
      fi
      printf "%b\n" "${GREEN}已清理旧文件，准备重新写入...${NC}"
    fi

    # 创建目录并初始化空文件
    mkdir -p "$CERT_DIR"
    > "$CERT_FILE"
    > "$KEY_FILE"
    printf "%b\n" "\n${YELLOW}[1/2] 准备导入 Cloudflare 源证书 (Origin Certificate)${NC}"
    printf "%b\n" "请在下方粘贴以 -----BEGIN CERTIFICATE----- 开头的完整内容："
    printf "%b\n" "（提示：右键粘贴即可，脚本检测到结束标志会自动进入下一步）"
    printf "%b\n" "${GREEN}--------------------------------------------------------${NC}"

    while IFS= read -r line; do
        printf "%s\n" "$line" >> "$CERT_FILE"
        case "$line" in
            *"-----END CERTIFICATE-----"*)
                break
                ;;
        esac
    done
    printf "%b\n" "${GREEN}✅ 源证书已成功保存至 $CERT_FILE${NC}"

    printf "%b\n" "\n${YELLOW}[2/2] 准备导入 Cloudflare 私钥 (Private Key)${NC}"
    printf "%b\n" "请在下方粘贴以 -----BEGIN PRIVATE KEY----- 开头的完整内容："
    printf "%b\n" "（提示：右键粘贴即可，脚本检测到结束标志会自动结束任务）"
    printf "%b\n" "${GREEN}--------------------------------------------------------${NC}"

    while IFS= read -r line; do
        printf "%s\n" "$line" >> "$KEY_FILE"
        case "$line" in
            *"-----END PRIVATE KEY-----"*)
                break
                ;;
        esac
    done
    printf "%b\n" "${GREEN}✅ 私钥已成功保存至 $KEY_FILE${NC}"

    # 设置安全权限
    chmod 644 "$CERT_FILE"
    chmod 600 "$KEY_FILE"

    printf "%b\n" "\n${GREEN}========================================================${NC}"
    printf "%b\n" "${GREEN}🎉 证书导入全部完成！${NC}"
    printf "%b\n" "文件位置："
    printf "%b\n" " - 证书: $CERT_FILE"
    printf "%b\n" " - 私钥: $KEY_FILE"
    printf "%b\n" "\n修改配置后，请使用命令重启生效: ${YELLOW}V2bX restart${NC}"
    printf "%b\n" "${GREEN}========================================================${NC}"
    exit 0
}

# 交互式主菜单
show_menu() {
    while true; do
        printf "%b\n" "\n${GREEN}========================================================${NC}"
        printf "%b\n" "${GREEN}       Cloudflare 证书一键导入工具 (V2bX 专用)      ${NC}"
        printf "%b\n" "${GREEN}========================================================${NC}"
        printf "%b\n" " 1. 导入 Cloudflare 源证书"
        printf "%b\n" " 2. 更新当前脚本"
        printf "%b\n" " 0. 退出脚本"
        printf "%b\n" "${GREEN}========================================================${NC}"
        printf "请输入选项 [0-2]: "
        read -r menu_opt
        
        case "$menu_opt" in
            1)
                install_cert
                ;;
            2)
                update_script
                ;;
            0)
                printf "%b\n" "${GREEN}已退出脚本。${NC}"
                exit 0
                ;;
            *)
                printf "%b\n" "${RED}无效选项，请重新输入。${NC}"
                sleep 1
                ;;
        esac
    done
}

# 1. 检查并安装快捷方式
install_shortcut

# 2. 启动菜单
show_menu
