#!/usr/bin/env bash
# =================================================================
# 麦卖云 (Maimai Cloud) - V2bX 多节点独立 S5 落地调度器 (v3.1.0-Pro)
# 路径：all/xmm24_1
# 特性: 完美兼容 port_*.json 隔离、自动复用本机证书、精准匹配入站端口标签
# =================================================================
sh_ver="3.1.0-Pro"

# 0. POSIX /bin/sh 自愈引导
if [ -z "$BASH_VERSION" ]; then
    if ! command -v bash >/dev/null 2>&1; then
        if command -v apk >/dev/null 2>&1; then
            apk update >/dev/null 2>&1 && apk add --no-cache bash >/dev/null 2>&1
        else
            echo "错误：请先安装 bash 后运行此脚本！"
            exit 1
        fi
    fi
    [ -f "$0" ] && exec bash "$0" "$@" || exec bash -s -- "$@"
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m'

if [ "$(id -u)" != "0" ]; then
    echo -e "${RED}错误: 必须使用 root 权限运行！${NC}"
    exit 1
fi

CONFIG_FILE="/etc/V2bX/config.json"
OUTBOUND_FILE="/etc/V2bX/custom_outbound.json"
ROUTE_FILE="/etc/V2bX/route.json"
DNS_FILE="/etc/V2bX/dns.json"

is_systemd() {
    command -v systemctl >/dev/null 2>&1 && [[ -d /run/systemd/system ]]
}

ensure_deps() {
    local need_install=0
    for c in curl python3 openssl pgrep; do
        command -v "$c" >/dev/null 2>&1 || need_install=1
    done

    if [ "$need_install" -eq 1 ]; then
        echo -e "${YELLOW}正在自动补齐必要运行组件 (python3 / curl / openssl)...${NC}"
        if command -v apk >/dev/null 2>&1; then
            apk update >/dev/null 2>&1
            apk add --no-cache python3 curl openssl procps >/dev/null 2>&1
        elif command -v apt-get >/dev/null 2>&1; then
            DEBIAN_FRONTEND=noninteractive apt-get update -y -q >/dev/null 2>&1
            DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends python3 curl openssl procps >/dev/null 2>&1
        elif command -v yum >/dev/null 2>&1; then
            yum install -y python3 curl openssl procps-ng >/dev/null 2>&1
        fi
    fi
}
ensure_deps

is_multi_mode() {
    if [[ -f /etc/V2bX/nodes/.multi_enabled ]] || \
       compgen -G "/etc/V2bX/nodes/port_*.json" >/dev/null 2>&1 || \
       compgen -G "/etc/V2bX/nodes/node_*.json" >/dev/null 2>&1 || \
       compgen -G "/etc/systemd/system/multi-user.target.wants/v2bx@*.service" >/dev/null 2>&1 || \
       compgen -G "/etc/init.d/v2bx_port_*" >/dev/null 2>&1 || \
       compgen -G "/etc/init.d/v2bx_node_*" >/dev/null 2>&1 || \
       compgen -G "/etc/init.d/v2bx.node_*" >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

# 按监听端口隔离同步并重启 (与 xmm2 / xmm12 完全一致，保留证书复用与熔断)
sync_and_restart_multi() {
    mkdir -p /etc/V2bX/nodes /var/log/V2bX
    rm -f /etc/V2bX/nodes/node_*.json /etc/V2bX/nodes/port_*.json

    python3 - <<'PYEOF'
import json, os, re, subprocess, urllib.request, urllib.parse, ssl, sys

master_path = "/etc/V2bX/config.json"
nodes_dir = "/etc/V2bX/nodes"

raw = open(master_path, "r", encoding="utf-8").read()
try:
    cfg = json.loads(raw)
except Exception:
    cfg = json.loads(re.sub(r'(?<!:)//.*', '', raw))

nodes = cfg.get("Nodes", [])
if not nodes:
    sys.exit(1)

cert_inventory = []
search_dirs = ["/etc/V2bX", "/etc/V2bX/cert", "/etc/V2bX/certs", "/root/.acme.sh"]
scanned_certs = set()

for base_dir in search_dirs:
    if not os.path.isdir(base_dir):
        continue
    for root, _, files in os.walk(base_dir):
        for fn in files:
            if not fn.lower().endswith((".crt", ".pem", ".cer")):
                continue
            if "ca.cer" in fn.lower() or ("chain" in fn.lower() and "fullchain" not in fn.lower()):
                continue
            c_path = os.path.join(root, fn)
            if c_path in scanned_certs:
                continue
            scanned_certs.add(c_path)

            chk = subprocess.run(
                ["openssl", "x509", "-in", c_path, "-noout", "-checkend", "86400", "-ext", "subjectAltName", "-subject"],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True
            )
            if chk.returncode != 0:
                continue

            stem = os.path.splitext(fn)[0].replace("_ecc", "").replace("fullchain", "")
            k_candidates = [
                os.path.splitext(c_path)[0] + ".key",
                os.path.join(root, stem + ".key") if stem else "",
                os.path.join(root, os.path.basename(root).replace("_ecc", "") + ".key"),
                os.path.join(root, "privkey.pem"),
                os.path.join(root, "private.key"),
            ]
            k_path = next((kp for kp in k_candidates if kp and os.path.isfile(kp) and os.path.getsize(kp) > 0), "")
            if not k_path:
                for f2 in files:
                    if f2.lower().endswith(".key"):
                        k_path = os.path.join(root, f2)
                        break
            if not k_path:
                continue

            domains = set(re.findall(r'DNS:([^\s,]+)', chk.stdout))
            cn_m = re.search(r'CN\s*=\s*([^\s,/]+)', chk.stdout)
            if cn_m:
                domains.add(cn_m.group(1))
            if domains:
                cert_inventory.append((domains, c_path, k_path))

def find_matching_cert(target_domain):
    if not target_domain:
        return None
    td = target_domain.strip().lower()
    for domains, cp, kp in cert_inventory:
        if td in [d.lower() for d in domains]:
            return (cp, kp)
    if "." in td:
        wildcard = "*." + td.split(".", 1)[1]
        for domains, cp, kp in cert_inventory:
            if wildcard in [d.lower() for d in domains]:
                return (cp, kp)
    return None

ctx = ssl.create_default_context()
ctx.check_hostname = False
ctx.verify_mode = ssl.CERT_NONE

def fetch_node_remote_meta(node):
    api_host = str(node.get("ApiHost", "")).rstrip("/")
    api_key = str(node.get("ApiKey", ""))
    nid = str(node.get("NodeID", ""))
    ntype = str(node.get("NodeType", "")).lower()
    if not (api_host and api_key and nid and ntype):
        return None, ""
    qs = urllib.parse.urlencode({"node_id": nid, "node_type": ntype, "token": api_key})
    url = f"{api_host}/api/v1/server/UniProxy/config?{qs}"
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "V2bX/1.0", "Accept": "application/json"})
        with urllib.request.urlopen(req, timeout=6, context=ctx) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            port = data.get("server_port")
            host = data.get("host") or data.get("server_name") or ""
            return (int(port) if port else None), str(host)
    except Exception:
        return None, ""

port_groups = {}
fallback_groups = {}

for node in nodes:
    nid = node.get("NodeID")
    ntype = node.get("NodeType", "unknown")
    port, remote_host = fetch_node_remote_meta(node)

    cert_cfg = node.get("CertConfig") or {}
    cmode = str(cert_cfg.get("CertMode", "")).lower()
    cdomain = str(cert_cfg.get("CertDomain", "")).strip() or remote_host

    if cmode in ("dns", "http", "") and cdomain:
        matched = find_matching_cert(cdomain)
        if matched:
            cert_cfg["CertMode"] = "file"
            cert_cfg["CertFile"] = matched[0]
            cert_cfg["KeyFile"] = matched[1]
            node["CertConfig"] = cert_cfg

    if port:
        port_groups.setdefault(port, []).append(node)
    else:
        fallback_groups[f"node_{nid}_{ntype}"] = [node]

def write_instance_file(inst_name, group_nodes):
    needed_cores = {str(n.get("Core", "xray")).lower() for n in group_nodes}
    matched_cores = []
    for c in cfg.get("Cores", []):
        ctype = str(c.get("Type", "")).lower()
        if ctype in needed_cores:
            c_copy = json.loads(json.dumps(c))
            if ctype == "xray":
                c_copy.setdefault("Log", {})
                c_copy["Log"]["ErrorPath"] = f"/var/log/V2bX/error_{inst_name}.log"
                if c_copy["Log"].get("AccessPath", "") != "none":
                    c_copy["Log"]["AccessPath"] = f"/var/log/V2bX/access_{inst_name}.log"
            matched_cores.append(c_copy)

    sub_cfg = {
        "Log": {"Level": cfg.get("Log", {}).get("Level", "error"), "Output": ""},
        "Runtime": cfg.get("Runtime", {"GCPercent": 50, "MemoryLimitPercent": 70}),
        "Cores": matched_cores,
        "Nodes": group_nodes
    }
    out_file = os.path.join(nodes_dir, f"{inst_name}.json")
    with open(out_file, "w", encoding="utf-8") as f:
        json.dump(sub_cfg, f, indent=2, ensure_ascii=False)

for p, g_nodes in sorted(port_groups.items()):
    write_instance_file(f"port_{p}", g_nodes)

for fb_name, g_nodes in fallback_groups.items():
    write_instance_file(fb_name, g_nodes)
PYEOF

    local mem_env=""
    if [[ -f /etc/systemd/system/V2bX.service ]]; then
        mem_env=$(grep '^Environment="GOMEMLIMIT=' /etc/systemd/system/V2bX.service | head -n1)
    elif [[ -f /etc/init.d/V2bX ]]; then
        mem_env=$(grep -oE 'GOMEMLIMIT=[0-9]+[A-Za-z]*' /etc/init.d/V2bX 2>/dev/null | head -n1)
    fi

    if is_systemd; then
        systemctl disable --now V2bX.service >/dev/null 2>&1
        systemctl mask V2bX.service >/dev/null 2>&1
        for old_srv in /etc/systemd/system/multi-user.target.wants/v2bx@*.service; do
            [[ -e "$old_srv" ]] || continue
            local srv_base; srv_base=$(basename "$old_srv")
            systemctl stop "$srv_base" 2>/dev/null
            systemctl disable "$srv_base" >/dev/null 2>&1
        done
        systemctl daemon-reload 2>/dev/null

        shopt -s nullglob
        local split_files=(/etc/V2bX/nodes/port_*.json /etc/V2bX/nodes/node_*.json)
        shopt -u nullglob
        for nf in "${split_files[@]}"; do
            local inst; inst=$(basename "$nf" .json)
            systemctl reset-failed "v2bx@${inst}.service" 2>/dev/null
            systemctl enable "v2bx@${inst}.service" >/dev/null 2>&1
            systemctl restart "v2bx@${inst}.service" 2>/dev/null
        done
    elif command -v rc-service >/dev/null 2>&1; then
        rc-service V2bX stop 2>/dev/null
        rc-update del V2bX default >/dev/null 2>&1
        [[ -f /etc/init.d/V2bX ]] && chmod -x /etc/init.d/V2bX 2>/dev/null
        for old_rc in /etc/init.d/V2bX.node_* /etc/init.d/v2bx.node_* /etc/init.d/v2bx.port_* /etc/init.d/v2bx_node_* /etc/init.d/v2bx_port_*; do
            [[ -f "$old_rc" ]] || continue
            local rc_base; rc_base=$(basename "$old_rc")
            rc-service "$rc_base" stop 2>/dev/null
            rc-update del "$rc_base" default >/dev/null 2>&1
            rm -f "$old_rc"
        done

        shopt -s nullglob
        local split_files=(/etc/V2bX/nodes/port_*.json /etc/V2bX/nodes/node_*.json)
        shopt -u nullglob
        for nf in "${split_files[@]}"; do
            local inst rc_name rc_file
            inst=$(basename "$nf" .json)
            rc_name="v2bx_${inst}"
            rc_file="/etc/init.d/${rc_name}"
            local env_line="XRAY_DNS_PATH=/etc/V2bX/dns.json SING_DNS_PATH=/etc/V2bX/sing_dns.json"
            [[ -n "$mem_env" ]] && env_line="${env_line} ${mem_env} GOGC=50"
            cat << EOF > "$rc_file"
#!/sbin/openrc-run
description="V2bX Isolated Instance (${inst})"
command="/usr/local/V2bX/V2bX"
command_args="server -c /etc/V2bX/nodes/${inst}.json -w"
command_background=true
pidfile="/run/${rc_name}.pid"
output_log="/var/log/V2bX/out_${inst}.log"
error_log="/var/log/V2bX/err_${inst}.log"
command_env="${env_line}"

depend() {
    need net
}
EOF
            chmod +x "$rc_file"
            rc-update add "$rc_name" default >/dev/null 2>&1
            rc-service "$rc_name" restart 2>/dev/null
        done
    fi
    touch /etc/V2bX/nodes/.multi_enabled
}

restart_v2bx() {
    if is_multi_mode; then
        sync_and_restart_multi
        return
    fi

    if is_systemd; then
        systemctl unmask V2bX.service >/dev/null 2>&1
        systemctl restart V2bX 2>/dev/null
    elif command -v rc-service >/dev/null 2>&1; then
        [[ -f /etc/init.d/V2bX ]] && chmod +x /etc/init.d/V2bX 2>/dev/null
        rc-service V2bX restart 2>/dev/null || /etc/init.d/V2bX restart 2>/dev/null
    elif [ -x /etc/init.d/V2bX ]; then
        /etc/init.d/V2bX restart 2>/dev/null
    elif [ -x /usr/local/V2bX/V2bX ]; then
        pkill -9 -f "[/]usr/local/V2bX/V2bX" 2>/dev/null
        nohup /usr/local/V2bX/V2bX server -c /etc/V2bX/config.json -w >/var/log/v2bx_out.log 2>&1 &
    fi
}

ensure_core_paths() {
    local target_level="${1:-info}"
    export CONFIG_FILE OUTBOUND_FILE ROUTE_FILE DNS_FILE TARGET_LEVEL="$target_level"
    python3 -c "
import json, re, os, sys

cfg_path = os.environ['CONFIG_FILE']
out_path = os.environ['OUTBOUND_FILE']
route_path = os.environ['ROUTE_FILE']
dns_path = os.environ['DNS_FILE']
t_level = os.environ['TARGET_LEVEL']

try:
    raw = open(cfg_path, 'r', encoding='utf-8').read()
    try:
        cfg = json.loads(raw)
    except Exception:
        cfg = json.loads(re.sub(r'(?<!:)//.*', '', raw))
    changed = False

    for core in cfg.get('Cores', []):
        if core.get('Type', '').lower() == 'xray':
            if core.get('OutboundConfigPath') != out_path:
                core['OutboundConfigPath'] = out_path
                changed = True
            if core.get('RouteConfigPath') != route_path:
                core['RouteConfigPath'] = route_path
                changed = True
            if os.path.exists(dns_path) and not core.get('DnsConfigPath'):
                core['DnsConfigPath'] = dns_path
                changed = True
            if 'Log' not in core or not isinstance(core['Log'], dict):
                core['Log'] = {}
            if core['Log'].get('Level', '').lower() != t_level:
                core['Log']['Level'] = t_level
                changed = True

    if changed:
        tmp_file = cfg_path + '.tmp'
        with open(tmp_file, 'w', encoding='utf-8') as f:
            json.dump(cfg, f, indent=2, ensure_ascii=False)
        os.replace(tmp_file, cfg_path)
except Exception as e:
    print('Core 挂载失败:', e)
    sys.exit(1)
"
}

list_nodes() {
    export CONFIG_FILE ROUTE_FILE OUTBOUND_FILE
    python3 -c "
import json, re, os

cfg_path = os.environ['CONFIG_FILE']
route_path = os.environ['ROUTE_FILE']
out_path = os.environ['OUTBOUND_FILE']

try:
    if not os.path.exists(cfg_path):
        print('NOT_FOUND')
        exit(0)

    raw = open(cfg_path, encoding='utf-8').read()
    try:
        cfg = json.loads(raw)
    except Exception:
        cfg = json.loads(re.sub(r'(?<!:)//.*', '', raw))

    nodes = cfg.get('Nodes', [])
    if not nodes:
        print('EMPTY')
        exit(0)

    s5_routed = set()
    if os.path.exists(route_path):
        try:
            r_data = json.loads(open(route_path, encoding='utf-8').read())
            for r in r_data.get('rules', []):
                otag = r.get('outboundTag', '')
                if otag.startswith('s5-out-'):
                    s5_routed.add(otag.replace('s5-out-', ''))
        except Exception:
            pass

    s5_endpoints = {}
    if os.path.exists(out_path):
        try:
            o_data = json.loads(open(out_path, encoding='utf-8').read())
            for o in o_data:
                tag = str(o.get('tag', ''))
                if tag.startswith('s5-out-'):
                    srvs = o.get('settings', {}).get('servers', [])
                    if srvs:
                        s5_endpoints[tag.replace('s5-out-', '')] = f\"{srvs[0].get('address')}:{srvs[0].get('port')}\"
        except Exception:
            pass

    for idx, node in enumerate(nodes):
        nid = str(node.get('NodeID', '未知'))
        core = node.get('Core', 'xray')
        ntype = node.get('NodeType', '未知')
        if core.lower() != 'xray':
            status = '\033[0;33m非Xray内核(不支持S5分流)\033[0m'
        elif nid in s5_routed:
            ep = s5_endpoints.get(nid, '')
            status = f'\033[0;32mS5已落地 ({ep})\033[0m'
        else:
            status = '原生机房直连'
        print(f'{idx+1}|{nid}|{ntype}|{core}|{status}')
except Exception:
    print('ERROR')
"
}

test_s5_connection() {
    export TEST_HOST="$1" TEST_PORT="$2"
    python3 -c "
import socket, time, os

host = os.environ['TEST_HOST'].strip('[]')
port = int(os.environ['TEST_PORT'])

start = time.time()
try:
    s = socket.create_connection((host, port), timeout=4.0)
    s.settimeout(3.0)
    s.sendall(b'\x05\x02\x00\x02')
    resp = s.recv(2)
    latency = round((time.time() - start) * 1000)
    s.close()
    if len(resp) == 2 and resp[0] == 5:
        auth_txt = '无认证' if resp[1] == 0 else ('账密认证' if resp[1] == 2 else f'方法:{resp[1]}')
        print(f'OK|{latency}ms ({auth_txt})')
    else:
        print(f'WARN|端口可通但非标准SOCKS5响应')
except Exception as e:
    print(f'FAIL|{e}')
"
}

setup_node_s5() {
    echo -e "\n${CYAN}================== 当前 V2bX 节点列表 ==================${NC}"
    NODE_RAW=$(list_nodes)

    if [ "$NODE_RAW" = "EMPTY" ] || [ "$NODE_RAW" = "NOT_FOUND" ] || [ "$NODE_RAW" = "ERROR" ] || [ -z "$NODE_RAW" ]; then
        echo -e "${RED}未在 /etc/V2bX/config.json 中扫描到任何有效节点或配置有误！${NC}"
        return 1
    fi

    printf "${YELLOW}%-6s %-10s %-12s %-10s %-30s${NC}\n" "序号" "NodeID" "协议类型" "内核" "落地状态"
    echo "------------------------------------------------------------------"
    
    TOTAL_NODES=0
    while IFS='|' read -r idx nid ntype core status; do
        [ -n "$idx" ] || continue
        printf "%-6s %-10s %-12s %-10s %-30b\n" " [$idx]" "$nid" "$ntype" "$core" "$status"
        TOTAL_NODES=$((TOTAL_NODES + 1))
    done << EOF
$NODE_RAW
EOF
    echo -e "${CYAN}==================================================================${NC}"

    read -rp "请输入要配置 S5 落地的节点【序号】(1-${TOTAL_NODES}): " CHOSEN_IDX < /dev/tty
    case $CHOSEN_IDX in
        ''|*[!0-9]*) echo -e "${RED}输入序号无效！${NC}"; return 1 ;;
    esac
    if [ "$CHOSEN_IDX" -lt 1 ] || [ "$CHOSEN_IDX" -gt "$TOTAL_NODES" ]; then
        echo -e "${RED}序号超出范围！${NC}"; return 1
    fi

    TARGET_LINE=$(echo "$NODE_RAW" | sed -n "${CHOSEN_IDX}p")
    TARGET_NID=$(echo "$TARGET_LINE" | cut -d'|' -f2)
    TARGET_TYPE=$(echo "$TARGET_LINE" | cut -d'|' -f3)
    TARGET_CORE=$(echo "$TARGET_LINE" | cut -d'|' -f4)

    if [ "${TARGET_CORE,,}" != "xray" ]; then
        echo -e "\n${RED}⚠️ 拦截提示：节点 [NodeID: ${TARGET_NID}] 当前使用的内核是 [${TARGET_CORE}]！${NC}"
        echo -e "${YELLOW}Xray 路由分流仅支持 Xray 内核；若需让 Hysteria2 / Sing-box 走 S5，请使用底层透明劫持版 (all/xmm_24)。${NC}"
        return 1
    fi

    echo -e "\n已选定: ${GREEN}NodeID: ${TARGET_NID} (${TARGET_TYPE} / ${TARGET_CORE})${NC}"
    echo -e "${YELLOW}--- 请输入该节点专属的 SOCKS5 代理信息 ---${NC}"
    read -rp "S5 服务器 (域名/IPv4/IPv6, 本地填 127.0.0.1): " RAW_HOST < /dev/tty
    read -rp "S5 端口: " RAW_PORT < /dev/tty
    read -rp "S5 用户名 (无则直接回车): " S5_USER < /dev/tty
    read -rp "S5 密码 (无则直接回车): " S5_PASS < /dev/tty

    CLEAN_HOST=$(echo "$RAW_HOST" | tr -d ' ' | sed -E 's#^[a-zA-Z0-9]+://##; s#/.*$##')
    if [[ "$CLEAN_HOST" =~ ^\[([0-9a-fA-F:]+)\]:([0-9]+)$ ]]; then
        S5_HOST="${BASH_REMATCH[1]}"
        [ -z "$RAW_PORT" ] && S5_PORT="${BASH_REMATCH[2]}" || S5_PORT="$RAW_PORT"
    elif [[ "$CLEAN_HOST" =~ ^([^:]+):([0-9]+)$ ]]; then
        S5_HOST="${BASH_REMATCH[1]}"
        [ -z "$RAW_PORT" ] && S5_PORT="${BASH_REMATCH[2]}" || S5_PORT="$RAW_PORT"
    else
        S5_HOST="${CLEAN_HOST#[}"
        S5_HOST="${S5_HOST%]}"
        S5_PORT="$RAW_PORT"
    fi

    case $S5_PORT in
        ''|*[!0-9]*) echo -e "${RED}错误: 端口必须为纯数字！${NC}"; return 1 ;;
    esac
    if [ -z "$S5_HOST" ] || [ "$S5_PORT" -lt 1 ] || [ "$S5_PORT" -gt 65535 ]; then
        echo -e "${RED}错误: 主机地址为空或端口超出范围！${NC}"; return 1
    fi

    echo -e "${CYAN}正在对 S5 出口执行 TCP + SOCKS5 握手双层预检...${NC}"
    TEST_RES=$(test_s5_connection "$S5_HOST" "$S5_PORT")
    STATUS=$(echo "$TEST_RES" | cut -d'|' -f1)
    DETAIL=$(echo "$TEST_RES" | cut -d'|' -f2)

    if [ "$STATUS" = "OK" ]; then
        echo -e "${GREEN}✔ SOCKS5 握手验证正常 (延迟: ${DETAIL})${NC}"
    elif [ "$STATUS" = "WARN" ]; then
        echo -e "${YELLOW}⚠️ 警告: ${DETAIL} (可能为 HTTP 代理或端口填错)${NC}"
        read -rp "是否仍要强行写入？(y/N): " force_write < /dev/tty
        [[ ! "$force_write" =~ ^[Yy]$ ]] && { echo "已取消部署。"; return; }
    else
        echo -e "${RED}⚠️ 警告: 无法连通目标 S5 端口 (${DETAIL})${NC}"
        read -rp "目标代理当前不可达，仍要强行写入吗？(y/N): " force_write < /dev/tty
        [[ ! "$force_write" =~ ^[Yy]$ ]] && { echo "已取消部署。"; return; }
    fi

    ensure_core_paths "info" || return 1

    export S5_HOST S5_PORT S5_USER S5_PASS TARGET_NID TARGET_TYPE
    export CONFIG_FILE OUTBOUND_FILE ROUTE_FILE

    python3 -c "
import json, os, re, urllib.request, urllib.parse, ssl

cfg_file = os.environ['CONFIG_FILE']
out_file = os.environ['OUTBOUND_FILE']
route_file = os.environ['ROUTE_FILE']
nid = os.environ['TARGET_NID']
ntype = os.environ['TARGET_TYPE']
target_tag = f's5-out-{nid}'

s5_host = os.environ['S5_HOST']
s5_port = int(os.environ['S5_PORT'])
s5_user = os.environ['S5_USER']
s5_pass = os.environ['S5_PASS']

# 查询面板获取该节点的实际监听端口与 ListenIP，用于生成 V2bX 真实的 inboundTag ({NodeType}_{ListenIP}_{Port})
listen_ip = '0.0.0.0'
remote_port = ''
try:
    raw_cfg = open(cfg_file, encoding='utf-8').read()
    try: m_cfg = json.loads(raw_cfg)
    except Exception: m_cfg = json.loads(re.sub(r'(?<!:)//.*', '', raw_cfg))
    for n in m_cfg.get('Nodes', []):
        if str(n.get('NodeID')) == str(nid):
            listen_ip = n.get('ListenIP') or '0.0.0.0'
            ah = str(n.get('ApiHost', '')).rstrip('/')
            ak = str(n.get('ApiKey', ''))
            if ah and ak:
                ctx = ssl.create_default_context()
                ctx.check_hostname = False
                ctx.verify_mode = ssl.CERT_NONE
                qs = urllib.parse.urlencode({'node_id': nid, 'node_type': ntype.lower(), 'token': ak})
                req = urllib.request.Request(f'{ah}/api/v1/server/UniProxy/config?{qs}', headers={'User-Agent': 'V2bX/1.0'})
                with urllib.request.urlopen(req, timeout=5, context=ctx) as resp:
                    r_meta = json.loads(resp.read().decode('utf-8'))
                    if r_meta.get('server_port'):
                        remote_port = str(r_meta['server_port'])
            break
except Exception:
    pass

# 1. 维护 outbounds (完整保留 IPv4_out 与 block)
existing_outs = []
if os.path.exists(out_file):
    try:
        existing_outs = json.loads(open(out_file, encoding='utf-8').read())
    except Exception:
        existing_outs = []

has_ipv4_out = any(o.get('tag') == 'IPv4_out' for o in existing_outs)
has_block = any(o.get('tag') == 'block' for o in existing_outs)

base_outs = []
if not has_ipv4_out:
    base_outs.append({
        'tag': 'IPv4_out',
        'protocol': 'freedom',
        'streamSettings': {'sockopt': {'domainStrategy': 'UseIP'}}
    })
if not has_block:
    base_outs.append({'tag': 'block', 'protocol': 'blackhole'})

kept_outs = [o for o in existing_outs if o.get('tag') != target_tag]

new_s5_outbound = {
    'tag': target_tag,
    'protocol': 'socks',
    'settings': {
        'servers': [
            {
                'address': s5_host,
                'port': s5_port,
                'users': [{'user': s5_user, 'pass': s5_pass}] if s5_user else []
            }
        ]
    }
}

final_outbounds = base_outs + kept_outs + [new_s5_outbound]
tmp_out = out_file + '.tmp'
with open(tmp_out, 'w', encoding='utf-8') as f:
    json.dump(final_outbounds, f, indent=2, ensure_ascii=False)
os.replace(tmp_out, out_file)

# 2. 维护 routes (涵盖 V2bX 全部入站命名格式)
routes = {'domainStrategy': 'AsIs', 'rules': []}
if os.path.exists(route_file):
    try:
        routes = json.loads(open(route_file, encoding='utf-8').read())
    except Exception:
        pass

existing_rules = routes.get('rules', [])
other_rules = [
    r for r in existing_rules
    if r.get('outboundTag') not in [target_tag, 'block', 'maimai-default-block']
]

tag_candidates = [
    nid,
    f'node_{nid}',
    f'{ntype}_{nid}',
    f'{ntype.lower()}_{nid}',
    f'{ntype.upper()}_{nid}',
    f'inbound_{nid}',
    f'{ntype.lower()}_{nid}_tcp',
    f'{ntype.lower()}_{nid}_ws',
    f'{ntype.lower()}_{nid}_grpc',
    f'{ntype.lower()}_{nid}_xhttp',
    f'{ntype.lower()}_{nid}_httpupgrade'
]
if remote_port:
    for lip in sorted(set([listen_ip, '0.0.0.0', '::'])):
        tag_candidates.extend([
            f'{ntype.lower()}_{lip}_{remote_port}',
            f'{ntype}_{lip}_{remote_port}',
            f'V2ray_{lip}_{remote_port}'
        ])

inbound_tags = sorted(list(set(tag_candidates)))

new_rule = {
    'type': 'field',
    'inboundTag': inbound_tags,
    'outboundTag': target_tag
}

security_rules = [
    {
        'type': 'field',
        'outboundTag': 'block',
        'ip': [
            '0.0.0.0/8', '10.0.0.0/8', '100.64.0.0/10', '127.0.0.0/8',
            '169.254.0.0/16', '172.16.0.0/12', '192.0.0.0/24', '192.0.2.0/24',
            '192.168.0.0/16', '198.18.0.0/15', '198.51.100.0/24', '203.0.113.0/24',
            '::1/128', 'fc00::/7', 'fe80::/10'
        ]
    },
    {
        'type': 'field',
        'outboundTag': 'block',
        'protocol': ['bittorrent']
    }
]

routes['domainStrategy'] = routes.get('domainStrategy', 'AsIs')
routes['rules'] = security_rules + other_rules + [new_rule]

tmp_route = route_file + '.tmp'
with open(tmp_route, 'w', encoding='utf-8') as f:
    json.dump(routes, f, indent=2, ensure_ascii=False)
os.replace(tmp_route, route_file)
"

    if [ $? -eq 0 ]; then
        restart_v2bx
        echo -e "\n${GREEN}✅ 节点 [NodeID: ${TARGET_NID}] 专属落地配置成功！${NC}"
        echo -e "${CYAN}入站匹配: NodeID ${TARGET_NID} ➔ 专属出站: s5-out-${TARGET_NID} (${S5_HOST}:${S5_PORT})${NC}"
        echo -e "${GREEN}V2bX 服务已自适应重载生效。${NC}"
    else
        echo -e "${RED}❌ 写入配置失败！${NC}"
    fi
}

reset_node_s5() {
    NODE_RAW=$(list_nodes)
    if [ "$NODE_RAW" = "EMPTY" ] || [ "$NODE_RAW" = "NOT_FOUND" ] || [ -z "$NODE_RAW" ]; then
        echo -e "${RED}当前无节点可重置。${NC}"; return 1
    fi

    TOTAL_NODES=0
    printf "${YELLOW}%-6s %-10s %-30s${NC}\n" "序号" "NodeID" "当前状态"
    while IFS='|' read -r idx nid ntype core status; do
        [ -n "$idx" ] || continue
        printf "%-6s %-10s %-30b\n" " [$idx]" "$nid" "$status"
        TOTAL_NODES=$((TOTAL_NODES + 1))
    done << EOF
$NODE_RAW
EOF

    read -rp "请输入要重置为机房原生直连的节点【序号】: " R_IDX < /dev/tty
    case $R_IDX in
        ''|*[!0-9]*) echo -e "${RED}输入序号无效！${NC}"; return 1 ;;
    esac
    if [ "$R_IDX" -lt 1 ] || [ "$R_IDX" -gt "$TOTAL_NODES" ]; then
        echo -e "${RED}序号超出范围！${NC}"; return 1
    fi

    TARGET_NID=$(echo "$NODE_RAW" | sed -n "${R_IDX}p" | cut -d'|' -f2)
    TARGET_TAG="s5-out-${TARGET_NID}"

    export OUTBOUND_FILE ROUTE_FILE TARGET_TAG

    REMAIN_S5=$(python3 -c "
import json, os

out_file = os.environ['OUTBOUND_FILE']
route_file = os.environ['ROUTE_FILE']
target_tag = os.environ['TARGET_TAG']
remain = 0

if os.path.exists(out_file):
    try:
        outs = json.loads(open(out_file, encoding='utf-8').read())
        outs = [o for o in outs if o.get('tag') != target_tag]
        remain = sum(1 for o in outs if str(o.get('tag', '')).startswith('s5-out-'))
        tmp_out = out_file + '.tmp'
        with open(tmp_out, 'w', encoding='utf-8') as f:
            json.dump(outs, f, indent=2, ensure_ascii=False)
        os.replace(tmp_out, out_file)
    except Exception:
        pass

if os.path.exists(route_file):
    try:
        rts = json.loads(open(route_file, encoding='utf-8').read())
        rts['rules'] = [r for r in rts.get('rules', []) if r.get('outboundTag') != target_tag]
        tmp_route = route_file + '.tmp'
        with open(tmp_route, 'w', encoding='utf-8') as f:
            json.dump(rts, f, indent=2, ensure_ascii=False)
        os.replace(tmp_route, route_file)
    except Exception:
        pass

print(remain)
")

    if [ "${REMAIN_S5:-0}" -eq 0 ]; then
        ensure_core_paths "error" >/dev/null 2>&1
    fi

    restart_v2bx
    echo -e "${GREEN}✅ 节点 [NodeID: ${TARGET_NID}] 已成功解绑 S5，恢复原生直连！${NC}"
}

view_s5_purified_logs() {
    echo -e "\n${YELLOW}💡 正在实时滚动 S5 出站流量流水 (按 Ctrl+C 退出)...${NC}\n"
    
    GREP_OPTS="-E"
    if grep --help 2>&1 | grep -q "line-buffered"; then
        GREP_OPTS="-E --line-buffered"
    fi

    trap ':' INT
    if is_multi_mode && is_systemd; then
        journalctl -u "v2bx@*" -n 150 -f --no-pager | grep $GREP_OPTS "s5-out|proxy|socks|accepted"
    elif is_systemd; then
        journalctl -u V2bX -n 150 -f --no-pager | grep $GREP_OPTS "s5-out|proxy|socks|accepted"
    elif ls /var/log/V2bX/out_*.log /var/log/V2bX/access_*.log >/dev/null 2>&1; then
        tail -n 150 -f /var/log/V2bX/out_*.log /var/log/V2bX/access_*.log 2>/dev/null | grep $GREP_OPTS "s5-out|proxy|socks|accepted"
    else
        LOG_TARGET=""
        for f in /var/log/v2bx_out.log /var/log/V2bX.log /var/log/v2bx.log /etc/V2bX/v2bx.log /var/log/messages; do
            if [ -f "$f" ]; then LOG_TARGET="$f"; break; fi
        done
        if [ -n "$LOG_TARGET" ]; then
            tail -n 150 -f "$LOG_TARGET" | grep $GREP_OPTS "s5-out|proxy|socks|accepted"
        else
            echo -e "${RED}未找到运行日志文件，请确认 V2bX 正在运行。${NC}"
        fi
    fi
    trap - INT
    echo -e "\n${GREEN}✔ 已退出日志查看。${NC}"
}

check_exit_ip() {
    if [ ! -f "$OUTBOUND_FILE" ]; then
        echo -e "${RED}尚未生成任何 S5 出口配置！${NC}"; return
    fi

    echo -e "\n${CYAN}--- 正在逐个测试 S5 落地真实出口 IP (通过 socks5h 远端解析) ---${NC}"
    export OUTBOUND_FILE
    python3 -c "
import json, subprocess, os

try:
    outs = json.loads(open(os.environ['OUTBOUND_FILE'], encoding='utf-8').read())
    s5_outs = [o for o in outs if str(o.get('tag', '')).startswith('s5-out-')]
    if not s5_outs:
        print('[\033[0;33m提示\033[0m] 当前没有正在运行的 S5 出口')
        exit(0)

    for o in s5_outs:
        tag = o['tag']
        nid = tag.replace('s5-out-', '')
        srv = o['settings']['servers'][0]
        host = srv['address'].strip('[]')
        port = srv['port']
        users = srv.get('users', [])
        user = users[0].get('user', '') if users else ''
        passwd = users[0].get('pass', '') if users else ''

        proxy_host = f'[{host}]' if ':' in host else host
        proxy_url = f'socks5h://{proxy_host}:{port}'

        cmd = ['curl', '-s', '--max-time', '8', '--proxy', proxy_url]
        if user:
            cmd.extend(['--proxy-user', f'{user}:{passwd}'])
        cmd.append('https://api.ip.sb/geoip')

        try:
            res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            if res.returncode == 0 and res.stdout:
                geo = json.loads(res.stdout)
                ip = geo.get('ip', '未知')
                country = geo.get('country', '')
                isp = geo.get('isp', '')
                print(f'[\033[0;32m节点 {nid}\033[0m] 出口 IP: \033[0;36m{ip}\033[0m | 地区: {country} ({isp})')
            else:
                print(f'[\033[0;31m节点 {nid}\033[0m] 目标代理 ({host}:{port}) 连通超时或鉴权失败')
        except Exception:
            print(f'[\033[0;31m节点 {nid}\033[0m] 探测失败')
except Exception as e:
    print('解析出错:', e)
"
}

while true; do
    MODE_LABEL="${CYAN}单进程${NC}"
    is_multi_mode && MODE_LABEL="${MAGENTA}多进程隔离${NC}"
    echo -e "\n${CYAN}===========================================${NC}"
    echo -e "${GREEN}  麦卖云 (Maimai Cloud) - S5 落地调度器 v${sh_ver}${NC}"
    echo -e "  运行模式: ${MODE_LABEL}"
    echo -e "${CYAN}===========================================${NC}"
    echo "  1. 扫描节点并配置专属 S5 落地 (SOCKS5协议预检)"
    echo "  2. 单独重置某个节点为原生直连 (解绑 S5)"
    echo "  3. 查看 S5 出站专属流量流水 (纯净提纯版)"
    echo "  4. 真实探测各节点 S5 落地出口 IP 与国家"
    echo "  9. 退出"
    echo -e "${CYAN}===========================================${NC}"
    read -rp "请输入指令: " opt < /dev/tty

    case $opt in
        1) setup_node_s5 ;;
        2) reset_node_s5 ;;
        3) view_s5_purified_logs ;;
        4) check_exit_ip ;;
        9) exit 0 ;;
        *) echo -e "${RED}输入无效！${NC}" ;;
    esac
done
