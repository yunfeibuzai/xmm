#!/bin/bash
# =================================================================
# 麦卖云 V2bX 核心部署与更新引擎 (自建库锁定 + Shannon-x 防爆版)
# 路径：all/xmm1and2
# =================================================================

red='\033[31m'; green='\033[32m'; yellow='\033[33m'; cyan='\033[36m'; plain='\033[0m'

# 1. 强制 Root 权限检查
if [[ $EUID -ne 0 ]]; then
    echo -e "${red}[错误] 必须使用 root 用户运行此脚本！请使用 sudo -i 切换后重试。${plain}"
    exit 1
fi

# 2. 环境依赖自动检查与安装
check_and_install_deps() {
    local pkgs=()
    command -v wget &>/dev/null || pkgs+=("wget")
    command -v unzip &>/dev/null || pkgs+=("unzip")
    command -v curl &>/dev/null || pkgs+=("curl")
    command -v killall &>/dev/null || pkgs+=("psmisc")

    if [ ${#pkgs[@]} -gt 0 ]; then
        echo -e "${cyan}正在自动安装缺失的系统依赖: ${pkgs[*]} ...${plain}"
        if command -v apt &>/dev/null; then
            if ! apt update -q &>/dev/null; then
                echo -e "${yellow}检测到 apt 源可能已失效 (系统 EOL)，正在自动为您切换至 Archive 历史归档源...${plain}"
                cp /etc/apt/sources.list /etc/apt/sources.list.bak 2>/dev/null
                sed -i -E 's/(deb|security).debian.org/archive.debian.org/g' /etc/apt/sources.list
                sed -i -E '/updates/d' /etc/apt/sources.list
                echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99no-check-valid-until
                mkdir -p /root/apt_backup && mv /etc/apt/sources.list.d/*.list /root/apt_backup/ 2>/dev/null
                rm -rf /var/lib/apt/lists/* && apt clean
                apt update -q &>/dev/null
            fi
            apt install -y "${pkgs[@]}" >/dev/null 2>&1
        elif command -v yum &>/dev/null; then
            yum install -y epel-release >/dev/null 2>&1
            yum install -y "${pkgs[@]}" >/dev/null 2>&1
        elif command -v apk &>/dev/null; then
            apk add --no-cache "${pkgs[@]}" >/dev/null 2>&1
        fi
    fi
}
check_and_install_deps

# 独立的服务控制器，兼容单/多进程与不同系统架构
manage_service_local() {
    local action=$1
    if [[ -f /etc/V2bX/nodes/.multi_enabled ]]; then
        if command -v systemctl &>/dev/null; then
            for f in /etc/V2bX/nodes/node_*.json; do
                [[ ! -f "$f" ]] && continue
                local inst; inst=$(basename "$f" .json)
                systemctl "$action" "v2bx@${inst}" 2>/dev/null
            done
        elif command -v rc-service &>/dev/null; then
            for init_f in /etc/init.d/v2bx.node_*; do
                [[ ! -f "$init_f" ]] && continue
                local svc; svc=$(basename "$init_f")
                case "$action" in
                    enable) rc-update add "$svc" default >/dev/null 2>&1 ;;
                    disable) rc-update del "$svc" default >/dev/null 2>&1 ;;
                    *) rc-service "$svc" "$action" 2>/dev/null ;;
                esac
            done
        fi
        return
    fi
    if command -v systemctl &>/dev/null; then
        systemctl "$action" V2bX 2>/dev/null
    elif command -v rc-service &>/dev/null; then
        case "$action" in
            enable) rc-update add V2bX default >/dev/null 2>&1 ;;
            disable) rc-update del V2bX default >/dev/null 2>&1 ;;
            *) rc-service V2bX "$action" 2>/dev/null ;;
        esac
    fi
}

echo -e "${yellow}正在准备部署 V2bX 后端核心组件 (Shannon-x Core)...${plain}"
echo -e "\n${cyan}====== 🛡️ 资源护卫限制策略选择 ======${plain}"
echo -e "  ${green}1.${plain} 原生态无锁版 (推荐：依赖 Shannon-x 内置软上限，满血不杀进程)"
echo -e "  ${green}2.${plain} 标准防爆锁 (160M 内存硬上限 + 45% CPU 压制，适合 512M 普通小鸡)"
echo -e "  ${green}3.${plain} 极致低配锁 (96M 内存硬上限 + 25% CPU 压制，适合 128M~256M NAT 鸡)"
echo -e "  ${green}4.${plain} 自定义限额 (手动指定内存与 CPU 上限)"
read -rp "请选择限额策略 [1-4] (默认 1): " limit_opt < /dev/tty
[[ -z "$limit_opt" ]] && limit_opt="1"

mem_limit=""; cpu_limit=""
case "$limit_opt" in
    2) mem_limit=160; cpu_limit=45 ;;
    3) mem_limit=96; cpu_limit=25 ;;
    4)
        read -rp "请输入允许核心使用的内存硬性上限 (单位 MiB, 建议不低于 96): " mem_limit < /dev/tty
        read -rp "请输入允许核心使用的最大 CPU 使用率 (单位 %, 例如 60): " cpu_limit < /dev/tty
        [[ ! "$mem_limit" =~ ^[0-9]+$ ]] && mem_limit=160
        [[ ! "$cpu_limit" =~ ^[0-9]+$ ]] && cpu_limit=45
        ;;
    *) limit_opt="1" ;;
esac

# 停止旧服务并清理残余
manage_service_local stop
manage_service_local disable
killall -9 V2bX >/dev/null 2>&1 || pkill -9 -f "/usr/local/V2bX/V2bX" >/dev/null 2>&1
mkdir -p /usr/local/V2bX /etc/V2bX /var/log/V2bX
rm -rf /usr/local/V2bX/V2bX /tmp/v2bx_tmp*

# ==================== 针对 Xray 与 Sing-box 的双防线初始化 ====================
cat << 'EOF' > /etc/V2bX/dns.json
{
  "servers": [
    "tcp://8.8.8.8:53",
    "tcp://1.1.1.1:53",
    "8.8.8.8",
    "1.1.1.1"
  ]
}
EOF

cat << 'EOF' > /etc/V2bX/sing_dns.json
{
  "servers": [
    { "address": "8.8.8.8" },
    { "address": "1.1.1.1" }
  ]
}
EOF

cat << 'EOF' > /etc/V2bX/custom_outbound.json
[
  {
    "tag": "IPv4_out",
    "protocol": "freedom",
    "streamSettings": { "sockopt": { "domainStrategy": "UseIP" } }
  },
  { "tag": "block", "protocol": "blackhole" }
]
EOF
chmod 644 /etc/V2bX/dns.json /etc/V2bX/sing_dns.json /etc/V2bX/custom_outbound.json

# 架构判定
raw_arch=$(uname -m); arch="linux-64"
case "${raw_arch}" in 
    x86_64|amd64) arch="linux-64" ;; 
    arm64|aarch64) arch="linux-arm64-v8a" ;; 
    armv7*|armhf) arch="linux-arm32-v7a" ;; 
    s390x) arch="linux-s390x" ;; 
    riscv64) arch="linux-riscv64" ;;
esac

repo_owner="yunfeibuzai"
repo_name="xmm"
core_ver="v1.1.202611061743"
urls=(
    "https://ghp.ci/https://github.com/${repo_owner}/${repo_name}/releases/download/${core_ver}/V2bX-${arch}.zip"
    "https://mirror.ghproxy.net/https://github.com/${repo_owner}/${repo_name}/releases/download/${core_ver}/V2bX-${arch}.zip"
    "https://github.com/${repo_owner}/${repo_name}/releases/download/${core_ver}/V2bX-${arch}.zip"
)

success=false
echo -e "${cyan}开始从自建仓库拉取 V2bX 核心 [${core_ver}] (架构: ${arch})...${plain}"
for url in "${urls[@]}"; do
    tmp_file="/tmp/v2bx_tmp_${RANDOM}.zip"
    if wget -q --show-progress -O "$tmp_file" "$url" --timeout=15; then
        if [[ -f "$tmp_file" && -s "$tmp_file" ]] && head -c 4 "$tmp_file" | grep -q 'PK\|ELF'; then
            tmp_dir="/tmp/v2bx_extract_${RANDOM}"
            mkdir -p "$tmp_dir"
            
            if unzip -q -o "$tmp_file" -d "$tmp_dir" >/dev/null 2>&1; then
                b_target=""
                [[ -f "$tmp_dir/V2bX" ]] && b_target="$tmp_dir/V2bX"
                [[ -f "$tmp_dir/V2bX-${arch}" ]] && b_target="$tmp_dir/V2bX-${arch}"
                [[ -z "$b_target" ]] && b_target=$(find "$tmp_dir" -type f -name "V2bX*" | head -n 1)
                
                if [[ -n "$b_target" && -f "$b_target" ]]; then
                    mv -f "$b_target" /usr/local/V2bX/V2bX && success=true
                fi
            elif head -c 4 "$tmp_file" | grep -q 'ELF'; then
                mv -f "$tmp_file" /usr/local/V2bX/V2bX && success=true
            fi
            rm -rf "$tmp_dir"
        fi
    fi
    rm -f "$tmp_file"
    if [ "$success" = true ]; then
        chmod +x /usr/local/V2bX/V2bX
        echo -e "${green}[成功] 核心拉取并解压成功！${plain}"
        break
    fi
done

if [ "$success" = false ]; then
    echo -e "${red}[错误] 所有拉取线路均失败或文件损坏，请检查网络或确认仓库中已上传 V2bX-${arch}.zip！${plain}"
    exit 1
fi

rm -f /usr/local/V2bX/geoip.dat /usr/local/V2bX/geosite.dat

# 如果没有配置文件，提示运行向导
if [ ! -f /etc/V2bX/config.json ]; then
    read -rp "未检测到配置文件，是否立即运行向导生成？(y/n) " ask_gen_config < /dev/tty
    if [[ "$ask_gen_config" =~ ^[Yy]$ ]]; then
        tmp_xmm2="/tmp/xmm2_boot_${RANDOM}.sh"
        xmm2_urls=(
            "https://ghp.ci/https://raw.githubusercontent.com/yunfeibuzai/xmm/main/xmm2"
            "https://mirror.ghproxy.net/https://raw.githubusercontent.com/yunfeibuzai/xmm/main/xmm2"
            "https://raw.githubusercontent.com/yunfeibuzai/xmm/main/xmm2"
        )
        for xurl in "${xmm2_urls[@]}"; do
            if wget -q --timeout=10 -O "$tmp_xmm2" "$xurl" || curl -sL --connect-timeout 8 "$xurl" -o "$tmp_xmm2"; then
                if [[ -f "$tmp_xmm2" && -s "$tmp_xmm2" ]]; then
                    chmod +x "$tmp_xmm2"
                    bash "$tmp_xmm2"
                    break
                fi
            fi
        done
        rm -f "$tmp_xmm2"
    fi
fi

# ==================== 写入守护服务 ====================
if [ -d /etc/systemd/system ]; then
    cat << EOF > /etc/systemd/system/V2bX.service
[Unit]
Description=V2bX Service - Adaptive Managed (Hot-Reload)
After=network.target

[Service]
ExecStart=/usr/local/V2bX/V2bX server -c /etc/V2bX/config.json -w
Restart=always
RestartSec=10
User=root
LimitNOFILE=1048576
LimitNPROC=51200
Environment="XRAY_DNS_PATH=/etc/V2bX/dns.json"
Environment="SING_DNS_PATH=/etc/V2bX/sing_dns.json"
EOF

    if [[ "$limit_opt" != "1" ]]; then
        high_mark=$((mem_limit * 8 / 10))
        cat << EOF >> /etc/systemd/system/V2bX.service
Environment="GOMEMLIMIT=${mem_limit}MiB"
Environment="GOGC=50"
CPUQuota=${cpu_limit}%
Nice=19
MemoryHigh=${high_mark}M
MemoryMax=${mem_limit}M
OOMScoreAdjust=-100
EOF
    fi

    echo -e "[Install]\nWantedBy=multi-user.target" >> /etc/systemd/system/V2bX.service
    systemctl daemon-reload
    [[ ! -f /etc/V2bX/nodes/.multi_enabled ]] && manage_service_local enable
    
elif [ -d /etc/init.d ]; then
    cat << EOF > /etc/init.d/V2bX
#!/sbin/openrc-run
description="V2bX Alpine Service (Hot-Reload)"
command="/usr/local/V2bX/V2bX"
command_args="server -c /etc/V2bX/config.json -w"
command_background=true
pidfile="/run/V2bX.pid"
output_log="/var/log/v2bx_out.log"
error_log="/var/log/v2bx_err.log"
command_env="XRAY_DNS_PATH=/etc/V2bX/dns.json SING_DNS_PATH=/etc/V2bX/sing_dns.json"
EOF

    if [[ "$limit_opt" != "1" ]]; then
        cat << EOF >> /etc/init.d/V2bX
command_env="\$command_env GOMEMLIMIT=${mem_limit}MiB GOGC=50"
start_stop_daemon_args="--nicelevel 19"
EOF
    fi

    cat << EOF >> /etc/init.d/V2bX

depend() {
    need net
}
EOF
    chmod +x /etc/init.d/V2bX
    [[ ! -f /etc/V2bX/nodes/.multi_enabled ]] && manage_service_local enable
fi

if [ -f /etc/V2bX/config.json ]; then
    manage_service_local restart
    echo -e "${green}V2bX 部署启动完成！热重载 (-w) 已生效。${plain}"
else
    echo -e "${yellow}V2bX 核心已就绪，请在主菜单配置 config.json 后启动。${plain}"
fi
