# ════════════════════ 依赖组件安全补齐 ════════════════════
ensure_tools() {
    local need=0
    for c in jq openssl curl python3; do
        command -v "$c" &>/dev/null || need=1
    done
    if [[ $need -eq 1 ]]; then
        echo -e " ${yellow}正在自动补齐核心运行组件 (jq / openssl / curl / python3)...${plain}"
        if command -v apt-get &>/dev/null; then
            DEBIAN_FRONTEND=noninteractive apt-get update -y -q >/dev/null 2>&1
            DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends jq openssl curl python3 >/dev/null 2>&1
        elif command -v yum &>/dev/null; then
            yum install -y jq openssl curl python3 >/dev/null 2>&1
        elif command -v apk &>/dev/null; then
            apk update >/dev/null 2>&1
            apk add --no-cache jq openssl curl python3 bash coreutils procps >/dev/null 2>&1
        fi
    fi
}
ensure_tools

# ════════════════════ 本地有效证书嗅探器 (防重复申请触发 ACME 429) ════════════════════
find_local_valid_cert() {
    local target_domain="$1"
    [[ -z "$target_domain" ]] && return 1
    python3 - "$target_domain" <<'PYEOF'
import os, re, subprocess, sys

td = sys.argv[1].strip().lower()
wildcard = "*." + td.split(".", 1)[1] if "." in td else ""
search_dirs = ["/etc/V2bX", "/etc/V2bX/cert", "/etc/V2bX/certs", "/root/.acme.sh"]
scanned = set()
exact_match = None
wild_match = None

for base_dir in search_dirs:
    if not os.path.isdir(base_dir):
        continue
    for root, _, files in os.walk(base_dir):
        for fn in files:
            if not fn.lower().endswith((".crt", ".pem", ".cer")):
                continue
            if "ca.cer" in fn.lower() or ("chain" in fn.lower() and "fullchain" not in fn.lower()):
                continue
            c_path = os.path.join(root, fn)
            if c_path in scanned:
                continue
            scanned.add(c_path)

            chk = subprocess.run(
                ["openssl", "x509", "-in", c_path, "-noout", "-checkend", "86400", "-ext", "subjectAltName", "-subject"],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True
            )
            if chk.returncode != 0:
                continue

            stem = os.path.splitext(fn)[0].replace("_ecc", "").replace("fullchain", "")
            k_candidates = [
                os.path.splitext(c_path)[0] + ".key",
                os.path.join(root, stem + ".key") if stem else "",
                os.path.join(root, os.path.basename(root).replace("_ecc", "") + ".key"),
                os.path.join(root, "privkey.pem"),
                os.path.join(root, "private.key"),
            ]
            k_path = next((kp for kp in k_candidates if kp and os.path.isfile(kp) and os.path.getsize(kp) > 0), "")
            if not k_path:
                for f2 in files:
                    if f2.lower().endswith(".key"):
                        k_path = os.path.join(root, f2)
                        break
            if not k_path:
                continue

            domains = [d.lower() for d in re.findall(r'DNS:([^\s,]+)', chk.stdout)]
            cn_m = re.search(r'CN\s*=\s*([^\s,/]+)', chk.stdout)
            if cn_m:
                domains.append(cn_m.group(1).lower())

            if td in domains and not exact_match:
                exact_match = (c_path, k_path)
            elif wildcard and wildcard in domains and not wild_match:
                wild_match = (c_path, k_path)

res = exact_match or wild_match
if res:
    print(f"{res[0]}|{res[1]}")
PYEOF
}

# ════════════════════ 本地 CF 隧道嗅探 ════════════════════
check_cf_tunnel() {
    cf_tunnel_running=false
    cf_tunnel_domain=""

    if pgrep -f "[c]loudflared" >/dev/null 2>&1; then
        cf_tunnel_running=true
    fi

    if compgen -G "/etc/cloudflared/*.y*ml" >/dev/null 2>&1; then
        cf_tunnel_domain=$(grep -E '^\s*-\s*hostname:' /etc/cloudflared/*.y*ml 2>/dev/null | head -n1 | awk '{print $NF}' | tr -d ' "\r\n')
    fi
}
check_cf_tunnel

