    [[ ! -f /etc/V2bX/sing_origin.json ]] && echo '{ "outbounds": [ { "type": "direct", "tag": "direct" } ] }' > /etc/V2bX/sing_origin.json
    if [[ ! -f /etc/V2bX/dns.json ]]; then
        cat << 'EOF' > /etc/V2bX/dns.json
{
  "servers": [
    "tcp://8.8.8.8:53",
    "tcp://1.1.1.1:53",
    "8.8.8.8",
    "1.1.1.1"
  ]
}
EOF
    fi
    [[ ! -f /etc/V2bX/sing_dns.json ]] && echo '{ "servers": [ {"address": "8.8.8.8"}, {"address": "1.1.1.1"} ] }' > /etc/V2bX/sing_dns.json
    echo '[ { "tag": "IPv4_out", "protocol": "freedom", "streamSettings": { "sockopt": { "domainStrategy": "UseIP" } } }, { "tag": "block", "protocol": "blackhole" } ]' > /etc/V2bX/custom_outbound.json
    
    if [[ ! -f /etc/V2bX/route.json ]]; then
        cat << 'EOF' > /etc/V2bX/route.json
{ "domainStrategy": "AsIs", "rules": [ { "type": "field", "outboundTag": "block", "ip": [ "0.0.0.0/8", "10.0.0.0/8", "100.64.0.0/10", "127.0.0.0/8", "169.254.0.0/16", "172.16.0.0/12", "192.0.0.0/24", "192.0.2.0/24", "192.168.0.0/16", "198.18.0.0/15", "198.51.100.0/24", "203.0.113.0/24", "::1/128", "fc00::/7", "fe80::/10" ] }, { "type": "field", "outboundTag": "block", "protocol": [ "bittorrent" ] } ] }
EOF
    fi

    cat << 'EOF' > /etc/V2bX/xhttp_template.conf
{
  "mode": "auto",
  "extra": {
    "noEof": true
  }
}
EOF

    [[ ! -f /etc/V2bX/hy2config.yaml ]] && generate_hy2_yaml
}

generate_hy2_yaml() {
    cat << 'EOF' > /etc/V2bX/hy2config.yaml
quic:
  initStreamReceiveWindow: 16777216
  maxStreamReceiveWindow: 16777216
  initConnReceiveWindow: 33554432
  maxConnReceiveWindow: 33554432
  maxIdleTimeout: 90s
  maxIncomingStreams: 4096
  disablePathMTUDiscovery: false
ignoreClientBandwidth: false
disableUDP: false
udpIdleTimeout: 120s
resolver:
  type: system
masquerade:
  type: 404
EOF
}

load_or_ask_creds() {
    local default_host="https://example.com"
    local default_key=""

    if [[ -f "$saved_file" ]]; then
        source "$saved_file" 2>/dev/null
        default_host=${saved_host:-"https://example.com"}
        default_key=${saved_key:-""}
    fi

    echo -e "${yellow}💡 基础对接配置 (支持自动记忆，下次无需重复输入)${plain}"
    echo -e " 当前记忆面板: ${cyan}${saved_host:-未保存}${plain}"
    
    echo -ne " ${bold}▸ 请输入机场面板网址${plain} ${dim}[回车默认: ${default_host}]${plain}: "
    read -r input_host < /dev/tty
    api_host=${input_host:-"$default_host"}
    
    if [[ ! "$api_host" =~ ^https?:// ]]; then
        api_host="https://${api_host}"
    fi
    api_host="${api_host%/}"

    if [[ -n "$default_key" ]]; then
        echo -ne " ${bold}▸ 请输入对接 API Key${plain} ${dim}[回车使用记忆 Key: ${default_key:0:4}****]${plain}: "
        read -r input_key < /dev/tty
        api_key=${input_key:-"$default_key"}
    else
        api_key=""
        while [[ -z "$api_key" ]]; do
            echo -ne " ${bold}▸ 请输入面板对接 API Key${plain}: "
            read -r api_key < /dev/tty
        done
    fi

    echo -ne " ${bold}▸ 是否固定保存此面板信息以便日后调用？${plain} [Y/n]: "
    read -r save_yn < /dev/tty
    [[ -z "$save_yn" ]] && save_yn="y"
    if [[ "$save_yn" =~ ^[Yy]$ ]]; then
        echo "saved_host=\"$api_host\"" > "$saved_file"
        echo "saved_key=\"$api_key\"" >> "$saved_file"
        chmod 600 "$saved_file"
        echo -e " ${green}✔ 凭证已安全锁定于 ${saved_file}${plain}"
    fi
}

build_xray_core_json() {
    local hs=${1:-4} idle=${2:-120} up=${3:-2} down=${4:-4} buf=${5:-64} acc=${6:-""}
    jq -n \
        --arg acc "$acc" \
        --argjson hs "$hs" \
        --argjson idle "$idle" \
        --argjson up "$up" \
        --argjson down "$down" \
        --argjson buf "$buf" \
        '{
          Type: "xray",
          Log: { Level: "error", AccessPath: $acc, ErrorPath: "/etc/V2bX/error.log", MaxSize: 100, MaxBackups: 0, MaxDays: 90, Compress: true },
          AssetPath: "/etc/V2bX/",
          DnsConfigPath: "/etc/V2bX/dns.json",
          OutboundConfigPath: "/etc/V2bX/custom_outbound.json",
          RouteConfigPath: "/etc/V2bX/route.json",
          XrayConnectionConfig: { handshake: $hs, connIdle: $idle, uplinkOnly: $up, downlinkOnly: $down, bufferSize: $buf }
        }'
}

build_sing_core_json() {
    echo '{ "Type": "sing", "Log": { "Level": "error", "Timestamp": true }, "NTP": { "Enable": false, "Server": "time.apple.com", "ServerPort": 0 }, "OriginalPath": "/etc/V2bX/sing_origin.json" }'
}

build_hy2_core_json() {
    echo '{ "Type": "hysteria2", "Log": { "Level": "error" } }'
}

collect_single_node() {
    local idx="$1"
    ui_section "配置第 ${idx} 个后端节点"

    ui_step "1/4" "选择代理核心与传输协议"
    echo -e "  ${cyan}[1]${plain} Xray      ${dim}(首选: Vless / Vmess / Reality / XHTTP / AnyTLS / Hy2 / CDN)${plain}"
    echo -e "  ${cyan}[2]${plain} Sing-box  ${dim}(全能: Shadowsocks / Trojan / Tuic / AnyTLS / Hy1&2 / Vless / Vmess)${plain}"
    echo -e "  ${cyan}[3]${plain} Hysteria2 ${dim}(官方专属高性能内核)${plain}"
    
    local core_num=""
    while [[ ! "$core_num" =~ ^[1-3]$ ]]; do
        echo -ne " ${bold}▸ 请选择内核引擎${plain} [1-3, 默认 1]: "
        read -r core_num < /dev/tty
        [[ -z "$core_num" ]] && core_num=1
    done

    case "$core_num" in 1) core_type="xray"; has_xray=true ;; 2) core_type="sing"; has_sing=true ;; 3) core_type="hysteria2"; has_hysteria2=true ;; esac

    local protocol_num=""
    if [[ "$core_type" == "hysteria2" ]]; then
        node_type="hysteria2"; echo -e "  ${green}✔ 自动锁定协议: hysteria2${plain}"
    elif [[ "$core_type" == "xray" ]]; then
        echo -e "\n  ${cyan}[1]${plain} Vless  ${cyan}[2]${plain} Vmess  ${cyan}[3]${plain} Trojan  ${cyan}[4]${plain} Shadowsocks  ${cyan}[5]${plain} AnyTLS  ${cyan}[6]${plain} Hysteria2"
        while [[ ! "$protocol_num" =~ ^[1-6]$ ]]; do
            echo -ne " ${bold}▸ 请选择协议${plain} [1-6, 默认 1]: "; read -r protocol_num < /dev/tty; [[ -z "$protocol_num" ]] && protocol_num=1
        done
        case "$protocol_num" in
            1) node_type="vless" ;; 2) node_type="vmess" ;; 3) node_type="trojan" ;;
            4) node_type="shadowsocks" ;; 5) node_type="anytls" ;; 6) node_type="hysteria2" ;;
        esac
    elif [[ "$core_type" == "sing" ]]; then
        echo -e "\n  ${cyan}[1]${plain} Shadowsocks  ${cyan}[2]${plain} Trojan  ${cyan}[3]${plain} Tuic  ${cyan}[4]${plain} AnyTLS  ${cyan}[5]${plain} Hysteria"
        echo -e "  ${cyan}[6]${plain} Hysteria2    ${cyan}[7]${plain} Vless   ${cyan}[8]${plain} Vmess ${cyan}[9]${plain} Naive ${dim}(仅限yabx内核)${plain}"
        while [[ ! "$protocol_num" =~ ^[1-9]$ ]]; do
            echo -ne " ${bold}▸ 请选择协议${plain} [1-9, 默认 1]: "; read -r protocol_num < /dev/tty; [[ -z "$protocol_num" ]] && protocol_num=1
        done
        case "$protocol_num" in
            1) node_type="shadowsocks" ;; 2) node_type="trojan" ;; 3) node_type="tuic" ;; 4) node_type="anytls" ;;
            5) node_type="hysteria" ;; 6) node_type="hysteria2" ;; 7) node_type="vless" ;; 8) node_type="vmess" ;; 9) node_type="naive" ;;
        esac
    fi

    ui_step "2/4" "基础参数与监听网络"
    while true; do
        node_id=""
        while [[ ! "$node_id" =~ ^[0-9]+$ ]]; do
            echo -ne " ${bold}▸ Node ID${plain} (纯数字): "; read -r node_id < /dev/tty
        done
        if [[ " ${used_node_ids[*]} " =~ " ${node_id} " ]]; then
            echo -e "  ${red}✖ 警告：本轮配置中已添加过 NodeID ${node_id}，请输入不同的 Node ID！${plain}"
        else
            used_node_ids+=("$node_id")
            break
        fi
    done

    local listen_ip="0.0.0.0"
    [[ "$core_type" == "hysteria2" ]] && listen_ip=""
    echo -ne " ${bold}▸ 监听 IP${plain} ${dim}[回车默认$([[ "$core_type" == "hysteria2" ]] && echo "双栈全监听" || echo " 0.0.0.0，双栈填 ::")]${plain}: "
    read -r input_listen < /dev/tty
    [[ -n "$input_listen" ]] && listen_ip="$input_listen"

    ui_step "3/4" "TLS 安全与证书模式"
    local run_tls_flow=false; local reality_yn="n" tls_yn="n" cert_mode="none" cert_domain="" cf_token="" cert_file="" key_file=""
    if [[ "$node_type" == "vless" ]]; then
        if [ "$cf_tunnel_running" = true ]; then
            echo -ne " ${bold}▸ 是否为 Reality 节点？${plain} ${dim}(CF隧道通常选 N 走 TLS)${plain} [y/N]: "; read -r reality_yn < /dev/tty; [[ -z "$reality_yn" ]] && reality_yn="n"
        else
            echo -ne " ${bold}▸ 是否为 Reality 节点？${plain} [Y/n]: "; read -r reality_yn < /dev/tty; [[ -z "$reality_yn" ]] && reality_yn="y"
        fi
        if [[ "$reality_yn" =~ ^[Yy]$ ]]; then echo -e "  ${green}✔ Reality 节点自动设为 none${plain}"; else run_tls_flow=true; fi
    elif [[ "$node_type" =~ ^(hysteria2|tuic|hysteria|trojan|naive|anytls)$ ]]; then
        run_tls_flow=true; echo -e "  ${yellow}ℹ 协议 [${node_type}] 必须配置 TLS 证书。${plain}"
    else
        echo -ne " ${bold}▸ 是否开启 TLS 证书？${plain} [y/N]: "; read -r tls_yn < /dev/tty; [[ "$tls_yn" =~ ^[Yy]$ ]] && run_tls_flow=true
    fi

    if [ "$run_tls_flow" = true ]; then
        if [ "$cf_tunnel_running" = true ]; then
            cert_mode="file"
            echo -e "  ${yellow}⚡ 检测到本地运行中的 Cloudflare Tunnel${plain}${cf_tunnel_domain:+ " (${cyan}${cf_tunnel_domain}${plain})"}"
            echo -e "  ${green}✔ 已自动生成本地自签证书并以【file 模式】挂载 (兼容全内核)${plain}"
            
            local default_self_sni=${cf_tunnel_domain:-"cf.babymonster.cc.cd"}
            echo -ne " ${bold}▸ 确认自签域名${plain} ${dim}[回车默认: ${default_self_sni}]${plain}: "
            read -r input_sni < /dev/tty
            cert_domain=${input_sni:-"$default_self_sni"}
            cert_file="/etc/V2bX/${cert_domain}.cert.pem"
            key_file="/etc/V2bX/${cert_domain}.key.pem"
            
            echo -e "  ${cyan}正在生成 10 年期自签证书...${plain}"
            openssl req -x509 -nodes -newkey rsa:2048 -days 3650 -keyout "$key_file" -out "$cert_file" -subj "/CN=${cert_domain}" >/dev/null 2>&1
        else
            echo -e "  ${cyan}[1] HTTP 模式${plain}  ${cyan}[2] DNS 模式${plain}  ${cyan}[3] File 模式${plain}  ${cyan}[4] 本地自签(File)${plain}"
            local cert_mode_num=""
            while [[ ! "$cert_mode_num" =~ ^[1-4]$ ]]; do echo -ne " ${bold}▸ 选择申请方式${plain} [1-4]: "; read -r cert_mode_num < /dev/tty; [[ -z "$cert_mode_num" ]] && cert_mode_num=1; done
            case "$cert_mode_num" in
                1) cert_mode="http"; while [[ -z "$cert_domain" ]]; do echo -ne " ${bold}▸ 绑定域名${plain}: "; read -r cert_domain < /dev/tty; done; cert_file="/etc/V2bX/${cert_domain}.cert.pem"; key_file="/etc/V2bX/${cert_domain}.key.pem" ;;
                2) cert_mode="dns"; while [[ -z "$cert_domain" ]]; do echo -ne " ${bold}▸ 绑定域名${plain}: "; read -r cert_domain < /dev/tty; done; while [[ -z "$cf_token" ]]; do echo -ne " ${bold}▸ Cloudflare Token${plain}: "; read -r cf_token < /dev/tty; done; cert_file="/etc/V2bX/${cert_domain}.cert.pem"; key_file="/etc/V2bX/${cert_domain}.key.pem" ;;
                3) cert_mode="file"; echo -ne " ${bold}▸ 节点域名${plain}: "; read -r cert_domain < /dev/tty; echo -ne " ${bold}▸ 公钥路径${plain} [/etc/V2bX/fullchain.cer]: "; read -r input_cert < /dev/tty; cert_file=${input_cert:-"/etc/V2bX/fullchain.cer"}; echo -ne " ${bold}▸ 私钥路径${plain} [/etc/V2bX/cert.key]: "; read -r input_key < /dev/tty; key_file=${input_key:-"/etc/V2bX/cert.key"} ;;
                4) cert_mode="file"; echo -ne " ${bold}▸ 自签域名${plain} [cf.babymonster.cc.cd]: "; read -r input_sni < /dev/tty; cert_domain=${input_sni:-"cf.babymonster.cc.cd"}; cert_file="/etc/V2bX/${cert_domain}.cert.pem"; key_file="/etc/V2bX/${cert_domain}.key.pem"; echo -e "  ${cyan}生成 10 年自签证书...${plain}"; openssl req -x509 -nodes -newkey rsa:2048 -days 3650 -keyout "$key_file" -out "$cert_file" -subj "/CN=${cert_domain}" >/dev/null 2>&1 ;;
            esac
        fi
    fi

    local cert_json
    if [[ "$cert_mode" == "dns" ]]; then
        cert_json=$(jq -n --arg dom "$cert_domain" --arg cf "$cert_file" --arg kf "$key_file" --arg tok "$cf_token" \
            '{CertMode:"dns",RejectUnknownSni:false,CertDomain:$dom,CertFile:$cf,KeyFile:$kf,Email:"admin@v2bx.com",Provider:"cloudflare",DNSEnv:{CF_DNS_API_TOKEN:$tok,CLOUDFLARE_DNS_API_TOKEN:$tok}}')
    elif [[ "$cert_mode" =~ ^(http|file)$ ]]; then
        cert_json=$(jq -n --arg cm "$cert_mode" --arg dom "$cert_domain" --arg cf "$cert_file" --arg kf "$key_file" \
            '{CertMode:$cm,RejectUnknownSni:false,CertDomain:$dom,CertFile:$cf,KeyFile:$kf,Email:"admin@v2bx.com"}')
    else
        cert_json='{"CertMode":"none"}'
    fi

    ui_step "4/4" "流量控制与网络优化"
    local has_limit="false" speed_limit=0 dev_limit=0 conn_limit=0 enable_dyn="false"
    echo -ne " ${bold}▸ 配置限速/设备锁？${plain} [y/N]: "; read -r limit_yn < /dev/tty
    if [[ "$limit_yn" =~ ^[Yy]$ ]]; then
        has_limit="true"
        echo -ne "   └─ 限速(Mbps) [0]: "; read -r speed_limit < /dev/tty; [[ ! "$speed_limit" =~ ^[0-9]+$ ]] && speed_limit=0
        echo -ne "   └─ 设备限制 [0]: "; read -r dev_limit < /dev/tty; [[ ! "$dev_limit" =~ ^[0-9]+$ ]] && dev_limit=0
        echo -ne "   └─ TCP上限 [0]: "; read -r conn_limit < /dev/tty; [[ ! "$conn_limit" =~ ^[0-9]+$ ]] && conn_limit=0
        echo -ne "   └─ 暴流压制？[y/N]: "; read -r dyn_yn < /dev/tty; [[ "$dyn_yn" =~ ^[Yy]$ ]] && enable_dyn="true"
    fi

    local dns_type="UseIPv4"
    if [[ "$core_type" == "xray" ]]; then
        echo -ne " ${bold}▸ 解析策略${plain} [1:IPv4 2:IPv6 3:双栈 4:AsIs]: "; read -r dns_opt < /dev/tty
        case "$dns_opt" in 2) dns_type="UseIPv6" ;; 3) dns_type="UseIP" ;; 4) dns_type="AsIs" ;; esac
    fi

    current_node=$(jq -n \
        --arg core "$core_type" \
        --arg host "$api_host" \
        --arg key "$api_key" \
        --argjson nid "$node_id" \
        --arg ntype "$node_type" \
        --arg lip "$listen_ip" \
        --arg dnstype "$dns_type" \
        --argjson cert "$cert_json" \
        --argjson has_lim "$has_limit" \
        --argjson spd "$speed_limit" \
        --argjson dev "$dev_limit" \
        --argjson conn "$conn_limit" \
        --argjson dyn "$enable_dyn" \
        '
        (if $core == "xray" then
          {Core:"xray",ApiHost:$host,ApiKey:$key,NodeID:$nid,NodeType:$ntype,Timeout:30,ListenIP:$lip,SendIP:"0.0.0.0",DeviceOnlineMinTraffic:200,ReportMinTraffic:0,EnableProxyProtocol:false,EnableUot:true,EnableTFO:true,DNSType:$dnstype,DisableSniffing:false,CertConfig:$cert}
        elif $core == "sing" then
          {Core:"sing",ApiHost:$host,ApiKey:$key,NodeID:$nid,NodeType:$ntype,Timeout:30,ListenIP:$lip,SendIP:"0.0.0.0",DeviceOnlineMinTraffic:200,ReportMinTraffic:0,EnableTFO:true,EnableSniff:true,SniffOverrideDestination:true,CertConfig:$cert}
        else
          {Core:"hysteria2",ApiHost:$host,ApiKey:$key,NodeID:$nid,NodeType:"hysteria2",Hysteria2ConfigPath:"/etc/V2bX/hy2config.yaml",Timeout:30,ListenIP:$lip,SendIP:"0.0.0.0",DeviceOnlineMinTraffic:200,ReportMinTraffic:0,CertConfig:$cert}
        end)
        | if $has_lim then
            . + {LimitConfig:{EnableRealtime:false,SpeedLimit:$spd,DeviceLimit:$dev,ConnLimit:$conn,EnableDynamicSpeedLimit:$dyn,DynamicSpeedLimitConfig:{Periodic:60,Traffic:1073741824,SpeedLimit:10,ExpireTime:600}}}
          else . end
        ')
}

main_create_all() {
    ui_banner
    init_aux_files
    load_or_ask_creds

    local nodes_json="[]"
    used_node_ids=()
    has_xray=false; has_sing=false; has_hysteria2=false; node_count=0

    while true; do
        ((node_count++))
        collect_single_node "$node_count"
        nodes_json=$(jq -n --argjson arr "$nodes_json" --argjson item "$current_node" '$arr + [$item]')
        echo -ne "\n ${bold}▸ 是否继续配置下一个节点？${plain} [y/N, 默认 N]: "; read -r continue_yn < /dev/tty
        [[ ! "$continue_yn" =~ ^[Yy]$ ]] && break
    done

    local hs=4 idle=120 up=2 down=4 buf=64 gc=50 mem_pct=70 acc_path=""
    if [ "$has_xray" = true ]; then
        ui_section "Xray 引擎网络连接池与运行时防爆档位"
        echo -e "  ${cyan}[1] 均衡默认档${plain} (4/120/2/4/64)    ${cyan}[2] 大带宽高并发${plain} (4/300/2/4/128)  ${cyan}[3] 极限低内存${plain} (4/60/1/2/16 + 关连接日志)"
        echo -ne " ${bold}▸ 请选择连接池档位${plain} [1-3, 默认 1]: "; read -r perf_opt < /dev/tty
        case "$perf_opt" in
            2) hs=4; idle=300; up=2; down=4; buf=128; gc=60; mem_pct=80; acc_path="" ;;
            3) hs=4; idle=60; up=1; down=2; buf=16; gc=40; mem_pct=65; acc_path="none" ;;
        esac
    fi

    local cores_json="[]"
    if [ "$has_xray" = true ]; then
        local xc; xc=$(build_xray_core_json $hs $idle $up $down $buf "$acc_path")
        cores_json=$(jq -n --argjson arr "$cores_json" --argjson c "$xc" '$arr + [$c]')
    fi
    if [ "$has_sing" = true ]; then
        local sc; sc=$(build_sing_core_json)
        cores_json=$(jq -n --argjson arr "$cores_json" --argjson c "$sc" '$arr + [$c]')
    fi
    if [ "$has_hysteria2" = true ]; then
        local hc; hc=$(build_hy2_core_json)
        cores_json=$(jq -n --argjson arr "$cores_json" --argjson c "$hc" '$arr + [$c]')
    fi

    local tmp_json="/etc/V2bX/config.json.tmp"
    if jq -n \
        --argjson gc "$gc" \
        --argjson mp "$mem_pct" \
        --argjson cores "$cores_json" \
        --argjson nodes "$nodes_json" \
        '{
          Log: { Level: "error", Output: "" },
          Runtime: { GCPercent: $gc, MemoryLimitPercent: $mp },
          Cores: $cores,
          Nodes: $nodes
        }' > "$tmp_json" 2>/dev/null && jq -e . "$tmp_json" >/dev/null 2>&1; then
        mv -f "$tmp_json" /etc/V2bX/config.json
        echo -e "\n ${green}✔ 成功生成包含 ${node_count} 个节点的标准化配置 (/etc/V2bX/config.json)${plain}"
    else
        rm -f "$tmp_json"
        echo -e "\n ${red}✖ 生成配置校验失败，请检查系统 jq 组件是否正常！${plain}"
        return 1
    fi

    if [ "$cf_tunnel_running" = true ]; then
        echo -e "\n ${yellow}💡 Cloudflare Tunnel 联动注意：${plain}"
        echo -e "   节点已生成自签证书并以 ${green}file${plain} 模式挂载。请确保 ${cyan}/etc/cloudflared/*.yml${plain} 中已配置："
        echo -e "   ${bold}originRequest:${plain}"
        echo -e "   ${bold}  noTLSVerify: true${plain}"
    fi

    restart_v2bx_service
}

main_create_all
