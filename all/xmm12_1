#!/usr/bin/env bash

# 麦卖云 V2bX 独立节点增量追加引擎 (all/xmm12_1 - 由 xmm12 调用或独立运行)
sh_ver="1.0.0-Pro"

red='\033[31m'; green='\033[32m'; yellow='\033[33m'
magenta='\033[35m'; cyan='\033[36m'; bold='\033[1m'; plain='\033[0m'
dim='\033[2m'

[[ $EUID -ne 0 ]] && echo -e "${red}错误：${plain}必须使用 root 用户运行此脚本！\n" && exit 1

mkdir -p /etc/V2bX /etc/V2bX/nodes /var/log/V2bX
saved_file="/etc/V2bX/.saved_creds"
config_file="/etc/V2bX/config.json"

is_systemd() {
    command -v systemctl &>/dev/null && [[ -d /run/systemd/system ]]
}

# ════════════════════ 依赖组件安全补齐 ════════════════════
ensure_tools() {
    local need=0
    for c in jq openssl curl python3; do
        command -v "$c" &>/dev/null || need=1
    done
    if [[ $need -eq 1 ]]; then
        echo -e " ${yellow}正在自动补齐核心运行组件 (jq / openssl / curl / python3)...${plain}"
        if command -v apt-get &>/dev/null; then
            DEBIAN_FRONTEND=noninteractive apt-get update -y -q >/dev/null 2>&1
            DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends jq openssl curl python3 >/dev/null 2>&1
        elif command -v yum &>/dev/null; then
            yum install -y jq openssl curl python3 >/dev/null 2>&1
        elif command -v apk &>/dev/null; then
            apk update >/dev/null 2>&1
            apk add --no-cache jq openssl curl python3 bash coreutils procps >/dev/null 2>&1
        fi
    fi
}
ensure_tools

# ════════════════════ 本地有效证书嗅探器 ════════════════════
find_local_valid_cert() {
    local target_domain="$1"
    [[ -z "$target_domain" || "$target_domain" == "-" ]] && return 1
    python3 - "$target_domain" <<'PYEOF'
import os, re, subprocess, sys

td = sys.argv[1].strip().lower()
wildcard = "*." + td.split(".", 1)[1] if "." in td else ""
search_dirs = ["/etc/V2bX", "/etc/V2bX/cert", "/etc/V2bX/certs", "/root/.acme.sh"]
scanned = set()
exact_match = None
wild_match = None

for base_dir in search_dirs:
    if not os.path.isdir(base_dir):
        continue
    for root, _, files in os.walk(base_dir):
        for fn in files:
            if not fn.lower().endswith((".crt", ".pem", ".cer")):
                continue
            if "ca.cer" in fn.lower() or ("chain" in fn.lower() and "fullchain" not in fn.lower()):
                continue
            c_path = os.path.join(root, fn)
            if c_path in scanned:
                continue
            scanned.add(c_path)

            chk = subprocess.run(
                ["openssl", "x509", "-in", c_path, "-noout", "-checkend", "86400", "-ext", "subjectAltName", "-subject"],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True
            )
            if chk.returncode != 0:
                continue

            stem = os.path.splitext(fn)[0].replace("_ecc", "").replace("fullchain", "")
            k_candidates = [
                os.path.splitext(c_path)[0] + ".key",
                os.path.join(root, stem + ".key") if stem else "",
                os.path.join(root, os.path.basename(root).replace("_ecc", "") + ".key"),
                os.path.join(root, "privkey.pem"),
                os.path.join(root, "private.key"),
            ]
            k_path = next((kp for kp in k_candidates if kp and os.path.isfile(kp) and os.path.getsize(kp) > 0), "")
            if not k_path:
                for f2 in files:
                    if f2.lower().endswith(".key"):
                        k_path = os.path.join(root, f2)
                        break
            if not k_path:
                continue

            domains = [d.lower() for d in re.findall(r'DNS:([^\s,]+)', chk.stdout)]
            cn_m = re.search(r'CN\s*=\s*([^\s,/]+)', chk.stdout)
            if cn_m:
                domains.append(cn_m.group(1).lower())

            if td in domains and not exact_match:
                exact_match = (c_path, k_path)
            elif wildcard and wildcard in domains and not wild_match:
                wild_match = (c_path, k_path)

res = exact_match or wild_match
if res:
    print(f"{res[0]}|{res[1]}")
PYEOF
}

# ════════════════════ UI 组件库 ════════════════════
ui_line() { echo -e "${dim}────────────────────────────────────────────────────────${plain}"; }
ui_section() { echo -e "\n${cyan}${bold}▌ $1${plain}"; ui_line; }
ui_step() { echo -e "\n${magenta}${bold}┌── [步骤 $1] $2${plain}"; }

detect_multi_active() {
    shopt -s nullglob
    local split_files=(/etc/V2bX/nodes/port_*.json /etc/V2bX/nodes/node_*.json)
    shopt -u nullglob
    local active_cnt=0
    for f in "${split_files[@]}"; do
        local inst; inst=$(basename "$f" .json)
        if is_systemd && systemctl is-active --quiet "v2bx@${inst}.service" 2>/dev/null; then
            ((active_cnt++))
        elif pgrep -f "/etc/V2bX/nodes/${inst}.json" >/dev/null 2>&1; then
            ((active_cnt++))
        fi
    done

    if [[ $active_cnt -gt 0 ]] || [[ -f /etc/V2bX/nodes/.multi_enabled && ${#split_files[@]} -gt 0 ]]; then
        return 0
    fi
    return 1
}

ui_banner() {
    printf '\033[H\033[2J'
    echo -e "${cyan}${bold}╔══════════════════════════════════════════════════════╗${plain}"
    echo -e "${cyan}${bold}║         麦卖云 V2bX 节点增量追加向导 (xmm12_1)       ║${plain}"
    echo -e "${cyan}${bold}║     全内核协议矩阵 • 证书自动复用 • 按端口进程隔离   ║${plain}"
    echo -e "${cyan}${bold}╚══════════════════════════════════════════════════════╝${plain}"
    local node_cnt=0
    [[ -f "$config_file" ]] && node_cnt=$(jq '(.Nodes // []) | length' "$config_file" 2>/dev/null || echo 0)
    local mode_tag="${green}单进程${plain}"
    detect_multi_active && mode_tag="${magenta}多进程隔离${plain}"
    echo -e " ${dim}版本: v${sh_ver}  |  当前模式: ${mode_tag}  |  已挂载节点: ${green}${node_cnt}${plain}"
    ui_line
}

# ════════════════════ 按端口隔离编译与服务重载引擎 ════════════════════
multi_split_configs() {
    if [[ ! -f "$config_file" ]]; then return 1; fi
    mkdir -p /etc/V2bX/nodes /var/log/V2bX
    rm -f /etc/V2bX/nodes/node_*.json /etc/V2bX/nodes/port_*.json

    echo -e " ${cyan}正在查询面板真实端口、匹配本机证书并按端口合并拆分配置...${plain}"
    python3 - <<'PYEOF'
import json, os, re, subprocess, urllib.request, urllib.parse, ssl, sys

master_path = "/etc/V2bX/config.json"
nodes_dir = "/etc/V2bX/nodes"

raw = open(master_path, "r", encoding="utf-8").read()
try:
    cfg = json.loads(raw)
except Exception:
    cfg = json.loads(re.sub(r'(?<!:)//.*', '', raw))

nodes = cfg.get("Nodes", [])
if not nodes:
    sys.exit(1)

cert_inventory = []
search_dirs = ["/etc/V2bX", "/etc/V2bX/cert", "/etc/V2bX/certs", "/root/.acme.sh"]
scanned_certs = set()

for base_dir in search_dirs:
    if not os.path.isdir(base_dir):
        continue
    for root, _, files in os.walk(base_dir):
        for fn in files:
            if not fn.lower().endswith((".crt", ".pem", ".cer")):
                continue
            if "ca.cer" in fn.lower() or ("chain" in fn.lower() and "fullchain" not in fn.lower()):
                continue
            c_path = os.path.join(root, fn)
            if c_path in scanned_certs:
                continue
            scanned_certs.add(c_path)

            chk = subprocess.run(
                ["openssl", "x509", "-in", c_path, "-noout", "-checkend", "86400", "-ext", "subjectAltName", "-subject"],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True
            )
            if chk.returncode != 0:
                continue

            stem = os.path.splitext(fn)[0].replace("_ecc", "").replace("fullchain", "")
            k_candidates = [
                os.path.splitext(c_path)[0] + ".key",
                os.path.join(root, stem + ".key") if stem else "",
                os.path.join(root, os.path.basename(root).replace("_ecc", "") + ".key"),
                os.path.join(root, "privkey.pem"),
                os.path.join(root, "private.key"),
            ]
            k_path = next((kp for kp in k_candidates if kp and os.path.isfile(kp) and os.path.getsize(kp) > 0), "")
            if not k_path:
                for f2 in files:
                    if f2.lower().endswith(".key"):
                        k_path = os.path.join(root, f2)
                        break
            if not k_path:
                continue

            domains = set(re.findall(r'DNS:([^\s,]+)', chk.stdout))
            cn_m = re.search(r'CN\s*=\s*([^\s,/]+)', chk.stdout)
            if cn_m:
                domains.add(cn_m.group(1))
            if domains:
                cert_inventory.append((domains, c_path, k_path))

def find_matching_cert(target_domain):
    if not target_domain:
        return None
    td = target_domain.strip().lower()
    for domains, cp, kp in cert_inventory:
        if td in [d.lower() for d in domains]:
            return (cp, kp)
    if "." in td:
        wildcard = "*." + td.split(".", 1)[1]
        for domains, cp, kp in cert_inventory:
            if wildcard in [d.lower() for d in domains]:
                return (cp, kp)
    return None

ctx = ssl.create_default_context()
ctx.check_hostname = False
ctx.verify_mode = ssl.CERT_NONE

def fetch_node_remote_meta(node):
    api_host = str(node.get("ApiHost", "")).rstrip("/")
    api_key = str(node.get("ApiKey", ""))
    nid = str(node.get("NodeID", ""))
    ntype = str(node.get("NodeType", "")).lower()
    if not (api_host and api_key and nid and ntype):
        return None, ""
    qs = urllib.parse.urlencode({"node_id": nid, "node_type": ntype, "token": api_key})
    url = f"{api_host}/api/v1/server/UniProxy/config?{qs}"
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "V2bX/1.0"})
        with urllib.request.urlopen(req, timeout=6, context=ctx) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            port = data.get("server_port")
            host = data.get("host") or data.get("server_name") or ""
            return (int(port) if port else None), str(host)
    except Exception:
        return None, ""

port_groups = {}
fallback_groups = {}

for node in nodes:
    nid = node.get("NodeID")
    ntype = node.get("NodeType", "unknown")
    port, remote_host = fetch_node_remote_meta(node)

    cert_cfg = node.get("CertConfig") or {}
    cmode = str(cert_cfg.get("CertMode", "")).lower()
    cdomain = str(cert_cfg.get("CertDomain", "")).strip() or remote_host

    if cmode in ("dns", "http", "") and cdomain:
        matched = find_matching_cert(cdomain)
        if matched:
            cert_cfg["CertMode"] = "file"
            cert_cfg["CertFile"] = matched[0]
            cert_cfg["KeyFile"] = matched[1]
            node["CertConfig"] = cert_cfg
            print(f"   ├─ [证书复用] NodeID {nid} ({cdomain}) 自动切换为 file 模式 -> {matched[0]}")

    if port:
        port_groups.setdefault(port, []).append(node)
    else:
        fallback_groups[f"node_{nid}_{ntype}"] = [node]

def write_instance_file(inst_name, group_nodes):
    needed_cores = {str(n.get("Core", "xray")).lower() for n in group_nodes}
    matched_cores = []
    for c in cfg.get("Cores", []):
        ctype = str(c.get("Type", "")).lower()
        if ctype in needed_cores:
            c_copy = json.loads(json.dumps(c))
            if ctype == "xray":
                c_copy.setdefault("Log", {})
                c_copy["Log"]["ErrorPath"] = f"/var/log/V2bX/error_{inst_name}.log"
                if c_copy["Log"].get("AccessPath", "") != "none":
                    c_copy["Log"]["AccessPath"] = f"/var/log/V2bX/access_{inst_name}.log"
            matched_cores.append(c_copy)

    sub_cfg = {
        "Log": {"Level": cfg.get("Log", {}).get("Level", "error"), "Output": ""},
        "Runtime": cfg.get("Runtime", {"GCPercent": 50, "MemoryLimitPercent": 70}),
        "Cores": matched_cores,
        "Nodes": group_nodes
    }
    out_file = os.path.join(nodes_dir, f"{inst_name}.json")
    with open(out_file, "w", encoding="utf-8") as f:
        json.dump(sub_cfg, f, indent=2, ensure_ascii=False)
    nids = [str(n.get("NodeID")) for n in group_nodes]
    print(f"   ├─ 已生成独立配置: {out_file} (包含 NodeID: {', '.join(nids)})")

for p, g_nodes in sorted(port_groups.items()):
    write_instance_file(f"port_{p}", g_nodes)

for fb_name, g_nodes in fallback_groups.items():
    write_instance_file(fb_name, g_nodes)
PYEOF
    [[ $? -ne 0 ]] && return 1
    return 0
}

sync_multi_process_instances() {
    multi_split_configs || return 1

    local mem_env="" cpu_quota="" nice_val="" mem_high="" mem_max=""
    if [[ -f /etc/systemd/system/V2bX.service ]]; then
        mem_env=$(grep '^Environment="GOMEMLIMIT=' /etc/systemd/system/V2bX.service | head -n1)
        cpu_quota=$(grep '^CPUQuota=' /etc/systemd/system/V2bX.service | head -n1)
        nice_val=$(grep '^Nice=' /etc/systemd/system/V2bX.service | head -n1)
        mem_high=$(grep '^MemoryHigh=' /etc/systemd/system/V2bX.service | head -n1)
        mem_max=$(grep '^MemoryMax=' /etc/systemd/system/V2bX.service | head -n1)
    elif [[ -f /etc/init.d/V2bX ]]; then
        mem_env=$(grep 'GOMEMLIMIT=' /etc/init.d/V2bX | head -n1 | sed -n 's/.*\(GOMEMLIMIT=[^" ]*\).*/\1/p')
    fi

    if is_systemd; then
        systemctl stop V2bX.service 2>/dev/null
        systemctl disable V2bX.service >/dev/null 2>&1
        systemctl mask V2bX.service >/dev/null 2>&1

        for old_srv in /etc/systemd/system/multi-user.target.wants/v2bx@*.service; do
            [[ -e "$old_srv" ]] || continue
            local srv_base; srv_base=$(basename "$old_srv")
            systemctl stop "$srv_base" 2>/dev/null
            systemctl disable "$srv_base" >/dev/null 2>&1
        done

        cat << EOF > /etc/systemd/system/v2bx@.service
[Unit]
Description=V2bX Isolated Instance (%i)
After=network-online.target nss-lookup.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
ExecStart=/usr/local/V2bX/V2bX server -c /etc/V2bX/nodes/%i.json -w
Restart=always
RestartSec=5
User=root
LimitNOFILE=1048576
LimitNPROC=51200
Environment="XRAY_DNS_PATH=/etc/V2bX/dns.json"
Environment="SING_DNS_PATH=/etc/V2bX/sing_dns.json"
EOF
        if [[ -n "$mem_env" ]]; then
            {
                echo "$mem_env"
                echo 'Environment="GOGC=50"'
                [[ -n "$cpu_quota" ]] && echo "$cpu_quota"
                [[ -n "$nice_val" ]] && echo "$nice_val"
                [[ -n "$mem_high" ]] && echo "$mem_high"
                [[ -n "$mem_max" ]] && echo "$mem_max"
                echo "OOMScoreAdjust=-100"
            } >> /etc/systemd/system/v2bx@.service
        fi
        echo -e "[Install]\nWantedBy=multi-user.target" >> /etc/systemd/system/v2bx@.service
        systemctl daemon-reload

        shopt -s nullglob
        local split_files=(/etc/V2bX/nodes/port_*.json /etc/V2bX/nodes/node_*.json)
        shopt -u nullglob

        for nf in "${split_files[@]}"; do
            local inst; inst=$(basename "$nf" .json)
            systemctl reset-failed "v2bx@${inst}.service" 2>/dev/null
            systemctl enable "v2bx@${inst}.service" >/dev/null 2>&1
            systemctl restart "v2bx@${inst}.service"
            if systemctl is-active --quiet "v2bx@${inst}.service"; then
                echo -e " ${green}✔ 已同步重启隔离实例: v2bx@${inst}.service${plain}"
            else
                echo -e " ${red}✖ 实例 v2bx@${inst}.service 启动异常，请检查证书或面板参数！${plain}"
            fi
        done

    elif command -v rc-service &>/dev/null; then
        rc-service V2bX stop 2>/dev/null
        rc-update del V2bX default >/dev/null 2>&1
        [[ -f /etc/init.d/V2bX ]] && chmod -x /etc/init.d/V2bX 2>/dev/null

        for old_rc in /etc/init.d/V2bX.node_* /etc/init.d/v2bx.node_* /etc/init.d/v2bx.port_*; do
            [[ -f "$old_rc" ]] || continue
            local rc_base; rc_base=$(basename "$old_rc")
            rc-service "$rc_base" stop 2>/dev/null
            rc-update del "$rc_base" default >/dev/null 2>&1
            rm -f "$old_rc"
        done

        shopt -s nullglob
        local split_files=(/etc/V2bX/nodes/port_*.json /etc/V2bX/nodes/node_*.json)
        shopt -u nullglob

        for nf in "${split_files[@]}"; do
            local inst rc_file; inst=$(basename "$nf" .json); rc_file="/etc/init.d/v2bx.${inst}"
            local env_line="XRAY_DNS_PATH=/etc/V2bX/dns.json SING_DNS_PATH=/etc/V2bX/sing_dns.json"
            [[ -n "$mem_env" ]] && env_line="${env_line} ${mem_env} GOGC=50"
            cat << EOF > "$rc_file"
#!/sbin/openrc-run
description="V2bX Isolated Instance (${inst})"
command="/usr/local/V2bX/V2bX"
command_args="server -c /etc/V2bX/nodes/${inst}.json -w"
command_background=true
pidfile="/run/v2bx.${inst}.pid"
output_log="/var/log/V2bX/out_${inst}.log"
error_log="/var/log/V2bX/err_${inst}.log"
command_env="${env_line}"
respawn_delay=5
respawn_max=3

depend() {
    need net
}
EOF
            chmod +x "$rc_file"
            rc-update add "v2bx.${inst}" default >/dev/null 2>&1
            rc-service "v2bx.${inst}" restart 2>/dev/null
            echo -e " ${green}✔ 已同步重启 OpenRC 隔离实例: v2bx.${inst}${plain}"
        done
    fi

    touch /etc/V2bX/nodes/.multi_enabled
}

choose_and_apply_run_mode() {
    echo ""
    ui_section "选择 V2bX 进程运行架构"
    echo -e "  ${cyan}[1] 单进程标准模式${plain}   ${dim}• 所有节点共用 1 个 V2bX 进程，内存占用最低${plain}"
    echo -e "  ${cyan}[2] 多进程隔离模式${plain}   ${dim}• 按监听端口独立隔离，单节点异常绝不连坐其他端口${plain}"
    local default_mode="1"
    detect_multi_active && default_mode="2"

    echo -ne " ${bold}▸ 请选择运行架构${plain} [1-2, 默认 ${default_mode}]: "
    read -r run_mode_sel < /dev/tty
    [[ -z "$run_mode_sel" ]] && run_mode_sel="$default_mode"

    if [[ "$run_mode_sel" == "2" ]]; then
        echo -e " ${cyan}正在按端口拆分隔离实例并启动守护服务...${plain}"
        sync_multi_process_instances
        return
    fi

    rm -f /etc/V2bX/nodes/.multi_enabled /etc/V2bX/nodes/port_*.json /etc/V2bX/nodes/node_*.json 2>/dev/null
    if is_systemd; then
        for old_srv in /etc/systemd/system/multi-user.target.wants/v2bx@*.service; do
            [[ -e "$old_srv" ]] || continue
            local srv_base; srv_base=$(basename "$old_srv")
            systemctl stop "$srv_base" 2>/dev/null
            systemctl disable "$srv_base" >/dev/null 2>&1
        done
        rm -f /etc/systemd/system/v2bx@.service
        systemctl daemon-reload
        systemctl unmask V2bX.service >/dev/null 2>&1
        systemctl enable V2bX.service >/dev/null 2>&1
        systemctl reset-failed V2bX.service 2>/dev/null
        if systemctl restart V2bX 2>/dev/null; then
            echo -e " ${green}✔ Systemd: 已切换为【单进程标准模式】并成功启动！${plain}"
        else
            echo -e " ${yellow}⚠ Systemd: 配置已落盘为单进程模式，请使用主菜单选项 1 或 4 启动服务。${plain}"
        fi
    elif command -v rc-service &>/dev/null; then
        for old_rc in /etc/init.d/V2bX.node_* /etc/init.d/v2bx.node_* /etc/init.d/v2bx.port_*; do
            [[ -f "$old_rc" ]] || continue
            local rc_base; rc_base=$(basename "$old_rc")
            rc-service "$rc_base" stop 2>/dev/null
            rc-update del "$rc_base" default >/dev/null 2>&1
            rm -f "$old_rc"
        done
        [[ -f /etc/init.d/V2bX ]] && chmod +x /etc/init.d/V2bX 2>/dev/null
        rc-update add V2bX default >/dev/null 2>&1
        if rc-service V2bX restart 2>/dev/null; then
            echo -e " ${green}✔ OpenRC: 已切换为【单进程标准模式】并成功启动！${plain}"
        else
            echo -e " ${yellow}⚠ OpenRC: 配置已落盘为单进程模式，待启动后生效。${plain}"
        fi
    fi
}

# ════════════════════ 附属配置文件初始化 ════════════════════
init_aux_files() {
    if [[ ! -f /etc/V2bX/sing_origin.json ]]; then
        echo '{ "outbounds": [ { "type": "direct", "tag": "direct" } ] }' > /etc/V2bX/sing_origin.json
    fi
    if [[ ! -f /etc/V2bX/dns.json ]]; then
        cat << 'EOF' > /etc/V2bX/dns.json
{
  "servers": [
    "tcp://8.8.8.8:53",
    "tcp://1.1.1.1:53",
    "8.8.8.8",
    "1.1.1.1"
  ]
}
EOF
    fi
    if [[ ! -f /etc/V2bX/sing_dns.json ]]; then
        cat << 'EOF' > /etc/V2bX/sing_dns.json
{
  "servers": [
    { "address": "8.8.8.8" },
    { "address": "1.1.1.1" }
  ]
}
EOF
    fi
    if [[ ! -f /etc/V2bX/custom_outbound.json ]]; then
        cat << 'EOF' > /etc/V2bX/custom_outbound.json
[
  { "tag": "IPv4_out", "protocol": "freedom", "streamSettings": { "sockopt": { "domainStrategy": "UseIP" } } },
  { "tag": "block", "protocol": "blackhole" }
]
EOF
    fi
    if [[ ! -f /etc/V2bX/route.json ]]; then
        cat << 'EOF' > /etc/V2bX/route.json
{
  "domainStrategy": "AsIs",
  "rules": [
    {
      "type": "field",
      "outboundTag": "block",
      "ip": [
        "0.0.0.0/8", "10.0.0.0/8", "100.64.0.0/10", "127.0.0.0/8",
        "169.254.0.0/16", "172.16.0.0/12", "192.0.0.0/24", "192.0.2.0/24",
        "192.168.0.0/16", "198.18.0.0/15", "198.51.100.0/24", "203.0.113.0/24",
        "::1/128", "fc00::/7", "fe80::/10"
      ]
    },
    { "type": "field", "outboundTag": "block", "protocol": [ "bittorrent" ] }
  ]
}
EOF
    fi
    if [[ ! -f /etc/V2bX/hy2config.yaml ]]; then
        cat << 'EOF' > /etc/V2bX/hy2config.yaml
quic:
  initStreamReceiveWindow: 16777216
  maxStreamReceiveWindow: 16777216
  initConnReceiveWindow: 33554432
  maxConnReceiveWindow: 33554432
  maxIdleTimeout: 90s
  maxIncomingStreams: 4096
  disablePathMTUDiscovery: false
ignoreClientBandwidth: false
disableUDP: false
udpIdleTimeout: 120s
resolver:
  type: system
masquerade:
  type: 404
EOF
    fi
}

load_or_ask_creds() {
    local default_host="https://example.com"
    local default_key=""

    if [[ -f "$saved_file" ]]; then
        source "$saved_file" 2>/dev/null
        default_host=${saved_host:-"https://example.com"}
        default_key=${saved_key:-""}
    elif [[ -f "$config_file" ]] && jq -e . "$config_file" >/dev/null 2>&1; then
        local extracted_host extracted_key
        extracted_host=$(jq -r '.Nodes[0].ApiHost // empty' "$config_file" 2>/dev/null)
        extracted_key=$(jq -r '.Nodes[0].ApiKey // empty' "$config_file" 2>/dev/null)
        [[ -n "$extracted_host" ]] && default_host="$extracted_host"
        [[ -n "$extracted_key" ]] && default_key="$extracted_key"
    fi

    echo -e "${yellow}💡 面板对接凭证读取${plain}"
    echo -ne " ${bold}▸ 机场面板网址${plain} ${dim}[回车默认: ${default_host}]${plain}: "
    read -r input_host < /dev/tty
    api_host=${input_host:-"$default_host"}
    [[ ! "$api_host" =~ ^https?:// ]] && api_host="https://${api_host}"
    api_host="${api_host%/}"

    if [[ -n "$default_key" ]]; then
        echo -ne " ${bold}▸ 面板 API Key${plain} ${dim}[回车使用现有 Key: ${default_key:0:4}****]${plain}: "
        read -r input_key < /dev/tty
        api_key=${input_key:-"$default_key"}
    else
        api_key=""
        while [[ -z "$api_key" ]]; do
            echo -ne " ${bold}▸ 请输入面板对接 API Key${plain}: "
            read -r api_key < /dev/tty
        done
    fi

    echo "saved_host=\"$api_host\"" > "$saved_file"
    echo "saved_key=\"$api_key\"" >> "$saved_file"
    chmod 600 "$saved_file"
}

build_xray_core_json() {
    cat << 'EOF'
{
  "Type": "xray",
  "Log": { "Level": "error", "AccessPath": "", "ErrorPath": "/etc/V2bX/error.log", "MaxSize": 100, "MaxBackups": 0, "MaxDays": 90, "Compress": true },
  "AssetPath": "/etc/V2bX/",
  "DnsConfigPath": "/etc/V2bX/dns.json",
  "OutboundConfigPath": "/etc/V2bX/custom_outbound.json",
  "RouteConfigPath": "/etc/V2bX/route.json",
  "XrayConnectionConfig": { "handshake": 4, "connIdle": 120, "uplinkOnly": 2, "downlinkOnly": 4, "bufferSize": 64 }
}
EOF
}

build_sing_core_json() {
    cat << 'EOF'
{
  "Type": "sing",
  "Log": { "Level": "error", "Timestamp": true },
  "NTP": { "Enable": false, "Server": "time.apple.com", "ServerPort": 0 },
  "OriginalPath": "/etc/V2bX/sing_origin.json"
}
EOF
}

build_hy2_core_json() {
    cat << 'EOF'
{ "Type": "hysteria2", "Log": { "Level": "error" } }
EOF
}

# ════════════════════ 采集单个新节点配置 ════════════════════
collect_single_node() {
    local idx="$1"
    replace_existing_id=""
    ui_section "追加配置第 ${idx} 个后端节点"

    ui_step "1/4" "选择代理核心与传输协议"
    echo -e "  ${cyan}[1]${plain} Xray      ${dim}(首选: Vless / Vmess / Reality / XHTTP / AnyTLS / Hy2 / CDN)${plain}"
    echo -e "  ${cyan}[2]${plain} Sing-box  ${dim}(全能: Shadowsocks / Trojan / Tuic / AnyTLS / Hy1&2 / Vless / Vmess)${plain}"
    echo -e "  ${cyan}[3]${plain} Hysteria2 ${dim}(官方专属高性能内核)${plain}"
    
    local core_num=""
    while [[ ! "$core_num" =~ ^[1-3]$ ]]; do
        echo -ne " ${bold}▸ 请选择内核引擎${plain} [1-3, 默认 1]: "
        read -r core_num < /dev/tty
        [[ -z "$core_num" ]] && core_num=1
    done

    case "$core_num" in 
        1) core_type="xray"; has_xray=true ;; 
        2) core_type="sing"; has_sing=true ;; 
        3) core_type="hysteria2"; has_hysteria2=true ;; 
    esac

    local protocol_num=""
    if [[ "$core_type" == "hysteria2" ]]; then
        node_type="hysteria2"
        echo -e "  ${green}✔ Hysteria2 引擎自动锁定协议: hysteria2${plain}"
    elif [[ "$core_type" == "xray" ]]; then
        echo -e "\n  ${cyan}[1]${plain} Vless ${dim}(Reality/XHTTP/WS)${plain}  ${cyan}[2]${plain} Vmess  ${cyan}[3]${plain} Trojan  ${cyan}[4]${plain} Shadowsocks  ${cyan}[5]${plain} AnyTLS  ${cyan}[6]${plain} Hysteria2"
        while [[ ! "$protocol_num" =~ ^[1-6]$ ]]; do
            echo -ne " ${bold}▸ 请选择 Xray 协议${plain} [1-6, 默认 1-Vless]: "
            read -r protocol_num < /dev/tty
            [[ -z "$protocol_num" ]] && protocol_num=1
        done
        case "$protocol_num" in
            1) node_type="vless" ;; 2) node_type="vmess" ;; 3) node_type="trojan" ;;
            4) node_type="shadowsocks" ;; 5) node_type="anytls" ;; 6) node_type="hysteria2" ;;
        esac
    elif [[ "$core_type" == "sing" ]]; then
        echo -e "\n  ${cyan}[1]${plain} Shadowsocks  ${cyan}[2]${plain} Trojan  ${cyan}[3]${plain} Tuic  ${cyan}[4]${plain} AnyTLS"
        echo -e "  ${cyan}[5]${plain} Hysteria     ${cyan}[6]${plain} Hysteria2  ${cyan}[7]${plain} Vless  ${cyan}[8]${plain} Vmess"
        while [[ ! "$protocol_num" =~ ^[1-8]$ ]]; do
            echo -ne " ${bold}▸ 请选择 Sing-box 协议${plain} [1-8, 默认 1-SS]: "
            read -r protocol_num < /dev/tty
            [[ -z "$protocol_num" ]] && protocol_num=1
        done
        case "$protocol_num" in
            1) node_type="shadowsocks" ;; 2) node_type="trojan" ;; 3) node_type="tuic" ;; 4) node_type="anytls" ;;
            5) node_type="hysteria" ;; 6) node_type="hysteria2" ;; 7) node_type="vless" ;; 8) node_type="vmess" ;;
        esac
    fi

    ui_step "2/4" "基础参数与监听网络"
    while true; do
        node_id=""
        while [[ ! "$node_id" =~ ^[0-9]+$ ]]; do
            echo -ne " ${bold}▸ 请输入面板中的 Node ID${plain} (纯数字): "
            read -r node_id < /dev/tty
        done

        if jq -e --argjson nid "$node_id" '(.Nodes // [])[] | select(.NodeID == $nid)' "$config_file" >/dev/null 2>&1; then
            echo -e "  ${yellow}⚠ 警告：NodeID ${node_id} 已存在于当前配置中！${plain}"
            echo -ne "  ${bold}▸ 是否覆盖替换该旧节点？${plain} [y: 覆盖替换 / N: 重新输入其他 ID]: "
            read -r dup_yn < /dev/tty
            if [[ "$dup_yn" =~ ^[Yy]$ ]]; then
                replace_existing_id="$node_id"
                break
            fi
        else
            break
        fi
    done

    local listen_ip="0.0.0.0"
    [[ "$core_type" == "hysteria2" ]] && listen_ip=""
    echo -ne " ${bold}▸ 监听 IP (ListenIP)${plain} ${dim}[回车默认$([[ "$core_type" == "hysteria2" ]] && echo "双栈全监听" || echo " 0.0.0.0，双栈填 ::")]${plain}: "
    read -r input_listen < /dev/tty
    [[ -n "$input_listen" ]] && listen_ip="$input_listen"

    ui_step "3/4" "TLS 安全与证书模式"
    local run_tls_flow=false
    local reality_yn="n" tls_yn="n" cert_mode_num="" cert_mode="none" cert_domain="" cf_token=""
    local cert_file="" key_file=""

    if [[ "$node_type" == "vless" ]]; then
        echo -ne " ${bold}▸ 该 Vless 节点是否为 Reality 节点？${plain} [Y/n, 默认 Y]: "
        read -r reality_yn < /dev/tty
        [[ -z "$reality_yn" ]] && reality_yn="y"
        if [[ "$reality_yn" =~ ^[Yy]$ ]]; then
            cert_mode="none"
            echo -e "  ${green}✔ Reality 节点无需证书 (自动设为 none)${plain}"
        else
            run_tls_flow=true
        fi
    elif [[ "$node_type" =~ ^(hysteria2|tuic|hysteria|trojan|anytls)$ ]]; then
        run_tls_flow=true
        echo -e "  ${yellow}ℹ 协议 [${node_type}] 强制要求配置 TLS 证书。${plain}"
    else
        echo -ne " ${bold}▸ 是否开启 TLS 证书保护？${plain} [y/N, 默认 N]: "
        read -r tls_yn < /dev/tty
        [[ "$tls_yn" =~ ^[Yy]$ ]] && run_tls_flow=true
    fi

    if [ "$run_tls_flow" = true ]; then
        echo -e "  ${cyan}[1]${plain} HTTP 模式  ${dim}(内置自动申请，需域名已解析到本机且80空闲)${plain}"
        echo -e "  ${cyan}[2]${plain} DNS 模式   ${dim}(内置 Cloudflare API Token 自动验证)${plain}"
        echo -e "  ${cyan}[3]${plain} File 模式  ${dim}(推荐：挂载外置 ACME 申请的证书或已有证书)${plain}"
        echo -e "  ${cyan}[4]${plain} 本地自签   ${dim}(CF隧道推荐：自动生成自签证书并以 File 模式挂载)${plain}"
        
        while [[ ! "$cert_mode_num" =~ ^[1-4]$ ]]; do
            echo -ne " ${bold}▸ 选择证书模式${plain} [1-4, 默认 1]: "
            read -r cert_mode_num < /dev/tty
            [[ -z "$cert_mode_num" ]] && cert_mode_num=1
        done

        case "$cert_mode_num" in
            1)
                while [[ -z "$cert_domain" ]]; do
                    echo -ne " ${bold}▸ 请输入绑定域名 (如 node.example.com)${plain}: "
                    read -r cert_domain < /dev/tty
                done
                local existing_pair; existing_pair=$(find_local_valid_cert "$cert_domain")
                if [[ -n "$existing_pair" ]]; then
                    cert_mode="file"
                    cert_file="${existing_pair%%|*}"
                    key_file="${existing_pair##*|}"
                    echo -e "  ${green}✔ 检测到本机已存在有效证书 (${cert_file})，自动切换为【file 模式】复用！${plain}"
                else
                    cert_mode="http"; cert_file="/etc/V2bX/${cert_domain}.cert.pem"; key_file="/etc/V2bX/${cert_domain}.key.pem"
                fi
                ;;
            2)
                while [[ -z "$cert_domain" ]]; do
                    echo -ne " ${bold}▸ 请输入绑定域名 (如 node.example.com)${plain}: "
                    read -r cert_domain < /dev/tty
                done
                local existing_pair; existing_pair=$(find_local_valid_cert "$cert_domain")
                if [[ -n "$existing_pair" ]]; then
                    cert_mode="file"
                    cert_file="${existing_pair%%|*}"
                    key_file="${existing_pair##*|}"
                    echo -e "  ${green}✔ 检测到本机已存在有效证书 (${cert_file})，自动切换为【file 模式】复用（免填 Token）！${plain}"
                else
                    cert_mode="dns"
                    while [[ -z "$cf_token" ]]; do
                        echo -ne " ${bold}▸ 请输入 Cloudflare API Token${plain}: "
                        read -r cf_token < /dev/tty
                    done
                    cert_file="/etc/V2bX/${cert_domain}.cert.pem"; key_file="/etc/V2bX/${cert_domain}.key.pem"
                fi
                ;;
            3)
                cert_mode="file"
                echo -ne " ${bold}▸ 请输入节点域名${plain} ${dim}[如已通过外置ACME申请，直接填该域名]${plain}: "
                read -r cert_domain < /dev/tty
                local existing_pair; existing_pair=$(find_local_valid_cert "$cert_domain")
                local def_c="/etc/V2bX/fullchain.cer"
                local def_k="/etc/V2bX/cert.key"
                if [[ -n "$existing_pair" ]]; then
                    def_c="${existing_pair%%|*}"
                    def_k="${existing_pair##*|}"
                fi
                echo -ne " ${bold}▸ 公钥绝对路径${plain} ${dim}[默认: ${def_c}]${plain}: "
                read -r input_cert < /dev/tty
                cert_file=${input_cert:-"$def_c"}
                echo -ne " ${bold}▸ 私钥绝对路径${plain} ${dim}[默认: ${def_k}]${plain}: "
                read -r input_key < /dev/tty
                key_file=${input_key:-"$def_k"}
                ;;
            4)
                cert_mode="file"
                echo -ne " ${bold}▸ 请输入自签域名${plain} ${dim}[默认: cf.babymonster.cc.cd]${plain}: "
                read -r input_sni < /dev/tty
                cert_domain=${input_sni:-"cf.babymonster.cc.cd"}
                cert_file="/etc/V2bX/${cert_domain}.cert.pem"
                key_file="/etc/V2bX/${cert_domain}.key.pem"
                openssl req -x509 -nodes -newkey rsa:2048 -days 3650 \
                    -keyout "$key_file" -out "$cert_file" \
                    -subj "/CN=${cert_domain}" >/dev/null 2>&1
                echo -e "  ${green}✔ 自签名证书已生成至 ${cert_file}${plain}"
                ;;
        esac
    fi

    local cert_json
    if [[ "$cert_mode" == "dns" ]]; then
        cert_json=$(jq -n --arg dom "$cert_domain" --arg cf "$cert_file" --arg kf "$key_file" --arg tok "$cf_token" \
            '{CertMode:"dns",RejectUnknownSni:false,CertDomain:$dom,CertFile:$cf,KeyFile:$kf,Email:"admin@v2bx.com",Provider:"cloudflare",DNSEnv:{CF_DNS_API_TOKEN:$tok,CLOUDFLARE_DNS_API_TOKEN:$tok}}')
    elif [[ "$cert_mode" =~ ^(http|file)$ ]]; then
        cert_json=$(jq -n --arg cm "$cert_mode" --arg dom "$cert_domain" --arg cf "$cert_file" --arg kf "$key_file" \
            '{CertMode:$cm,RejectUnknownSni:false,CertDomain:$dom,CertFile:$cf,KeyFile:$kf,Email:"admin@v2bx.com"}')
    else
        cert_json='{"CertMode":"none"}'
    fi

    ui_step "4/4" "流量控制与网络策略"
    local has_limit="false" speed_limit=0 dev_limit=0 conn_limit=0 enable_dyn="false"
    echo -ne " ${bold}▸ 是否配置本节点限速/设备锁 (LimitConfig)？${plain} [y/N, 默认 N]: "
    read -r limit_yn < /dev/tty
    if [[ "$limit_yn" =~ ^[Yy]$ ]]; then
        has_limit="true"
        echo -ne "   └─ 单用户限速 (Mbps, 0不限) [0]: "; read -r speed_limit < /dev/tty; [[ ! "$speed_limit" =~ ^[0-9]+$ ]] && speed_limit=0
        echo -ne "   └─ 单用户设备限制 (0跟随面板) [0]: "; read -r dev_limit < /dev/tty; [[ ! "$dev_limit" =~ ^[0-9]+$ ]] && dev_limit=0
        echo -ne "   └─ 单用户连接上限 (0不限) [0]: "; read -r conn_limit < /dev/tty; [[ ! "$conn_limit" =~ ^[0-9]+$ ]] && conn_limit=0
        echo -ne "   └─ 启用暴流动态压制 (60秒达1GB限速10Mbps)？[y/N]: "; read -r dyn_yn < /dev/tty
        [[ "$dyn_yn" =~ ^[Yy]$ ]] && enable_dyn="true"
    fi

    local dns_type="UseIPv4"
    if [[ "$core_type" == "xray" ]]; then
        echo -ne " ${bold}▸ Xray 出站解析策略${plain} [1:IPv4(默认) 2:IPv6 3:双栈 4:AsIs]: "
        read -r dns_opt < /dev/tty
        case "$dns_opt" in 2) dns_type="UseIPv6" ;; 3) dns_type="UseIP" ;; 4) dns_type="AsIs" ;; esac
    fi

    current_node=$(jq -n \
        --arg core "$core_type" \
        --arg host "$api_host" \
        --arg key "$api_key" \
        --argjson nid "$node_id" \
        --arg ntype "$node_type" \
        --arg lip "$listen_ip" \
        --arg dnstype "$dns_type" \
        --argjson cert "$cert_json" \
        --argjson has_lim "$has_limit" \
        --argjson spd "$speed_limit" \
        --argjson dev "$dev_limit" \
        --argjson conn "$conn_limit" \
        --argjson dyn "$enable_dyn" \
        '
        (if $core == "xray" then
          {Core:"xray",ApiHost:$host,ApiKey:$key,NodeID:$nid,NodeType:$ntype,Timeout:30,ListenIP:$lip,SendIP:"0.0.0.0",DeviceOnlineMinTraffic:200,ReportMinTraffic:0,EnableProxyProtocol:false,EnableUot:true,EnableTFO:true,DNSType:$dnstype,DisableSniffing:false,CertConfig:$cert}
        elif $core == "sing" then
          {Core:"sing",ApiHost:$host,ApiKey:$key,NodeID:$nid,NodeType:$ntype,Timeout:30,ListenIP:$lip,SendIP:"0.0.0.0",DeviceOnlineMinTraffic:200,ReportMinTraffic:0,EnableTFO:true,EnableSniff:true,SniffOverrideDestination:true,CertConfig:$cert}
        else
          {Core:"hysteria2",ApiHost:$host,ApiKey:$key,NodeID:$nid,NodeType:"hysteria2",Hysteria2ConfigPath:"/etc/V2bX/hy2config.yaml",Timeout:30,ListenIP:$lip,SendIP:"0.0.0.0",DeviceOnlineMinTraffic:200,ReportMinTraffic:0,CertConfig:$cert}
        end)
        | if $has_lim then
            . + {LimitConfig:{EnableRealtime:false,SpeedLimit:$spd,DeviceLimit:$dev,ConnLimit:$conn,EnableDynamicSpeedLimit:$dyn,DynamicSpeedLimitConfig:{Periodic:60,Traffic:1073741824,SpeedLimit:10,ExpireTime:600}}}
          else . end
        ')
}

wizard_append_node() {
    ui_banner
    init_aux_files

    if [[ ! -f "$config_file" ]] || ! jq -e . "$config_file" >/dev/null 2>&1; then
        echo -e " ${yellow}ℹ 未检测到有效的主配置，正在初始化标准配置骨架...${plain}"
        echo '{ "Log": { "Level": "error", "Output": "" }, "Runtime": { "GCPercent": 50, "MemoryLimitPercent": 70 }, "Cores": [], "Nodes": [] }' | jq . > "$config_file"
    fi

    load_or_ask_creds

    has_xray=false; has_sing=false; has_hysteria2=false
    local exist_count
    exist_count=$(jq '(.Nodes // []) | length' "$config_file" 2>/dev/null || echo 0)

    while true; do
        ((exist_count++))
        collect_single_node "$exist_count"

        local tmp_json="/tmp/v2bx_append_${RANDOM}.json"
        cp -f "$config_file" "$tmp_json"

        if [[ -n "$replace_existing_id" ]]; then
            jq --argjson rid "$replace_existing_id" 'del(.Nodes[] | select(.NodeID == $rid))' "$tmp_json" > "${tmp_json}.new" && mv -f "${tmp_json}.new" "$tmp_json"
        fi

        if [ "$has_xray" = true ] && ! jq -e '(.Cores // [])[] | select(.Type=="xray")' "$tmp_json" >/dev/null 2>&1; then
            local xc; xc=$(build_xray_core_json)
            jq --argjson c "$xc" '.Cores = ((.Cores // []) + [$c])' "$tmp_json" > "${tmp_json}.new" && mv -f "${tmp_json}.new" "$tmp_json"
        fi
        if [ "$has_sing" = true ] && ! jq -e '(.Cores // [])[] | select(.Type=="sing")' "$tmp_json" >/dev/null 2>&1; then
            local sc; sc=$(build_sing_core_json)
            jq --argjson c "$sc" '.Cores = ((.Cores // []) + [$c])' "$tmp_json" > "${tmp_json}.new" && mv -f "${tmp_json}.new" "$tmp_json"
        fi
        if [ "$has_hysteria2" = true ] && ! jq -e '(.Cores // [])[] | select(.Type=="hysteria2")' "$tmp_json" >/dev/null 2>&1; then
            local hc; hc=$(build_hy2_core_json)
            jq --argjson c "$hc" '.Cores = ((.Cores // []) + [$c])' "$tmp_json" > "${tmp_json}.new" && mv -f "${tmp_json}.new" "$tmp_json"
        fi

        jq --argjson n "$current_node" '.Nodes = ((.Nodes // []) + [$n])
          | ([.Nodes[].Core] | unique) as $active_cores
          | .Cores = [(.Cores // [])[] | select(.Type as $t | $active_cores | index($t))]' \
          "$tmp_json" > "${tmp_json}.new" 2>/dev/null
        
        if jq -e . "${tmp_json}.new" >/dev/null 2>&1; then
            mv -f "${tmp_json}.new" "$config_file"
            echo -e "\n ${green}✔ 节点 (NodeID: ${node_id} / ${node_type}) 已成功写入配置！${plain}"
        else
            echo -e "\n ${red}✖ JSON 合并致命校验失败，已安全回滚原配置！${plain}"
        fi
        rm -f "$tmp_json" "${tmp_json}.new"

        echo ""
        echo -ne " ${bold}▸ 是否继续追加下一个节点？${plain} [y/N, 默认 N]: "
        read -r cont < /dev/tty
        [[ ! "$cont" =~ ^[Yy]$ ]] && break
    done

    choose_and_apply_run_mode
}

wizard_append_node
