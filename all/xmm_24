#!/bin/sh
# 麦卖云 (Maimai Cloud) - SOCKS5 自动化调度主脚本 (工业稳定版)
# 适配: Alpine Linux (OpenRC/BusyBox) + Debian 11/12 / Ubuntu (Systemd)
# 更新地址: https://github.com/yunfeibuzai/xmm/blob/main/all/xmm_24

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
NC='\033[0m'

SCRIPT_URL="https://raw.githubusercontent.com/yunfeibuzai/xmm/main/all/xmm_24"
S5_REMOTE_URL="https://raw.githubusercontent.com/yunfeibuzai/xmm/main/all/xmm24_1"

if [ "$(id -u)" != "0" ]; then
    echo -e "${RED}错误: 必须使用 root 权限运行！${NC}"
    exit 1
fi

# ==================== 1. 包管理器与环境自动愈合 ====================
if command -v apk >/dev/null 2>&1; then
    PKG_MAN="apk"
elif command -v apt-get >/dev/null 2>&1; then
    PKG_MAN="apt"
else
    echo -e "${RED}不支持的系统，仅支持 Debian/Ubuntu/Alpine${NC}"
    exit 1
fi

# 确保 Alpine 具备基础环境并切换至 Bash
if [ -z "$BASH_VERSION" ]; then
    if [ "$PKG_MAN" = "apk" ]; then
        command -v bash >/dev/null 2>&1 || apk add --no-cache bash
    elif [ "$PKG_MAN" = "apt" ]; then
        command -v bash >/dev/null 2>&1 || { apt-get update -y && apt-get install -y bash; }
    fi
    if command -v bash >/dev/null 2>&1 && [ -f "$0" ]; then
        exec bash "$0" "$@"
    fi
fi

# ==================== 2. 服务管理与依赖补全 ====================
if command -v systemctl >/dev/null 2>&1; then
    SYS_MAN="systemd"
elif command -v rc-service >/dev/null 2>&1; then
    SYS_MAN="openrc"
elif [ -f /etc/init.d/V2bX ]; then
    SYS_MAN="sysvinit"
else
    SYS_MAN="generic"
fi

if [ "$PKG_MAN" = "apk" ]; then
    command -v curl >/dev/null 2>&1 || apk add --no-cache curl
    command -v python3 >/dev/null 2>&1 || apk add --no-cache python3
    command -v nano >/dev/null 2>&1 || apk add --no-cache nano
    command -v ss >/dev/null 2>&1 || apk add --no-cache iproute2
    [ -d /etc/ssl/certs ] || apk add --no-cache ca-certificates
    apk add --no-cache grep >/dev/null 2>&1
elif [ "$PKG_MAN" = "apt" ]; then
    export DEBIAN_FRONTEND=noninteractive
    command -v curl >/dev/null 2>&1 || { apt-get update -y && apt-get install -y curl; }
    command -v python3 >/dev/null 2>&1 || apt-get install -y python3
    command -v nano >/dev/null 2>&1 || apt-get install -y nano
    command -v ss >/dev/null 2>&1 || apt-get install -y iproute2
    [ -d /etc/ssl/certs ] || apt-get install -y ca-certificates
fi

restart_service() {
    local srv=$1
    if [ "$SYS_MAN" = "systemd" ]; then
        systemctl restart "$srv"
    elif [ "$SYS_MAN" = "openrc" ]; then
        rc-service "$srv" restart 2>/dev/null \vert{}\vert{} /etc/init.d/"$srv" restart
    elif [ -x "/etc/init.d/$srv" ]; then
        /etc/init.d/"$srv" restart
    else
        pkill -f "$srv" && /usr/local/bin/"$srv" server &
    fi
}

# ==================== 1. 动态调取远程 S5 模块 ====================
setup_s5() {
    echo -e "${CYAN}--- 正在连接 GitHub 获取 S5 独立落地模块 ---${NC}" export SYS_MAN PKG_MAN TMP_SCRIPT="/tmp/xmm24_1_$$.sh"
    
    if curl -fsSL "$S5_REMOTE_URL" -o "$TMP_SCRIPT" || wget -qO "$TMP_SCRIPT" "$S5_REMOTE_URL"; then
        chmod +x "$TMP_SCRIPT"
        bash "$TMP_SCRIPT"
        rm -f "$TMP_SCRIPT"
    else
        echo -e "${RED}拉取失败！请检查网络或 GitHub 仓库地址。${NC}"
    fi
}

# ==================== 0. 手动修改配置 ====================
edit_configs() {
    echo -e "\n${YELLOW}=== 手动修改配置文件 ===${NC}"
    echo "1) 修改 /etc/V2bX/config.json (主配置)"
    echo "2) 修改 /etc/V2bX/custom_outbound.json (S5出站)"
    echo "3) 修改 /etc/V2bX/route.json (路由配置)"
    echo "4) 返回主菜单"
    read -p "请输入对应的数字: " edit_choice
    
    FILE=""
    case $edit_choice in
        1) FILE="/etc/V2bX/config.json" ;;
        2) FILE="/etc/V2bX/custom_outbound.json" ;;
        3) FILE="/etc/V2bX/route.json" ;;
        4) return ;;
        *) echo -e "${RED}输入错误！${NC}"; return ;;
    esac

    [ ! -f "$FILE" ] && touch "$FILE"
    nano "$FILE"
    
    echo -e "\n${CYAN}保存完毕！是否立即重启 V2bX 使其生效？ (y/n)${NC}"
    read -p "请选择: " r_choice
    if [ "$r_choice" = "y" ] \vert{}\vert{} [ "$r_choice" = "Y" ]; then
        restart_service "V2bX" 2>/dev/null
        echo -e "${GREEN}✅ 服务已重启。${NC}"
    fi
}

# ==================== 2. 深度体检与诊断 ====================
diagnose_env() {
    echo -e "\n${CYAN}===========================================${NC}"
    echo -e "${YELLOW}🩺 正在深度体检 V2bX 配置与本地环境...${NC}"
    echo -e "${CYAN}===========================================${NC}"
    
    python3 -c "
import json, os, re
print('[\033[0;36m配置检查\033[0m] 分析 /etc/V2bX/config.json 依赖...')
try:
    if not os.path.exists('/etc/V2bX/config.json'):
        print('  [\033[0;31m致命\033[0m] /etc/V2bX/config.json 不存在！')
        exit(0)

    raw = open('/etc/V2bX/config.json', encoding='utf-8').read()
    try: cfg = json.loads(raw)
    except: cfg = json.loads(re.sub(r'(?<!:)//.*', '', raw))

    for idx, node in enumerate(cfg.get('Nodes', [])):
        nid = node.get('NodeID', '未知')
        cert = node.get('CertConfig', {})
        cf = cert.get('CertFile')
        kf = cert.get('KeyFile')
        if cf:
            if os.path.exists(cf): print(f'  [\033[0;32m正常\033[0m] 节点 {nid} TLS 证书存在: {cf}')
            else: print(f'  [\033[0;31m致命\033[0m] 节点 {nid} TLS 证书丢失: {cf}')
        if kf:
            if os.path.exists(kf): print(f'  [\033[0;32m正常\033[0m] 节点 {nid} TLS 私钥存在: {kf}')
            else: print(f'  [\033[0;31m致命\033[0m] 节点 {nid} TLS 私钥丢失: {kf}')
            
    for core in cfg.get('Cores', []):
        lvl = core.get('Log', {}).get('Level', 'warning')
        if lvl.lower() != 'info':
            print(f'  [\033[0;33m提示\033[0m] 当前核心日志等级为 {lvl}，配置落地后将自动提升为 info')
except Exception as e:
    print(f'  [\033[0;31m错误\033[0m] JSON解析失败: {e}')
"
    
    echo -e "\n[\033[0;36m端口扫描\033[0m] 检测本地已知代理与隧道进程..."
    TUNNELS=$(ss -tulnp 2>/dev/null | grep -iE 'v2bx|xray|sing-box|gost|danted|microsocks|socat|sshd')
    
    if [ -z "$TUNNELS" ]; then
        echo -e "  ${GREEN}未检测到冲突的本地代理进程。${NC}"
    else
        printf "  ${CYAN}\%-20s \%-10s \%-25s${NC}\n" "进程名称" "PID" "监听地址:端口"
        echo "  --------------------------------------------------------"
        echo "$TUNNELS" | while read -r line; do
            port=$(echo "$line" | awk '{print $5}')
            proc=$(echo "$line" | grep -o 'users:((".*"' | cut -d '"' -f2)
            pid=$(echo "$line" | grep -o 'pid=[0-9]*' | cut -d '=' -f2 | head -n 1)
            [ -n "$proc" ] && printf "  ${GREEN}%-20s${NC}${YELLOW}%-10s${NC} \%-25s\n" "$proc" "$pid" "$port"
        done
        echo "  --------------------------------------------------------"
    fi
    echo -e "${CYAN}===========================================${NC}"
}

# ==================== 3. 一键卸载与无痕回滚 ====================
uninstall_all() {
    echo -e "\n${RED}⚠️ 警告: 这将彻底清除全部节点的 S5 落地，将出口恢复为原生直连。${NC}"
    read -p "确定要继续吗？(y/n): " confirm
    [ "$confirm" != "y" ] && [ "$confirm" != "Y" ] && { echo "已取消。"; return; }
    
    echo -e "${YELLOW}正在剥离 V2bX 的外部出站路由设定...${NC}"
    python3 -c "
import json, re, os
cfg_path = '/etc/V2bX/config.json'
try:
    raw = open(cfg_path, encoding='utf-8').read()
    try: cfg = json.loads(raw)
    except: cfg = json.loads(re.sub(r'(?<!:)//.*', '', raw))
    
    for core in cfg.get('Cores', []):
        core.pop('OutboundConfigPath', None)
        core.pop('RouteConfigPath', None)
    for node in cfg.get('Nodes', []):
        node.pop('OutboundConfigPath', None)
        node.pop('RouteConfigPath', None)
        
    tmp = cfg_path + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump(cfg, f, indent=2, ensure_ascii=False)
    os.replace(tmp, cfg_path)
    
    for f in ['/etc/V2bX/custom_outbound.json', '/etc/V2bX/route.json']:
        if os.path.exists(f): os.remove(f)
except Exception as e:
    print('清理失败:', e)
" 2>/dev/null
    restart_service "V2bX" 2>/dev/null
    echo -e "${GREEN}✅ 清理完毕！所有节点已恢复机房原生直连。${NC}"
}

update_self() {
    echo -e "${YELLOW}正在更新脚本...${NC}"
    (curl -fsSL "$SCRIPT_URL" -o "$0" || wget -qO "$0" "$SCRIPT_URL") && chmod +x "$0" && exec bash "$0"
}

# ==================== 入口菜单 ====================
while true; do
    echo -e "\n${CYAN}===========================================${NC}"
    echo -e "${GREEN}  Maimai Cloud - S5 落地调度器 (Pro 稳定版) ${NC}"
    echo -e "  内核系统: ${YELLOW}${SYS_MAN^^}${NC} \vert{} 包管理器: ${YELLOW}${PKG_MAN^^}${NC}"
    echo -e "${CYAN}===========================================${NC}"
    echo "  0. 手动修改配置文件 (nano)"
    echo "  1. 部署 S5 落地 (自适应识别多节点 - 远程)"
    echo "  2. 深度诊断 (配置体检 & 端口探针)"
    echo "  3. 一键剥离所有落地 (回滚直连)"
    echo "  8. 更新当前脚本"
    echo "  9. 退出"
    echo -e "${CYAN}===========================================${NC}"
    read -p "请输入指令: " opt

    case $opt in
        0) edit_configs ;;
        1) setup_s5 ;;
        2) diagnose_env ;;
        3) uninstall_all ;;
        8) update_self ;;
        9) exit 0 ;;
        *) echo -e "${RED}无效输入！${NC}" ;;
    esac
done
