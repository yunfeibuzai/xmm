#!/bin/bash
# 麦卖云 (Maimai Cloud) - SOCKS5 自动化落地脚本 (底层全劫持版)
# 适配: Debian/Ubuntu (Systemd) + Alpine (OpenRC)
# 核心: 抛弃不可靠的面板路由，强制采用网卡级透明劫持，100%防漏流
# 更新地址: https://github.com/yunfeibuzai/xmm/blob/main/all/xmm_24

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
NC='\033[0m'

SCRIPT_URL="https://raw.githubusercontent.com/yunfeibuzai/xmm/main/all/xmm_24"

if [ "$(id -u)" != "0" ]; then
    echo -e "${RED}错误: 必须使用 root 权限运行！${NC}"
    exit 1
fi

# ==================== 智能环境探测 ====================
if command -v apt-get >/dev/null 2>&1; then
    PKG_MAN="apt"
elif command -v apk >/dev/null 2>&1; then
    PKG_MAN="apk"
else
    echo -e "${RED}不支持的系统，仅支持 Debian/Ubuntu/Alpine${NC}"
    exit 1
fi

if command -v systemctl >/dev/null 2>&1; then
    SYS_MAN="systemd"
elif command -v rc-service >/dev/null 2>&1; then
    SYS_MAN="openrc"
else
    echo -e "${RED}无法识别服务管理器 (systemd/openrc)${NC}"
    exit 1
fi

command -v python3 >/dev/null 2>&1 || { [ "$PKG_MAN" == "apt" ] && apt-get update && apt-get install -y python3 || apk add python3; }
command -v iptables >/dev/null 2>&1 || { [ "$PKG_MAN" == "apt" ] && apt-get update && apt-get install -y iptables || apk add iptables iptables-openrc; }
command -v nano >/dev/null 2>&1 || { [ "$PKG_MAN" == "apt" ] && apt-get install -y nano || apk add nano; }
command -v ss >/dev/null 2>&1 || { [ "$PKG_MAN" == "apt" ] && apt-get install -y iproute2 || apk add iproute2; }

# ==================== 工具函数 ====================
resolve_domain() {
    python3 -c "import socket, sys; print(socket.gethostbyname(sys.argv[1]))" "$1" 2>/dev/null
}

get_panel_ip() {
    python3 -c "
import json, re
try:
    content = re.sub(r'(?<!:)//.*', '', open('/etc/V2bX/config.json').read())
    host = json.loads(content)['Nodes'][0]['ApiHost'].split('//')[-1].split('/')[0].split(':')[0]
    import socket
    print(socket.gethostbyname(host))
except:
    pass
" 2>/dev/null
}

restart_service() {
    local srv=$1
    [ "$SYS_MAN" == "systemd" ] && systemctl restart "$srv" || rc-service "$srv" restart
}

enable_service() {
    local srv=$1
    [ "$SYS_MAN" == "systemd" ] && systemctl enable "$srv" || rc-update add "$srv" default
}

# ==================== 核心: 底层透明代理全劫持 ====================
deploy_universal_hijack() {
    echo -e "${CYAN}--- 开始配置网卡级 S5 底层透明劫持 ---${NC}"
    
    # 1. 净化历史上可能残留的失效路由注入
    python3 -c "
import json, re
try:
    content = re.sub(r'(?<!:)//.*', '', open('/etc/V2bX/config.json').read())
    cfg = json.loads(content)
    for core in cfg.get('Cores', []):
        core.pop('OutboundConfigPath', None)
        core.pop('RouteConfigPath', None)
    for node in cfg.get('Nodes', []):
        node.pop('OutboundConfigPath', None)
        node.pop('RouteConfigPath', None)
    with open('/etc/V2bX/config.json', 'w') as f:
        json.dump(cfg, f, indent=2)
except:
    pass
" 2>/dev/null
    restart_service "V2bX" 2>/dev/null

    S5_IP=$(resolve_domain "$S5_HOST")
    if [ -z "$S5_IP" ]; then
        echo -e "${RED}错误: 无法解析域名 ${S5_HOST}${NC}"
        return 1
    fi
    
    if [[ "$S5_IP" == "127.0.0"* ]]; then
        echo -e "${YELLOW}⚠️ 检测到目标 S5 为本机内网 IP！请确保本地 S5 服务是由非 root 用户运行，否则会死循环！${NC}"
        read -p "确定要强行继续吗？(y/n): " force_local
        [ "$force_local" != "y" ] && return
    fi
    
    PANEL_IP=$(get_panel_ip)
    
    read -p "请输入当前节点的 [回源监听端口] (非常重要，如 443, 填错会导致断网): " NODE_PORT
    if [[ -z "$NODE_PORT" || ! "$NODE_PORT" =~ ^[0-9]+$ ]]; then
        echo -e "${RED}必须输入有效的数字端口！${NC}"
        return 1
    fi
    SPORT_ARGS="22,${NODE_PORT}"

    if [ "$PKG_MAN" == "apt" ]; then
        apt-get install -y redsocks iptables-persistent
    else
        apk add redsocks
    fi

    DAEMON_MODE="off"
    [ "$SYS_MAN" == "openrc" ] && DAEMON_MODE="on"

    cat << EOF > /etc/redsocks.conf
base {
    log_debug = off;
    log_info = on;
    log = "stderr";
    daemon = ${DAEMON_MODE};
    redirector = iptables;
}
redsocks {
    local_ip = 127.0.0.1;
    local_port = 12345;
    ip = ${S5_IP};
    port = ${S5_PORT};
    type = socks5;
    login = "${S5_USER}";
    password = "${S5_PASS}";
}
EOF

    if [ "$SYS_MAN" == "systemd" ]; then
        cat << 'EOF' > /etc/systemd/system/redsocks.service
[Unit]
Description=Redsocks transparent proxy
After=network.target

[Service]
Type=simple
User=root
ExecStart=/usr/sbin/redsocks -c /etc/redsocks.conf
Restart=always

[Install]
WantedBy=multi-user.target
EOF
        systemctl daemon-reload
    fi

    enable_service "redsocks"
    restart_service "redsocks"

    # 清除旧规则
    while iptables -t nat -D OUTPUT -p tcp -j REDSOCKS 2>/dev/null; do :; done
    iptables -t nat -F REDSOCKS 2>/dev/null
    iptables -t nat -X REDSOCKS 2>/dev/null

    iptables -t nat -N REDSOCKS
    iptables -t nat -A REDSOCKS -d 127.0.0.0/8 -j RETURN
    iptables -t nat -A REDSOCKS -d 10.0.0.0/8 -j RETURN
    iptables -t nat -A REDSOCKS -d 172.16.0.0/12 -j RETURN
    iptables -t nat -A REDSOCKS -d 192.168.0.0/16 -j RETURN
    
    iptables -t nat -A REDSOCKS -d ${S5_IP}/32 -j RETURN
    [ -n "$PANEL_IP" ] && iptables -t nat -A REDSOCKS -d ${PANEL_IP}/32 -j RETURN

    # 关键防漏流与防断网放行
    iptables -t nat -A REDSOCKS -p tcp -m multiport --sports ${SPORT_ARGS} -j RETURN
    
    # 强制将剩余所有 TCP 塞入 Redsocks
    iptables -t nat -A REDSOCKS -p tcp -j REDIRECT --to-ports 12345
    iptables -t nat -A OUTPUT -p tcp -j REDSOCKS

    if [ "$PKG_MAN" == "apt" ]; then
        netfilter-persistent save 2>/dev/null
    else
        /etc/init.d/iptables save 2>/dev/null || rc-service iptables save 2>/dev/null
        rc-update add iptables default 2>/dev/null
    fi
    echo -e "${GREEN}✅ 底层透明劫持落地配置完毕！不管内核怎么乱跑，出网 100% 锁定 HKT！${NC}"
}

# ==================== 诊断与卸载 ====================
diagnose_env() {
    echo -e "\n${CYAN}===========================================${NC}"
    echo -e "${YELLOW}🩺 正在深度体检 V2bX 配置与本地 S5 环境...${NC}"
    echo -e "${CYAN}===========================================${NC}"
    
    python3 -c "
import json, os, re
print('[\033[0;36m配置检查\033[0m] 分析 /etc/V2bX/config.json 依赖...')
try:
    if not os.path.exists('/etc/V2bX/config.json'):
        print('  [\033[0;31m致命\033[0m] /etc/V2bX/config.json 不存在！')
        exit(0)
    content = re.sub(r'(?<!:)//.*', '', open('/etc/V2bX/config.json').read())
    cfg = json.loads(content)
    for idx, node in enumerate(cfg.get('Nodes', [])):
        cert = node.get('CertConfig', {})
        cf = cert.get('CertFile')
        kf = cert.get('KeyFile')
        if cf:
            if os.path.exists(cf): print(f'  [\033[0;32m正常\033[0m] TLS 证书存在: {cf}')
            else: print(f'  [\033[0;31m致命\033[0m] TLS 证书丢失: {cf}')
        if kf:
            if os.path.exists(kf): print(f'  [\033[0;32m正常\033[0m] TLS 私钥存在: {kf}')
            else: print(f'  [\033[0;31m致命\033[0m] TLS 私钥丢失: {kf}')
except Exception as e:
    print(f'  [\033[0;31m错误\033[0m] 解析失败: {e}')
"
    
    echo -e "\n[\033[0;36m端口扫描\033[0m] 检测本地已知代理与隧道进程..."
    TUNNELS=$(ss -tulnp | grep -iE 'v2bx|xray|sing-box|gost|danted|microsocks|socat|sshd|redsocks')
    if [ -z "$TUNNELS" ]; then
        echo -e "  ${GREEN}未检测到本地运行的其他代理隧道服务。${NC}"
    else
        printf "  ${CYAN}%-20s %-10s %-25s${NC}\n" "进程名称" "PID" "监听地址:端口"
        echo "  --------------------------------------------------------"
        echo "$TUNNELS" | while read -r line; do
            port=$(echo "$line" | awk '{print $5}')
            proc=$(echo "$line" | grep -o 'users:((".*"' | cut -d '"' -f2)
            pid=$(echo "$line" | grep -o 'pid=[0-9]*' | cut -d '=' -f2 | head -n 1)
            [ -n "$proc" ] && printf "  ${GREEN}%-20s${NC} ${YELLOW}%-10s${NC} %-25s\n" "$proc" "$pid" "$port"
        done
    fi
    echo -e "${CYAN}===========================================${NC}"
}

uninstall_all() {
    echo -e "\n${RED}⚠️ 警告: 这将彻底清除 S5 落地，将出口恢复为 VPS 原生机房直连。${NC}"
    read -p "确定要继续吗？(y/n): " confirm
    [ "$confirm" != "y" ] && return
    
    echo -e "${YELLOW}正在剥离底层 iptables 劫持规则...${NC}"
    while iptables -t nat -D OUTPUT -p tcp -j REDSOCKS 2>/dev/null; do :; done
    iptables -t nat -F REDSOCKS 2>/dev/null
    iptables -t nat -X REDSOCKS 2>/dev/null
    
    if [ "$PKG_MAN" == "apt" ]; then
        netfilter-persistent save 2>/dev/null
    else
        /etc/init.d/iptables save 2>/dev/null || rc-service iptables save 2>/dev/null
    fi

    echo -e "${YELLOW}正在停止并禁用 Redsocks...${NC}"
    if [ "$SYS_MAN" == "systemd" ]; then
        systemctl stop redsocks 2>/dev/null
        systemctl disable redsocks 2>/dev/null
    else
        rc-service redsocks stop 2>/dev/null
        rc-update del redsocks default 2>/dev/null
    fi
    
    echo -e "${YELLOW}正在剥离 V2bX 外部注入路由...${NC}"
    python3 -c "
import json, re
try:
    content = re.sub(r'(?<!:)//.*', '', open('/etc/V2bX/config.json').read())
    cfg = json.loads(content)
    for core in cfg.get('Cores', []):
        core.pop('OutboundConfigPath', None)
        core.pop('RouteConfigPath', None)
    for node in cfg.get('Nodes', []):
        node.pop('OutboundConfigPath', None)
        node.pop('RouteConfigPath', None)
    with open('/etc/V2bX/config.json', 'w') as f:
        json.dump(cfg, f, indent=2)
except:
    pass
" 2>/dev/null
    restart_service "V2bX" 2>/dev/null

    echo -e "${GREEN}✅ 清理完毕！已完美回滚为原生机房直连。${NC}"
}

# ==================== 主菜单调度 ====================
setup_s5() {
    echo -e "${YELLOW}--- 强制底层 SOCKS5 劫持部署 ---${NC}"
    read -p "服务器(支持域名或IP, 本机S5填127.0.0.1): " S5_HOST
    read -p "端口: " S5_PORT
    read -p "用户名 (无则留空): " S5_USER
    read -p "密码 (无则留空): " S5_PASS
    
    deploy_universal_hijack
}

view_logs() {
    echo -e "\n${CYAN}1) V2bX 日志  2) Redsocks 日志${NC}"
    read -p "请选择(1/2): " log_choice
    echo -e "${YELLOW}💡 提示：正在实时滚动日志，随时按 [Ctrl+C] 可安全退出查看并返回主菜单。${NC}\n"
    trap '' INT
    (
        trap - INT
        if command -v journalctl >/dev/null 2>&1; then
            [ "$log_choice" == "1" ] && journalctl -u V2bX -n 100 -f
            [ "$log_choice" == "2" ] && journalctl -u redsocks -n 100 -f
        else
            echo -e "${YELLOW}当前为 Alpine OpenRC 环境：${NC}"
            [ "$log_choice" == "1" ] && tail -f /var/log/V2bX* /etc/V2bX/*.log 2>/dev/null
            [ "$log_choice" == "2" ] && tail -f /var/log/messages | grep redsocks
        fi
    )
    trap - INT
    echo -e "\n${GREEN}✔ 已安全停止查阅日志。${NC}"
}

update_self() {
    echo -e "${YELLOW}正在更新脚本...${NC}"
    wget -qO "$0" "$SCRIPT_URL"
    if [ $? -eq 0 ]; then
        chmod +x "$0"
        echo -e "${GREEN}✅ 更新成功！重启中...${NC}"
        sleep 1
        exec bash "$0"
    else
        echo -e "${RED}更新失败！${NC}"
    fi
}

# ==================== 入口 ====================
while true; do
    echo -e "\n${CYAN}===========================================${NC}"
    echo -e "${GREEN}  Maimai Cloud - S5 落地智能路由 (全劫持版) ${NC}"
    echo -e "  环境: ${YELLOW}${SYS_MAN^^}${NC} | 状态: ${YELLOW}强制底层劫持 (通杀漏流)${NC}"
    echo -e "${CYAN}===========================================${NC}"
    echo "  1. 部署 S5 落地 (强制接管一切内核漏流)"
    echo "  2. 查看服务运行日志"
    echo "  3. 深度诊断 (配置体检 & 端口探针)"
    echo "  4. 一键剥离 S5 落地 (回滚原生机房直连)"
    echo "  8. 更新当前脚本"
    echo "  9. 退出"
    echo -e "${CYAN}===========================================${NC}"
    read -p "请输入指令: " opt

    case $opt in
        1) setup_s5 ;;
        2) view_logs ;;
        3) diagnose_env ;;
        4) uninstall_all ;;
        8) update_self ;;
        9) exit 0 ;;
        *) echo -e "${RED}无效输入！${NC}" ;;
    esac
done
