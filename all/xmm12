# ════════════════════ 1. 原有配置无缝追加节点 ════════════════════
collect_single_node() {
    local idx="$1"
    replace_existing_id=""
    ui_section "追加配置第 ${idx} 个后端节点"

    ui_step "1/4" "选择代理核心与传输协议"
    echo -e "  ${cyan}[1]${plain} Xray      ${dim}(首选: Vless / Vmess / Reality / XHTTP / AnyTLS / Hy2 / CDN)${plain}"
    echo -e "  ${cyan}[2]${plain} Sing-box  ${dim}(全能: Shadowsocks / Trojan / Tuic / AnyTLS / Hy1&2 / Vless / Vmess)${plain}"
    echo -e "  ${cyan}[3]${plain} Hysteria2 ${dim}(官方专属高性能内核)${plain}"
    
    local core_num=""
    while [[ ! "$core_num" =~ ^[1-3]$ ]]; do
        echo -ne " ${bold}▸ 请选择内核引擎${plain} [1-3, 默认 1]: "
        read -r core_num < /dev/tty
        [[ -z "$core_num" ]] && core_num=1
    done

    case "$core_num" in 
        1) core_type="xray"; has_xray=true ;; 
        2) core_type="sing"; has_sing=true ;; 
        3) core_type="hysteria2"; has_hysteria2=true ;; 
    esac

    local protocol_num=""
    if [[ "$core_type" == "hysteria2" ]]; then
        node_type="hysteria2"
        echo -e "  ${green}✔ Hysteria2 引擎自动锁定协议: hysteria2${plain}"
    elif [[ "$core_type" == "xray" ]]; then
        echo -e "\n  ${cyan}[1]${plain} Vless ${dim}(Reality/XHTTP/WS)${plain}  ${cyan}[2]${plain} Vmess  ${cyan}[3]${plain} Trojan  ${cyan}[4]${plain} Shadowsocks  ${cyan}[5]${plain} AnyTLS  ${cyan}[6]${plain} Hysteria2"
        while [[ ! "$protocol_num" =~ ^[1-6]$ ]]; do
            echo -ne " ${bold}▸ 请选择 Xray 协议${plain} [1-6, 默认 1-Vless]: "
            read -r protocol_num < /dev/tty
            [[ -z "$protocol_num" ]] && protocol_num=1
        done
        case "$protocol_num" in
            1) node_type="vless" ;; 2) node_type="vmess" ;; 3) node_type="trojan" ;;
            4) node_type="shadowsocks" ;; 5) node_type="anytls" ;; 6) node_type="hysteria2" ;;
        esac
    elif [[ "$core_type" == "sing" ]]; then
        echo -e "\n  ${cyan}[1]${plain} Shadowsocks  ${cyan}[2]${plain} Trojan  ${cyan}[3]${plain} Tuic  ${cyan}[4]${plain} AnyTLS"
        echo -e "  ${cyan}[5]${plain} Hysteria     ${cyan}[6]${plain} Hysteria2  ${cyan}[7]${plain} Vless  ${cyan}[8]${plain} Vmess"
        while [[ ! "$protocol_num" =~ ^[1-8]$ ]]; do
            echo -ne " ${bold}▸ 请选择 Sing-box 协议${plain} [1-8, 默认 1-SS]: "
            read -r protocol_num < /dev/tty
            [[ -z "$protocol_num" ]] && protocol_num=1
        done
        case "$protocol_num" in
            1) node_type="shadowsocks" ;; 2) node_type="trojan" ;; 3) node_type="tuic" ;; 4) node_type="anytls" ;;
            5) node_type="hysteria" ;; 6) node_type="hysteria2" ;; 7) node_type="vless" ;; 8) node_type="vmess" ;;
        esac
    fi

    ui_step "2/4" "基础参数与监听网络"
    while true; do
        node_id=""
        while [[ ! "$node_id" =~ ^[0-9]+$ ]]; do
            echo -ne " ${bold}▸ 请输入面板中的 Node ID${plain} (纯数字): "
            read -r node_id < /dev/tty
        done

        if jq -e --argjson nid "$node_id" '(.Nodes // [])[] | select(.NodeID == $nid)' "$config_file" >/dev/null 2>&1; then
            echo -e "  ${yellow}⚠ 警告：NodeID ${node_id} 已存在于当前配置中！${plain}"
            echo -ne "  ${bold}▸ 是否覆盖替换该旧节点？${plain} [y: 覆盖替换 / N: 重新输入其他 ID]: "
            read -r dup_yn < /dev/tty
            if [[ "$dup_yn" =~ ^[Yy]$ ]]; then
                replace_existing_id="$node_id"
                break
            fi
        else
            break
        fi
    done

    local listen_ip="0.0.0.0"
    [[ "$core_type" == "hysteria2" ]] && listen_ip=""
    echo -ne " ${bold}▸ 监听 IP (ListenIP)${plain} ${dim}[回车默认$([[ "$core_type" == "hysteria2" ]] && echo "双栈全监听" || echo " 0.0.0.0，双栈填 ::")]${plain}: "
    read -r input_listen < /dev/tty
    [[ -n "$input_listen" ]] && listen_ip="$input_listen"

    ui_step "3/4" "TLS 安全与证书模式"
    local run_tls_flow=false
    local reality_yn="n" tls_yn="n" cert_mode_num="" cert_mode="none" cert_domain="" cf_token=""
    local cert_file="" key_file=""

    if [[ "$node_type" == "vless" ]]; then
        echo -ne " ${bold}▸ 该 Vless 节点是否为 Reality 节点？${plain} [Y/n, 默认 Y]: "
        read -r reality_yn < /dev/tty
        [[ -z "$reality_yn" ]] && reality_yn="y"
        if [[ "$reality_yn" =~ ^[Yy]$ ]]; then
            cert_mode="none"
            echo -e "  ${green}✔ Reality 节点无需证书 (自动设为 none)${plain}"
        else
            run_tls_flow=true
        fi
    elif [[ "$node_type" =~ ^(hysteria2|tuic|hysteria|trojan|anytls)$ ]]; then
        run_tls_flow=true
        echo -e "  ${yellow}ℹ 协议 [${node_type}] 强制要求配置 TLS 证书。${plain}"
    else
        echo -ne " ${bold}▸ 是否开启 TLS 证书保护？${plain} [y/N, 默认 N]: "
        read -r tls_yn < /dev/tty
        [[ "$tls_yn" =~ ^[Yy]$ ]] && run_tls_flow=true
    fi

    if [ "$run_tls_flow" = true ]; then
        echo -e "  ${cyan}[1]${plain} HTTP 模式  ${dim}(内置自动申请，需域名已解析到本机且80空闲)${plain}"
        echo -e "  ${cyan}[2]${plain} DNS 模式   ${dim}(内置 Cloudflare API Token 自动验证)${plain}"
        echo -e "  ${cyan}[3]${plain} File 模式  ${dim}(推荐：挂载本脚本外置 ACME 申请的证书或已有证书)${plain}"
        echo -e "  ${cyan}[4]${plain} 本地自签   ${dim}(CF隧道推荐：自动生成自签证书并以 File 模式挂载)${plain}"
        
        while [[ ! "$cert_mode_num" =~ ^[1-4]$ ]]; do
            echo -ne " ${bold}▸ 选择证书模式${plain} [1-4, 默认 1]: "
            read -r cert_mode_num < /dev/tty
            [[ -z "$cert_mode_num" ]] && cert_mode_num=1
        done

        case "$cert_mode_num" in
            1)
                cert_mode="http"
                while [[ -z "$cert_domain" ]]; do
                    echo -ne " ${bold}▸ 请输入绑定域名 (如 node.example.com)${plain}: "
                    read -r cert_domain < /dev/tty
                done
                cert_file="/etc/V2bX/${cert_domain}.cert.pem"; key_file="/etc/V2bX/${cert_domain}.key.pem"
                ;;
            2)
                cert_mode="dns"
                while [[ -z "$cert_domain" ]]; do
                    echo -ne " ${bold}▸ 请输入绑定域名 (如 node.example.com)${plain}: "
                    read -r cert_domain < /dev/tty
                done
                while [[ -z "$cf_token" ]]; do
                    echo -ne " ${bold}▸ 请输入 Cloudflare API Token${plain}: "
                    read -r cf_token < /dev/tty
                done
                cert_file="/etc/V2bX/${cert_domain}.cert.pem"; key_file="/etc/V2bX/${cert_domain}.key.pem"
                ;;
            3)
                cert_mode="file"
                echo -ne " ${bold}▸ 请输入节点域名${plain} ${dim}[如已通过外置ACME申请，直接填该域名]${plain}: "
                read -r cert_domain < /dev/tty
                local def_c="/etc/V2bX/fullchain.cer"
                local def_k="/etc/V2bX/cert.key"
                if [[ -n "$cert_domain" && -f "/etc/V2bX/${cert_domain}.cert.pem" ]]; then
                    def_c="/etc/V2bX/${cert_domain}.cert.pem"
                    def_k="/etc/V2bX/${cert_domain}.key.pem"
                fi
                echo -ne " ${bold}▸ 公钥绝对路径${plain} ${dim}[默认: ${def_c}]${plain}: "
                read -r input_cert < /dev/tty
                cert_file=${input_cert:-"$def_c"}
                echo -ne " ${bold}▸ 私钥绝对路径${plain} ${dim}[默认: ${def_k}]${plain}: "
                read -r input_key < /dev/tty
                key_file=${input_key:-"$def_k"}
                ;;
            4)
                cert_mode="file"
                echo -ne " ${bold}▸ 请输入自签域名${plain} ${dim}[默认: cf.babymonster.cc.cd]${plain}: "
                read -r input_sni < /dev/tty
                cert_domain=${input_sni:-"cf.babymonster.cc.cd"}
                cert_file="/etc/V2bX/${cert_domain}.cert.pem"
                key_file="/etc/V2bX/${cert_domain}.key.pem"
                openssl req -x509 -nodes -newkey rsa:2048 -days 3650 \
                    -keyout "$key_file" -out "$cert_file" \
                    -subj "/CN=${cert_domain}" >/dev/null 2>&1
                echo -e "  ${green}✔ 自签名证书已生成至 ${cert_file}${plain}"
                ;;
        esac
    fi

    local cert_json
    if [[ "$cert_mode" == "dns" ]]; then
        cert_json=$(jq -n --arg dom "$cert_domain" --arg cf "$cert_file" --arg kf "$key_file" --arg tok "$cf_token" \
            '{CertMode:"dns",RejectUnknownSni:false,CertDomain:$dom,CertFile:$cf,KeyFile:$kf,Email:"admin@v2bx.com",Provider:"cloudflare",DNSEnv:{CF_DNS_API_TOKEN:$tok,CLOUDFLARE_DNS_API_TOKEN:$tok}}')
    elif [[ "$cert_mode" =~ ^(http|file)$ ]]; then
        cert_json=$(jq -n --arg cm "$cert_mode" --arg dom "$cert_domain" --arg cf "$cert_file" --arg kf "$key_file" \
            '{CertMode:$cm,RejectUnknownSni:false,CertDomain:$dom,CertFile:$cf,KeyFile:$kf,Email:"admin@v2bx.com"}')
    else
        cert_json='{"CertMode":"none"}'
    fi

    ui_step "4/4" "流量控制与网络策略"
    local has_limit="false" speed_limit=0 dev_limit=0 conn_limit=0 enable_dyn="false"
    echo -ne " ${bold}▸ 是否配置本节点限速/设备锁 (LimitConfig)？${plain} [y/N, 默认 N]: "
    read -r limit_yn < /dev/tty
    if [[ "$limit_yn" =~ ^[Yy]$ ]]; then
        has_limit="true"
        echo -ne "   └─ 单用户限速 (Mbps, 0不限) [0]: "; read -r speed_limit < /dev/tty; [[ ! "$speed_limit" =~ ^[0-9]+$ ]] && speed_limit=0
        echo -ne "   └─ 单用户设备限制 (0跟随面板) [0]: "; read -r dev_limit < /dev/tty; [[ ! "$dev_limit" =~ ^[0-9]+$ ]] && dev_limit=0
        echo -ne "   └─ 单用户连接上限 (0不限) [0]: "; read -r conn_limit < /dev/tty; [[ ! "$conn_limit" =~ ^[0-9]+$ ]] && conn_limit=0
        echo -ne "   └─ 启用暴流动态压制 (60秒达1GB限速10Mbps)？[y/N]: "; read -r dyn_yn < /dev/tty
        [[ "$dyn_yn" =~ ^[Yy]$ ]] && enable_dyn="true"
    fi

    local dns_type="UseIPv4"
    if [[ "$core_type" == "xray" ]]; then
        echo -ne " ${bold}▸ Xray 出站解析策略${plain} [1:IPv4(默认) 2:IPv6 3:双栈 4:AsIs]: "
        read -r dns_opt < /dev/tty
        case "$dns_opt" in 2) dns_type="UseIPv6" ;; 3) dns_type="UseIP" ;; 4) dns_type="AsIs" ;; esac
    fi

    current_node=$(jq -n \
        --arg core "$core_type" \
        --arg host "$api_host" \
        --arg key "$api_key" \
        --argjson nid "$node_id" \
        --arg ntype "$node_type" \
        --arg lip "$listen_ip" \
        --arg dnstype "$dns_type" \
        --argjson cert "$cert_json" \
        --argjson has_lim "$has_limit" \
        --argjson spd "$speed_limit" \
        --argjson dev "$dev_limit" \
        --argjson conn "$conn_limit" \
        --argjson dyn "$enable_dyn" \
        '
        (if $core == "xray" then
          {Core:"xray",ApiHost:$host,ApiKey:$key,NodeID:$nid,NodeType:$ntype,Timeout:30,ListenIP:$lip,SendIP:"0.0.0.0",DeviceOnlineMinTraffic:200,ReportMinTraffic:0,EnableProxyProtocol:false,EnableUot:true,EnableTFO:true,DNSType:$dnstype,DisableSniffing:false,CertConfig:$cert}
        elif $core == "sing" then
          {Core:"sing",ApiHost:$host,ApiKey:$key,NodeID:$nid,NodeType:$ntype,Timeout:30,ListenIP:$lip,SendIP:"0.0.0.0",DeviceOnlineMinTraffic:200,ReportMinTraffic:0,EnableTFO:true,EnableSniff:true,SniffOverrideDestination:true,CertConfig:$cert}
        else
          {Core:"hysteria2",ApiHost:$host,ApiKey:$key,NodeID:$nid,NodeType:"hysteria2",Hysteria2ConfigPath:"/etc/V2bX/hy2config.yaml",Timeout:30,ListenIP:$lip,SendIP:"0.0.0.0",DeviceOnlineMinTraffic:200,ReportMinTraffic:0,CertConfig:$cert}
        end)
        | if $has_lim then
            . + {LimitConfig:{EnableRealtime:false,SpeedLimit:$spd,DeviceLimit:$dev,ConnLimit:$conn,EnableDynamicSpeedLimit:$dyn,DynamicSpeedLimitConfig:{Periodic:60,Traffic:1073741824,SpeedLimit:10,ExpireTime:600}}}
          else . end
        ')
}

wizard_append_node() {
    ui_banner
    init_aux_files

    if [[ ! -f "$config_file" ]] || ! jq -e . "$config_file" >/dev/null 2>&1; then
        echo -e " ${yellow}ℹ 未检测到有效的主配置，正在初始化标准配置骨架...${plain}"
        echo '{ "Log": { "Level": "error", "Output": "" }, "Runtime": { "GCPercent": 50, "MemoryLimitPercent": 70 }, "Cores": [], "Nodes": [] }' | jq . > "$config_file"
    fi

    load_or_ask_creds

    has_xray=false; has_sing=false; has_hysteria2=false
    local exist_count
    exist_count=$(jq '(.Nodes // []) | length' "$config_file" 2>/dev/null || echo 0)

    while true; do
        ((exist_count++))
        collect_single_node "$exist_count"

        local tmp_json="/tmp/v2bx_append_${RANDOM}.json"
        cp -f "$config_file" "$tmp_json"

        if [[ -n "$replace_existing_id" ]]; then
            jq --argjson rid "$replace_existing_id" 'del(.Nodes[] | select(.NodeID == $rid))' "$tmp_json" > "${tmp_json}.new" && mv -f "${tmp_json}.new" "$tmp_json"
        fi

        if [ "$has_xray" = true ] && ! jq -e '(.Cores // [])[] | select(.Type=="xray")' "$tmp_json" >/dev/null 2>&1; then
            local xc; xc=$(build_xray_core_json)
            jq --argjson c "$xc" '.Cores = ((.Cores // []) + [$c])' "$tmp_json" > "${tmp_json}.new" && mv -f "${tmp_json}.new" "$tmp_json"
        fi
        if [ "$has_sing" = true ] && ! jq -e '(.Cores // [])[] | select(.Type=="sing")' "$tmp_json" >/dev/null 2>&1; then
            local sc; sc=$(build_sing_core_json)
            jq --argjson c "$sc" '.Cores = ((.Cores // []) + [$c])' "$tmp_json" > "${tmp_json}.new" && mv -f "${tmp_json}.new" "$tmp_json"
        fi
        if [ "$has_hysteria2" = true ] && ! jq -e '(.Cores // [])[] | select(.Type=="hysteria2")' "$tmp_json" >/dev/null 2>&1; then
            local hc; hc=$(build_hy2_core_json)
            jq --argjson c "$hc" '.Cores = ((.Cores // []) + [$c])' "$tmp_json" > "${tmp_json}.new" && mv -f "${tmp_json}.new" "$tmp_json"
        fi

        jq --argjson n "$current_node" '.Nodes = ((.Nodes // []) + [$n])
          | ([.Nodes[].Core] | unique) as $active_cores
          | .Cores = [(.Cores // [])[] | select(.Type as $t | $active_cores | index($t))]' \
          "$tmp_json" > "${tmp_json}.new" 2>/dev/null
        
        if jq -e . "${tmp_json}.new" >/dev/null 2>&1; then
            mv -f "${tmp_json}.new" "$config_file"
            echo -e "\n ${green}✔ 节点 (NodeID: ${node_id} / ${node_type}) 已成功写入配置！${plain}"
        else
            echo -e "\n ${red}✖ JSON 合并致命校验失败，已安全回滚原配置！${plain}"
        fi
        rm -f "$tmp_json" "${tmp_json}.new"

        echo ""
        echo -ne " ${bold}▸ 是否继续追加下一个节点？${plain} [y/N, 默认 N]: "
        read -r cont < /dev/tty
        [[ ! "$cont" =~ ^[Yy]$ ]] && break
    done

    restart_v2bx_service
}

# ════════════════════ 2. 面板对接与网络“红绿灯”四维体检中心 ════════════════════
traffic_light_health_check() {
    ui_banner
    ui_section "🚦 面板对接与网络“红绿灯”四维全景体检中心"

    if [[ ! -f "$config_file" ]] || ! jq -e . "$config_file" >/dev/null 2>&1; then
        echo -e " ${red}🔴 [红灯] /etc/V2bX/config.json 不存在或配置结构被破坏！${plain}"
        return
    fi

    local is_multi=false
    if [[ -f /etc/V2bX/nodes/.multi_enabled ]] || \
       compgen -G "/etc/systemd/system/multi-user.target.wants/v2bx@*.service" >/dev/null 2>&1 || \
       compgen -G "/etc/init.d/v2bx.node_*" >/dev/null 2>&1; then
        is_multi=true
    fi

    if pgrep -f "/usr/local/V2bX/V2bX" >/dev/null 2>&1; then
        local proc_cnt; proc_cnt=$(pgrep -fc "/usr/local/V2bX/V2bX")
        echo -e " 🟢 ${green}[进程状态]${plain} V2bX 正在运行 (共 ${proc_cnt} 个活跃进程 | 模式: $([[ "$is_multi" = true ]] && echo "多进程隔离" || echo "单进程"))"
    else
        echo -e " 🔴 ${red}[进程状态]${plain} V2bX 核心进程未运行！"
    fi

    local listen_snapshot=""
    listen_snapshot=$(ss -tuln 2>/dev/null || netstat -tuln 2>/dev/null)

    ui_line
    echo -e " ${bold}正在逐节点执行 API 握手、端口监听与证书有效期巡检...${plain}\n"

    local node_len
    node_len=$(jq '(.Nodes // []) | length' "$config_file")
    if [[ "$node_len" -eq 0 ]]; then
        echo -e " ${yellow}🟡 [黄灯] 当前配置文件中没有任何节点${plain}"
        return
    fi

    local i=0
    while [[ $i -lt $node_len ]]; do
        local c_core c_host c_key c_id c_type c_cmode c_cfile
        c_core=$(jq -r ".Nodes[$i].Core // \"xray\"" "$config_file")
        c_host=$(jq -r ".Nodes[$i].ApiHost // \"\"" "$config_file")
        c_key=$(jq -r ".Nodes[$i].ApiKey // \"\"" "$config_file")
        c_id=$(jq -r ".Nodes[$i].NodeID // 0" "$config_file")
        c_type=$(jq -r ".Nodes[$i].NodeType // \"vless\"" "$config_file")
        c_cmode=$(jq -r ".Nodes[$i].CertConfig.CertMode // \"none\"" "$config_file")
        c_cfile=$(jq -r ".Nodes[$i].CertConfig.CertFile // \"\"" "$config_file")

        c_host="${c_host%/}"
        local test_url="${c_host}/api/v1/server/UniProxy/config?node_id=${c_id}&node_type=${c_type}&token=${c_key}"
        local resp_file="/tmp/v2bx_diag_${RANDOM}.json"
        local http_code curl_rc
        http_code=$(curl -sL -w "%{http_code}" --connect-timeout 8 --max-time 12 -o "$resp_file" "$test_url" 2>/dev/null)
        curl_rc=$?

        echo -e "${cyan}${bold}┌── 节点 #$((i+1)) [NodeID: ${c_id} | 内核: ${c_core} | 协议: ${c_type}]${plain}"
        echo -e "│ 对接面板: ${c_host}"

        if [[ "$is_multi" = true ]]; then
            local inst_n="node_${c_id}_${c_type}"
            if systemctl is-active --quiet "v2bx@${inst_n}.service" 2>/dev/null || \
               rc-service "v2bx.${inst_n}" status 2>/dev/null | grep -q "started"; then
                echo -e "│ 独立进程: 🟢 ${green}[运行中] (${inst_n})${plain}"
            else
                echo -e "│ 独立进程: 🔴 ${red}[已停止] (${inst_n})${plain}"
            fi
        fi

        if [[ "$http_code" == "200" ]]; then
            if jq -e 'type == "object" and (has("server_port") or has("port") or has("base_config") or has("protocol"))' "$resp_file" >/dev/null 2>&1; then
                local srv_port
                srv_port=$(jq -r '.server_port // .port // ""' "$resp_file" 2>/dev/null)
                echo -e "│ API 握手: 🟢 ${green}[绿灯正常] (HTTP 200) — 下发端口: ${srv_port:-动态}${plain}"

                if [[ "$srv_port" =~ ^[0-9]+$ ]] && [[ -n "$listen_snapshot" ]]; then
                    if echo "$listen_snapshot" | grep -qE "[:.]${srv_port}[[:space:]]"; then
                        echo -e "│ 端口监听: 🟢 ${green}[已成功监听 :${srv_port}]${plain}"
                    else
                        echo -e "│ 端口监听: 🔴 ${red}[未监听 :${srv_port}] (端口被占用或节点启动报错)${plain}"
                    fi
                fi
            else
                echo -e "│ API 握手: 🟡 ${yellow}[黄灯异常] (HTTP 200 但返回非 JSON，可能被 CDN/WAF 拦截)${plain}"
            fi
        elif [[ "$http_code" == "000" ]]; then
            local net_reason="网络不通或连接重置"
            case "$curl_rc" in
                6) net_reason="面板域名 DNS 解析失败" ;;
                7) net_reason="面板服务器拒绝连接 (端口未开或防火墙拦截)" ;;
                28) net_reason="连接面板超时 (网络阻断或面板过载)" ;;
                35|51|60) net_reason="SSL/TLS 握手或证书校验失败" ;;
            esac
            echo -e "│ API 握手: 🔴 ${red}[红灯断联] (${net_reason})${plain}"
        elif [[ "$http_code" == "401" || "$http_code" == "403" || "$http_code" == "500" ]]; then
            local err_msg
            err_msg=$(jq -r '.message // "密钥错误或 NodeID 不存在"' "$resp_file" 2>/dev/null | head -c 60)
            echo -e "│ API 握手: 🔴 ${red}[红灯拒绝] (HTTP ${http_code}) — 原因: ${err_msg}${plain}"
        else
            echo -e "│ API 握手: 🟡 ${yellow}[黄灯异常] (HTTP ${http_code})${plain}"
        fi
        rm -f "$resp_file"

        if [[ "$c_cmode" == "file" ]]; then
            if [[ -f "$c_cfile" && -s "$c_cfile" ]]; then
                local exp_date
                exp_date=$(openssl x509 -enddate -noout -in "$c_cfile" 2>/dev/null | cut -d= -f2)
                if ! openssl x509 -checkend 0 -noout -in "$c_cfile" >/dev/null 2>&1; then
                    echo -e "│ 证书状态: 🔴 ${red}[已过期!] 到期时间: ${exp_date}${plain}"
                elif ! openssl x509 -checkend 1296000 -noout -in "$c_cfile" >/dev/null 2>&1; then
                    echo -e "│ 证书状态: 🟡 ${yellow}[即将过期(<15天)] 到期: ${exp_date}${plain}"
                else
                    echo -e "│ 证书状态: 🟢 ${green}[健康有效] 到期: ${exp_date:-未知}${plain}"
                fi
            else
                echo -e "│ 证书状态: 🔴 ${red}[证书缺失] 找不到: ${c_cfile}${plain}"
            fi
        else
            echo -e "│ 证书状态: 🟢 ${dim}模式: ${c_cmode}${plain}"
        fi
        echo -e "${cyan}${bold}└─────────────────────────────────────────────────────${plain}"
        ((i++))
    done
}

# ════════════════════ 3. 独立外置 ACME.sh 证书控制台 ════════════════════
install_acme_sh() {
    if [[ ! -f ~/.acme.sh/acme.sh ]]; then
        echo -e " ${cyan}正在安装独立 acme.sh 证书引擎...${plain}"
        curl -sL https://get.acme.sh | sh -s email=admin@v2bx.com >/dev/null 2>&1
        ~/.acme.sh/acme.sh --upgrade --auto-upgrade >/dev/null 2>&1
        ~/.acme.sh/acme.sh --set-default-ca --server letsencrypt >/dev/null 2>&1
    fi
}

acme_bind_to_node() {
    local domain="$1"
    local cert_f="$2"
    local key_f="$3"

    if [[ ! -f "$config_file" ]]; then return; fi
    echo -ne "\n ${bold}▸ 是否将该证书一键挂载到现有节点 (自动改为 CertMode: file)？${plain} [Y/n]: "
    read -r bind_yn < /dev/tty
    [[ -z "$bind_yn" ]] && bind_yn="y"
    [[ ! "$bind_yn" =~ ^[Yy]$ ]] && return

    echo -e " 当前已配置的节点列表："
    jq -r '(.Nodes // [])[] | "  ▸ NodeID: \(.NodeID)  | 协议: \(.NodeType)  | 证书模式: \(.CertConfig.CertMode)"' "$config_file"
    echo -ne " ${bold}▸ 请输入要绑定此证书的 NodeID${plain} (输入 all 绑定所有): "
    read -r target_id < /dev/tty
    [[ -z "$target_id" ]] && return

    local tmp_j="/tmp/v2bx_cert_bind_${RANDOM}.json"
    if [[ "$target_id" == "all" ]]; then
        jq --arg dom "$domain" --arg cf "$cert_f" --arg kf "$key_f" \
           '(.Nodes[].CertConfig) = {"CertMode":"file","RejectUnknownSni":false,"CertDomain":$dom,"CertFile":$cf,"KeyFile":$kf,"Email":"admin@v2bx.com"}' \
           "$config_file" > "$tmp_j" && mv -f "$tmp_j" "$config_file"
        echo -e " ${green}✔ 已挂载至所有节点！${plain}"
        restart_v2bx_service
    elif [[ "$target_id" =~ ^[0-9]+$ ]]; then
        if ! jq -e --argjson nid "$target_id" '(.Nodes // [])[] | select(.NodeID == $nid)' "$config_file" >/dev/null 2>&1; then
            echo -e " ${red}✖ 未找到 NodeID: ${target_id}，请核对上方节点列表！${plain}"
            return
        fi
        jq --argjson nid "$target_id" --arg dom "$domain" --arg cf "$cert_f" --arg kf "$key_f" \
           '(.Nodes[] | select(.NodeID == $nid) | .CertConfig) = {"CertMode":"file","RejectUnknownSni":false,"CertDomain":$dom,"CertFile":$cf,"KeyFile":$kf,"Email":"admin@v2bx.com"}' \
           "$config_file" > "$tmp_j" && mv -f "$tmp_j" "$config_file"
        echo -e " ${green}✔ 已挂载至 NodeID: ${target_id}！${plain}"
        restart_v2bx_service
    fi
    rm -f "$tmp_j"
}

external_acme_console() {
    local r_cmd="if [ -f /etc/V2bX/nodes/.multi_enabled ]; then systemctl restart 'v2bx@*' 2>/dev/null || for s in /etc/init.d/v2bx.node_*; do [ -x \"\$s\" ] && \"\$s\" restart; done; else systemctl restart V2bX 2>/dev/null || { [ -x /etc/init.d/V2bX ] && /etc/init.d/V2bX restart; }; fi || true"

    while true; do
        ui_banner
        ui_section "🔐 独立外置 ACME.sh 证书管理控制台"
        echo -e "  ${cyan}[1]${plain} 🌐 Cloudflare DNS API 模式申请 ${dim}(免80端口 / 支持套CDN / 自动续签)${plain}"
        echo -e "  ${cyan}[2]${plain} ⚡ HTTP 80 端口独立模式申请 ${dim}(需80端口空闲)${plain}"
        echo -e "  ${cyan}[3]${plain} 🔄 手动强制续签所有外置证书"
        echo -e "  ${cyan}[4]${plain} 📋 查看本地已安装的证书详情"
        echo -e "  ${cyan}[5]${plain} 🔗 将已有证书一键绑定到指定 NodeID"
        echo -e "  ${cyan}[0]${plain} 🔙 返回上级菜单"
        ui_line
        echo -ne " ${bold}▸ 请选择操作${plain} [0-5]: "
        read -r acme_opt < /dev/tty

        case "$acme_opt" in
            1)
                install_acme_sh
                local saved_cf_token=""
                [[ -f "$acme_env_file" ]] && source "$acme_env_file" 2>/dev/null
                echo -ne " ${bold}▸ 请输入要申请证书的域名${plain} (如 node1.example.com): "
                read -r domain < /dev/tty
                [[ -z "$domain" ]] && continue

                if [[ -n "$saved_cf_token" ]]; then
                    echo -ne " ${bold}▸ Cloudflare API Token${plain} ${dim}[回车使用已保存 Token]${plain}: "
                    read -r in_token < /dev/tty
                    cf_token=${in_token:-"$saved_cf_token"}
                else
                    echo -ne " ${bold}▸ 请输入 Cloudflare API Token${plain}: "
                    read -r cf_token < /dev/tty
                fi
                [[ -z "$cf_token" ]] && echo -e " ${red}✖ Token 不能为空！${plain}" && sleep 1 && continue

                echo "saved_cf_token=\"$cf_token\"" > "$acme_env_file"
                chmod 600 "$acme_env_file"
                unset CF_Key CF_Email
                export CF_Token="$cf_token"

                echo -e "\n ${cyan}正在通过 Cloudflare DNS 验证申请 ECC 证书 (${domain})...${plain}"
                if ~/.acme.sh/acme.sh --issue --dns dns_cf -d "$domain" --keylength ec-256 --force; then
                    local cert_f="/etc/V2bX/${domain}.cert.pem"
                    local key_f="/etc/V2bX/${domain}.key.pem"
                    ~/.acme.sh/acme.sh --install-cert -d "$domain" --ecc \
                        --fullchain-file "$cert_f" \
                        --key-file "$key_f" \
                        --reloadcmd "$r_cmd"
                    ln -sf "$cert_f" /etc/V2bX/fullchain.cer
                    ln -sf "$key_f" /etc/V2bX/cert.key
                    echo -e "\n ${green}✔ 证书签发成功！已启用定时自动续签与单/多进程自适应重启。${plain}"
                    acme_bind_to_node "$domain" "$cert_f" "$key_f"
                else
                    echo -e "\n ${red}✖ 证书申请失败！${plain}"
                fi
                echo -ne "\n ${dim}按回车键继续...${plain}"; read -r < /dev/tty
                ;;
            2)
                install_acme_sh
                local port80_proc
                port80_proc=$( (ss -tlnp 2>/dev/null || ss -tln 2>/dev/null || netstat -tlnp 2>/dev/null || netstat -tln 2>/dev/null) | grep -E '[:.]80[[:space:]]' | head -n1 )
                if [[ -n "$port80_proc" ]]; then
                    echo -e "\n ${red}✖ 检测到 80 端口当前已被占用，无法使用 HTTP 独立模式！${plain}"
                    echo -e " ${dim}占用信息: ${port80_proc}${plain}"
                    echo -e " ${yellow}💡 建议：先停止占用 80 端口的程序，或改用选项 [1] Cloudflare DNS 模式申请。${plain}"
                    echo -ne "\n ${dim}按回车键继续...${plain}"; read -r < /dev/tty
                    continue
                fi

                echo -ne " ${bold}▸ 请输入已解析到本机的域名${plain}: "
                read -r domain < /dev/tty
                [[ -z "$domain" ]] && continue
                if ~/.acme.sh/acme.sh --issue -d "$domain" --standalone --keylength ec-256 --force; then
                    local cert_f="/etc/V2bX/${domain}.cert.pem"
                    local key_f="/etc/V2bX/${domain}.key.pem"
                    ~/.acme.sh/acme.sh --install-cert -d "$domain" --ecc \
                        --fullchain-file "$cert_f" \
                        --key-file "$key_f" \
                        --reloadcmd "$r_cmd"
                    echo -e "\n ${green}✔ 证书签发成功！${plain}"
                    acme_bind_to_node "$domain" "$cert_f" "$key_f"
                else
                    echo -e "\n ${red}✖ 申请失败，请确认域名 A/AAAA 记录已正确解析到本机公网 IP。${plain}"
                fi
                echo -ne "\n ${dim}按回车键继续...${plain}"; read -r < /dev/tty
                ;;
            3)
                install_acme_sh
                ~/.acme.sh/acme.sh --cron --force
                echo -e " ${green}✔ 强制续签任务执行完毕！${plain}"
                echo -ne "\n ${dim}按回车键继续...${plain}"; read -r < /dev/tty
                ;;
            4)
                echo -e "\n ${bold}/etc/V2bX/ 目录下的证书文件状态：${plain}"
                local found_cert=false
                for f in /etc/V2bX/*.cert.pem /etc/V2bX/*.cer; do
                    [[ ! -e "$f" || -L "$f" ]] && continue
                    found_cert=true
                    local exp_d subj_d
                    exp_d=$(openssl x509 -enddate -noout -in "$f" 2>/dev/null | cut -d= -f2)
                    subj_d=$(openssl x509 -subject -noout -in "$f" 2>/dev/null | sed 's/.*CN *= *//')
                    echo -e "  🟢 文件: ${cyan}${f}${plain} | 域名: ${subj_d} | 到期: ${green}${exp_d}${plain}"
                done
                [[ "$found_cert" = false ]] && echo -e "  ${yellow}暂无本地独立证书文件。${plain}"
                echo -ne "\n ${dim}按回车键继续...${plain}"; read -r < /dev/tty
                ;;
            5)
                echo -e "\n ${dim}本地已有证书列表：${plain}"
                for f in /etc/V2bX/*.cert.pem; do
                    [[ ! -e "$f" || -L "$f" ]] && continue
                    echo -e "  ▸ $(basename "$f" .cert.pem)"
                done
                echo -ne " ${bold}▸ 请输入要绑定的域名${plain}: "
                read -r b_dom < /dev/tty
                if [[ -f "/etc/V2bX/${b_dom}.cert.pem" ]]; then
                    acme_bind_to_node "$b_dom" "/etc/V2bX/${b_dom}.cert.pem" "/etc/V2bX/${b_dom}.key.pem"
                else
                    echo -e " ${red}✖ 未找到 /etc/V2bX/${b_dom}.cert.pem${plain}"
                fi
                echo -ne "\n ${dim}按回车键继续...${plain}"; read -r < /dev/tty
                ;;
            0|*) break ;;
        esac
    done
}

# ════════════════════ 4. 节点精准删除与闲置内核清理 ════════════════════
remove_single_node() {
    ui_banner
    ui_section "🗑️ 现有节点精准管理与移除"
    if [[ ! -f "$config_file" ]] || ! jq -e . "$config_file" >/dev/null 2>&1; then
        echo -e " ${red}✖ 配置文件不存在或损坏！${plain}"; return
    fi
    echo -e " 当前已挂载的节点列表："
    jq -r '(.Nodes // []) | to_entries[] | "  [\(.key + 1)] NodeID: \(.value.NodeID) | 内核: \(.value.Core) | 协议: \(.value.NodeType)"' "$config_file"
    ui_line
    echo -ne " ${bold}▸ 请输入要删除的 NodeID${plain} (直接回车取消): "
    read -r del_id < /dev/tty
    [[ ! "$del_id" =~ ^[0-9]+$ ]] && return

    if ! jq -e --argjson id "$del_id" '(.Nodes // [])[] | select(.NodeID == $id)' "$config_file" >/dev/null 2>&1; then
        echo -e " ${red}✖ 未找到 NodeID: ${del_id}，请核对上方列表！${plain}"
        return
    fi

    local tmp_d="/tmp/v2bx_del_${RANDOM}.json"
    if jq --argjson id "$del_id" '
        del(.Nodes[] | select(.NodeID == $id))
        | ([.Nodes[].Core] | unique) as $active_cores
        | .Cores = [(.Cores // [])[] | select(.Type as $t | $active_cores | index($t))]
    ' "$config_file" > "$tmp_d" 2>/dev/null; then
        if jq -e . "$tmp_d" >/dev/null 2>&1; then
            mv -f "$tmp_d" "$config_file"
            echo -e " ${green}✔ 已安全移除 NodeID: ${del_id} 并清理闲置内核！${plain}"
            restart_v2bx_service
        else
            echo -e " ${red}✖ 移除逻辑导致配置毁损，已取消操作！${plain}"
        fi
    else
        echo -e " ${red}✖ 移除失败！${plain}"
    fi
    rm -f "$tmp_d"
}

# ════════════════════ 5. 在线自更新 ════════════════════
update_self_script() {
    ui_banner
    ui_section "🔄 正在同步云端最新 all/xmm12 脚本"
    local tmp_new="/tmp/xmm12_update_${RANDOM}"
    local urls=(
        "https://ghp.ci/https://raw.githubusercontent.com/yunfeibuzai/xmm/main/all/xmm12"
        "https://mirror.ghproxy.net/https://raw.githubusercontent.com/yunfeibuzai/xmm/main/all/xmm12"
        "https://raw.githubusercontent.com/yunfeibuzai/xmm/main/all/xmm12"
    )

    local success=false
    for url in "${urls[@]}"; do
        if curl -sSfL --connect-timeout 8 "$url" -o "$tmp_new" || wget -q --timeout=10 -O "$tmp_new" "$url"; then
            if [[ -f "$tmp_new" && -s "$tmp_new" ]] && grep -q "sh_ver=" "$tmp_new"; then
                success=true; break
            fi
        fi
    done

    if [ "$success" = true ]; then
        local new_ver; new_ver=$(grep -m1 '^sh_ver=' "$tmp_new" | cut -d'"' -f2)
        local real_me
        real_me=$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")
        if [[ -f "$real_me" && "$real_me" != "/usr/local/bin/xmm12" ]]; then
            cp -f "$tmp_new" "$real_me" 2>/dev/null
            chmod +x "$real_me" 2>/dev/null
        fi
        cp -f "$tmp_new" /usr/local/bin/xmm12 2>/dev/null
        chmod +x /usr/local/bin/xmm12 2>/dev/null
        rm -f "$tmp_new"
        echo -e " ${green}✔ all/xmm12 已成功更新至 v${new_ver}！${plain}"
        sleep 1
        exec bash "/usr/local/bin/xmm12"
    else
        rm -f "$tmp_new"
        echo -e " ${red}✖ 更新失败，可能遭遇网络阻断，请稍后重试！${plain}"
    fi
}

