#!/usr/bin/env bash

# 麦卖云 V2bX 节点管理 • 克隆复用 • 体检 • 外置 ACME 证书中心 (all/xmm12)
sh_ver="5.0.1-Pro"

# 0. POSIX /bin/sh 自愈引导
if [ -z "$BASH_VERSION" ]; then
    if ! command -v bash >/dev/null 2>&1; then
        if command -v apk >/dev/null 2>&1; then
            apk update >/dev/null 2>&1 && apk add --no-cache bash >/dev/null 2>&1
        else
            printf '错误：当前系统缺少 bash，请先安装 bash！\n'
            exit 1
        fi
    fi
    [ -f "$0" ] && exec bash "$0" "$@" || exec bash -s -- "$@"
fi

red='\033[31m'; green='\033[32m'; yellow='\033[33m'
magenta='\033[35m'; cyan='\033[36m'; bold='\033[1m'; plain='\033[0m'
dim='\033[2m'

[[ $EUID -ne 0 ]] && echo -e "${red}错误：${plain}必须使用 root 用户运行此脚本！\n" && exit 1

mkdir -p /etc/V2bX /etc/V2bX/nodes /var/log/V2bX
saved_file="/etc/V2bX/.saved_creds"
acme_env_file="/etc/V2bX/.acme_cf.env"
config_file="/etc/V2bX/config.json"

REPO_RAW_BASE="https://raw.githubusercontent.com/yunfeibuzai/xmm/main"
GH_MIRRORS=(
    "https://gh-proxy.com/"
    "https://ghproxy.net/"
    "https://github.akams.cn/"
    "https://ghproxy.homeboyc.cn/"
    ""
)

is_systemd() {
    command -v systemctl &>/dev/null && [[ -d /run/systemd/system ]]
}

# ════════════════════ 依赖组件安全补齐 ════════════════════
ensure_tools() {
    local need=0
    for c in jq openssl socat curl python3 pgrep; do
        command -v "$c" &>/dev/null || need=1
    done
    if [[ $need -eq 1 ]]; then
        echo -e " ${yellow}正在补齐必要运维组件 (jq / openssl / socat / python3)...${plain}"
        if command -v apt-get &>/dev/null; then
            DEBIAN_FRONTEND=noninteractive apt-get update -y -q >/dev/null 2>&1
            DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends jq openssl socat cron curl iproute2 python3 procps >/dev/null 2>&1
        elif command -v yum &>/dev/null; then
            yum install -y jq openssl socat cronie curl iproute python3 procps-ng >/dev/null 2>&1
        elif command -v apk &>/dev/null; then
            apk update >/dev/null 2>&1
            apk add --no-cache jq openssl socat cronie curl bash coreutils iproute2 python3 procps >/dev/null 2>&1
            rc-update add crond default 2>/dev/null && rc-service crond start >/dev/null 2>&1
        fi
    fi
}
ensure_tools

# ════════════════════ 多镜像安全拉取器 (GNU & BusyBox 双兼容) ════════════════════
fetch_github_module() {
    local rel_path="$1"
    local dest_file="$2"
    local verify_pat="${3:-}"
    for mirror in "${GH_MIRRORS[@]}"; do
        local url="${mirror}${REPO_RAW_BASE}/${rel_path}"
        rm -f "$dest_file"
        if command -v curl &>/dev/null; then
            curl -fsSL --connect-timeout 4 --max-time 15 "$url" -o "$dest_file" 2>/dev/null
        fi
        if [[ ! -s "$dest_file" ]] && command -v wget &>/dev/null; then
            if wget --help 2>&1 | grep -q -- '--tries'; then
                wget -q --timeout=8 --tries=1 --no-check-certificate -O "$dest_file" "$url" 2>/dev/null
            else
                wget -q -T 8 -O "$dest_file" "$url" 2>/dev/null
            fi
        fi
        if [[ -s "$dest_file" ]] && ! head -n 5 "$dest_file" | grep -qiE '<!doctype|<html'; then
            if [[ -n "$verify_pat" ]] && ! grep -q "$verify_pat" "$dest_file"; then
                continue
            fi
            sed -i 's/\r$//' "$dest_file" 2>/dev/null
            if bash -n "$dest_file" 2>/dev/null; then
                return 0
            fi
        fi
    done
    rm -f "$dest_file"
    return 1
}

# ════════════════════ 本地有效证书嗅探器 ════════════════════
find_local_valid_cert() {
    local target_domain="$1"
    [[ -z "$target_domain" || "$target_domain" == "-" ]] && return 1
    python3 - "$target_domain" <<'PYEOF'
import os, re, subprocess, sys

td = sys.argv[1].strip().lower()
wildcard = "*." + td.split(".", 1)[1] if "." in td else ""
search_dirs = ["/etc/V2bX", "/etc/V2bX/cert", "/etc/V2bX/certs", "/root/.acme.sh"]
scanned = set()
exact_match = None
wild_match = None

for base_dir in search_dirs:
    if not os.path.isdir(base_dir):
        continue
    for root, _, files in os.walk(base_dir):
        for fn in files:
            if not fn.lower().endswith((".crt", ".pem", ".cer")):
                continue
            if "ca.cer" in fn.lower() or ("chain" in fn.lower() and "fullchain" not in fn.lower()):
                continue
            c_path = os.path.join(root, fn)
            if c_path in scanned:
                continue
            scanned.add(c_path)

            chk = subprocess.run(
                ["openssl", "x509", "-in", c_path, "-noout", "-checkend", "86400", "-ext", "subjectAltName", "-subject"],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True
            )
            if chk.returncode != 0:
                continue

            stem = os.path.splitext(fn)[0].replace("_ecc", "").replace("fullchain", "")
            k_candidates = [
                os.path.splitext(c_path)[0] + ".key",
                os.path.join(root, stem + ".key") if stem else "",
                os.path.join(root, os.path.basename(root).replace("_ecc", "") + ".key"),
                os.path.join(root, "privkey.pem"),
                os.path.join(root, "private.key"),
            ]
            k_path = next((kp for kp in k_candidates if kp and os.path.isfile(kp) and os.path.getsize(kp) > 0), "")
            if not k_path:
                for f2 in files:
                    if f2.lower().endswith(".key"):
                        k_path = os.path.join(root, f2)
                        break
            if not k_path:
                continue

            domains = [d.lower() for d in re.findall(r'DNS:([^\s,]+)', chk.stdout)]
            cn_m = re.search(r'CN\s*=\s*([^\s,/]+)', chk.stdout)
            if cn_m:
                domains.append(cn_m.group(1).lower())

            if td in domains and not exact_match:
                exact_match = (c_path, k_path)
            elif wildcard and wildcard in domains and not wild_match:
                wild_match = (c_path, k_path)

res = exact_match or wild_match
if res:
    print(f"{res[0]}|{res[1]}")
PYEOF
}

# ════════════════════ UI 组件库 ════════════════════
ui_line() {
    echo -e "${dim}────────────────────────────────────────────────────────${plain}"
}

detect_multi_active() {
    shopt -s nullglob
    local split_files=(/etc/V2bX/nodes/port_*.json /etc/V2bX/nodes/node_*.json)
    shopt -u nullglob
    local active_cnt=0
    for f in "${split_files[@]}"; do
        local inst; inst=$(basename "$f" .json)
        if is_systemd && systemctl is-active --quiet "v2bx@${inst}.service" 2>/dev/null; then
            ((active_cnt++))
        elif pgrep -f "/etc/V2bX/nodes/${inst}.json" >/dev/null 2>&1; then
            ((active_cnt++))
        fi
    done

    if [[ $active_cnt -gt 0 ]] || [[ -f /etc/V2bX/nodes/.multi_enabled && ${#split_files[@]} -gt 0 ]]; then
        return 0
    fi
    return 1
}

