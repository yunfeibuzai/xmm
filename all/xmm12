# ════════════════════ 2. 识别本机已有配置并改 NodeID 直接复用 ════════════════════
list_local_node_templates() {
    python3 - <<'PYEOF'
import json, os, re

files = []
if os.path.isfile("/etc/V2bX/config.json"):
    files.append("/etc/V2bX/config.json")
if os.path.isdir("/etc/V2bX/nodes"):
    for fn in sorted(os.listdir("/etc/V2bX/nodes")):
        if fn.endswith(".json"):
            files.append(os.path.join("/etc/V2bX/nodes", fn))

nodes_map = {}
for fp in files:
    try:
        raw = open(fp, "r", encoding="utf-8").read()
        try:
            data = json.loads(raw)
        except Exception:
            data = json.loads(re.sub(r'(?<!:)//.*', '', raw))
        for n in data.get("Nodes", []):
            nid = str(n.get("NodeID", ""))
            if nid:
                nodes_map[nid] = n
    except Exception:
        pass

for idx, (nid, n) in enumerate(nodes_map.items(), 1):
    core = n.get("Core", "xray")
    ntype = n.get("NodeType", "unknown")
    cert = n.get("CertConfig") or {}
    cmode = cert.get("CertMode", "none")
    cdom = cert.get("CertDomain", "") or "-"
    host = n.get("ApiHost", "")
    print(f"{idx}|{nid}|{ntype}|{core}|{cmode}|{cdom}|{host}")
PYEOF
}

clone_from_local_config() {
    ui_banner
    ui_section "♻️ 识别本机已有配置 ➔ 改 NodeID 直接复用"
    local tpl_list
    tpl_list=$(list_local_node_templates)
    if [[ -z "$tpl_list" ]]; then
        echo -e " ${red}✖ 未在本机扫描到任何有效的历史节点配置！请先使用选项 [1] 新增节点。${plain}"
        return 1
    fi

    printf " ${yellow}%-5s %-9s %-12s %-10s %-10s %-26s${plain}\n" "序号" "NodeID" "协议类型" "内核" "证书模式" "绑定域名"
    ui_line
    local total_tpl=0
    while IFS='|' read -r idx nid ntype core cmode cdom host; do
        [[ -z "$idx" ]] && continue
        printf " ${green}[%-1s]${plain}   %-9s %-12s %-10s %-10s %-26s\n" "$idx" "$nid" "$ntype" "$core" "$cmode" "$cdom"
        ((total_tpl++))
    done <<< "$tpl_list"
    ui_line

    echo -ne " ${bold}▸ 请选择要克隆复用的模板【序号】${plain} [1-${total_tpl}, 回车取消]: "
    read -r tpl_idx < /dev/tty
    [[ -z "$tpl_idx" ]] && return 0
    if [[ ! "$tpl_idx" =~ ^[0-9]+$ ]] || [[ "$tpl_idx" -lt 1 ]] || [[ "$tpl_idx" -gt "$total_tpl" ]]; then
        echo -e " ${red}✖ 序号无效！${plain}"
        return 1
    fi

    local chosen_line src_nid src_type src_core src_cmode src_cdom
    chosen_line=$(echo "$tpl_list" | sed -n "${tpl_idx}p")
    src_nid=$(echo "$chosen_line" | cut -d'|' -f2)
    src_type=$(echo "$chosen_line" | cut -d'|' -f3)
    src_core=$(echo "$chosen_line" | cut -d'|' -f4)
    src_cmode=$(echo "$chosen_line" | cut -d'|' -f5)
    src_cdom=$(echo "$chosen_line" | cut -d'|' -f6)

    echo -e "\n 已选定模板: ${green}NodeID ${src_nid}${plain} (${src_type} / ${src_core} / 证书: ${src_cmode})"
    if [[ "$src_type" =~ ^(hysteria2|tuic|hysteria)$ ]]; then
        echo -e " ${yellow}💡 提示：UDP 协议 (${src_type}) 同机复用时，请在面板后台为新 NodeID 分配不同的端口。${plain}"
    elif [[ "$src_cmode" != "none" ]]; then
        echo -e " ${yellow}💡 提示：CF CDN / TLS 节点同机复用时，建议在面板后台错开端口 (如 443/2053/2083/2087/2096/8443)。${plain}"
    fi

    echo -e "\n ${cyan}[1] 追加为新节点${plain} ${dim}(保留本机原有节点，将新 NodeID 加入配置，推荐)${plain}"
    echo -e " ${cyan}[2] 覆盖替换原有配置${plain} ${dim}(清空原有节点，仅保留这个新 NodeID)${plain}"
    echo -ne " ${bold}▸ 请选择写入方式${plain} [1-2, 默认 1]: "
    read -r write_mode < /dev/tty
    [[ -z "$write_mode" ]] && write_mode="1"

    local batch_count=0
    while true; do
        local new_nid=""
        while [[ ! "$new_nid" =~ ^[0-9]+$ ]]; do
            echo -ne "\n ${bold}▸ 请输入新的 NodeID${plain} (纯数字): "
            read -r new_nid < /dev/tty
        done

        local new_domain="" effective_domain="$src_cdom"
        if [[ "$src_cmode" != "none" ]]; then
            echo -ne " ${bold}▸ 确认域名${plain} ${dim}[回车直接复用原域名与证书 (${src_cdom})，或输入新域名]${plain}: "
            read -r new_domain < /dev/tty
            [[ -n "$new_domain" ]] && effective_domain="$new_domain"
        fi

        local cert_hint=""
        if [[ "$src_cmode" != "none" && -n "$effective_domain" && "$effective_domain" != "-" ]]; then
            cert_hint=$(find_local_valid_cert "$effective_domain")
        fi

        export SRC_NID="$src_nid" NEW_NID="$new_nid" NEW_DOMAIN="$new_domain" CERT_HINT="$cert_hint" WRITE_MODE="$write_mode" BATCH_IDX="$batch_count"
        python3 - <<'PYEOF'
import copy, json, os, re, sys

src_nid = os.environ["SRC_NID"]
new_nid = int(os.environ["NEW_NID"])
new_domain = os.environ.get("NEW_DOMAIN", "").strip()
cert_hint = os.environ.get("CERT_HINT", "").strip()
write_mode = os.environ.get("WRITE_MODE", "1")
batch_idx = int(os.environ.get("BATCH_IDX", "0"))

def load_json_relaxed(path):
    raw = open(path, "r", encoding="utf-8").read()
    try:
        return json.loads(raw)
    except Exception:
        return json.loads(re.sub(r'(?<!:)//.*', '', raw))

master_path = "/etc/V2bX/config.json"
cfg = load_json_relaxed(master_path) if os.path.isfile(master_path) else {
    "Log": {"Level": "error", "Output": ""},
    "Runtime": {"GCPercent": 50, "MemoryLimitPercent": 70},
    "Cores": [],
    "Nodes": []
}

tpl_node = None
tpl_core_obj = None
search_files = [master_path]
if os.path.isdir("/etc/V2bX/nodes"):
    for fn in sorted(os.listdir("/etc/V2bX/nodes")):
        if fn.endswith(".json"):
            search_files.append(os.path.join("/etc/V2bX/nodes", fn))

for fp in search_files:
    if not os.path.isfile(fp):
        continue
    try:
        d = load_json_relaxed(fp)
        for n in d.get("Nodes", []):
            if str(n.get("NodeID", "")) == src_nid:
                tpl_node = copy.deepcopy(n)
                c_type = str(n.get("Core", "xray")).lower()
                for c in d.get("Cores", []):
                    if str(c.get("Type", "")).lower() == c_type:
                        tpl_core_obj = copy.deepcopy(c)
    except Exception:
        pass

if not tpl_node:
    print("  [错误] 找不到源节点模板！", file=sys.stderr)
    sys.exit(1)

cloned = copy.deepcopy(tpl_node)
cloned["NodeID"] = new_nid

cert = cloned.get("CertConfig") or {}
old_dom = str(cert.get("CertDomain", ""))
target_dom = new_domain if new_domain else old_dom
if new_domain:
    cert["CertDomain"] = new_domain

if cert_hint and "|" in cert_hint:
    cp, kp = cert_hint.split("|", 1)
    prev_mode = str(cert.get("CertMode", "")).lower()
    cert["CertMode"] = "file"
    cert["CertFile"] = cp
    cert["KeyFile"] = kp
    if prev_mode in ("http", "dns"):
        print(f"  [证书免重申] 域名 {target_dom} 命中本机有效证书，已自动从 {prev_mode} 转为 file 模式 -> {cp}")
    elif new_domain:
        print(f"  [证书复用] 新域名 {target_dom} 已命中本机有效证书 -> {cp}")
elif new_domain and cert.get("CertMode") == "file" and old_dom and old_dom in str(cert.get("CertFile", "")):
    cert["CertFile"] = str(cert["CertFile"]).replace(old_dom, new_domain)
    cert["KeyFile"] = str(cert["KeyFile"]).replace(old_dom, new_domain)

if cert:
    cloned["CertConfig"] = cert

needed_core = str(cloned.get("Core", "xray")).lower()
existing_cores = {str(c.get("Type", "")).lower() for c in cfg.get("Cores", [])}
if needed_core not in existing_cores:
    if tpl_core_obj:
        cfg.setdefault("Cores", []).append(tpl_core_obj)
    elif needed_core == "xray":
        cfg.setdefault("Cores", []).append({
            "Type": "xray",
            "Log": {"Level": "error", "AccessPath": "", "ErrorPath": "/etc/V2bX/error.log", "MaxSize": 100, "MaxBackups": 0, "MaxDays": 90, "Compress": True},
            "AssetPath": "/etc/V2bX/",
            "DnsConfigPath": "/etc/V2bX/dns.json",
            "OutboundConfigPath": "/etc/V2bX/custom_outbound.json",
            "RouteConfigPath": "/etc/V2bX/route.json",
            "XrayConnectionConfig": {"handshake": 4, "connIdle": 120, "uplinkOnly": 2, "downlinkOnly": 4, "bufferSize": 64}
        })
    elif needed_core == "sing":
        cfg.setdefault("Cores", []).append({
            "Type": "sing",
            "Log": {"Level": "error", "Timestamp": True},
            "NTP": {"Enable": False, "Server": "time.apple.com", "ServerPort": 0},
            "OriginalPath": "/etc/V2bX/sing_origin.json"
        })
    elif needed_core == "hysteria2":
        cfg.setdefault("Cores", []).append({"Type": "hysteria2", "Log": {"Level": "error"}})

if write_mode == "2" and batch_idx == 0:
    cfg["Nodes"] = [cloned]
else:
    nodes = [n for n in cfg.get("Nodes", []) if int(n.get("NodeID", -1)) != new_nid]
    nodes.append(cloned)
    cfg["Nodes"] = nodes

tmp_p = master_path + ".tmp"
with open(tmp_p, "w", encoding="utf-8") as f:
    json.dump(cfg, f, indent=2, ensure_ascii=False)
os.replace(tmp_p, master_path)
print(f"  ✔ 已成功克隆生成 NodeID: {new_nid} ({cloned.get('NodeType')} / {cloned.get('Core')})")
PYEOF
        [[ $? -ne 0 ]] && return 1
        ((batch_count++))

        echo -ne "\n ${bold}▸ 是否继续基于此模板复用下一个 NodeID？${plain} [y/N, 默认 N]: "
        read -r more_clone < /dev/tty
        [[ ! "$more_clone" =~ ^[Yy]$ ]] && break
    done

    echo -e "\n ${green}✔ 共完成 ${batch_count} 个节点配置复用并写入 /etc/V2bX/config.json！${plain}"
    choose_and_apply_run_mode
    return 0
}

# ════════════════════ 3. 面板对接与网络“红绿灯”四维体检中心 ════════════════════
traffic_light_health_check() {
    ui_banner
    ui_section "🚦 面板对接与网络“红绿灯”四维全景体检中心"

    if [[ ! -f "$config_file" ]] || ! jq -e . "$config_file" >/dev/null 2>&1; then
        echo -e " ${red}🔴 [红灯] /etc/V2bX/config.json 不存在或配置结构被破坏！${plain}"
        return
    fi

    local is_multi=false
    detect_multi_active && is_multi=true

    local proc_cnt
    proc_cnt=$(pgrep -f "[/]usr/local/V2bX/V2bX server" 2>/dev/null | wc -l | tr -d ' ')
    if [[ "${proc_cnt:-0}" -gt 0 ]]; then
        echo -e " 🟢 ${green}[进程状态]${plain} V2bX 正在运行 (共 ${proc_cnt} 个活跃进程 | 模式: $([[ "$is_multi" = true ]] && echo "多进程隔离" || echo "单进程"))"
    else
        echo -e " 🔴 ${red}[进程状态]${plain} V2bX 核心进程未运行！"
    fi

    local listen_snapshot=""
    listen_snapshot=$(ss -tuln 2>/dev/null || netstat -tuln 2>/dev/null)

    ui_line
    echo -e " ${bold}正在逐节点执行 API 握手、端口监听与证书有效期巡检...${plain}\n"

    local node_len
    node_len=$(jq '(.Nodes // []) | length' "$config_file")
    if [[ "$node_len" -eq 0 ]]; then
        echo -e " ${yellow}🟡 [黄灯] 当前配置文件中没有任何节点${plain}"
        return
    fi

    local i=0
    while [[ $i -lt $node_len ]]; do
        local c_core c_host c_key c_id c_type c_cmode c_cfile
        c_core=$(jq -r ".Nodes[$i].Core // \"xray\"" "$config_file")
        c_host=$(jq -r ".Nodes[$i].ApiHost // \"\"" "$config_file")
        c_key=$(jq -r ".Nodes[$i].ApiKey // \"\"" "$config_file")
        c_id=$(jq -r ".Nodes[$i].NodeID // 0" "$config_file")
        c_type=$(jq -r ".Nodes[$i].NodeType // \"vless\"" "$config_file")
        c_cmode=$(jq -r ".Nodes[$i].CertConfig.CertMode // \"none\"" "$config_file")
        c_cfile=$(jq -r ".Nodes[$i].CertConfig.CertFile // \"\"" "$config_file")

        if [[ "$is_multi" = true ]] && compgen -G "/etc/V2bX/nodes/*.json" >/dev/null 2>&1; then
            local split_cert_info
            split_cert_info=$(jq -r --argjson nid "$c_id" '(.Nodes // [])[] | select(.NodeID == $nid) | "\(.CertConfig.CertMode // "")|\(.CertConfig.CertFile // "")"' /etc/V2bX/nodes/*.json 2>/dev/null | head -n1)
            if [[ -n "$split_cert_info" && "$split_cert_info" != "|" ]]; then
                c_cmode="${split_cert_info%%|*}"
                c_cfile="${split_cert_info##*|}"
            fi
        fi

        c_host="${c_host%/}"
        local test_url="${c_host}/api/v1/server/UniProxy/config?node_id=${c_id}&node_type=${c_type}&token=${c_key}"
        local resp_file="/tmp/v2bx_diag_${RANDOM}.json"
        local http_code curl_rc
        http_code=$(curl -sL -w "%{http_code}" --connect-timeout 8 --max-time 12 -o "$resp_file" "$test_url" 2>/dev/null)
        curl_rc=$?

        echo -e "${cyan}${bold}┌── 节点 #$((i+1)) [NodeID: ${c_id} | 内核: ${c_core} | 协议: ${c_type}]${plain}"
        echo -e "│ 对接面板: ${c_host}"

        local srv_port=""
        if [[ "$http_code" == "200" ]]; then
            if jq -e 'type == "object" and (has("server_port") or has("port") or has("base_config") or has("protocol"))' "$resp_file" >/dev/null 2>&1; then
                srv_port=$(jq -r '.server_port // .port // ""' "$resp_file" 2>/dev/null)
                echo -e "│ API 握手: 🟢 ${green}[绿灯正常] (HTTP 200) — 下发端口: ${srv_port:-动态}${plain}"
            else
                echo -e "│ API 握手: 🟡 ${yellow}[黄灯异常] (HTTP 200 但返回非 JSON，可能被 CDN/WAF 拦截)${plain}"
            fi
        elif [[ "$http_code" == "000" ]]; then
            local net_reason="网络不通或连接重置"
            case "$curl_rc" in
                6) net_reason="面板域名 DNS 解析失败" ;;
                7) net_reason="面板服务器拒绝连接 (端口未开或防火墙拦截)" ;;
                28) net_reason="连接面板超时 (网络阻断或面板过载)" ;;
                35|51|60) net_reason="SSL/TLS 握手或证书校验失败" ;;
            esac
            echo -e "│ API 握手: 🔴 ${red}[红灯断联] (${net_reason})${plain}"
        elif [[ "$http_code" == "401" || "$http_code" == "403" || "$http_code" == "500" ]]; then
            local err_msg
            err_msg=$(jq -r '.message // "密钥错误或 NodeID 不存在"' "$resp_file" 2>/dev/null | head -c 60)
            echo -e "│ API 握手: 🔴 ${red}[红灯拒绝] (HTTP ${http_code}) — 原因: ${err_msg}${plain}"
        else
            echo -e "│ API 握手: 🟡 ${yellow}[黄灯异常] (HTTP ${http_code})${plain}"
        fi
        rm -f "$resp_file"

        if [[ "$is_multi" = true ]]; then
            local inst_n=""
            if [[ -n "$srv_port" && -f "/etc/V2bX/nodes/port_${srv_port}.json" ]]; then
                inst_n="port_${srv_port}"
            elif [[ -f "/etc/V2bX/nodes/node_${c_id}_${c_type}.json" ]]; then
                inst_n="node_${c_id}_${c_type}"
            fi

            if [[ -n "$inst_n" ]]; then
                if systemctl is-active --quiet "v2bx@${inst_n}.service" 2>/dev/null || \
                   rc-service "v2bx_${inst_n}" status 2>/dev/null | grep -q "started" || \
                   rc-service "v2bx.${inst_n}" status 2>/dev/null | grep -q "started" || \
                   pgrep -f "/etc/V2bX/nodes/${inst_n}.json" >/dev/null 2>&1; then
                    echo -e "│ 隔离实例: 🟢 ${green}[运行中] (${inst_n})${plain}"
                else
                    echo -e "│ 隔离实例: 🔴 ${red}[已停止/熔断] (${inst_n})${plain}"
                fi
            else
                echo -e "│ 隔离实例: 🟡 ${yellow}[未生成对应拆分配置] (建议重新执行同步拆分)${plain}"
            fi
        fi

        if [[ "$srv_port" =~ ^[0-9]+$ ]] && [[ -n "$listen_snapshot" ]]; then
            if echo "$listen_snapshot" | grep -qE "[:.]${srv_port}[[:space:]]"; then
                echo -e "│ 端口监听: 🟢 ${green}[已成功监听 :${srv_port}]${plain}"
            else
                echo -e "│ 端口监听: 🔴 ${red}[未监听 :${srv_port}] (端口被占用或节点启动报错)${plain}"
            fi
        fi

        if [[ "$c_cmode" == "file" ]]; then
            if [[ -f "$c_cfile" && -s "$c_cfile" ]]; then
                local exp_date
                exp_date=$(openssl x509 -enddate -noout -in "$c_cfile" 2>/dev/null | cut -d= -f2)
                if ! openssl x509 -checkend 0 -noout -in "$c_cfile" >/dev/null 2>&1; then
                    echo -e "│ 证书状态: 🔴 ${red}[已过期!] 到期时间: ${exp_date}${plain}"
                elif ! openssl x509 -checkend 1296000 -noout -in "$c_cfile" >/dev/null 2>&1; then
                    echo -e "│ 证书状态: 🟡 ${yellow}[即将过期(<15天)] 到期: ${exp_date}${plain}"
                else
                    echo -e "│ 证书状态: 🟢 ${green}[健康有效] 到期: ${exp_date:-未知}${plain}"
                fi
            else
                echo -e "│ 证书状态: 🔴 ${red}[证书缺失] 找不到: ${c_cfile}${plain}"
            fi
        else
            echo -e "│ 证书状态: 🟢 ${dim}模式: ${c_cmode}${plain}"
        fi
        echo -e "${cyan}${bold}└─────────────────────────────────────────────────────${plain}"
        ((i++))
    done
}

# ════════════════════ 4. 独立外置 ACME.sh 证书控制台 ════════════════════
install_acme_sh() {
    if [[ ! -f ~/.acme.sh/acme.sh ]]; then
        echo -e " ${cyan}正在安装独立 acme.sh 证书引擎...${plain}"
        curl -sL --connect-timeout 10 --max-time 30 https://get.acme.sh | sh -s email=admin@v2bx.com >/dev/null 2>&1
        if [[ -f ~/.acme.sh/acme.sh ]]; then
            ~/.acme.sh/acme.sh --upgrade --auto-upgrade >/dev/null 2>&1
            ~/.acme.sh/acme.sh --set-default-ca --server letsencrypt >/dev/null 2>&1
        fi
    fi
    [[ -f ~/.acme.sh/acme.sh ]]
}

acme_bind_to_node() {
    local domain="$1"
    local cert_f="$2"
    local key_f="$3"

    if [[ ! -f "$config_file" ]]; then return; fi
    echo -ne "\n ${bold}▸ 是否将该证书一键挂载到现有节点 (自动改为 CertMode: file)？${plain} [Y/n]: "
    read -r bind_yn < /dev/tty
    [[ -z "$bind_yn" ]] && bind_yn="y"
    [[ ! "$bind_yn" =~ ^[Yy]$ ]] && return

    echo -e " 当前已配置的节点列表："
    jq -r '(.Nodes // [])[] | "  ▸ NodeID: \(.NodeID)  | 协议: \(.NodeType)  | 证书模式: \(.CertConfig.CertMode)"' "$config_file"
    echo -ne " ${bold}▸ 请输入要绑定此证书的 NodeID${plain} (输入 all 绑定所有): "
    read -r target_id < /dev/tty
    [[ -z "$target_id" ]] && return

    local tmp_j="/tmp/v2bx_cert_bind_${RANDOM}.json"
    if [[ "$target_id" == "all" ]]; then
        jq --arg dom "$domain" --arg cf "$cert_f" --arg kf "$key_f" \
           '(.Nodes[].CertConfig) = {"CertMode":"file","RejectUnknownSni":false,"CertDomain":$dom,"CertFile":$cf,"KeyFile":$kf,"Email":"admin@v2bx.com"}' \
           "$config_file" > "$tmp_j" && mv -f "$tmp_j" "$config_file"
        echo -e " ${green}✔ 已挂载至所有节点！${plain}"
        restart_v2bx_service
    elif [[ "$target_id" =~ ^[0-9]+$ ]]; then
        if ! jq -e --argjson nid "$target_id" '(.Nodes // [])[] | select(.NodeID == $nid)' "$config_file" >/dev/null 2>&1; then
            echo -e " ${red}✖ 未找到 NodeID: ${target_id}，请核对上方节点列表！${plain}"
            return
        fi
        jq --argjson nid "$target_id" --arg dom "$domain" --arg cf "$cert_f" --arg kf "$key_f" \
           '(.Nodes[] | select(.NodeID == $nid) | .CertConfig) = {"CertMode":"file","RejectUnknownSni":false,"CertDomain":$dom,"CertFile":$cf,"KeyFile":$kf,"Email":"admin@v2bx.com"}' \
           "$config_file" > "$tmp_j" && mv -f "$tmp_j" "$config_file"
        echo -e " ${green}✔ 已挂载至 NodeID: ${target_id}！${plain}"
        restart_v2bx_service
    fi
    rm -f "$tmp_j"
}

external_acme_console() {
    local r_cmd="if [ -f /etc/V2bX/nodes/.multi_enabled ]; then systemctl reset-failed 'v2bx@*' 2>/dev/null; systemctl restart 'v2bx@*' 2>/dev/null || for s in /etc/init.d/v2bx_port_* /etc/init.d/v2bx_node_* /etc/init.d/v2bx.port_* /etc/init.d/v2bx.node_*; do [ -x \"\$s\" ] && \"\$s\" restart; done; else systemctl restart V2bX 2>/dev/null || { [ -x /etc/init.d/V2bX ] && /etc/init.d/V2bX restart; }; fi || true"

    while true; do
        ui_banner
        ui_section "🔐 独立外置 ACME.sh 证书管理控制台"
        echo -e "  ${cyan}[1]${plain} 🌐 Cloudflare DNS API 模式申请 ${dim}(免80端口 / 支持套CDN / 自动续签)${plain}"
        echo -e "  ${cyan}[2]${plain} ⚡ HTTP 80 端口独立模式申请 ${dim}(需80端口空闲)${plain}"
        echo -e "  ${cyan}[3]${plain} 🔄 手动强制续签所有外置证书"
        echo -e "  ${cyan}[4]${plain} 📋 查看本地已安装的证书详情"
        echo -e "  ${cyan}[5]${plain} 🔗 将已有证书一键绑定到指定 NodeID"
        echo -e "  ${cyan}[0]${plain} 🔙 返回上级菜单"
        ui_line
        echo -ne " ${bold}▸ 请选择操作${plain} [0-5]: "
        read -r acme_opt < /dev/tty

        case "$acme_opt" in
            1)
                if ! install_acme_sh; then
                    echo -e " ${red}✖ acme.sh 安装失败，请检查机器外网连通性！${plain}"
                    echo -ne "\n ${dim}按回车键继续...${plain}"; read -r < /dev/tty
                    continue
                fi
                local saved_cf_token=""
                [[ -f "$acme_env_file" ]] && source "$acme_env_file" 2>/dev/null
                echo -ne " ${bold}▸ 请输入要申请证书的域名${plain} (如 node1.example.com 或 *.example.com): "
                read -r domain < /dev/tty
                [[ -z "$domain" ]] && continue

                if [[ -n "$saved_cf_token" ]]; then
                    echo -ne " ${bold}▸ Cloudflare API Token${plain} ${dim}[回车使用已保存 Token]${plain}: "
                    read -r in_token < /dev/tty
                    cf_token=${in_token:-"$saved_cf_token"}
                else
                    echo -ne " ${bold}▸ 请输入 Cloudflare API Token${plain}: "
                    read -r cf_token < /dev/tty
                fi
                [[ -z "$cf_token" ]] && echo -e " ${red}✖ Token 不能为空！${plain}" && sleep 1 && continue

                echo "saved_cf_token=\"$cf_token\"" > "$acme_env_file"
                chmod 600 "$acme_env_file"
                unset CF_Key CF_Email
                export CF_Token="$cf_token"

                local safe_dom="${domain/\*/wildcard}"
                echo -e "\n ${cyan}正在通过 Cloudflare DNS 验证申请 ECC 证书 (${domain})...${plain}"
                if ~/.acme.sh/acme.sh --issue --dns dns_cf -d "$domain" --keylength ec-256 --force; then
                    local cert_f="/etc/V2bX/${safe_dom}.cert.pem"
                    local key_f="/etc/V2bX/${safe_dom}.key.pem"
                    ~/.acme.sh/acme.sh --install-cert -d "$domain" --ecc \
                        --fullchain-file "$cert_f" \
                        --key-file "$key_f" \
                        --reloadcmd "$r_cmd"
                    ln -sf "$cert_f" /etc/V2bX/fullchain.cer
                    ln -sf "$key_f" /etc/V2bX/cert.key
                    echo -e "\n ${green}✔ 证书签发成功！已启用定时自动续签与单/多进程自适应重启。${plain}"
                    acme_bind_to_node "$domain" "$cert_f" "$key_f"
                else
                    echo -e "\n ${red}✖ 证书申请失败！${plain}"
                fi
                echo -ne "\n ${dim}按回车键继续...${plain}"; read -r < /dev/tty
                ;;
            2)
                if ! install_acme_sh; then
                    echo -e " ${red}✖ acme.sh 安装失败，请检查机器外网连通性！${plain}"
                    echo -ne "\n ${dim}按回车键继续...${plain}"; read -r < /dev/tty
                    continue
                fi
                local port80_proc
                port80_proc=$( (ss -tlnp 2>/dev/null || ss -tln 2>/dev/null || netstat -tlnp 2>/dev/null || netstat -tln 2>/dev/null) | grep -E '[:.]80[[:space:]]' | head -n1 )
                if [[ -n "$port80_proc" ]]; then
                    echo -e "\n ${red}✖ 检测到 80 端口当前已被占用，无法使用 HTTP 独立模式！${plain}"
                    echo -e " ${dim}占用信息: ${port80_proc}${plain}"
                    echo -e " ${yellow}💡 建议：先停止占用 80 端口的程序，或改用选项 [1] Cloudflare DNS 模式申请。${plain}"
                    echo -ne "\n ${dim}按回车键继续...${plain}"; read -r < /dev/tty
                    continue
                fi

                echo -ne " ${bold}▸ 请输入已解析到本机的域名${plain}: "
                read -r domain < /dev/tty
                [[ -z "$domain" ]] && continue
                if ~/.acme.sh/acme.sh --issue -d "$domain" --standalone --keylength ec-256 --force; then
                    local cert_f="/etc/V2bX/${domain}.cert.pem"
                    local key_f="/etc/V2bX/${domain}.key.pem"
                    ~/.acme.sh/acme.sh --install-cert -d "$domain" --ecc \
                        --fullchain-file "$cert_f" \
                        --key-file "$key_f" \
                        --reloadcmd "$r_cmd"
                    echo -e "\n ${green}✔ 证书签发成功！${plain}"
                    acme_bind_to_node "$domain" "$cert_f" "$key_f"
                else
                    echo -e "\n ${red}✖ 申请失败，请确认域名 A/AAAA 记录已正确解析到本机公网 IP。${plain}"
                fi
                echo -ne "\n ${dim}按回车键继续...${plain}"; read -r < /dev/tty
                ;;
            3)
                install_acme_sh && ~/.acme.sh/acme.sh --cron --force
                echo -e " ${green}✔ 强制续签任务执行完毕！${plain}"
                echo -ne "\n ${dim}按回车键继续...${plain}"; read -r < /dev/tty
                ;;
            4)
                echo -e "\n ${bold}/etc/V2bX/ 目录下的证书文件状态：${plain}"
                local found_cert=false
                for f in /etc/V2bX/*.cert.pem /etc/V2bX/*.cer; do
                    [[ ! -e "$f" || -L "$f" ]] && continue
                    found_cert=true
                    local exp_d subj_d
                    exp_d=$(openssl x509 -enddate -noout -in "$f" 2>/dev/null | cut -d= -f2)
                    subj_d=$(openssl x509 -subject -noout -in "$f" 2>/dev/null | sed 's/.*CN *= *//')
                    echo -e "  🟢 文件: ${cyan}${f}${plain} | 域名: ${subj_d} | 到期: ${green}${exp_d}${plain}"
                done
                [[ "$found_cert" = false ]] && echo -e "  ${yellow}暂无本地独立证书文件。${plain}"
                echo -ne "\n ${dim}按回车键继续...${plain}"; read -r < /dev/tty
                ;;
            5)
                echo -e "\n ${dim}本地已有证书列表：${plain}"
                for f in /etc/V2bX/*.cert.pem; do
                    [[ ! -e "$f" || -L "$f" ]] && continue
                    echo -e "  ▸ $(basename "$f" .cert.pem)"
                done
                echo -ne " ${bold}▸ 请输入要绑定的证书文件名(不含.cert.pem)${plain}: "
                read -r b_dom < /dev/tty
                if [[ -f "/etc/V2bX/${b_dom}.cert.pem" ]]; then
                    acme_bind_to_node "$b_dom" "/etc/V2bX/${b_dom}.cert.pem" "/etc/V2bX/${b_dom}.key.pem"
                else
                    echo -e " ${red}✖ 未找到 /etc/V2bX/${b_dom}.cert.pem${plain}"
                fi
                echo -ne "\n ${dim}按回车键继续...${plain}"; read -r < /dev/tty
                ;;
            0|*) break ;;
        esac
    done
}

# ════════════════════ 5. 节点精准删除与闲置内核清理 ════════════════════
remove_single_node() {
    ui_banner
    ui_section "🗑️ 现有节点精准管理与移除"
    if [[ ! -f "$config_file" ]] || ! jq -e . "$config_file" >/dev/null 2>&1; then
        echo -e " ${red}✖ 配置文件不存在或损坏！${plain}"; return
    fi
    echo -e " 当前已挂载的节点列表："
    jq -r '(.Nodes // []) | to_entries[] | "  [\(.key + 1)] NodeID: \(.value.NodeID) | 内核: \(.value.Core) | 协议: \(.value.NodeType)"' "$config_file"
    ui_line
    echo -ne " ${bold}▸ 请输入要删除的 NodeID${plain} (直接回车取消): "
    read -r del_id < /dev/tty
    [[ ! "$del_id" =~ ^[0-9]+$ ]] && return

    if ! jq -e --argjson id "$del_id" '(.Nodes // [])[] | select(.NodeID == $id)' "$config_file" >/dev/null 2>&1; then
        echo -e " ${red}✖ 未找到 NodeID: ${del_id}，请核对上方列表！${plain}"
        return
    fi

    local tmp_d="/tmp/v2bx_del_${RANDOM}.json"
    if jq --argjson id "$del_id" '
        del(.Nodes[] | select(.NodeID == $id))
        | ([.Nodes[].Core] | unique) as $active_cores
        | .Cores = [(.Cores // [])[] | select(.Type as $t | $active_cores | index($t))]
    ' "$config_file" > "$tmp_d" 2>/dev/null; then
        if jq -e . "$tmp_d" >/dev/null 2>&1; then
            mv -f "$tmp_d" "$config_file"
            echo -e " ${green}✔ 已安全移除 NodeID: ${del_id} 并清理闲置内核！${plain}"
            restart_v2bx_service
        else
            echo -e " ${red}✖ 移除逻辑导致配置毁损，已取消操作！${plain}"
        fi
    else
        echo -e " ${red}✖ 移除失败！${plain}"
    fi
    rm -f "$tmp_d"
}

# ════════════════════ 6. 在线自更新 ════════════════════
update_self_script() {
    ui_banner
    ui_section "🔄 正在同步云端最新 all/xmm12 脚本"
    local tmp_new="/tmp/xmm12_update_${RANDOM}.sh"

    if fetch_github_module "all/xmm12" "$tmp_new" "sh_ver="; then
        local new_ver; new_ver=$(grep -m1 '^sh_ver=' "$tmp_new" | cut -d'"' -f2)
        local real_me
        real_me=$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")
        mkdir -p /usr/local/bin
        cp -f "$tmp_new" /usr/local/bin/xmm12 2>/dev/null
        chmod +x /usr/local/bin/xmm12 2>/dev/null
        if [[ -f "$real_me" && "$real_me" != "/usr/local/bin/xmm12" ]]; then
            cp -f "$tmp_new" "$real_me" 2>/dev/null
            chmod +x "$real_me" 2>/dev/null
        fi
        rm -f "$tmp_new"
        echo -e " ${green}✔ all/xmm12 已成功更新至 v${new_ver}！${plain}"
        sleep 1
        exec bash "/usr/local/bin/xmm12"
    else
        rm -f "$tmp_new"
        echo -e " ${red}✖ 更新失败，可能遭遇网络阻断，请稍后重试！${plain}"
    fi
}

