    show_xmm12_menu
    echo -ne " ${bold}▸ 请选择功能序号${plain} [0-5, 默认 1]: "
    read -r menu_num < /dev/tty
    [[ -z "$menu_num" ]] && menu_num="1"
    case "$menu_num" in
        1) wizard_append_node ;;
        2) traffic_light_health_check ;;
        3) external_acme_console ;;
        4) remove_single_node ;;
        5) update_self_script ;;
        0) echo -e "\n ${green}已返回主菜单。${plain}\n"; exit 0 ;;
        *) echo -e " ${red}无效选择，请输入 0-5！${plain}" ;;
    esac
    echo ""
    echo -ne " ${dim}按回车键返回子菜单...${plain}"
    read -r < /dev/tty
done
