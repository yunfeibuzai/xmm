load_or_ask_creds() {
    local default_host="https://example.com"
    local default_key=""

    if [[ -f "$saved_file" ]]; then
        source "$saved_file" 2>/dev/null
        default_host=${saved_host:-"https://example.com"}
        default_key=${saved_key:-""}
    elif [[ -f "$config_file" ]] && jq -e . "$config_file" >/dev/null 2>&1; then
        local extracted_host extracted_key
        extracted_host=$(jq -r '.Nodes[0].ApiHost // empty' "$config_file" 2>/dev/null)
        extracted_key=$(jq -r '.Nodes[0].ApiKey // empty' "$config_file" 2>/dev/null)
        [[ -n "$extracted_host" ]] && default_host="$extracted_host"
        [[ -n "$extracted_key" ]] && default_key="$extracted_key"
    fi

    echo -e "${yellow}💡 面板对接凭证读取${plain}"
    echo -ne " ${bold}▸ 机场面板网址${plain} ${dim}[回车默认: ${default_host}]${plain}: "
    read -r input_host < /dev/tty
    api_host=${input_host:-"$default_host"}
    [[ ! "$api_host" =~ ^https?:// ]] && api_host="https://${api_host}"
    api_host="${api_host%/}"

    if [[ -n "$default_key" ]]; then
        echo -ne " ${bold}▸ 面板 API Key${plain} ${dim}[回车使用现有 Key: ${default_key:0:4}****]${plain}: "
        read -r input_key < /dev/tty
        api_key=${input_key:-"$default_key"}
    else
        api_key=""
        while [[ -z "$api_key" ]]; do
            echo -ne " ${bold}▸ 请输入面板对接 API Key${plain}: "
            read -r api_key < /dev/tty
        done
    fi

    echo "saved_host=\"$api_host\"" > "$saved_file"
    echo "saved_key=\"$api_key\"" >> "$saved_file"
    chmod 600 "$saved_file"
}

