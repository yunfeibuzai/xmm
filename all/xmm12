#!/bin/bash

# 麦卖云 V2bX 节点追加 + 体检 + 外置 ACME 证书管理中心 (all/xmm12 - Shannon-x 深度适配版)
sh_ver="4.5.0-AllInOne"

# 终端色彩与样式
red='\033[31m'; green='\033[32m'; yellow='\033[33m'
magenta='\033[35m'; cyan='\033[36m'; bold='\033[1m'; plain='\033[0m'
dim='\033[2m'

[[ $EUID -ne 0 ]] && echo -e "${red}错误：${plain}必须使用 root 用户运行此脚本！\n" && exit 1

mkdir -p /etc/V2bX /etc/V2bX/nodes /var/log/V2bX
saved_file="/etc/V2bX/.saved_creds"
acme_env_file="/etc/V2bX/.acme_cf.env"
config_file="/etc/V2bX/config.json"

# ════════════════════ UI 组件库 ════════════════════
ui_line() {
    echo -e "${dim}────────────────────────────────────────────────────────${plain}"
}

ui_banner() {
    printf '\033[H\033[2J'
    echo -e "${cyan}${bold}╔══════════════════════════════════════════════════════╗${plain}"
    echo -e "${cyan}${bold}║     麦卖云 V2bX 节点追加 • 体检 • 证书中心 (xmm12)   ║${plain}"
    echo -e "${cyan}${bold}║    无缝增量追加 • 红绿灯 API 诊断 • 外置 ACME 证书   ║${plain}"
    echo -e "${cyan}${bold}╚══════════════════════════════════════════════════════╝${plain}"
    local node_cnt=0
    if [[ -f "$config_file" ]] && command -v jq &>/dev/null; then
        node_cnt=$(jq '.Nodes | length' "$config_file" 2>/dev/null || echo 0)
    fi
    echo -e " ${dim}版本: v${sh_ver}  |  当前已挂载节点数: ${green}${node_cnt}${plain}"
    ui_line
}

ui_section() {
    echo -e "\n${cyan}${bold}▌ $1${plain}"
    ui_line
}

ui_step() {
    echo -e "\n${magenta}${bold}┌── [步骤 $1] $2${plain}"
}

# ════════════════════ 服务与环境适配 ════════════════════
ensure_tools() {
    if ! command -v jq &>/dev/null || ! command -v openssl &>/dev/null || ! command -v socat &>/dev/null; then
        echo -e " ${yellow}正在补齐必要运维组件 (jq / openssl / socat)...${plain}"
        if command -v apt-get &>/dev/null; then
            apt-get update -y -q >/dev/null 2>&1
            apt-get install -y --no-install-recommends jq openssl socat cron curl >/dev/null 2>&1
        elif command -v yum &>/dev/null; then
            yum install -y jq openssl socat cronie curl >/dev/null 2>&1
        elif command -v apk &>/dev/null; then
            apk update >/dev/null 2>&1
            apk add --no-cache jq openssl socat cronie curl bash coreutils >/dev/null 2>&1
            rc-update add crond default 2>/dev/null && rc-service crond start >/dev/null 2>&1
        fi
    fi
}
ensure_tools

sync_multi_process_instances() {
    local total_nodes
    total_nodes=$(jq '.Nodes | length' "$config_file" 2>/dev/null || echo 0)

    # 先清理旧实例，避免删除节点后残留幽灵进程
    if command -v systemctl &>/dev/null; then
        for old_srv in /etc/systemd/system/multi-user.target.wants/v2bx@*.service; do
            [[ -e "$old_srv" ]] || continue
            local srv_base; srv_base=$(basename "$old_srv")
            systemctl stop "$srv_base" 2>/dev/null
            systemctl disable "$srv_base" >/dev/null 2>&1
        done
    elif command -v rc-service &>/dev/null; then
        for old_rc in /etc/init.d/v2bx.node_* /etc/init.d/V2bX.node_*; do
            [[ -f "$old_rc" ]] || continue
            local rc_base; rc_base=$(basename "$old_rc")
            rc-service "$rc_base" stop 2>/dev/null
            rc-update del "$rc_base" default >/dev/null 2>&1
            rm -f "$old_rc"
        done
    fi

    rm -f /etc/V2bX/nodes/node_*.json
    if [[ "$total_nodes" -eq 0 ]]; then
        echo -e " ${yellow}⚠ 当前已无任何节点，所有隔离实例已停止。${plain}"
        return
    fi

    for ((i=0; i<total_nodes; i++)); do
        local nid ntype ncore inst_name out_file
        nid=$(jq -r ".Nodes[$i].NodeID" "$config_file")
        ntype=$(jq -r ".Nodes[$i].NodeType" "$config_file")
        ncore=$(jq -r ".Nodes[$i].Core" "$config_file")
        inst_name="node_${nid}_${ntype}"
        out_file="/etc/V2bX/nodes/${inst_name}.json"

        jq --argjson idx "$i" --arg core "$ncore" --arg name "$inst_name" '
        {
          "Log": { "Level": (.Log.Level // "error"), "Output": "" },
          "Runtime": (.Runtime // { "GCPercent": 50, "MemoryLimitPercent": 70 }),
          "Cores": [
            (
              (.Cores[] | select(.Type == $core)) as $c |
              if $core == "xray" then
                $c | .Log.ErrorPath = ("/var/log/V2bX/error_" + $name + ".log") | .Log.AccessPath = ("/var/log/V2bX/access_" + $name + ".log")
              else $c end
            )
          ],
          "Nodes": [ .Nodes[$idx] ]
        }' "$config_file" > "$out_file"

        if command -v systemctl &>/dev/null; then
            systemctl enable "v2bx@${inst_name}.service" >/dev/null 2>&1
            systemctl restart "v2bx@${inst_name}.service"
            echo -e " ${green}✔ 已同步重启隔离实例: v2bx@${inst_name}.service${plain}"
        elif command -v rc-service &>/dev/null; then
            local rc_file="/etc/init.d/v2bx.${inst_name}"
            cat << EOF > "$rc_file"
#!/sbin/openrc-run
description="V2bX Isolated Node (${inst_name})"
command="/usr/local/V2bX/V2bX"
command_args="server -c /etc/V2bX/nodes/${inst_name}.json -w"
command_background=true
pidfile="/run/v2bx.${inst_name}.pid"
output_log="/var/log/V2bX/out_${inst_name}.log"
error_log="/var/log/V2bX/err_${inst_name}.log"
command_env="XRAY_DNS_PATH=/etc/V2bX/dns.json SING_DNS_PATH=/etc/V2bX/sing_dns.json"

depend() {
    need net
}
EOF
            chmod +x "$rc_file"
            rc-update add "v2bx.${inst_name}" default >/dev/null 2>&1
            rc-service "v2bx.${inst_name}" restart
            echo -e " ${green}✔ 已同步重启 OpenRC 隔离实例: v2bx.${inst_name}${plain}"
        fi
    done
}

restart_v2bx_service() {
    echo ""
    ui_section "正在应用配置并重载 V2bX 服务"
    if [[ -f /etc/V2bX/nodes/.multi_enabled ]] || \
       compgen -G "/etc/systemd/system/multi-user.target.wants/v2bx@*.service" >/dev/null 2>&1 || \
       compgen -G "/etc/init.d/v2bx.node_*" >/dev/null 2>&1; then
        echo -e " ${cyan}ℹ 检测到【多进程隔离模式】，正在自动重新拆分并同步所有节点实例...${plain}"
        sync_multi_process_instances
        return
    fi

    if command -v systemctl &>/dev/null; then
        if systemctl restart V2bX 2>/dev/null; then
            echo -e " ${green}✔ Systemd: V2bX 服务已成功重启生效！${plain}"
        else
            echo -e " ${yellow}⚠ Systemd: 服务重启失败，请检查配置或主程序状态。${plain}"
        fi
    elif command -v rc-service &>/dev/null; then
        if rc-service V2bX restart 2>/dev/null; then
            echo -e " ${green}✔ OpenRC: V2bX 服务已成功重启生效！${plain}"
        else
            echo -e " ${yellow}⚠ OpenRC: 服务重启失败，请检查主程序状态。${plain}"
        fi
    else
        echo -e " ${yellow}ℹ 未检测到系统守护程序，若已挂载 -w 参数将自动热重载。${plain}"
    fi
}

