#!/usr/bin/env bash
# =================================================================
# 麦卖云 Cloudflare Argo Tunnel 智能诊断引擎 (终极满血版)
# 独创：全系统兼容底层探针、配置自动剖析、端口盲审避障
# 修复：Windows CRLF 换行符导致的控制台乱码重叠问题
# =================================================================

# 1. 自动修补 Alpine 执行环境 (拦截 sh 执行或缺失 bash 的情境)
if [ -z "$BASH_VERSION" ]; then
    if command -v apk >/dev/null 2>&1; then
        echo -e "\033[33m检测到 Alpine 环境，正在自愈加载 bash...\033[0m"
        apk update >/dev/null 2>&1 && apk add --no-cache bash grep sed gawk net-tools coreutils >/dev/null 2>&1
        exec bash "$0" "$@"
    else
        echo "错误：请使用 bash 执行脚本！"
        exit 1
    fi
fi

# 2. 初始化标准控制台颜色
red='\033[31m'; green='\033[32m'; yellow='\033[33m'
magenta='\033[35m'; cyan='\033[36m'; bold='\033[1m'; plain='\033[0m'; dim='\033[2m'

[[ $EUID -ne 0 ]] && echo -e "${red}错误：${plain}必须使用 root 用户运行此脚本！\n" && exit 1

# 3. 跨系统底层进程防误探针 (兼容 BusyBox)
check_pid_alive() {
    local pid="$1"
    [[ -n "$pid" && "$pid" =~ ^[0-9]+$ && -d "/proc/$pid" ]] && kill -0 "$pid" 2>/dev/null
}

# 清理字符串中所有不可见控制字符 (解决 CRLF 乱码重叠的核心函数)
clean_string() {
    echo "$1" | tr -d '\r' | tr -d '\000-\011\013-\037' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

# 4. 主干逻辑
view_cf_tunnel_logs() {
    clear
    echo -e "${cyan}================================================================${plain}"
    echo -e "${cyan}       🚀 Cloudflare Argo Tunnel 实时智能诊断雷达引擎           ${plain}"
    echo -e "${cyan}================================================================${plain}"

    local discovered_tunnels=()

    # Systemd 层扫描
    if command -v systemctl &>/dev/null && [[ -d /run/systemd/system ]]; then
        for f in /etc/systemd/system/cf-*.service; do
            [[ -f "$f" ]] && discovered_tunnels+=("$(basename "$f" | sed 's/^cf-//;s/\.service$//')")
        done
        [[ -f "/etc/systemd/system/cloudflared.service" ]] && discovered_tunnels+=("cloudflared")
    fi

    # Alpine OpenRC 层扫描
    if command -v rc-service &>/dev/null || [[ -d "/etc/init.d" ]]; then
        for f in /etc/init.d/cf-*; do
            [[ -f "$f" ]] && discovered_tunnels+=("$(basename "$f" | sed 's/^cf-//')")
        done
        [[ -f "/etc/init.d/cloudflared" ]] && discovered_tunnels+=("cloudflared")
    fi

    # 兜底文件扫描 (跳过非配置 yml)
    for dir in "/etc/cloudflared" "/root/.cloudflared"; do
        if [[ -d "$dir" ]]; then
            for yml in "$dir"/*.yml "$dir"/*.yaml; do
                [[ -f "$yml" ]] || continue
                local base; base=$(basename "$yml" | sed 's/\.yml$//;s/\.yaml$//')
                [[ "$base" != "cert" && "$base" != "config" ]] && discovered_tunnels+=("$base")
            done
        fi
    done

    # 进程级扫描兜底
    for p in /proc/[0-9]*/cmdline; do
        [[ -f "$p" ]] || continue
        local cmd; cmd=$(tr '\0' ' ' < "$p" 2>/dev/null)
        if [[ "$cmd" == *"cloudflared "* ]]; then
            if [[ "$cmd" =~ tunnel[[:space:]]+run[[:space:]]+([^[:space:]\-][^[:space:]]*) ]]; then
                discovered_tunnels+=("${BASH_REMATCH[1]}")
            fi
        fi
    done

    # 极简安全的数组去重
    local tunnels=()
    for t in "${discovered_tunnels[@]}"; do
        [[ -z "$t" ]] && continue
        local is_duplicate=0
        for exist in "${tunnels[@]}"; do
            [[ "$t" == "$exist" ]] && is_duplicate=1 && break
        done
        [[ $is_duplicate -eq 0 ]] && tunnels+=("$t")
    done

    if [[ ${#tunnels[@]} -eq 0 ]]; then
        echo -e "\n${yellow}雷达未扫描到当前服务器存在任何部署的 CF 隧道实例！${plain}\n"
        return
    fi

    local target=""
    if [[ ${#tunnels[@]} -eq 1 ]]; then
        target="${tunnels[0]}"
        echo -e "${green}雷达锁定：当前机器仅存在 1 个隧道，已自动选定: ${cyan}${target}${plain}\n"
    else
        echo -e "${green}雷达锁定：发现多集群隧道，请选择要体检的目标：${plain}"
        local i=1
        for t in "${tunnels[@]}"; do
            echo -e "  ${bold}${green}${i}.${plain} 隧道标识: ${cyan}${t}${plain}"
            ((i++))
        done
        read -rp "请输入序号 [1-${#tunnels[@]}]: " sel
        if ! [[ "$sel" =~ ^[0-9]+$ ]] || (( sel < 1 || sel > ${#tunnels[@]} )); then
            echo -e "${red}坐标无效，中止体检！${plain}"
            return
        fi
        target="${tunnels[$((sel-1))]}"
        echo ""
    fi

    echo -e "${cyan}====== [ 📡 阶段一：守护进程存活深扫 ] ======${plain}"
    local pids=()
    
    # 获取 PID (多维度穿透)
    if command -v systemctl &>/dev/null && [[ -d /run/systemd/system ]]; then
        local p
        p=$(systemctl show -p MainPID "cf-${target}" 2>/dev/null | cut -d= -f2)
        [[ -n "$p" && "$p" != "0" ]] && pids+=("$p")
        p=$(systemctl show -p MainPID "cloudflared" 2>/dev/null | cut -d= -f2)
        [[ -n "$p" && "$p" != "0" ]] && pids+=("$p")
    fi
    for pf in "/run/cf-${target}.pid" "/var/run/cf-${target}.pid" "/run/cloudflared.pid" "/var/run/cloudflared.pid"; do
        [[ -f "$pf" ]] && pids+=("$(cat "$pf" 2>/dev/null | tr -d '\r\n')")
    done
    for proc_dir in /proc/[0-9]*; do
        [[ -d "$proc_dir" ]] || continue
        local p="${proc_dir##*/}"
        [[ "$p" == "$$" ]] && continue
        local cmdline; cmdline=$(tr '\0' ' ' < "$proc_dir/cmdline" 2>/dev/null)
        if [[ "$cmdline" == *"cloudflared"* && "$cmdline" == *"$target"* ]]; then
            pids+=("$p")
        fi
    done

    # PID 验活与去重
    local active_pid=""
    for p in "${pids[@]}"; do
        if check_pid_alive "$p"; then
            active_pid="$p"
            break
        fi
    done

    if [[ -n "$active_pid" ]]; then
        echo -e "核心动脉: ${green}[●] 正常起搏 (主进程 PID: ${active_pid})${plain}"
    else
        echo -e "核心动脉: ${red}[○] 心跳停止 (服务可能已停止，或配置文件致命错误导致坠毁)${plain}"
    fi

    echo -e "\n${cyan}====== [ 🎯 阶段二：端口内网穿透盲审 ] ======${plain}"
    local config_file=""
    for cand in "/etc/cloudflared/${target}.yml" "/etc/cloudflared/${target}.yaml" "/etc/cloudflared/config.yml" "/root/.cloudflared/${target}.yml" "/root/.cloudflared/${target}.yaml" "/root/.cloudflared/config.yml"; do
        if [[ -f "$cand" ]]; then
            config_file="$cand"
            break
        fi
    done

    if [[ -f "$config_file" ]]; then
        # 【防御核心】强制清理所有隐藏符，剥离注释，只取纯净的值
        local forward_url_raw
        forward_url_raw=$(grep -iE '^[[:space:]]*-[[:space:]]*service[[:space:]]*:' "$config_file" 2>/dev/null | \
                          grep -iv 'http_status' | head -n 1 | \
                          sed -e 's/^[[:space:]]*-[[:space:]]*service[[:space:]]*:[[:space:]]*//i' | \
                          cut -d'#' -f1)
        
        local forward_url; forward_url=$(clean_string "$forward_url_raw")
        
        if [[ -n "$forward_url" ]]; then
            local forward_port; forward_port=$(echo "$forward_url" | grep -oE '[0-9]+$')
            echo -e "配置文件: ${green}${config_file}${plain}"
            echo -e "接驳目标: ${yellow}${forward_url}${plain}"

            if [[ -n "$forward_port" ]]; then
                local listen_check=""
                # 兼容全系统的网络侦测引擎
                if command -v ss &>/dev/null; then
                    listen_check=$(ss -tlnp 2>/dev/null | awk '{print $4}' | grep -E "(:|\])${forward_port}$")
                elif command -v netstat &>/dev/null; then
                    listen_check=$(netstat -tlnp 2>/dev/null | awk '{print $4}' | grep -E "(:|\.)${forward_port}$")
                fi

                if [[ -n "$listen_check" ]]; then
                    echo -e "隧道闸口: ${green}✔ 物理贯通！本地后端正严阵以待监听 ${forward_port} 端口。${plain}"
                else
                    echo -e "隧道闸口: ${red}❌ 幽灵断层！本地没有任何服务接管 ${forward_port} 端口！${plain}"
                    echo -e "          ${yellow}👉 致命结果：外网访问将 100% 触发 503 Service Unavailable！${plain}"
                    echo -e "          ${yellow}👉 解决指南：请核对后端核心(如 V2bX/Xray)的 Listen 端口是否为 ${forward_port}。${plain}"
                fi
            else
                echo -e "隧道闸口: ${yellow}解析失败，未能提取到纯数字端口，跳过监听检测。${plain}"
            fi
        else
            echo -e "${yellow}配置探针未能嗅探到本地 service 转发信标 (Ingress 规则异常)。${plain}"
        fi
    else
        echo -e "${yellow}未找到适配的 YAML 配置文件，端口透扫跳过。${plain}"
    fi

    echo -e "\n${cyan}====== [ 📜 阶段三：黑匣子解码 (最近日志输出) ] ======${plain}"
    echo -e "${magenta}----------------------------------------------------------------${plain}"
    
    local log_found=0
    # 日志输出强制过滤 CRLF，防止系统日志残留 Windows 换行符
    if command -v systemctl &>/dev/null && [[ -d /run/systemd/system ]]; then
        if systemctl is-active "cf-${target}.service" &>/dev/null || systemctl is-failed "cf-${target}.service" &>/dev/null; then
            journalctl -u "cf-${target}" -n 40 --no-pager | tr -d '\r' && log_found=1
        elif systemctl is-active "cloudflared.service" &>/dev/null || systemctl is-failed "cloudflared.service" &>/dev/null; then
            journalctl -u cloudflared -n 40 --no-pager | tr -d '\r' && log_found=1
        fi
    fi

    if [[ $log_found -eq 0 ]]; then
        for log_f in "/var/log/cf-${target}.log" "/var/log/cf-${target}_err.log" "/var/log/cloudflared.log" "/var/log/cloudflared_err.log" "/root/.cloudflared/${target}.log"; do
            if [[ -f "$log_f" ]]; then
                tail -n 40 "$log_f" | tr -d '\r'
                log_found=1
                break
            fi
        done
    fi

    [[ $log_found -eq 0 ]] && echo -e "${yellow}未在内存日志树或磁盘中追踪到任何坠毁/运行记录。${plain}"
    echo -e "${magenta}----------------------------------------------------------------${plain}"
    
    echo -e "\n${yellow}💡 【破壁指南】${plain}"
    echo -e " 1. 拦截到 ${red}Failed to serve quic connection${plain} ? ${dim}➔ UDP 阻断，请去管理面板将协议切为 http2。${plain}"
    echo -e " 2. 拦截到 ${red}connection refused${plain} ? ${dim}➔ 端口脱节，说明你的后端挂了，或隧道填错端口了。${plain}"
    echo -e " 3. 拦截到 ${red}Unable to reach the origin service${plain} ? ${dim}➔ TLS证书验证失败，配置需加 noTLSVerify: true。${plain}"
    echo ""
}

view_cf_tunnel_logs
