#!/usr/bin/env bash
# =================================================================
# 麦卖云 Cloudflare Argo Tunnel 交互式管理引擎 (全系统终极容错版)
# 升级：精准识别 Protocol、智能去重隧道列表、进程状态强关联
# =================================================================

if [ -z "$BASH_VERSION" ]; then
    if command -v apk >/dev/null 2>&1; then
        echo -e "\033[33m检测到 Alpine 环境，正在自动准备 bash...\033[0m"
        apk update >/dev/null 2>&1 && apk add --no-cache bash grep sed gawk psmisc >/dev/null 2>&1
        exec bash "$0" "$@"
    else
        echo "错误：请使用 bash 运行此脚本 (例如: bash $0)"
        exit 1
    fi
fi

red='\033[31m'; green='\033[32m'; yellow='\033[33m'
magenta='\033[35m'; cyan='\033[36m'; bold='\033[1m'; plain='\033[0m'; dim='\033[2m'

[[ $EUID -ne 0 ]] && echo -e "${red}错误：${plain}必须使用 root 用户运行此脚本！\n" && exit 1

check_pid_alive() {
    local pid="$1"
    [[ -n "$pid" && "$pid" =~ ^[0-9]+$ && -d "/proc/$pid" ]] && kill -0 "$pid" 2>/dev/null
}

get_tunnel_status() {
    local target="$1"
    local config="$2"
    STATUS_RUNNING=0
    STATUS_PID=""
    STATUS_DESC="${red}○ 已停止${plain}"

    # 1. Systemd 状态检查
    if command -v systemctl &>/dev/null && [[ -d /run/systemd/system ]]; then
        local svc=""
        if systemctl list-unit-files "cf-${target}.service" &>/dev/null; then svc="cf-${target}"
        elif systemctl list-unit-files "cloudflared.service" &>/dev/null; then svc="cloudflared"
        fi
        if [[ -n "$svc" ]]; then
            if systemctl is-active "$svc" &>/dev/null; then
                local pid; pid=$(systemctl show -p MainPID "$svc" 2>/dev/null | cut -d= -f2)
                if [[ -n "$pid" && "$pid" -ne 0 ]]; then
                    STATUS_RUNNING=1; STATUS_PID="$pid"; STATUS_DESC="${green}● 运行中 (PID: ${pid} | Systemd)${plain}"
                else
                    STATUS_RUNNING=1; STATUS_DESC="${green}● 运行中 (Systemd 托管)${plain}"
                fi
                return
            fi
        fi
    fi

    # 2. OpenRC 状态检查
    if command -v rc-service &>/dev/null; then
        local rc_svc="cf-${target}"
        [[ "$target" == "cloudflared" || "$target" == "Token_Managed_Tunnel" ]] && rc_svc="cloudflared"
        if [[ -f "/etc/init.d/${rc_svc}" ]]; then
            if rc-service "$rc_svc" status 2>/dev/null | grep -qiE 'started|running'; then
                local pid=""
                [[ -f "/run/${rc_svc}.pid" ]] && pid=$(cat "/run/${rc_svc}.pid" 2>/dev/null)
                if check_pid_alive "$pid"; then
                    STATUS_RUNNING=1; STATUS_PID="$pid"; STATUS_DESC="${green}● 运行中 (PID: ${pid} | OpenRC)${plain}"
                else
                    STATUS_RUNNING=1; STATUS_DESC="${green}● 运行中 (OpenRC 托管)${plain}"
                fi
                return
            fi
        fi
    fi

    # 3. 独立进程深度探针兜底
    local cfg_name; cfg_name=$(basename "$config" 2>/dev/null)
    for p in /proc/[0-9]*/cmdline; do
        [[ -f "$p" ]] || continue
        local cmdline; cmdline=$(tr '\0' ' ' < "$p" 2>/dev/null)
        if [[ "$cmdline" == *"cloudflared "* ]]; then
            local is_match=0
            if [[ "$target" == "Token_Managed_Tunnel" && "$cmdline" == *"--token "* ]]; then is_match=1
            elif [[ -n "$target" && "$target" != "cloudflared" && "$cmdline" =~ tunnel[[:space:]]+run[[:space:]]+${target} ]]; then is_match=1
            elif [[ -n "$cfg_name" && "$cmdline" == *"$cfg_name"* ]]; then is_match=1
            elif [[ "$target" == "cloudflared" && "$cmdline" =~ tunnel[[:space:]]+run ]]; then is_match=1
            fi
            
            if [[ $is_match -eq 1 ]]; then
                local pid; pid=$(echo "$p" | awk -F'/' '{print $3}')
                if check_pid_alive "$pid"; then
                    STATUS_RUNNING=1; STATUS_PID="$pid"; STATUS_DESC="${green}● 运行中 (PID: ${pid} | 独立进程)${plain}"
                    return
                fi
            fi
        fi
    done
}

scan_all_local_tunnels() {
    local discovered=()
    
    # 扫描服务
    if command -v systemctl &>/dev/null; then
        for f in /etc/systemd/system/cf-*.service; do
            [[ -f "$f" ]] && discovered+=("$(basename "$f" | sed 's/^cf-//;s/\.service$//')")
        done
        [[ -f "/etc/systemd/system/cloudflared.service" ]] && discovered+=("cloudflared")
    fi
    if command -v rc-service &>/dev/null || [[ -d "/etc/init.d" ]]; then
        for f in /etc/init.d/cf-*; do
            [[ -f "$f" ]] && discovered+=("$(basename "$f" | sed 's/^cf-//')")
        done
        [[ -f "/etc/init.d/cloudflared" ]] && discovered+=("cloudflared")
    fi
    
    # 扫描配置文件
    for dir in "/etc/cloudflared" "/root/.cloudflared"; do
        if [[ -d "$dir" ]]; then
            for yml in "$dir"/*.yml "$dir"/*.yaml; do
                [[ -f "$yml" ]] || continue
                local base; base=$(basename "$yml" | sed 's/\.yml$//;s/\.yaml$//')
                [[ "$base" == "cert" || "$base" == "config" ]] && continue
                discovered+=("$base")
            done
        fi
    done
    
    # 扫描正在运行的进程 (提取具体隧道名，不盲目追加 process)
    for p in /proc/[0-9]*/cmdline; do
        [[ -f "$p" ]] || continue
        local cmd; cmd=$(tr '\0' ' ' < "$p" 2>/dev/null)
        if [[ "$cmd" == *"cloudflared "* ]]; then
            if [[ "$cmd" == *"--token "* ]]; then
                discovered+=("Token_Managed_Tunnel")
            elif [[ "$cmd" =~ tunnel[[:space:]]+run[[:space:]]+([^[:space:]\-][^[:space:]]*) ]]; then
                discovered+=("${BASH_REMATCH[1]}")
            elif [[ "$cmd" =~ --config[[:space:]=]+([^[:space:]]+) ]]; then
                local cfg="${BASH_REMATCH[1]}"
                local base; base=$(basename "$cfg" | sed 's/\.yml$//;s/\.yaml$//')
                [[ "$base" != "config" && "$base" != "cert" ]] && discovered+=("$base")
            fi
        fi
    done

    # 智能去重并输出
    if [[ ${#discovered[@]} -gt 0 ]]; then
        echo "${discovered[@]}" | tr ' ' '\n' | sort -u | grep -v '^$' | tr '\n' ' '
    fi
}

check_if_token_tunnel() {
    local target="$1"
    for p in /proc/[0-9]*; do
        [[ -d "$p" ]] || continue
        local cmd; cmd=$(tr '\0' ' ' < "$p/cmdline" 2>/dev/null)
        if [[ "$cmd" == *"cloudflared "* && "$cmd" == *"--token "* ]]; then return 0; fi
    done
    local svc_files=("/etc/systemd/system/cf-${target}.service" "/etc/systemd/system/cloudflared.service" "/etc/init.d/cf-${target}" "/etc/init.d/cloudflared")
    for sf in "${svc_files[@]}"; do
        if [[ -f "$sf" ]] && grep -qi "\-\-token" "$sf"; then return 0; fi
    done
    return 1
}

find_config_file() {
    local target="$1"
    local svc_files=("/etc/systemd/system/cf-${target}.service" "/etc/systemd/system/cloudflared.service" "/etc/init.d/cf-${target}" "/etc/init.d/cloudflared")
    for sf in "${svc_files[@]}"; do
        if [[ -f "$sf" ]]; then
            local cfg; cfg=$(grep -oE '--config[ =][^[:space:]]+' "$sf" | head -n 1 | sed 's/--config[ =]//' | tr -d '"' | tr -d "'")
            if [[ -n "$cfg" && -f "$cfg" ]]; then echo "$cfg"; return; fi
        fi
    done
    
    for p in /proc/[0-9]*/cmdline; do
        [[ -f "$p" ]] || continue
        local cmd; cmd=$(tr '\0' ' ' < "$p" 2>/dev/null)
        if [[ "$cmd" == *"cloudflared "* && "$cmd" == *"$target"* ]]; then
            if [[ "$cmd" =~ --config[[:space:]]+([^[:space:]]+) || "$cmd" =~ --config=([^[:space:]]+) ]]; then
                if [[ -f "${BASH_REMATCH[1]}" ]]; then echo "${BASH_REMATCH[1]}"; return; fi
            fi
        fi
    done

    local candidates=(
        "/etc/cloudflared/${target}.yml" "/etc/cloudflared/${target}.yaml" "/etc/cloudflared/config.yml"
        "/root/.cloudflared/${target}.yml" "/root/.cloudflared/${target}.yaml" "/root/.cloudflared/config.yml"
    )
    for c in "${candidates[@]}"; do
        if [[ -f "$c" ]]; then echo "$c"; return; fi
    done
    echo ""
}

inspect_tunnel_card() {
    local target="$1"
    local config="$2"
    local is_token="$3"

    get_tunnel_status "$target" "$config"

    echo -e "\n${cyan}┌─── 📋 隧道详情看板: ${bold}${target}${plain} ${cyan}─────────────────────────────${plain}"
    echo -e "${cyan}│${plain} 运行状态: ${STATUS_DESC}"
    
    if [[ $is_token -eq 1 ]]; then
        echo -e "${cyan}│${plain} 隧道模式: ${magenta}Token 远程托管 (Zero Trust Dashboard)${plain}"
        echo -e "${cyan}│${plain} 配置文件: ${yellow}无 (依赖云端下发)${plain}"
        echo -e "${cyan}└────────────────────────────────────────────────────────${plain}"
        return
    fi

    if [[ -z "$config" || ! -f "$config" ]]; then
        echo -e "${cyan}│${plain} 配置文件: ${red}未找到本地 YAML (或未挂载)${plain}"
        echo -e "${cyan}└────────────────────────────────────────────────────────${plain}"
        return
    fi

    local tunnel_id cred_file hostnames forward_urls current_protocol
    tunnel_id=$(grep -iE '^[[:space:]]*tunnel[[:space:]]*:' "$config" 2>/dev/null | head -n 1 | sed 's/^[^:]*://' | tr -d ' "\047\r\t')
    cred_file=$(grep -iE '^[[:space:]]*credentials-file[[:space:]]*:' "$config" 2>/dev/null | head -n 1 | sed 's/^[^:]*://' | tr -d ' "\047\r\t')
    hostnames=$(grep -iE '^[[:space:]]*-[[:space:]]*hostname[[:space:]]*:' "$config" 2>/dev/null | sed 's/^[^:]*://' | tr -d ' "\047\r\t')
    forward_urls=$(grep -iE '^[[:space:]]*service[[:space:]]*:' "$config" 2>/dev/null | grep -iv 'http_status' | sed 's/^[^:]*://' | tr -d ' "\047\r\t')
    
    # 【修复重点】精准解析 Protocol (过滤空格/引号并强转小写)
    current_protocol=$(grep -iE '^[[:space:]]*protocol[[:space:]]*:' "$config" 2>/dev/null | head -n 1 | sed 's/^[^:]*://' | tr -d ' "\047\r\t' | tr 'A-Z' 'a-z')
    if [[ -z "$current_protocol" ]]; then
        current_protocol="${yellow}quic (未配置, 默认值)${plain}"
    else
        current_protocol="${magenta}${current_protocol}${plain}"
    fi

    echo -e "${cyan}│${plain} 配置文件: ${green}${config}${plain}"
    echo -e "${cyan}│${plain} 隧道 ID : ${yellow}${tunnel_id:-<未读取到>}${plain}"
    echo -e "${cyan}│${plain} 传输协议: ${current_protocol}"

    if [[ -n "$cred_file" ]]; then
        if [[ -f "$cred_file" ]]; then echo -e "${cyan}│${plain} 凭据密钥: ${green}${cred_file} (✔ 存在)${plain}"
        else echo -e "${cyan}│${plain} 凭据密钥: ${red}${cred_file} (❌ 丢失！)${plain}"; fi
    fi

    if [[ -n "$hostnames" ]]; then
        echo -e "${cyan}│${plain} 穿透域名:"
        while IFS= read -r host; do [[ -n "$host" ]] && echo -e "${cyan}│${plain}   🌐 ${bold}${green}${host}${plain}"; done <<< "$hostnames"
    else
        echo -e "${cyan}│${plain} 穿透域名: ${yellow}未匹配到 hostname 规则${plain}"
    fi

    if [[ -n "$forward_urls" ]]; then
        echo -e "${cyan}│${plain} 本地转发:"
        while IFS= read -r svc; do [[ -n "$svc" ]] && echo -e "${cyan}│${plain}   🎯 ${magenta}${svc}${plain}"; done <<< "$forward_urls"
    fi
    echo -e "${cyan}└────────────────────────────────────────────────────────${plain}"
}

backup_config_file() {
    local config="$1"
    local bak="${config}.bak.$(date +%Y%m%d_%H%M%S)"
    cp "$config" "$bak"
    echo -e "${green}✔ 已自动备份原始配置至:${plain} ${bak}"
}

modify_hostname() {
    local config="$1"
    local current_hosts; current_hosts=$(grep -iE '^[[:space:]]*-[[:space:]]*hostname[[:space:]]*:' "$config" 2>/dev/null | sed 's/^[^:]*://' | tr -d ' "\047\r\t')
    if [[ -z "$current_hosts" ]]; then echo -e "${red}错误：配置文件中未找到 hostname 节点。${plain}"; return; fi
    local old_host=""; local count; count=$(echo "$current_hosts" | grep -c .)
    if [[ $count -eq 1 ]]; then
        old_host="$current_hosts"
        echo -e "\n当前绑定的域名为: ${yellow}${old_host}${plain}"
    else
        echo -e "\n${green}当前配置文件绑定了多个域名：${plain}"
        local i=1; local arr_hosts=()
        while IFS= read -r h; do [[ -z "$h" ]] && continue; echo -e "  [${i}] ${h}"; arr_hosts+=("$h"); ((i++)); done <<< "$current_hosts"
        read -rp "请选择需要修改的域名序号 [1-${#arr_hosts[@]}]: " h_sel
        if ! [[ "$h_sel" =~ ^[0-9]+$ ]] || (( h_sel < 1 || h_sel > ${#arr_hosts[@]} )); then echo -e "${red}输入无效，已取消。${plain}"; return; fi
        old_host="${arr_hosts[$((h_sel-1))]}"
    fi
    echo ""
    read -rp "请输入新域名 (如: vpn.domain.com): " new_host; new_host=$(echo "$new_host" | xargs)
    if [[ -z "$new_host" ]]; then echo -e "${red}域名不能为空！${plain}"; return; fi
    if [[ "$new_host" == "$old_host" ]]; then echo -e "${yellow}新旧域名一致，未做修改。${plain}"; return; fi

    backup_config_file "$config"
    sed -i "s|hostname[[:space:]]*:[[:space:]]*${old_host}|hostname: ${new_host}|g" "$config"
    echo -e "\n${green}✔ 域名修改完成！${plain}"
    echo -e "  原域名: ${red}${old_host}${plain}  ➔  新域名: ${green}${new_host}${plain}"
}

modify_tunnel_id() {
    local config="$1"
    local old_id; old_id=$(grep -iE '^[[:space:]]*tunnel[[:space:]]*:' "$config" 2>/dev/null | head -n 1 | sed 's/^[^:]*://' | tr -d ' "\047\r\t')
    echo -e "\n当前 Tunnel ID (UUID) 为: ${yellow}${old_id:-未定义}${plain}"
    read -rp "请输入全新的 Tunnel UUID: " new_id; new_id=$(echo "$new_id" | xargs)
    if [[ -z "$new_id" ]]; then echo -e "${red}Tunnel ID 不能为空！${plain}"; return; fi
    if [[ "$new_id" == "$old_id" ]]; then echo -e "${yellow}新旧 ID 相同，跳过修改。${plain}"; return; fi

    backup_config_file "$config"
    # 使用安全的 sed 匹配替换，避免影响其他字段
    if grep -qiE '^[[:space:]]*tunnel[[:space:]]*:' "$config"; then
        sed -i -e 's/^[[:space:]]*[tT][uU][nN][nN][eE][lL][[:space:]]*:.*/tunnel: '"$new_id"'/' "$config"
    else
        sed -i "1i tunnel: ${new_id}" "$config"
    fi

    if [[ -n "$old_id" ]] && grep -q "$old_id" "$config"; then
        read -rp "检测到凭证文件名与旧 ID 关联，是否同步更新 UUID？[Y/n]: " sync_cred
        if [[ "${sync_cred:-Y}" =~ ^[Yy]$ ]]; then
            sed -i "s|${old_id}|${new_id}|g" "$config"
            echo -e "${green}✔ 凭据配置路径已联动修改为新 UUID。${plain}"
        fi
    fi
    echo -e "\n${green}✔ Tunnel ID 修改完成！${plain}"
}

modify_protocol() {
    local config="$1"
    
    # 提取当前协议值
    local raw_protocol; raw_protocol=$(grep -iE '^[[:space:]]*protocol[[:space:]]*:' "$config" 2>/dev/null | head -n 1 | sed 's/^[^:]*://' | tr -d ' "\047\r\t' | tr 'A-Z' 'a-z')
    
    local current_protocol_val="quic"
    [[ -n "$raw_protocol" ]] && current_protocol_val="$raw_protocol"
    
    local target_protocol="http2"
    [[ "$current_protocol_val" == "http2" ]] && target_protocol="quic"

    local display_proto="${raw_protocol}"
    [[ -z "$raw_protocol" ]] && display_proto="quic (默认未配置)"

    echo -e "\n当前传输协议为: ${yellow}${display_proto}${plain}"
    echo -e " ${cyan}提示：防御运营商 UDP 阻断或 QoS 降速，推荐切换至 http2。恢复性能可切回 quic。${plain}"
    read -rp "是否将协议切换并写入为 [${target_protocol}]？[Y/n]: " switch_ans
    
    if [[ "${switch_ans:-Y}" =~ ^[Yy]$ ]]; then
        backup_config_file "$config"
        
        # 【修复重点】无视大小写，直接安全删除旧的 protocol 配置行
        sed -i -e '/^[[:space:]]*[pP][rR][oO][tT][oO][cC][oO][lL][[:space:]]*:/d' "$config"
        
        # 在第一行强行插入新协议，防止插在尾部导致 YAML 层级被 ingress 解析错乱
        sed -i "1i protocol: ${target_protocol}" "$config"
        
        echo -e "\n${green}✔ 协议已成功切换并写入为: ${target_protocol}${plain}"
    else
        echo -e "\n${yellow}已取消，保持当前协议。${plain}"
    fi
}

manage_service() {
    local target="$1"; local action="$2"
    local action_zh="启动"; [[ "$action" == "stop" ]] && action_zh="停止"; [[ "$action" == "restart" ]] && action_zh="重启"
    echo -e "\n${cyan}正在执行操作: ${action_zh}隧道服务...${plain}"

    local svc_name="cf-${target}"
    [[ "$target" == "cloudflared" || "$target" == "Token_Managed_Tunnel" || "$target" == "cloudflared_process" ]] && svc_name="cloudflared"

    local service_handled=0

    # Systemd 处理
    if command -v systemctl &>/dev/null && [[ -d /run/systemd/system ]]; then
        if systemctl list-unit-files "${svc_name}.service" &>/dev/null || systemctl list-unit-files "cloudflared.service" &>/dev/null; then
            systemctl "$action" "$svc_name" 2>/dev/null || systemctl "$action" cloudflared 2>/dev/null
            service_handled=1
        fi
    fi

    # OpenRC 处理
    if [[ $service_handled -eq 0 ]] && command -v rc-service &>/dev/null; then
        local rc_target="$svc_name"; [[ ! -f "/etc/init.d/$rc_target" && -f "/etc/init.d/cloudflared" ]] && rc_target="cloudflared"
        if [[ -f "/etc/init.d/$rc_target" ]]; then
            rc-service "$rc_target" "$action" 2>/dev/null
            service_handled=1
        fi
    fi

    sleep 1
    if [[ "$action" == "stop" ]]; then
        # 兜底强制 Kill
        local pids=$(pgrep -f "cloudflared.*${target}")
        [[ -z "$pids" && "$target" == "cloudflared" ]] && pids=$(pgrep -x "cloudflared")
        if [[ -n "$pids" ]]; then
            kill $pids 2>/dev/null
        fi
        echo -e "${green}✔ 服务/进程停止命令已下发。${plain}"
    else
        if [[ $service_handled -eq 1 ]]; then
            echo -e "${green}✔ 服务 ${action_zh} 指令已下发。${plain}"
        else
            echo -e "${yellow}未发现注册的标准服务。若为命令行直接运行，请手动执行启动命令。${plain}"
        fi
    fi
}

delete_tunnel() {
    local target="$1"
    local config="$2"
    local svc_name="cf-${target}"
    [[ "$target" == "cloudflared" || "$target" == "Token_Managed_Tunnel" || "$target" == "cloudflared_process" ]] && svc_name="cloudflared"

    echo -e "\n${red}===================================================${plain}"
    echo -e "${red} ⚠️ 危险操作：您正在尝试彻底删除隧道 [${target}]${plain}"
    echo -e "${red}===================================================${plain}"
    read -rp "是否确认停止并卸载该隧道服务？ [y/N]: " confirm_del
    [[ ! "$confirm_del" =~ ^[Yy]$ ]] && echo -e "${yellow}已取消删除操作。${plain}" && return 1

    manage_service "$target" "stop"

    local removed_svc=0
    if command -v systemctl &>/dev/null; then
        systemctl disable "$svc_name" 2>/dev/null
        if [[ -f "/etc/systemd/system/${svc_name}.service" ]]; then
            rm -f "/etc/systemd/system/${svc_name}.service"
            removed_svc=1
        fi
        systemctl daemon-reload 2>/dev/null
    fi
    if command -v rc-update &>/dev/null; then
        rc-update del "$svc_name" default 2>/dev/null
        if [[ -f "/etc/init.d/${svc_name}" ]]; then
            rm -f "/etc/init.d/${svc_name}"
            removed_svc=1
        fi
    fi

    [[ $removed_svc -eq 1 ]] && echo -e "${green}✔ 系统服务文件已卸载。${plain}"

    if [[ -n "$config" && -f "$config" ]]; then
        read -rp "是否一并删除关联的 YAML 配置文件及 JSON 密钥凭证？[y/N]: " del_cfg
        if [[ "$del_cfg" =~ ^[Yy]$ ]]; then
            local cred_file; cred_file=$(grep -iE '^[[:space:]]*credentials-file[[:space:]]*:' "$config" | sed 's/^[^:]*://' | tr -d ' "\047\r')
            if [[ -n "$cred_file" && -f "$cred_file" ]]; then
                rm -f "$cred_file"
                echo -e "${green}✔ JSON 凭证文件已删除: ${cred_file}${plain}"
            fi
            rm -f "$config"
            echo -e "${green}✔ YAML 配置文件已删除: ${config}${plain}"
        else
            echo -e "${yellow}已保留配置文件: ${config}${plain}"
        fi
    fi

    echo -e "\n${green}🎉 隧道实例 [${target}] 清理完成！按回车键重新加载面板...${plain}"
    read -r
    
    exec bash "$0" "$@"
}

main() {
    clear
    echo -e "${cyan}================================================================${plain}"
    echo -e "${cyan}   🚀 Cloudflare Argo Tunnel 交互式管理引擎 (全能进阶版)       ${plain}"
    echo -e "${cyan}================================================================${plain}"

    local raw_tunnels; raw_tunnels=$(scan_all_local_tunnels)
    local tunnels=($raw_tunnels)
    local target_name=""; local config_file=""

    if [[ ${#tunnels[@]} -eq 0 ]]; then
        echo -e "${yellow}未在系统服务或进程中找到运行的隧道，进入手动模式。${plain}"
        read -rp "请输入 cloudflared yml 配置文件的完整绝对路径: " config_file
        if [[ ! -f "$config_file" ]]; then echo -e "${red}文件不存在，退出。${plain}"; exit 1; fi
        target_name="custom"
    else
        echo -e "${green}已识别到本机存在以下隧道实例/服务：${plain}\n"
        local i=1
        for t in "${tunnels[@]}"; do
            local cfg; cfg=$(find_config_file "$t")
            get_tunnel_status "$t" "$cfg"
            printf "  ${green}%2d.${plain} 实例标识: ${cyan}%-18s${plain} 状态: %b\n" "$i" "$t" "$STATUS_DESC"
            ((i++))
        done
        echo ""

        if [[ ${#tunnels[@]} -eq 1 ]]; then
            echo -e "${green}检测到当前机器仅有 1 个隧道目标，已自动选定: ${cyan}${tunnels[0]}${plain}"
            target_name="${tunnels[0]}"
        else
            read -rp "请输入要进入管理的隧道序号 [1-${#tunnels[@]}]: " t_sel
            if ! [[ "$t_sel" =~ ^[0-9]+$ ]] || (( t_sel < 1 || t_sel > ${#tunnels[@]} )); then echo -e "${red}输入无效，退出。${plain}"; exit 1; fi
            target_name="${tunnels[$((t_sel-1))]}"
        fi
        config_file=$(find_config_file "$target_name")
    fi

    local is_token=0
    if check_if_token_tunnel "$target_name"; then is_token=1; fi

    if [[ -z "$config_file" || ! -f "$config_file" ]]; then
        if [[ $is_token -eq 0 ]]; then
            echo -e "\n${yellow}⚠ 未能自动定位 [${target_name}] 的 YAML 配置文件！${plain}"
            read -rp "请手动输入绝对路径 (若确认无配置文件，请直接回车进入查看模式): " config_file
            if [[ -n "$config_file" && ! -f "$config_file" ]]; then
                echo -e "${red}路径无效！将以“无配置安全模式”进入控制面板。${plain}"
                config_file=""
            fi
        fi
    fi

    while true; do
        inspect_tunnel_card "$target_name" "$config_file" "$is_token"

        echo -e "\n${bold}请选择要执行的操作：${plain}"
        if [[ $is_token -eq 0 && -n "$config_file" && -f "$config_file" ]]; then
            echo -e "  ${green}1.${plain} 修改绑定的域名 (Hostname)"
            echo -e "  ${green}2.${plain} 修改隧道 ID (Tunnel UUID)"
            echo -e "  ${green}3.${plain} 同时修改 ID 与 域名"
            echo -e "  ${green}4.${plain} 切换传输协议 (QUIC ⇄ HTTP2)  ${yellow}[防御 UDP 阻断]${plain}"
        else
            echo -e "  ${dim}1. 修改绑定的域名 (不可用: 需挂载本地 YAML)${plain}"
            echo -e "  ${dim}2. 修改隧道 ID (不可用: 需挂载本地 YAML)${plain}"
            echo -e "  ${dim}3. 同时修改 ID 与 域名 (不可用: 需挂载本地 YAML)${plain}"
            echo -e "  ${dim}4. 切换传输协议 (不可用: 需挂载本地 YAML)${plain}"
        fi

        echo -e "  ${green}5.${plain} 重启隧道服务 (Reload / Restart)"
        if [[ $STATUS_RUNNING -eq 1 ]]; then echo -e "  ${green}6.${plain} ${yellow}停止隧道服务 (Stop)${plain}"
        else echo -e "  ${green}6.${plain} ${green}启动隧道服务 (Start)${plain}"; fi
        echo -e "  ${green}7.${plain} ${red}彻底删除隧道 (卸载服务/配置文件)${plain}"
        echo -e "  ${green}0.${plain} 退出程序"
        echo ""
        read -rp "请输入菜单选项 [0-7]: " opt

        case "$opt" in
            1|2|3|4)
                if [[ $is_token -eq 1 ]]; then
                    echo -e "\n${yellow}⚠ 当前为 Token 远程托管隧道！\n👉 请登录 Cloudflare Zero Trust 网页后台进行配置更改，本地无法编辑。${plain}"
                elif [[ -z "$config_file" || ! -f "$config_file" ]]; then
                    echo -e "\n${red}⚠ 缺少本地 YAML 配置文件，此功能已被禁用。${plain}"
                else
                    if [ "$opt" -eq 1 ]; then modify_hostname "$config_file"; read -rp "是否立即重启生效？[Y/n]: " r_ans; [[ "${r_ans:-Y}" =~ ^[Yy]$ ]] && manage_service "$target_name" "restart"; fi
                    if [ "$opt" -eq 2 ]; then modify_tunnel_id "$config_file"; read -rp "是否立即重启生效？[Y/n]: " r_ans; [[ "${r_ans:-Y}" =~ ^[Yy]$ ]] && manage_service "$target_name" "restart"; fi
                    if [ "$opt" -eq 3 ]; then modify_tunnel_id "$config_file"; echo -e "${magenta}--------------------------------${plain}"; modify_hostname "$config_file"; read -rp "是否立即重启生效？[Y/n]: " r_ans; [[ "${r_ans:-Y}" =~ ^[Yy]$ ]] && manage_service "$target_name" "restart"; fi
                    if [ "$opt" -eq 4 ]; then modify_protocol "$config_file"; read -rp "是否立即重启生效？[Y/n]: " r_ans; [[ "${r_ans:-Y}" =~ ^[Yy]$ ]] && manage_service "$target_name" "restart"; fi
                fi
                ;;
            5) manage_service "$target_name" "restart" ;;
            6) [[ $STATUS_RUNNING -eq 1 ]] && manage_service "$target_name" "stop" || manage_service "$target_name" "start" ;;
            7) delete_tunnel "$target_name" "$config_file" ;;
            0) echo -e "\n${green}操作完成，已安全退出。${plain}\n"; exit 0 ;;
            *) echo -e "${red}无效输入，请重新选择。${plain}" ;;
        esac

        echo ""; read -rp "按回车键刷新面板..."; clear
    done
}

main
