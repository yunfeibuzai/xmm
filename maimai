#!/bin/bash

# 麦卖云 V2bX 后端全能王牌脚本 (Systemd & OpenRC 双模自适应+全透明防爆版)
sh_ver="4.9.1-Pro"

red='\033[31m'; green='\033[32m'; yellow='\033[33m'
magenta='\033[35m'; cyan='\033[36m'; plain='\033[0m'; dim='\033[2m'

[[ $EUID -ne 0 ]] && echo -e "${red}错误：${plain}必须使用 root 用户运行此脚本！\n" && exit 1

# 🌟 基础依赖自动补齐 (增加 sed、jq、openssl 保障 Alpine 兼容性)
install_dependencies() {
    local cmds=("wget" "curl" "tar" "unzip" "jq" "nano" "sed" "openssl")
    local needs_install=false

    for cmd in "${cmds[@]}"; do
        if ! command -v "$cmd" &>/dev/null; then
            needs_install=true
            break
        fi
    done

    if ! command -v update-ca-certificates &>/dev/null && [ ! -d /etc/ssl/certs ]; then
        needs_install=true
    fi

    if command -v apk &>/dev/null; then
        if ! apk info -e gcompat &>/dev/null || ! apk info -e libc6-compat &>/dev/null; then
            needs_install=true
        fi
    fi

    if [ "$needs_install" = true ]; then
        echo -e "${yellow}正在检查并补齐系统基础依赖与架构兼容层...${plain}"
        if command -v apt-get &>/dev/null; then
            apt-get update -y -q >/dev/null 2>&1
            apt-get install -y --no-install-recommends wget curl tar unzip jq nano sed openssl ca-certificates >/dev/null 2>&1
        elif command -v yum &>/dev/null; then
            yum install -y epel-release >/dev/null 2>&1
            yum install -y wget curl tar unzip jq nano sed openssl ca-certificates >/dev/null 2>&1
        elif command -v apk &>/dev/null; then
            apk add --no-cache wget curl tar unzip jq nano sed openssl ca-certificates gcompat libc6-compat >/dev/null 2>&1
        fi
    fi
}
install_dependencies

# 🌟 快捷命令注册
register_shortcut() {
    mkdir -p /usr/local/bin
    rm -f /usr/bin/maimai /usr/bin/v2bx
    
    if [[ -f "$0" ]]; then
        local current_abs_path
        current_abs_path=$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")
        if [[ "$current_abs_path" != "/usr/local/bin/maimai_core.sh" ]]; then
            cp -f "$current_abs_path" /usr/local/bin/maimai_core.sh 2>/dev/null
            chmod +x /usr/local/bin/maimai_core.sh
        fi
    fi
    
    if [[ -f /usr/local/bin/maimai_core.sh ]]; then
        ln -sf /usr/local/bin/maimai_core.sh /usr/bin/maimai
        ln -sf /usr/local/bin/maimai_core.sh /usr/bin/v2bx
        chmod +x /usr/bin/maimai /usr/bin/v2bx
    fi
}
register_shortcut

# 🌟 统一远程模块分发引擎 (支持子目录路径如 all/xmm12)
run_remote_module() {
    local mod_name="$1"
    local desc="$2"
    echo -e "${cyan}正在拉取并运行 ${desc}...${plain}"

    # 将路径中的 / 替换为 _，防止 /tmp/all/xmm12 因目录不存在报错
    local safe_name="${mod_name//\//_}"
    local tmp_file="/tmp/${safe_name}_${RANDOM}.sh"
    local urls=(
        "https://ghp.ci/https://raw.githubusercontent.com/yunfeibuzai/xmm/main/${mod_name}"
        "https://mirror.ghproxy.net/https://raw.githubusercontent.com/yunfeibuzai/xmm/main/${mod_name}"
        "https://raw.githubusercontent.com/yunfeibuzai/xmm/main/${mod_name}"
    )

    local success=false
    for url in "${urls[@]}"; do
        if wget -q --timeout=10 -O "$tmp_file" "$url" || curl -sL --connect-timeout 8 "$url" -o "$tmp_file"; then
            if [[ -f "$tmp_file" && -s "$tmp_file" ]]; then
                success=true
                break
            fi
        fi
    done

    if [ "$success" = true ]; then
        chmod +x "$tmp_file"
        bash "$tmp_file"
        rm -f "$tmp_file"
    else
        rm -f "$tmp_file"
        echo -e "${red}错误：拉取模块 [${desc}] (${mod_name}) 失败，请检查网络或 GitHub 存储库！${plain}"
    fi
}

# 🌟 智能内核服务管理器 (兼容单进程与多进程隔离模式)
manage_service() {
    local action=$1
    # 检测是否处于多进程隔离模式
    if [[ -f /etc/V2bX/nodes/.multi_enabled ]]; then
        if command -v systemctl &>/dev/null; then
            for f in /etc/V2bX/nodes/node_*.json; do
                [[ ! -f "$f" ]] && continue
                local inst
                inst=$(basename "$f" .json)
                case "$action" in
                    start|stop|restart|enable|disable) systemctl "$action" "v2bx@${inst}" 2>/dev/null ;;
                    status) systemctl status "v2bx@${inst}" --no-pager ;;
                esac
            done
        elif command -v rc-service &>/dev/null; then
            for init_f in /etc/init.d/v2bx.node_*; do
                [[ ! -f "$init_f" ]] && continue
                local svc
                svc=$(basename "$init_f")
                case "$action" in
                    start|stop|restart|status) rc-service "$svc" "$action" ;;
                    enable) rc-update add "$svc" default >/dev/null 2>&1 ;;
                    disable) rc-update del "$svc" default >/dev/null 2>&1 ;;
                esac
            done
        fi
        return
    fi

    # 默认单进程模式
    if command -v systemctl &>/dev/null; then
        case "$action" in
            start) systemctl start V2bX ;;
            stop) systemctl stop V2bX ;;
            restart) systemctl restart V2bX ;;
            status) systemctl status V2bX ;;
            enable) systemctl enable V2bX >/dev/null 2>&1 ;;
            disable) systemctl disable V2bX >/dev/null 2>&1 ;;
        esac
    elif command -v rc-service &>/dev/null; then
        case "$action" in
            start) rc-service V2bX start ;;
            stop) rc-service V2bX stop ;;
            restart) rc-service V2bX restart ;;
            status) rc-service V2bX status ;;
            enable) rc-update add V2bX default >/dev/null 2>&1 ;;
            disable) rc-update del V2bX default >/dev/null 2>&1 ;;
        esac
    fi
}

# 🌟 独立多维日志排查控制台 (保留在主脚本中)
inspect_logs() {
    echo -e "\n${cyan}================ 📊 V2bX 日志诊断中心 ================${plain}"
    echo -e "  ${green}1.${plain} 追踪系统级运行输出 (Systemd / OpenRC 控制台)"
    echo -e "  ${green}2.${plain} 查看核心错误日志 (/etc/V2bX/error.log)"
    echo -e "  ${green}3.${plain} 查看用户连接日志 (/var/log/V2bX/access.log)"
    echo -e "  ${green}4.${plain} 返回上级菜单"
    read -rp "请选择日志类型 [1-4] (默认 1): " log_type < /dev/tty
    [[ -z "$log_type" ]] && log_type=1

    if [[ "$log_type" == "4" ]]; then return; fi

    echo -e "${yellow}💡 提示：正在实时滚动日志，随时按 [Ctrl+C] 可安全退出查看并返回菜单。${plain}\n"
    
    trap '' INT
    (
        trap - INT
        case "$log_type" in
            1)
                if [[ -f /etc/V2bX/nodes/.multi_enabled ]] && command -v systemctl &>/dev/null; then
                    journalctl -u "v2bx@*" -n 50 -f --no-pager
                elif command -v systemctl &>/dev/null; then
                    journalctl -u V2bX -n 50 -f --no-pager
                else
                    tail -n 50 -f /var/log/v2bx*.log 2>/dev/null || echo -e "${yellow}暂无控制台日志${plain}"
                fi
                ;;
            2)
                if ls /var/log/V2bX/error_*.log >/dev/null 2>&1; then
                    tail -n 50 -f /var/log/V2bX/error_*.log
                elif [ -f /etc/V2bX/error.log ]; then
                    tail -n 50 -f /etc/V2bX/error.log
                elif [ -f /var/log/v2bx_err.log ]; then
                    tail -n 50 -f /var/log/v2bx_err.log
                else
                    echo -e "${green}暂无独立错误日志，核心运行良好！${plain}"
                fi
                ;;
            3)
                if [ -f /var/log/V2bX/access.log ]; then
                    tail -n 50 -f /var/log/V2bX/access.log
                else
                    echo -e "${yellow}未找到 /var/log/V2bX/access.log (可能连接日志已关闭或尚无连接)${plain}"
                fi
                ;;
        esac
    )
    trap - INT
    echo -e "\n${green}✔ 已停止查阅日志。${plain}"
}

show_status() {
    local core_status="${red}未安装${plain}"
    local guard_status="${yellow}未开启 (原生态无锁)${plain}"
    local mode_status="${cyan}单进程${plain}"

    if [[ -f /etc/V2bX/nodes/.multi_enabled ]]; then
        mode_status="${magenta}多进程隔离${plain}"
    fi

    if [[ -f /usr/local/V2bX/V2bX && -s /usr/local/V2bX/V2bX ]]; then
        if [[ -f /etc/V2bX/nodes/.multi_enabled ]]; then
            if pgrep -f "/usr/local/V2bX/V2bX" >/dev/null 2>&1; then
                local cnt
                cnt=$(pgrep -fc "/usr/local/V2bX/V2bX")
                core_status="${green}运行中 (${cnt}实例)${plain}"
            else
                core_status="${yellow}已停止${plain}"
            fi
        elif command -v systemctl &>/dev/null; then
            if systemctl is-active --quiet V2bX 2>/dev/null; then
                core_status="${green}运行中${plain}"
            else
                core_status="${yellow}已停止${plain}"
            fi
            if grep -q "MemoryMax" /etc/systemd/system/V2bX.service 2>/dev/null || grep -q "GOMEMLIMIT" /etc/systemd/system/V2bX.service 2>/dev/null; then
                guard_status="${green}内核防爆已开启${plain}"
            fi
        elif command -v rc-service &>/dev/null; then
            local rc_out; rc_out=$(rc-service V2bX status 2>/dev/null)
            if echo "$rc_out" | grep -q "started"; then
                core_status="${green}运行中${plain}"
            elif echo "$rc_out" | grep -q "crashed"; then
                core_status="${red}已崩溃${plain}"
            else
                core_status="${yellow}已停止${plain}"
            fi
            if grep -q "GOMEMLIMIT" /etc/init.d/V2bX 2>/dev/null; then
                guard_status="${green}内核防爆已开启${plain}"
            fi
        fi
    fi

    echo -e "状态: $core_status | 模式: $mode_status | 护卫: $guard_status"
}

