#!/usr/bin/env bash

# 麦卖云 V2bX 后端全能王牌脚本 (Systemd & OpenRC 双模自适应+全透明防爆版)
sh_ver="5.3.0-Pro"

# 0. 跨系统 POSIX /bin/sh 自愈引导
if [ -z "$BASH_VERSION" ]; then
    if ! command -v bash >/dev/null 2>&1; then
        if command -v apk >/dev/null 2>&1; then
            printf '\033[33m检测到 Alpine 环境，正在自动补齐 bash 运行环境...\033[0m\n'
            apk update >/dev/null 2>&1 && apk add --no-cache bash >/dev/null 2>&1
        else
            printf '错误：当前系统缺少 bash，请先安装 bash 后运行此脚本！\n'
            exit 1
        fi
    fi
    if [ -f "$0" ]; then
        exec bash "$0" "$@"
    else
        exec bash -s -- "$@"
    fi
fi

red='\033[31m'; green='\033[32m'; yellow='\033[33m'
magenta='\033[35m'; cyan='\033[36m'; plain='\033[0m'; dim='\033[2m'

[[ $EUID -ne 0 ]] && echo -e "${red}错误：${plain}必须使用 root 用户运行此脚本！\n" && exit 1

REPO_RAW_BASE="https://raw.githubusercontent.com/yunfeibuzai/xmm/main"
GH_MIRRORS=(
    "https://gh-proxy.com/"
    "https://ghproxy.net/"
    "https://github.akams.cn/"
    "https://ghproxy.homeboyc.cn/"
    ""
)

is_systemd() {
    command -v systemctl &>/dev/null && [[ -d /run/systemd/system ]]
}

get_openrc_main_svc() {
    if [[ -f /etc/init.d/V2bX ]]; then
        echo "V2bX"
    elif [[ -f /etc/init.d/v2bx ]]; then
        echo "v2bx"
    else
        echo "V2bX"
    fi
}

# 🌟 精确统计多进程隔离实例 (返回 "运行数|总配置数")
get_multi_instance_counts() {
    shopt -s nullglob
    local split_files=(/etc/V2bX/nodes/port_*.json /etc/V2bX/nodes/node_*.json)
    shopt -u nullglob

    local total=${#split_files[@]}
    local active=0

    for f in "${split_files[@]}"; do
        local inst
        inst=$(basename "$f" .json)
        if is_systemd; then
            systemctl is-active --quiet "v2bx@${inst}.service" 2>/dev/null && ((active++))
        elif command -v rc-service &>/dev/null; then
            if rc-service "v2bx.${inst}" status 2>/dev/null | grep -q "started" || \
               rc-service "V2bX.${inst}" status 2>/dev/null | grep -q "started" || \
               pgrep -f "/etc/V2bX/nodes/${inst}.json" >/dev/null 2>&1; then
                ((active++))
            fi
        else
            pgrep -f "/etc/V2bX/nodes/${inst}.json" >/dev/null 2>&1 && ((active++))
        fi
    done

    echo "${active}|${total}"
}

# 🌟 精准探测当前是否处于多进程隔离模式 (结合真实进程与服务状态，自动清理过期标记)
is_multi_active() {
    local counts active_cnt total_cnt
    counts=$(get_multi_instance_counts)
    active_cnt="${counts%%|*}"
    total_cnt="${counts##*|}"

    if [[ "${active_cnt:-0}" -gt 0 ]]; then
        mkdir -p /etc/V2bX/nodes
        touch /etc/V2bX/nodes/.multi_enabled 2>/dev/null
        return 0
    fi

    # 若单进程 V2bX 正在运行，说明当前实际为单进程模式，清理残留旧标记
    local single_running=false
    if is_systemd && systemctl is-active --quiet V2bX.service 2>/dev/null; then
        single_running=true
    elif command -v rc-service &>/dev/null && rc-service "$(get_openrc_main_svc)" status 2>/dev/null | grep -q "started"; then
        single_running=true
    elif pgrep -f "/etc/V2bX/config.json" >/dev/null 2>&1; then
        single_running=true
    fi

    if [ "$single_running" = true ]; then
        rm -f /etc/V2bX/nodes/.multi_enabled 2>/dev/null
        return 1
    fi

    if [[ -f /etc/V2bX/nodes/.multi_enabled ]] && [[ "${total_cnt:-0}" -gt 0 ]]; then
        return 0
    fi

    if compgen -G "/etc/systemd/system/multi-user.target.wants/v2bx@*.service" >/dev/null 2>&1 || \
       compgen -G "/etc/init.d/v2bx.port_*" >/dev/null 2>&1 || \
       compgen -G "/etc/init.d/v2bx.node_*" >/dev/null 2>&1 || \
       compgen -G "/etc/init.d/V2bX.node_*" >/dev/null 2>&1; then
        mkdir -p /etc/V2bX/nodes
        touch /etc/V2bX/nodes/.multi_enabled 2>/dev/null
        return 0
    fi

    return 1
}

make_temp_file() {
    local prefix="${1:-maimai_tmp}"
    local tmp
    tmp=$(mktemp "/tmp/${prefix}_XXXXXX" 2>/dev/null)
    if [[ -z "$tmp" ]]; then
        tmp="/tmp/${prefix}_$$_${RANDOM}"
        : > "$tmp"
    fi
    echo "$tmp"
}

install_dependencies() {
    local cmds=("wget" "curl" "tar" "unzip" "jq" "nano" "sed" "openssl" "pgrep")
    local needs_install=false

    for cmd in "${cmds[@]}"; do
        if ! command -v "$cmd" &>/dev/null; then
            needs_install=true
            break
        fi
    done

    if ! command -v update-ca-certificates &>/dev/null && [[ ! -d /etc/ssl/certs ]]; then
        needs_install=true
    fi

    if command -v apk &>/dev/null; then
        if ! apk info -e gcompat &>/dev/null; then
            needs_install=true
        fi
    fi

    if [[ "$needs_install" = true ]]; then
        echo -e "${yellow}正在检查并补齐系统基础依赖与架构兼容层...${plain}"
        if command -v apt-get &>/dev/null; then
            DEBIAN_FRONTEND=noninteractive apt-get update -y -q >/dev/null 2>&1
            DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends wget curl tar unzip jq nano sed openssl procps ca-certificates >/dev/null 2>&1
        elif command -v yum &>/dev/null; then
            yum install -y epel-release >/dev/null 2>&1
            yum install -y wget curl tar unzip jq nano sed openssl procps-ng ca-certificates >/dev/null 2>&1
        elif command -v apk &>/dev/null; then
            apk update >/dev/null 2>&1
            apk add --no-cache wget curl tar unzip jq nano sed openssl procps ca-certificates >/dev/null 2>&1
            apk add --no-cache gcompat libc6-compat >/dev/null 2>&1 || apk add --no-cache gcompat >/dev/null 2>&1
        fi
    fi
}
install_dependencies

fetch_github_file() {
    local raw_url="$1"
    local dest_file="$2"
    local verify_pattern="${3:-}"
    local is_shell="${4:-true}"
    local mirror full_url

    [[ -z "$dest_file" ]] && return 1

    for mirror in "${GH_MIRRORS[@]}"; do
        full_url="${mirror}${raw_url}"
        rm -f "$dest_file"

        if command -v curl &>/dev/null; then
            curl -fsSL --connect-timeout 4 --max-time 15 "$full_url" -o "$dest_file" 2>/dev/null
        fi

        if [[ ! -s "$dest_file" ]] && command -v wget &>/dev/null; then
            if wget --help 2>&1 | grep -q -- '--tries'; then
                wget -q --timeout=6 --tries=1 --no-check-certificate -O "$dest_file" "$full_url" 2>/dev/null
            else
                wget -q -T 6 -O "$dest_file" "$full_url" 2>/dev/null
            fi
        fi

        if [[ -s "$dest_file" ]]; then
            if head -n 5 "$dest_file" | grep -qiE '<!doctype|<html'; then
                continue
            fi
            if head -n 3 "$dest_file" | grep -qiE '^\s*(\{.*"error"|\{.*"message"|404:|502 |503 |504 |error code:)'; then
                continue
            fi
            if [[ -n "$verify_pattern" ]] && ! grep -q "$verify_pattern" "$dest_file"; then
                continue
            fi
            if [[ "$is_shell" == "true" ]]; then
                sed -i 's/\r$//' "$dest_file" 2>/dev/null
                if ! bash -n "$dest_file" 2>/dev/null; then
                    continue
                fi
            fi
            return 0
        fi
    done

    rm -f "$dest_file"
    return 1
}

register_shortcut() {
    mkdir -p /usr/local/bin
    local core_script="/usr/local/bin/maimai_core.sh"

    if [[ -f "$0" && ! -p "$0" && "$0" != /dev/fd/* && "$0" != /proc/self/fd/* && "$0" != "bash" && "$0" != "-bash" && "$0" != "sh" ]] && grep -q "sh_ver=" "$0" 2>/dev/null; then
        local current_abs_path
        current_abs_path=$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")
        if [[ "$current_abs_path" != "$core_script" ]]; then
            cp -f "$current_abs_path" "$core_script" 2>/dev/null
            chmod +x "$core_script"
        fi
    elif [[ ! -s "$core_script" ]] || ! grep -q "sh_ver=\"${sh_ver}\"" "$core_script" 2>/dev/null; then
        local tmp_core
        tmp_core=$(make_temp_file "maimai_core")
        if fetch_github_file "${REPO_RAW_BASE}/maimai" "$tmp_core" "sh_ver=" "true"; then
            mv -f "$tmp_core" "$core_script"
            chmod +x "$core_script"
        else
            rm -f "$tmp_core"
        fi
    fi

    if [[ -s "$core_script" ]]; then
        ln -sf "$core_script" /usr/bin/maimai
        ln -sf "$core_script" /usr/bin/v2bx
        chmod +x /usr/bin/maimai /usr/bin/v2bx
    fi
}
register_shortcut

run_remote_module() {
    local mod_name="$1"
    local desc="$2"
    echo -e "${cyan}正在拉取并运行 ${desc}...${plain}"

    local safe_name="${mod_name//\//_}"
    local tmp_file
    tmp_file=$(make_temp_file "${safe_name}")

    if fetch_github_file "${REPO_RAW_BASE}/${mod_name}" "$tmp_file" "" "true"; then
        sed -i -E 's|https?://(ghp\.ci|mirror\.ghproxy\.net|mirror\.ghproxy\.com|ghproxy\.com|ghps\.cc|ghproxy\.cc)(/?)|https://gh-proxy.com\2|g' "$tmp_file" 2>/dev/null
        chmod +x "$tmp_file"
        bash "$tmp_file"
        rm -f "$tmp_file"
    else
        rm -f "$tmp_file"
        echo -e "${red}错误：拉取模块 [${desc}] (${mod_name}) 失败，请检查网络或顶部 GH_MIRRORS 配置！${plain}"
    fi
}

manage_service() {
    local action=$1
    if is_multi_active; then
        if is_systemd; then
            systemctl disable --now V2bX.service >/dev/null 2>&1
            systemctl mask V2bX.service >/dev/null 2>&1

            shopt -s nullglob
            local split_files=(/etc/V2bX/nodes/port_*.json /etc/V2bX/nodes/node_*.json)
            shopt -u nullglob

            if [[ ${#split_files[@]} -eq 0 ]]; then
                echo -e "${yellow}未找到任何已拆分的实例配置文件 (/etc/V2bX/nodes/)${plain}"
                return
            fi

            for f in "${split_files[@]}"; do
                local inst
                inst=$(basename "$f" .json)
                case "$action" in
                    start|stop|restart|enable|disable)
                        systemctl reset-failed "v2bx@${inst}" 2>/dev/null
                        if systemctl "$action" "v2bx@${inst}" 2>/dev/null; then
                            echo -e "${green}✔ [v2bx@${inst}] 已执行 ${action}${plain}"
                        else
                            echo -e "${red}✖ [v2bx@${inst}] 执行 ${action} 失败，请通过选项 8 排查日志${plain}"
                        fi
                        ;;
                    status) systemctl status "v2bx@${inst}" --no-pager ;;
                esac
            done
        elif command -v rc-service &>/dev/null; then
            local main_svc
            main_svc=$(get_openrc_main_svc)
            rc-service "$main_svc" stop >/dev/null 2>&1
            rc-update del "$main_svc" default >/dev/null 2>&1
            chmod -x "/etc/init.d/${main_svc}" 2>/dev/null

            shopt -s nullglob
            local rc_files=(/etc/init.d/v2bx.port_* /etc/init.d/v2bx.node_* /etc/init.d/V2bX.node_*)
            shopt -u nullglob

            if [[ ${#rc_files[@]} -eq 0 ]]; then
                echo -e "${yellow}未找到任何 OpenRC 多进程服务脚本${plain}"
                return
            fi

            for init_f in "${rc_files[@]}"; do
                local svc
                svc=$(basename "$init_f")
                case "$action" in
                    start|stop|restart|status) rc-service "$svc" "$action" ;;
                    enable) rc-update add "$svc" default >/dev/null 2>&1 && echo -e "${green}✔ [${svc}] 已设开机自启${plain}" ;;
                    disable) rc-update del "$svc" default >/dev/null 2>&1 && echo -e "${green}✔ [${svc}] 已取消开机自启${plain}" ;;
                esac
            done
        fi
        return
    fi

    if is_systemd; then
        systemctl unmask V2bX.service >/dev/null 2>&1
        case "$action" in
            start|stop|restart)
                systemctl reset-failed V2bX.service 2>/dev/null
                if systemctl "$action" V2bX; then
                    echo -e "${green}✔ V2bX 服务 ${action} 成功！${plain}"
                else
                    echo -e "${red}✖ V2bX 服务 ${action} 失败，请使用选项 7 或 8 查看详情。${plain}"
                fi
                ;;
            status) systemctl status V2bX --no-pager ;;
            enable) systemctl enable V2bX >/dev/null 2>&1 && echo -e "${green}✔ 已设置 V2bX 开机自启动${plain}" ;;
            disable) systemctl disable V2bX >/dev/null 2>&1 && echo -e "${green}✔ 已取消 V2bX 开机自启动${plain}" ;;
        esac
    elif command -v rc-service &>/dev/null; then
        local main_svc
        main_svc=$(get_openrc_main_svc)
        [[ -f "/etc/init.d/${main_svc}" ]] && chmod +x "/etc/init.d/${main_svc}" 2>/dev/null
        case "$action" in
            start|stop|restart|status) rc-service "$main_svc" "$action" ;;
            enable) rc-update add "$main_svc" default >/dev/null 2>&1 && echo -e "${green}✔ 已设置 ${main_svc} 开机自启动${plain}" ;;
            disable) rc-update del "$main_svc" default >/dev/null 2>&1 && echo -e "${green}✔ 已取消 ${main_svc} 开机自启动${plain}" ;;
        esac
    fi
}

inspect_logs() {
    echo -e "\n${cyan}================ 📊 V2bX 日志诊断中心 ================${plain}"
    echo -e "  ${green}1.${plain} 追踪实时运行日志 (最近 200 行完整输出 + 实时滚动)"
    echo -e "  ${green}2.${plain} 排查核心错误与启动崩溃 (合并 Systemd/ACME/Hy2/Xray 报错)"
    echo -e "  ${green}3.${plain} 查看用户连接访问日志 (Access Log)"
    echo -e "  ${green}4.${plain} 返回上级菜单"
    read -rp "请选择日志类型 [1-4] (默认 1): " log_type < /dev/tty || return
    [[ -z "$log_type" ]] && log_type=1
    [[ "$log_type" == "4" ]] && return

    local target_unit="v2bx@*"
    local target_inst=""
    if is_multi_active; then
        shopt -s nullglob
        local inst_files=(/etc/V2bX/nodes/port_*.json /etc/V2bX/nodes/node_*.json)
        shopt -u nullglob
        if [[ ${#inst_files[@]} -gt 1 ]]; then
            echo -e "\n${cyan}检测到多个隔离实例，请选择查看范围：${plain}"
            echo -e "  ${green}0.${plain} 全部实例合并查看"
            local k=1
            for f in "${inst_files[@]}"; do
                echo -e "  ${green}${k}.${plain} 仅查看 $(basename "$f" .json)"
                ((k++))
            done
            read -rp "请输入序号 [0-$((k-1))] (默认 0): " inst_sel < /dev/tty || return
            if [[ "$inst_sel" =~ ^[1-9][0-9]*$ ]] && [ "$inst_sel" -lt "$k" ]; then
                target_inst=$(basename "${inst_files[$((inst_sel-1))]}" .json)
                target_unit="v2bx@${target_inst}"
            fi
        elif [[ ${#inst_files[@]} -eq 1 ]]; then
            target_inst=$(basename "${inst_files[0]}" .json)
            target_unit="v2bx@${target_inst}"
        fi
    fi

    echo -e "${yellow}💡 提示：正在输出完整日志（按 [Ctrl+C] 可随时安全退出返回菜单）。${plain}\n"
    
    trap ':' INT
    case "$log_type" in
        1)
            if is_multi_active && is_systemd; then
                journalctl -u "$target_unit" -n 200 -f --no-pager --output=short-iso
            elif is_systemd; then
                journalctl -u V2bX -n 200 -f --no-pager --output=short-iso
            elif [[ -n "$target_inst" ]] && ls /var/log/V2bX/*_"${target_inst}".log >/dev/null 2>&1; then
                tail -n 200 -f /var/log/V2bX/*_"${target_inst}".log 2>/dev/null
            elif ls /var/log/V2bX/out_*.log >/dev/null 2>&1; then
                tail -n 200 -f /var/log/V2bX/out_*.log /var/log/V2bX/err_*.log 2>/dev/null
            else
                tail -n 200 -f /var/log/v2bx*.log /var/log/V2bX*.log 2>/dev/null || echo -e "${yellow}暂无控制台日志${plain}"
            fi
            ;;
        2)
            if is_systemd; then
                local u_name="V2bX"
                is_multi_active && u_name="$target_unit"
                echo -e "${cyan}--- [进程启动 / ACME证书 / 面板对接日志] ---${plain}"
                journalctl -u "$u_name" -n 120 --no-pager --output=short-iso 2>/dev/null
            elif ls /var/log/V2bX/err_*.log >/dev/null 2>&1; then
                echo -e "${cyan}--- [OpenRC 进程错误输出] ---${plain}"
                tail -n 120 /var/log/V2bX/err_*.log 2>/dev/null
            fi

            echo -e "\n${cyan}--- [Xray 核心独立错误日志 (实时追踪)] ---${plain}"
            if [[ -n "$target_inst" && -f "/var/log/V2bX/error_${target_inst}.log" ]]; then
                tail -n 100 -f "/var/log/V2bX/error_${target_inst}.log"
            elif ls /var/log/V2bX/error_*.log >/dev/null 2>&1; then
                tail -n 100 -f /var/log/V2bX/error_*.log
            elif [[ -f /etc/V2bX/error.log ]]; then
                tail -n 100 -f /etc/V2bX/error.log
            else
                echo -e "${dim}(当前无 Xray 独立 error.log 文件，如使用 Hysteria2/Sing-box 请直接参考上方进程日志)${plain}"
            fi
            ;;
        3)
            if [[ -n "$target_inst" && -f "/var/log/V2bX/access_${target_inst}.log" ]]; then
                tail -n 150 -f "/var/log/V2bX/access_${target_inst}.log"
            elif ls /var/log/V2bX/access_*.log >/dev/null 2>&1; then
                tail -n 150 -f /var/log/V2bX/access_*.log
            elif [[ -f /var/log/V2bX/access.log ]]; then
                tail -n 150 -f /var/log/V2bX/access.log
            else
                echo -e "${yellow}未找到连接日志 (可能连接日志已设为 none 或尚无连接)${plain}"
            fi
            ;;
    esac
    trap - INT
    echo -e "\n${green}✔ 已停止查阅日志。${plain}"
}

show_status() {
    local core_status="${red}未安装${plain}"
    local guard_status="${yellow}未开启 (原生态无锁)${plain}"
    local mode_status="${cyan}单进程${plain}"

    if [[ -s /usr/local/V2bX/V2bX ]]; then
        if is_multi_active; then
            mode_status="${magenta}多进程隔离${plain}"
            local counts active_cnt total_cnt
            counts=$(get_multi_instance_counts)
            active_cnt="${counts%%|*}"
            total_cnt="${counts##*|}"

            if [[ "${total_cnt:-0}" -eq 0 ]]; then
                core_status="${yellow}未拆分配置${plain}"
            elif [[ "${active_cnt:-0}" -eq "${total_cnt}" ]]; then
                core_status="${green}运行中 (${active_cnt}/${total_cnt}实例)${plain}"
            elif [[ "${active_cnt:-0}" -gt 0 ]]; then
                core_status="${yellow}部分异常 (${active_cnt}/${total_cnt}实例)${plain}"
            else
                core_status="${red}已停止 (0/${total_cnt}实例)${plain}"
            fi

            if grep -qE "MemoryMax|GOMEMLIMIT" /etc/systemd/system/v2bx@.service /etc/init.d/v2bx.port_* /etc/init.d/v2bx.node_* /etc/init.d/V2bX.node_* 2>/dev/null || \
               grep -q "MemoryLimitPercent" /etc/V2bX/config.json 2>/dev/null; then
                guard_status="${green}内核防爆已开启${plain}"
            fi
        elif is_systemd; then
            if systemctl is-active --quiet V2bX 2>/dev/null; then
                core_status="${green}运行中${plain}"
            else
                core_status="${yellow}已停止${plain}"
            fi
            if grep -qE "MemoryMax|GOMEMLIMIT" /etc/systemd/system/V2bX.service 2>/dev/null || \
               grep -q "MemoryLimitPercent" /etc/V2bX/config.json 2>/dev/null; then
                guard_status="${green}内核防爆已开启${plain}"
            fi
        elif command -v rc-service &>/dev/null; then
            local main_svc rc_out
            main_svc=$(get_openrc_main_svc)
            rc_out=$(rc-service "$main_svc" status 2>/dev/null)
            if echo "$rc_out" | grep -q "started"; then
                core_status="${green}运行中${plain}"
            elif echo "$rc_out" | grep -q "crashed"; then
                core_status="${red}已崩溃${plain}"
            else
                core_status="${yellow}已停止${plain}"
            fi
            if grep -q "GOMEMLIMIT" /etc/init.d/"$main_svc" 2>/dev/null || \
               grep -q "MemoryLimitPercent" /etc/V2bX/config.json 2>/dev/null; then
                guard_status="${green}内核防爆已开启${plain}"
            fi
        fi
    fi

    echo -e "状态: $core_status | 模式: $mode_status | 护卫: $guard_status"
}

