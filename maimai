# 🌟 核心部署引擎 (修复多地址霸屏与系统适配)
self_install_core() {
    echo -e "${yellow}正在准备部署 V2bX 后端核心组件...${plain}"
    
    echo -e "\n${cyan}====== 🛡️ 资源护卫限制策略选择 ======${plain}"
    echo -e "  ${green}1.${plain} 原生态无锁版 (满血狂飙，适合高配小鸡或大流量节点)"
    echo -e "  ${green}2.${plain} 标准防爆锁 (128M 内存锁 + 40% CPU 压制，推荐普通小鸡)"
    echo -e "  ${green}3.${plain} 极致低配锁 (40M 内存锁 + 20% CPU 压制，适合极限清贫的 NAT 鸡)"
    echo -e "  ${green}4.${plain} 自定义限额 (手动指定内存与 CPU 上限)"
    read -rp "请选择限额策略 [1-4] (默认 1): " limit_opt < /dev/tty
    [[ -z "$limit_opt" ]] && limit_opt=1

    local mem_limit=""; local cpu_limit=""
    
    if [ "$limit_opt" -eq 2 ]; then
        mem_limit=128; cpu_limit=40
    elif [ "$limit_opt" -eq 3 ]; then
        mem_limit=40; cpu_limit=20
    elif [ "$limit_opt" -eq 4 ]; then
        read -rp "请输入允许核心使用的内存硬性上限 (单位 MiB, 例如 256): " mem_limit < /dev/tty
        read -rp "请输入允许核心使用的最大 CPU 使用率 (单位 %, 例如 60): " cpu_limit < /dev/tty
        [[ -z "$mem_limit" ]] && mem_limit=128; [[ -z "$cpu_limit" ]] && cpu_limit=40
    fi

    manage_service stop
    manage_service disable
    killall -9 V2bX >/dev/null 2>&1
    mkdir -p /usr/local/V2bX /etc/V2bX /var/log/V2bX
    rm -rf /usr/local/V2bX/V2bX /tmp/v2bx_tmp*

    local raw_arch=$(uname -m); local arch="linux-64"
    case "${raw_arch}" in 
        x86_64 | amd64) arch="linux-64" ;; 
        arm64 | aarch64) arch="linux-arm64-v8a" ;; 
        armv7* | armhf) arch="linux-arm32-v7a" ;;
        s390x) arch="linux-s390x" ;;
        riscv64) arch="linux-riscv64" ;;
        *) arch="linux-64" ;; 
    esac
    
    # 完美解决刷屏问题：直接利用 GitHub latest 跳转，静默重试机制
    local repo_owner="Shannon-x"
    local urls=(
        "https://ghp.ci/https://github.com/${repo_owner}/V2bX/releases/latest/download/V2bX-${arch}.zip"
        "https://mirror.ghproxy.net/https://github.com/${repo_owner}/V2bX/releases/latest/download/V2bX-${arch}.zip"
        "https://github.com/${repo_owner}/V2bX/releases/latest/download/V2bX-${arch}.zip"
    )

    local success=false
    echo -e "${cyan}开始从云端拉取 V2bX 最新版核心 (架构: ${arch})...${plain}"
    for url in "${urls[@]}"; do
        local tmp_file="/tmp/v2bx_tmp_${RANDOM}.zip"
        
        # 只显示下载进度，不再疯狂打印探测网址
        if wget -q --show-progress -O "$tmp_file" "$url" --timeout=15; then
            if [[ -f "$tmp_file" && -s "$tmp_file" ]] && head -c 4 "$tmp_file" | grep -q 'PK\|ELF'; then
                local tmp_dir="/tmp/v2bx_extract_${RANDOM}"
                mkdir -p "$tmp_dir"
                unzip -q -o "$tmp_file" -d "$tmp_dir" >/dev/null 2>&1
                
                local b_target=""
                [[ -f "$tmp_dir/V2bX" ]] && b_target="$tmp_dir/V2bX"
                [[ -f "$tmp_dir/V2bX-${arch}" ]] && b_target="$tmp_dir/V2bX-${arch}"
                [[ -z "$b_target" ]] && b_target=$(find "$tmp_dir" -type f -name "V2bX*" | head -n 1)
                
                if [[ -n "$b_target" && -f "$b_target" ]]; then
                    mv -f "$b_target" /usr/local/V2bX/V2bX && success=true
                elif head -c 4 "$tmp_file" | grep -q 'ELF'; then
                    mv -f "$tmp_file" /usr/local/V2bX/V2bX && success=true
                fi
                rm -rf "$tmp_dir"
            fi
        fi
        rm -f "$tmp_file"
        
        if [ "$success" = true ]; then
            chmod +x /usr/local/V2bX/V2bX
            echo -e "${green}[成功] 核心拉取成功！${plain}"
            break
        fi
    done

    if [ "$success" = false ]; then
        echo -e "${red}[错误] 所有拉取线路均失败，请检查服务器网络！${plain}"
        return
    fi

    rm -f /usr/local/V2bX/geoip.dat /usr/local/V2bX/geosite.dat

    if [ ! -f /etc/V2bX/config.json ]; then
        read -rp "未检测到配置文件，是否立即运行向导生成？(y/n) " ask_gen_config < /dev/tty
        if [[ "$ask_gen_config" =~ ^[Yy]$ ]]; then
            run_remote_module "xmm2" "向导配置创建引擎"
        fi
    fi

    # 配置守护进程 (补充 -w 热重载与 DNS 环境变亮)
    if [ -d /etc/systemd/system ]; then
        cat << EOF > /etc/systemd/system/V2bX.service
[Unit]
Description=V2bX Service - Adaptive Managed (Hot-Reload)
After=network.target

[Service]
ExecStart=/usr/local/V2bX/V2bX server -c /etc/V2bX/config.json -w
Restart=always
RestartSec=10
User=root
LimitNOFILE=1048576
LimitNPROC=51200
Environment="XRAY_DNS_PATH=/etc/V2bX/dns.json"
Environment="SING_DNS_PATH=/etc/V2bX/sing_dns.json"
EOF

        if [ "$limit_opt" -ne 1 ]; then
            local high_mark=$((mem_limit * 8 / 10))
            cat << EOF >> /etc/systemd/system/V2bX.service
Environment="GOMEMLIMIT=${mem_limit}MiB"
Environment="GOGC=80"
CPUQuota=${cpu_limit}%
Nice=19
MemoryHigh=${high_mark}M
MemoryMax=${mem_limit}M
MemorySwapMax=0
OOMScoreAdjust=-100
EOF
        fi

        echo -e "[Install]\nWantedBy=multi-user.target" >> /etc/systemd/system/V2bX.service
        systemctl daemon-reload
        manage_service enable
        
    elif [ -d /etc/init.d ]; then
        cat << EOF > /etc/init.d/V2bX
#!/sbin/openrc-run
description="V2bX Alpine Service (Hot-Reload)"
command="/usr/local/V2bX/V2bX"
command_args="server -c /etc/V2bX/config.json -w"
command_background=true
pidfile="/run/V2bX.pid"
output_log="/var/log/v2bx_out.log"
error_log="/var/log/v2bx_err.log"
command_env="XRAY_DNS_PATH=/etc/V2bX/dns.json SING_DNS_PATH=/etc/V2bX/sing_dns.json"
EOF

        if [ "$limit_opt" -ne 1 ]; then
            cat << EOF >> /etc/init.d/V2bX
command_env="\$command_env GOMEMLIMIT=${mem_limit}MiB GOGC=80"
start_stop_daemon_args="--nicelevel 19"
EOF
        fi

        cat << EOF >> /etc/init.d/V2bX

depend() {
    need net
}
EOF
        chmod +x /etc/init.d/V2bX
        manage_service enable
    fi
    
    if [ -f /etc/V2bX/config.json ]; then
        manage_service restart
        echo -e "${green}V2bX 部署启动完成！热重载 (-w) 已生效。${plain}"
    else
        echo -e "${yellow}V2bX 核心已就绪，请在主菜单配置 config.json 后启动。${plain}"
    fi
}

# 🌟 生成 X25519 密钥对并给出明确引导
generate_x25519() {
    if [[ ! -x /usr/local/V2bX/V2bX ]]; then
        echo -e "${red}错误：尚未安装 V2bX，请先执行选项 1 安装核心！${plain}"
        return
    fi
    echo -e "${cyan}正在生成 Reality X25519 密钥对...${plain}\n"
    /usr/local/V2bX/V2bX x25519
    echo "--------------------------------------------------------"
    echo -e "${yellow}💡 配置指引：${plain}"
    echo -e "  - ${green}Private key (私钥)${plain} : 填入节点配置"
    echo -e "  - ${green}Public key (公钥)${plain}  : 填入面板后台供客户端校验"
}

install_bbr() { 
    wget -O tcp.sh --no-check-certificate "https://github.com/ylx2016/Linux-NetSpeed/raw/master/tcp.sh" && chmod +x tcp.sh && ./tcp.sh
}

update_shell() { 
    local current_run="$0"
    echo -e "${cyan}正在拉取脚本最新版本...${plain}"
    curl -o /usr/local/bin/maimai_core.sh -Ls "https://raw.githubusercontent.com/yunfeibuzai/xmm/main/maimai"
    if [[ -f "$current_run" && "$current_run" != "/usr/local/bin/maimai_core.sh" ]]; then
        cp -f /usr/local/bin/maimai_core.sh "$current_run"
    fi
    register_shortcut
    echo -e "${green}脚本升级成功！${plain}"
    exit 0
}

process_run() {
    local num; read -rp "请输入选择 [0-23]: " num < /dev/tty
    case "$num" in
    0) 
        if [ ! -f /etc/V2bX/config.json ]; then
            echo -e "${yellow}配置文件不存在，请先执行向导生成配置！${plain}"
        else
            nano /etc/V2bX/config.json
            echo -e "${green}V2bX 支持自动热重载，若修改了关键端口或内核配置，建议重启服务生效。${plain}"
            read -rp "是否立即强制重启 V2bX 服务？(y/n，默认 n): " ask_restart < /dev/tty
            [[ "$ask_restart" =~ ^[Yy]$ ]] && manage_service restart
        fi
        ;; 
    1|2) self_install_core ;; 
    3) 
        read -rp "是否保留节点配置文件和域名证书 (/etc/V2bX)？(y/n，默认 y): " keep_conf < /dev/tty
        [[ -z "$keep_conf" ]] && keep_conf="y"

        manage_service stop
        manage_service disable
        rm -rf /usr/local/V2bX /etc/systemd/system/V2bX.service /etc/init.d/V2bX \
               /var/log/v2bx*.log /var/log/V2bX*.log /var/log/v2bx*.err /var/log/V2bX*.err \
               /etc/logrotate.d/v2bx_anti_explode /etc/logrotate.d/v2bx_all /etc/cron.hourly/v2bx_cleaner

        if [[ ! "$keep_conf" =~ ^[Yy]$ ]]; then
            rm -rf /etc/V2bX
            echo -e "${yellow}已清除配置文件与证书目录。${plain}"
        fi

        if command -v systemctl &>/dev/null; then systemctl daemon-reload; fi
        echo -e "${green}卸载完成！${plain}" 
        ;;
    4) manage_service start ;; 
    5) manage_service stop ;; 
    6) manage_service restart ;; 
    7) manage_service status ;; 
    8) inspect_logs ;; 
    9) manage_service enable ;; 
    10) manage_service disable ;; 
    11) run_remote_module "xmm2" "全新覆盖配置向导" ;; 
    12) run_remote_module "xmm3" "原有配置追加向导" ;;  
    13) generate_x25519 ;;
    14) update_shell ;; 
    15) install_bbr ;; 
