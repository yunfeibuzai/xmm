generate_x25519() {
    if [[ ! -x /usr/local/V2bX/V2bX ]]; then
        echo -e "${red}错误：尚未安装 V2bX，请先执行选项 1 安装核心！${plain}"
        return
    fi
    echo -e "${cyan}1) 生成 Reality X25519 密钥对 (默认)   2) 生成 VLESS Encryption 密钥对${plain}"
    read -rp "请选择密钥类型 [1-2] (默认 1): " key_opt < /dev/tty
    echo ""
    if [[ "$key_opt" == "2" ]]; then
        /usr/local/V2bX/V2bX vlessenc
    else
        /usr/local/V2bX/V2bX x25519
        echo "--------------------------------------------------------"
        echo -e "${yellow}💡 配置指引：${plain}"
        echo -e "  - ${green}Private key (私钥)${plain} : 填入节点配置"
        echo -e "  - ${green}Public key (公钥)${plain}  : 填入面板后台供客户端校验"
    fi
}

install_bbr() {
    local tmp_bbr
    tmp_bbr=$(make_temp_file "tcp_bbr")
    local bbr_raw="https://raw.githubusercontent.com/ylx2016/Linux-NetSpeed/master/tcp.sh"

    if fetch_github_file "$bbr_raw" "$tmp_bbr" "" "true"; then
        chmod +x "$tmp_bbr"
        ( cd /tmp && bash "$tmp_bbr" )
        rm -f "$tmp_bbr"
    else
        rm -f "$tmp_bbr"
        echo -e "${red}错误：拉取 BBR 脚本失败，请检查网络连接！${plain}"
    fi
}

update_shell() {
    echo -e "${cyan}正在拉取主控脚本最新版本...${plain}"
    local tmp_up
    tmp_up=$(make_temp_file "maimai_update")

    if ! fetch_github_file "${REPO_RAW_BASE}/maimai" "$tmp_up" "sh_ver=" "true"; then
        rm -f "$tmp_up"
        echo -e "${red}错误：拉取脚本更新失败，请检查网络！${plain}"
        return
    fi

    mkdir -p /usr/local/bin
    mv -f "$tmp_up" /usr/local/bin/maimai_core.sh
    chmod +x /usr/local/bin/maimai_core.sh

    if [[ -f "$0" && ! -p "$0" && "$0" != /dev/fd/* && "$0" != /proc/self/fd/* && "$0" != "bash" && "$0" != "-bash" && "$0" != "sh" ]]; then
        local real_run real_core
        real_run=$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")
        real_core=$(readlink -f "/usr/local/bin/maimai_core.sh" 2>/dev/null || echo "/usr/local/bin/maimai_core.sh")
        if [[ "$real_run" != "$real_core" && "$0" != "/usr/bin/v2bx" && "$0" != "/usr/bin/maimai" ]]; then
            cp -f /usr/local/bin/maimai_core.sh "$real_run" 2>/dev/null
            chmod +x "$real_run" 2>/dev/null
        fi
    fi

    register_shortcut
    local new_v
    new_v=$(grep -m1 '^sh_ver=' /usr/local/bin/maimai_core.sh | cut -d'"' -f2)
    echo -e "${green}✔ 脚本已成功升级至 v${new_v}！正在重新加载...${plain}"
    sleep 1
    exec /usr/local/bin/maimai_core.sh
}

edit_and_sync_file() {
    local target_file="$1"
    local editor="nano"
    command -v nano &>/dev/null || editor="vi"

    local mtime_before mtime_after
    mtime_before=$(stat -c %Y "$target_file" 2>/dev/null || date -r "$target_file" +%s 2>/dev/null || echo 0)
    "$editor" "$target_file"
    mtime_after=$(stat -c %Y "$target_file" 2>/dev/null || date -r "$target_file" +%s 2>/dev/null || echo 1)

    if [[ "$mtime_before" == "$mtime_after" ]]; then
        echo -e "\n${yellow}ℹ 检测到文件未发生任何改动（若使用 nano 修改，请确保按了 Ctrl+O 回车保存再按 Ctrl+X 退出）。${plain}"
        return 1
    fi

    if command -v jq &>/dev/null && ! jq -e . "$target_file" >/dev/null 2>&1; then
        echo -e "\n${red}✖ 警告：检测到 $(basename "$target_file") 存在 JSON 语法错误（可能少写了逗号或括号），已取消重启以防服务崩溃！请重新编辑修正。${plain}"
        return 1
    fi
    return 0
}

process_run() {
    local num
    read -rp "请输入选择 [0-25]: " num < /dev/tty || exit 0

    case "$num" in
    0)
        if is_multi_active; then
            shopt -s nullglob
            local node_files=(/etc/V2bX/nodes/port_*.json /etc/V2bX/nodes/node_*.json)
            shopt -u nullglob

            echo -e "\n${cyan}=== 🛠️ 多进程隔离配置编辑器 ===${plain}"
            echo -e "  ${green}1.${plain} 编辑【母版总配置】(/etc/V2bX/config.json) ${dim}— 自动重新拆分同步到所有运行实例${plain}"
            echo -e "  ${green}2.${plain} 编辑【单个隔离实例】(/etc/V2bX/nodes/*.json) ${dim}— 改完自动反向同步回母版防止覆盖${plain}"
            echo -e "  ${dim}0. 取消 / 返回主菜单${plain}"
            read -rp "请选择编辑方式 [0-2] (默认 2): " edit_mode < /dev/tty || return
            [[ -z "$edit_mode" ]] && edit_mode=2
            [[ "$edit_mode" == "0" ]] && return

            if [[ "$edit_mode" == "1" ]]; then
                if [[ ! -f /etc/V2bX/config.json ]]; then
                    echo -e "${yellow}母版配置文件不存在！${plain}"
                    return
                fi
                edit_and_sync_file "/etc/V2bX/config.json" || return
                echo -e "${cyan}正在将母版最新修改重新按端口编译同步至所有隔离实例...${plain}"
                run_remote_module "xmm2" "多进程配置同步编译"
                return
            fi

            if [[ ${#node_files[@]} -eq 0 ]]; then
                echo -e "${yellow}未找到任何已拆分的隔离配置文件 (/etc/V2bX/nodes/)${plain}"
                return
            fi

            echo -e "\n${cyan}请选择要编辑的独立实例：${plain}"
            local i=1
            for f in "${node_files[@]}"; do
                local nids=""
                command -v jq &>/dev/null && nids=$(jq -r '[.Nodes[].NodeID] | join(",")' "$f" 2>/dev/null)
                echo -e "  ${green}${i}.${plain} $(basename "$f") ${dim}(NodeID: ${nids:-?})${plain}"
                ((i++))
            done
            echo -e "  ${dim}0. 取消${plain}"
            read -rp "请输入实例序号 [0-$((i-1))]: " edit_idx < /dev/tty || return

            if [[ "$edit_idx" =~ ^[1-9][0-9]*$ ]] && [ "$edit_idx" -lt "$i" ]; then
                local target_file="${node_files[$((edit_idx-1))]}"
                local inst_name
                inst_name=$(basename "$target_file" .json)

                edit_and_sync_file "$target_file" || return

                if [[ -f /etc/V2bX/config.json ]] && command -v jq &>/dev/null; then
                    if jq --slurpfile inst "$target_file" '
                        ($inst[0].Nodes // []) as $updated |
                        .Nodes = [
                            .Nodes[] as $orig |
                            (($updated | map(select(.NodeID == $orig.NodeID)) | .[0]) // $orig)
                        ]
                    ' /etc/V2bX/config.json > /etc/V2bX/config.json.tmp 2>/dev/null && jq -e . /etc/V2bX/config.json.tmp >/dev/null 2>&1; then
                        mv -f /etc/V2bX/config.json.tmp /etc/V2bX/config.json
                        echo -e "${green}✔ 已将本次修改反向同步至母版 /etc/V2bX/config.json（永久保留）。${plain}"
                    else
                        rm -f /etc/V2bX/config.json.tmp
                    fi
                fi

                read -rp "是否立即重启实例 [${inst_name}] 使修改生效？(y/n，默认 y): " ask_restart < /dev/tty || return
                [[ -z "$ask_restart" ]] && ask_restart="y"
                if [[ "$ask_restart" =~ ^[Yy]$ ]]; then
                    if is_systemd; then
                        systemctl reset-failed "v2bx@${inst_name}" 2>/dev/null
                        systemctl restart "v2bx@${inst_name}" 2>/dev/null
                    elif command -v rc-service &>/dev/null; then
                        if [[ -f "/etc/init.d/v2bx.${inst_name}" ]]; then
                            rc-service "v2bx.${inst_name}" restart 2>/dev/null
                        elif [[ -f "/etc/init.d/V2bX.${inst_name}" ]]; then
                            rc-service "V2bX.${inst_name}" restart 2>/dev/null
                        fi
                    fi
                    echo -e "${green}✔ 实例 ${inst_name} 已成功重启并应用新配置！${plain}"
                fi
            fi
        else
            if [[ ! -f /etc/V2bX/config.json ]]; then
                echo -e "${yellow}配置文件不存在，请先执行向导生成配置！${plain}"
            else
                edit_and_sync_file "/etc/V2bX/config.json" || return
                echo -e "${green}✔ 配置已保存。${plain}"
                read -rp "是否立即重启 V2bX 服务使其生效？(y/n，默认 y): " ask_restart < /dev/tty || return
                [[ -z "$ask_restart" ]] && ask_restart="y"
                [[ "$ask_restart" =~ ^[Yy]$ ]] && manage_service restart
            fi
        fi
        ;;
    1|2) run_remote_module "all/xmm1and2" "V2bX 核心部署与更新引擎" ;;
    3)
        read -rp "是否保留节点配置文件和域名证书 (/etc/V2bX)？(y/n，默认 y): " keep_conf < /dev/tty || return
        [[ -z "$keep_conf" ]] && keep_conf="y"

        manage_service stop
        manage_service disable
        if is_systemd; then
            systemctl unmask V2bX.service >/dev/null 2>&1
        fi
        pkill -9 -f "[/]usr/local/V2bX/V2bX" >/dev/null 2>&1
        rm -rf /usr/local/V2bX /etc/systemd/system/V2bX.service /etc/systemd/system/v2bx@.service \
               /etc/systemd/system/multi-user.target.wants/v2bx@*.service \
               /etc/init.d/V2bX /etc/init.d/v2bx /etc/init.d/v2bx.port_* /etc/init.d/v2bx.node_* /etc/init.d/V2bX.node_* \
               /var/log/V2bX /var/log/v2bx*.log /var/log/V2bX*.log /var/log/v2bx*.err /var/log/V2bX*.err \
               /etc/logrotate.d/v2bx_anti_explode /etc/logrotate.d/v2bx_all /etc/logrotate.d/v2bx_sentinel_limit /etc/cron.hourly/v2bx_cleaner

        if [[ ! "$keep_conf" =~ ^[Yy]$ ]]; then
            rm -rf /etc/V2bX
            echo -e "${yellow}已清除配置文件与证书目录。${plain}"
        else
            rm -f /etc/V2bX/nodes/.multi_enabled /etc/V2bX/nodes/port_*.json /etc/V2bX/nodes/node_*.json 2>/dev/null
        fi

        if is_systemd; then systemctl daemon-reload; fi
        echo -e "${green}卸载完成！${plain}"
        ;;
    4) manage_service start ;;
    5) manage_service stop ;;
    6) manage_service restart ;;
    7) manage_service status ;;
    8) inspect_logs ;;
    9) manage_service enable ;;
    10) manage_service disable ;;
    11) run_remote_module "xmm2" "全新配置 / 克隆复用本地配置 / 多进程托管 (xmm2)" ;;
    12) run_remote_module "all/xmm12" "节点追加 / 红绿灯体检 / ACME证书中心 (xmm12)" ;;
    13) generate_x25519 ;;
    14) update_shell ;;
    15) install_bbr ;;
    16) run_remote_module "lianjie" "高并发连接数与端口解锁" ;;
    17) run_remote_module "Linuxclean" "Linux 系统级深度净化" ;;
    18) run_remote_module "V2bXclean" "日志深度防爆与轮转强控" ;;
    19) run_remote_module "memory" "内存回收机制优化" ;;
    20) run_remote_module "cf" "CDN 节点转 CF 隧道模块" ;;
    21) run_remote_module "cfjournal" "CF 隧道日志排查诊断" ;;
    22) run_remote_module "cfmgr" "CF 隧道交互式管理控制台" ;;
    23) run_remote_module "xmmzz" "极简网络中转管理面板" ;;
    24) run_remote_module "all/xmm_24" "S5 落地智能路由 (Pro Max)" ;;
    25|q|Q) exit 0 ;;
    *) echo -e "${red}未知序号，请输入 0-25 之间的数字${plain}" ;;
    esac
}

while true; do
    show_menu
    process_run
    echo ""
    read -rp "按回车键返回主菜单..." < /dev/tty || exit 0
done
