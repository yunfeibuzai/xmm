#!/bin/sh
# =======================================================================
# Komari Agent 智能专属工具箱 (双栈/IPv6 LXC 极速优化版)
# =======================================================================

RAW_SCRIPT_URL="https://raw.githubusercontent.com/yunfeibuzai/xmm/main/tz"
BIN_PATH="/usr/local/bin/komari-agent"
SELF_PATH="/usr/local/bin/tz"

GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m'

# 自动同步安装为全局快捷命令 tz
case "$0" in
    sh|bash|ash|dash|*/sh|*/bash|*/ash|*/dash) ;;
    *)
        if [ -f "$0" ] && [ "$0" != "$SELF_PATH" ]; then
            cp -f "$0" "$SELF_PATH" 2>/dev/null && chmod +x "$SELF_PATH" 2>/dev/null
        fi
        ;;
esac

# 多源智能下载与校验: smart_download <原始GitHub链接> <目标路径> <elf|text>
smart_download() {
    ORIG_URL="$1"
    DEST_FILE="$2"
    CHECK_MODE="$3"
    TMP_DL="${DEST_FILE}.tmp"

    MIRROR_LIST="
https://ghfast.top/${ORIG_URL}
https://gh-proxy.com/${ORIG_URL}
${ORIG_URL}
"
    for URL in $MIRROR_LIST; do
        rm -f "$TMP_DL"
        printf "${CYAN}   -> 尝试拉取: %s${NC}\n" "$URL"
        if command -v curl >/dev/null 2>&1; then
            curl -fSL -k --connect-timeout 8 -m 60 -o "$TMP_DL" "$URL" >/dev/null 2>&1
        elif command -v wget >/dev/null 2>&1; then
            wget --no-check-certificate -T 10 -t 2 -q -O "$TMP_DL" "$URL" >/dev/null 2>&1
        else
            printf "${RED}❌ 系统缺少 curl 和 wget，无法执行下载！${NC}\n"
            return 1
        fi

        [ ! -s "$TMP_DL" ] && continue

        if [ "$CHECK_MODE" = "elf" ]; then
            FILE_SIZE=$(wc -c < "$TMP_DL" 2>/dev/null | tr -d ' ')
            if [ "${FILE_SIZE:-0}" -gt 500000 ] && dd if="$TMP_DL" bs=4 count=1 2>/dev/null | tr -d '\000-\037' | grep -q 'ELF'; then
                mv -f "$TMP_DL" "$DEST_FILE"
                return 0
            fi
        elif [ "$CHECK_MODE" = "text" ]; then
            if head -n 1 "$TMP_DL" | grep -qE '^#!/bin/(sh|bash)' && sh -n "$TMP_DL" >/dev/null 2>&1; then
                mv -f "$TMP_DL" "$DEST_FILE"
                return 0
            fi
        fi
    done

    rm -f "$TMP_DL"
    return 1
}

get_arch() {
    ARCH=$(uname -m)
    case "$ARCH" in
        x86_64) echo "amd64" ;;
        aarch64|arm64) echo "arm64" ;;
        i386|i686) echo "386" ;;
        *) echo "" ;;
    esac
}

# 统一参数解析器：完整保留 -e、-t 之外的所有附加开关参数
# 输出全局变量: PARSED_URL, PARSED_TOKEN, PARSED_EXTRA
parse_agent_args() {
    CLEAN_CMD=$(printf '%s' "$1" | tr '\r\n\t\\' '    ' | tr -d "\"'" | sed -E 's/ +/ /g; s/^ //; s/ $//')

    case " $CLEAN_CMD " in
        *" -- "*)
            ARGS_PART=$(printf '%s' "$CLEAN_CMD" | sed 's/^.* -- //')
            ;;
        *)
            ARGS_PART=$(printf '%s' "$CLEAN_CMD" | sed -E 's/^[^-][^ ]* +//')
            ;;
    esac

    PARSED_URL=$(printf ' %s ' "$ARGS_PART" | grep -oE ' -e[= ]+[^ ]+' | head -n1 | sed -E 's/^ -e[= ]+//')
    PARSED_TOKEN=$(printf ' %s ' "$ARGS_PART" | grep -oE ' -t[= ]+[^ ]+' | head -n1 | sed -E 's/^ -t[= ]+//')
    PARSED_EXTRA=$(printf ' %s ' "$ARGS_PART" | sed -E 's/ -e[= ]+[^ ]+/ /g; s/ -t[= ]+[^ ]+/ /g; s/ +/ /g; s/^ //; s/ $//')
}

# 通用提取本机已安装探针的启动参数（兼容进程、Systemd、OpenRC 及官方路径）
get_existing_config() {
    FOUND_LINE=""
    for p in /proc/[0-9]*/cmdline; do
        [ -r "$p" ] || continue
        CMD_STR=$(tr '\0' ' ' < "$p" 2>/dev/null)
        case "$CMD_STR" in
            *komari-agent*|*/komari/agent*)
                FOUND_LINE="$CMD_STR"
                break
                ;;
        esac
    done

    if [ -z "$FOUND_LINE" ] && [ -f /etc/systemd/system/komari-agent.service ]; then
        FOUND_LINE=$(grep '^ExecStart=' /etc/systemd/system/komari-agent.service | head -n1 | sed 's/^ExecStart=//')
    fi

    if [ -z "$FOUND_LINE" ] && [ -f /etc/init.d/komari-agent ]; then
        FOUND_LINE=$(grep '^command_args=' /etc/init.d/komari-agent | head -n1 | sed 's/^command_args=//')
    fi

    printf '%s' "$FOUND_LINE"
}

kill_running_agent() {
    if command -v pkill >/dev/null 2>&1; then
        pkill -9 -f 'komari-agent|/komari/agent' >/dev/null 2>&1
    else
        for pid in $(ps -ef 2>/dev/null | grep -E '[k]omari-agent|[/]komari/agent' | awk '{print $2}'); do
            kill -9 "$pid" >/dev/null 2>&1
        done
    fi
}

# 彻底停止并清理旧服务
cleanup_agent() {
    if [ -f /etc/init.d/komari-agent ]; then
        rc-service komari-agent stop >/dev/null 2>&1
        rc-service komari-agent zap >/dev/null 2>&1
        rc-update del komari-agent default >/dev/null 2>&1
        rm -f /etc/init.d/komari-agent
    fi

    if [ -f /etc/systemd/system/komari-agent.service ] || command -v systemctl >/dev/null 2>&1; then
        systemctl stop komari-agent >/dev/null 2>&1
        systemctl disable komari-agent >/dev/null 2>&1
        rm -f /etc/systemd/system/komari-agent.service
        systemctl daemon-reload >/dev/null 2>&1
    fi

    kill_running_agent
    rm -f "$BIN_PATH" /var/run/komari-agent.pid
}

# 写入并启动守护进程
setup_service() {
    S_URL="$1"
    S_TOKEN="$2"
    S_ARGS="$3"

    if [ -n "$S_ARGS" ]; then
        FULL_ARGS="-e ${S_URL} -t ${S_TOKEN} ${S_ARGS}"
    else
        FULL_ARGS="-e ${S_URL} -t ${S_TOKEN}"
    fi

    if [ -f /sbin/openrc-run ] || { [ -d /etc/init.d ] && [ ! -d /run/systemd/system ]; }; then
        printf "${GREEN}   配置 OpenRC 守护系统 (Alpine Linux)${NC}\n"
        cat << END_OPENRC > /etc/init.d/komari-agent
#!/sbin/openrc-run
name="komari-agent"
description="Komari Agent Secure Service"
export GOMEMLIMIT="20MiB"
command="${BIN_PATH}"
command_args="${FULL_ARGS}"
pidfile="/var/run/\${RC_SVCNAME}.pid"
command_background="true"
depend() { need net; }
END_OPENRC
        chmod +x /etc/init.d/komari-agent
        rc-update add komari-agent default >/dev/null 2>&1
        rc-service komari-agent restart >/dev/null 2>&1
    elif command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
        printf "${GREEN}   配置 Systemd 守护系统${NC}\n"
        cat << END_SYSTEMD > /etc/systemd/system/komari-agent.service
[Unit]
Description=Komari Agent Secure Service
After=network.target

[Service]
Type=simple
Environment="GOMEMLIMIT=20MiB"
ExecStart=${BIN_PATH} ${FULL_ARGS}
Restart=always
RestartSec=5
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
END_SYSTEMD
        systemctl daemon-reload
        systemctl enable komari-agent >/dev/null 2>&1
        systemctl restart komari-agent >/dev/null 2>&1
    else
        printf "${YELLOW}   精简容器无守护进程管理器，使用后台模式启动${NC}\n"
        GOMEMLIMIT="20MiB" nohup "$BIN_PATH" -e "$S_URL" -t "$S_TOKEN" $S_ARGS >/dev/null 2>&1 &
    fi
}

# 安装主流程
install_agent() {
    RAW_CMD="$1"
    SILENT_MODE="$2"

    if [ -z "$RAW_CMD" ]; then
        clear
        printf "${GREEN}=======================================================${NC}\n"
        printf "${GREEN}    Komari Agent 智能解析 & 纯净全卸载安装向导        ${NC}\n"
        printf "${GREEN}=======================================================${NC}\n"
        printf "${YELLOW}👉 请粘贴 Komari 主控后台的 Agent 安装命令并回车：${NC}\n"
        read -r RAW_CMD < /dev/tty
    fi

    parse_agent_args "$RAW_CMD"
    SERVER_URL="$PARSED_URL"
    SECRET_TOKEN="$PARSED_TOKEN"
    EXTRA_ARGS="$PARSED_EXTRA"

    if [ -z "$SERVER_URL" ] || [ -z "$SECRET_TOKEN" ]; then
        printf "${RED}❌ [错误] 无法提取到 -e (主控地址) 或 -t (Token)，请检查输入！${NC}\n"
        [ "$SILENT_MODE" != "1" ] && { printf "按回车键返回..."; read -r _ < /dev/tty; }
        return 1
    fi

    BIN_ARCH=$(get_arch)
    if [ -z "$BIN_ARCH" ]; then
        printf "${RED}❌ 不支持的系统架构: %s${NC}\n" "$(uname -m)"
        [ "$SILENT_MODE" != "1" ] && read -r _ < /dev/tty
        return 1
    fi

    printf "\n${CYAN}解析参数确认：${NC}\n"
    printf "  主控地址: ${GREEN}%s${NC}\n" "$SERVER_URL"
    printf "  通信密钥: ${GREEN}%s${NC}\n" "$SECRET_TOKEN"
    printf "  附加参数: ${GREEN}%s${NC}\n" "${EXTRA_ARGS:-无}"

    printf "\n${YELLOW}[1/4] 正在彻底清理旧版组件与残留进程...${NC}\n"
    cleanup_agent
    printf "${GREEN}   ✔ 旧环境已完全擦除。${NC}\n"

    printf "${YELLOW}[2/4] 正在下载并校验官方二进制程序 (%s)...${NC}\n" "$BIN_ARCH"
    mkdir -p "$(dirname "$BIN_PATH")"
    DOWNLOAD_URL="https://github.com/komari-monitor/komari-agent/releases/latest/download/komari-agent-linux-${BIN_ARCH}"

    if ! smart_download "$DOWNLOAD_URL" "$BIN_PATH" "elf"; then
        printf "${RED}❌ 二进制文件下载或校验失败，请检查网络连接（纯 IPv6 需确保 DNS64 正常）。${NC}\n"
        [ "$SILENT_MODE" != "1" ] && { printf "按回车键返回..."; read -r _ < /dev/tty; }
        return 1
    fi
    chmod +x "$BIN_PATH"
    printf "${GREEN}   ✔ 二进制文件校验通过。${NC}\n"

    printf "${YELLOW}[3/4] 正在配置守护服务 (内存限制 GOMEMLIMIT=20MiB)...${NC}\n"
    setup_service "$SERVER_URL" "$SECRET_TOKEN" "$EXTRA_ARGS"

    printf "${YELLOW}[4/4] 正在进行运行状态体检...${NC}\n"
    sleep 2
    PROCESS_COUNT=$(ps -ef 2>/dev/null | grep -E '[k]omari-agent|[/]komari/agent' | wc -l | tr -d ' ')

    printf "${GREEN}=======================================================${NC}\n"
    if [ "${PROCESS_COUNT:-0}" -ge 1 ]; then
        printf "${GREEN} 🎉 Komari Agent 部署成功并已上线！${NC}\n"
    else
        printf "${RED} ⚠️ 进程未检测到存活，请使用菜单 [6] 查看报错日志！${NC}\n"
    fi
    printf " 活跃进程数: ${YELLOW}%s${NC} (标准单例为 1)\n" "$PROCESS_COUNT"
    printf "${GREEN}=======================================================${NC}\n"

    if [ "$SILENT_MODE" != "1" ]; then
        printf "按回车键返回主菜单..."
        read -r _ < /dev/tty
    fi
}

# 手动重启 Komari Agent 探针
restart_agent() {
    SILENT_CLI="$1"
    [ "$SILENT_CLI" != "1" ] && clear
    printf "${YELLOW}正在重启 Komari Agent 探针服务...${NC}\n"

    if [ -f /etc/init.d/komari-agent ]; then
        rc-service komari-agent restart >/dev/null 2>&1 || {
            rc-service komari-agent zap >/dev/null 2>&1
            rc-service komari-agent start >/dev/null 2>&1
        }
    elif command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ] && [ -f /etc/systemd/system/komari-agent.service ]; then
        systemctl restart komari-agent >/dev/null 2>&1
    else
        EXISTING_ARGS=$(get_existing_config)
        if [ -z "$EXISTING_ARGS" ]; then
            printf "${RED}❌ 未检测到已安装的 Komari Agent 服务或配置，请先选择 [1] 进行安装！${NC}\n"
            [ "$SILENT_CLI" != "1" ] && { printf "按回车键返回主菜单..."; read -r _ < /dev/tty; }
            return 1
        fi
        parse_agent_args "$EXISTING_ARGS"

        TARGET_BIN="$BIN_PATH"
        [ ! -x "$TARGET_BIN" ] && [ -x /opt/komari/agent ] && TARGET_BIN="/opt/komari/agent"

        if [ ! -x "$TARGET_BIN" ] || [ -z "$PARSED_URL" ] || [ -z "$PARSED_TOKEN" ]; then
            printf "${RED}❌ 无法定位可执行文件或启动参数，建议直接使用 [1] 重新部署！${NC}\n"
            [ "$SILENT_CLI" != "1" ] && { printf "按回车键返回主菜单..."; read -r _ < /dev/tty; }
            return 1
        fi

        kill_running_agent
        sleep 1
        GOMEMLIMIT="20MiB" nohup "$TARGET_BIN" -e "$PARSED_URL" -t "$PARSED_TOKEN" $PARSED_EXTRA >/dev/null 2>&1 &
    fi

    sleep 2
    PROCESS_COUNT=$(ps -ef 2>/dev/null | grep -E '[k]omari-agent|[/]komari/agent' | wc -l | tr -d ' ')
    if [ "${PROCESS_COUNT:-0}" -ge 1 ]; then
        printf "${GREEN}✔ Komari Agent 重启成功！当前活跃进程数: %s${NC}\n" "$PROCESS_COUNT"
    else
        printf "${RED}⚠️ 重启后未检测到存活进程，请使用 [6] 查看报错日志！${NC}\n"
    fi

    if [ "$SILENT_CLI" != "1" ]; then
        printf "按回车键返回主菜单..."
        read -r _ < /dev/tty
    fi
}

# 手动修改当前节点 Token（保留原有 -e 地址与所有附加参数）
change_token() {
    INPUT_TOKEN="$1"
    SILENT_CLI="$2"
    [ "$SILENT_CLI" != "1" ] && clear

    EXISTING_ARGS=$(get_existing_config)
    if [ -z "$EXISTING_ARGS" ]; then
        printf "${RED}❌ 未检测到已安装的 Komari Agent，请先使用菜单 [1] 进行安装！${NC}\n"
        [ "$SILENT_CLI" != "1" ] && { printf "按回车键返回主菜单..."; read -r _ < /dev/tty; }
        return 1
    fi

    parse_agent_args "$EXISTING_ARGS"
    if [ -z "$PARSED_URL" ]; then
        printf "${RED}❌ 无法读取原主控地址 (-e)，建议使用菜单 [1] 重新部署！${NC}\n"
        [ "$SILENT_CLI" != "1" ] && { printf "按回车键返回主菜单..."; read -r _ < /dev/tty; }
        return 1
    fi

    if [ -z "$INPUT_TOKEN" ]; then
        printf "${GREEN}=======================================================${NC}\n"
        printf "${GREEN}    手动修改 Komari Agent 节点 Token 令牌             ${NC}\n"
        printf "${GREEN}=======================================================${NC}\n"
        printf "  当前主控地址 : ${CYAN}%s${NC}\n" "$PARSED_URL"
        printf "  当前旧 Token : ${YELLOW}%s${NC}\n" "${PARSED_TOKEN:-无}"
        printf "  保留附加参数 : ${GREEN}%s${NC}\n" "${PARSED_EXTRA:-无}"
        printf "${GREEN}-------------------------------------------------------${NC}\n"
        printf "${YELLOW}👉 请输入新的 Token 令牌（支持直接粘贴密钥或完整命令）：${NC}\n"
        read -r INPUT_TOKEN < /dev/tty
    fi

    # 兼容直接粘贴纯 Token 或粘贴包含 -t xxx 的命令行
    CLEAN_INPUT=$(printf '%s' "$INPUT_TOKEN" | tr '\r\n\t\\' '    ' | tr -d "\"'" | sed -E 's/ +/ /g; s/^ //; s/ $//')
    case " $CLEAN_INPUT " in
        *" -t "*)
            NEW_TOKEN=$(printf ' %s ' "$CLEAN_INPUT" | grep -oE ' -t[= ]+[^ ]+' | head -n1 | sed -E 's/^ -t[= ]+//')
            ;;
        *)
            NEW_TOKEN=$(printf '%s' "$CLEAN_INPUT" | awk '{print $1}')
            ;;
    esac

    if [ -z "$NEW_TOKEN" ]; then
        printf "${RED}❌ 输入为空，未提取到有效的 Token，已取消修改！${NC}\n"
        [ "$SILENT_CLI" != "1" ] && { printf "按回车键返回主菜单..."; read -r _ < /dev/tty; }
        return 1
    fi

    # 若原进程使用官方路径 /opt/komari/agent，将其同步迁移至 BIN_PATH 免重新下载
    if [ ! -x "$BIN_PATH" ] && [ -x /opt/komari/agent ]; then
        mkdir -p "$(dirname "$BIN_PATH")"
        cp -f /opt/komari/agent "$BIN_PATH" && chmod +x "$BIN_PATH"
    fi

    if [ ! -x "$BIN_PATH" ]; then
        printf "${RED}❌ 未找到 komari-agent 可执行文件，请使用菜单 [1] 重新部署！${NC}\n"
        [ "$SILENT_CLI" != "1" ] && { printf "按回车键返回主菜单..."; read -r _ < /dev/tty; }
        return 1
    fi

    printf "\n${YELLOW}正在写入新 Token 并重启守护服务...${NC}\n"
    # 若为精简容器无 Systemd/OpenRC，先结束旧进程防止双开
    if [ ! -f /sbin/openrc-run ] && { [ ! -d /etc/init.d ] || [ -d /run/systemd/system ]; } && { ! command -v systemctl >/dev/null 2>&1 || [ ! -d /run/systemd/system ]; }; then
        kill_running_agent
        sleep 1
    fi

    setup_service "$PARSED_URL" "$NEW_TOKEN" "$PARSED_EXTRA"
    sleep 2
    PROCESS_COUNT=$(ps -ef 2>/dev/null | grep -E '[k]omari-agent|[/]komari/agent' | wc -l | tr -d ' ')

    printf "${GREEN}=======================================================${NC}\n"
    if [ "${PROCESS_COUNT:-0}" -ge 1 ]; then
        printf "${GREEN} ✔ Token 修改成功并已生效！${NC}\n"
        printf "   新 Token 令牌 : ${YELLOW}%s${NC}\n" "$NEW_TOKEN"
        printf "   保留附加参数  : ${GREEN}%s${NC}\n" "${PARSED_EXTRA:-无}"
        printf "   当前活跃进程  : ${YELLOW}%s${NC}\n" "$PROCESS_COUNT"
    else
        printf "${RED} ⚠️ Token 已写入，但进程未检测到存活，请用菜单 [6] 查看日志！${NC}\n"
    fi
    printf "${GREEN}=======================================================${NC}\n"

    if [ "$SILENT_CLI" != "1" ]; then
        printf "按回车键返回主菜单..."
        read -r _ < /dev/tty
    fi
}

# 保留现有 Token/地址/附加参数，仅升级 Agent 二进制
upgrade_agent_binary() {
    clear
    printf "${YELLOW}正在读取本机现有 Komari Agent 配置...${NC}\n"
    EXISTING_ARGS=$(get_existing_config)

    if [ -z "$EXISTING_ARGS" ]; then
        printf "${RED}❌ 未找到本机已安装的服务配置，请先使用菜单 [1] 进行全新安装！${NC}\n"
        printf "按回车键返回..."
        read -r _ < /dev/tty
        return
    fi

    printf "${GREEN}已完整提取原配置与附加参数，直接执行平滑升级...${NC}\n"
    install_agent "$EXISTING_ARGS" "0"
}

