upgrade_myself() {
    clear
    printf "${YELLOW}正在通过多源加速通道拉取最新 tz 脚本...${NC}\n"
    TMP_SCRIPT="/tmp/tz_update_safe.sh"

    if smart_download "$RAW_SCRIPT_URL" "$TMP_SCRIPT" "text"; then
        mv -f "$TMP_SCRIPT" "$SELF_PATH"
        chmod +x "$SELF_PATH"
        printf "${GREEN}✔ 脚本已升级到最新版本！请重新输入 tz 启动。${NC}\n"
        exit 0
    else
        printf "${RED}❌ 升级失败！所有镜像及直连节点均无法下载或语法校验未通过。${NC}\n"
        printf "按回车键返回主菜单..."
        read -r _ < /dev/tty
    fi
}

check_status() {
    clear
    printf "${GREEN}=======================================================${NC}\n"
    printf "${GREEN}    Komari Agent 运行状态与最近日志诊断               ${NC}\n"
    printf "${GREEN}=======================================================${NC}\n"
    PROCESS_COUNT=$(ps -ef 2>/dev/null | grep -E '[k]omari-agent|[/]komari/agent' | wc -l | tr -d ' ')
    printf "活跃进程数: ${YELLOW}%s${NC}\n" "$PROCESS_COUNT"
    ps -ef 2>/dev/null | grep -E '[k]omari-agent|[/]komari/agent'
    printf "\n${CYAN}--- 最近服务日志 ---${NC}\n"
    if command -v journalctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
        journalctl -u komari-agent -n 15 --no-pager 2>/dev/null
    elif [ -f /etc/init.d/komari-agent ]; then
        rc-service komari-agent status 2>/dev/null
    else
        printf "精简容器环境无 journalctl 日志输出。\n"
    fi
    printf "\n按回车键返回主菜单..."
    read -r _ < /dev/tty
}

uninstall_agent() {
    clear
    printf "${YELLOW}正在彻底卸载 Komari Agent 及自启服务...${NC}\n"
    cleanup_agent
    printf "${GREEN}✔ Komari Agent 已完全卸载清理！${NC}\n"
    printf "按回车键返回主菜单..."
    read -r _ < /dev/tty
}

show_menu() {
    clear
    printf "${GREEN}=======================================================${NC}\n"
    printf "${GREEN}    Komari Agent 智能管理工具箱 (快捷键: tz)          ${NC}\n"
    printf "${GREEN}=======================================================${NC}\n"
    printf "  ${YELLOW}[1]${NC} 全新纯净卸载 & 安装 Komari Agent\n"
    printf "  ${YELLOW}[2]${NC} 手动重启 Komari Agent 探针\n"
    printf "  ${YELLOW}[3]${NC} 保留原配置，原地升级 Agent 内核\n"
    printf "  ${YELLOW}[4]${NC} 查看当前节点配置与 Token 令牌\n"
    printf "  ${YELLOW}[5]${NC} 手动修改当前节点 Token 令牌\n"
    printf "  ${YELLOW}[6]${NC} 查看 Agent 运行状态与报错日志\n"
    printf "  ${YELLOW}[7]${NC} 一键升级 tz 脚本自身\n"
    printf "  ${YELLOW}[8]${NC} 彻底卸载 Komari Agent\n"
    printf "  ${YELLOW}[0]${NC} 退出工具箱\n"
    printf "${GREEN}=======================================================${NC}\n"
    printf "请选择操作 [0-8]: "
    read -r CHOICE < /dev/tty

    case "$CHOICE" in
        1) install_agent "" "0"; show_menu ;;
        2) restart_agent "0"; show_menu ;;
        3) upgrade_agent_binary; show_menu ;;
        4) show_token_info "0"; show_menu ;;
        5) change_token "" "0"; show_menu ;;
        6) check_status; show_menu ;;
        7) upgrade_myself ;;
        8) uninstall_agent; show_menu ;;
        0) printf "\n退出成功！\n"; exit 0 ;;
        *) printf "${RED}输入错误！${NC}\n"; sleep 1; show_menu ;;
    esac
}

# 支持命令行直接带参执行，无参则进入交互菜单
if [ $# -gt 0 ]; then
    case "$1" in
        restart) restart_agent "1" ;;
        token) show_token_info "1" ;;
        set-token) change_token "$2" "1" ;;
        update) upgrade_myself ;;
        status) check_status ;;
        uninstall) uninstall_agent ;;
        *) install_agent "$*" "1" ;;
    esac
else
    show_menu
fi
